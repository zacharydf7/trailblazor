{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["es2023", "dom", "dom.iterable"],
    // A script imports the other package's as the browser finds it, beside its own folder under _content/.
    "rootDirs": ["src/Trailblazor/Trailblazor.Primitives", "src/Trailblazor.Primitives/wwwroot"]
  },
  "include": ["src/browser-globals.d.ts", "src/Trailblazor/wwwroot/*.js", "src/Trailblazor.Primitives/wwwroot/*.js"]
}
