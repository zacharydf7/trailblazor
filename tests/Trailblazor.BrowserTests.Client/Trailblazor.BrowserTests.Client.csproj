<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The test host's pages, which run on the server or in WebAssembly as a test asks. They keep the host's namespace. -->
  <PropertyGroup>
    <RootNamespace>Trailblazor.BrowserTests.Host</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazor\Trailblazor.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs.Examples\Trailblazor.Docs.Examples.csproj" />
  </ItemGroup>

</Project>
