@page "/grid-edit-keys"

@* A column edited through its own multi-line field, which commits its text only on change, before a column with the grid's own field. *@
<TbDataGrid TItem="Note" Items="_notes" AriaLabel="Notes" KeySelector="note => note.Id">
    <TbColumn Field="note => note.Text" Editable>
        <EditTemplate>
            <TbTextField TValue="string" AriaLabel="Text" Lines="3" AutoFocus Value="@(context.Value as string)"
                         ValueChanged="text => context.SetValue(text)" />
        </EditTemplate>
    </TbColumn>
    <TbColumn Field="note => note.Tag" Editable />
</TbDataGrid>

@* A row edit whose first field has an OnBlur, so the field's own focus root sits inside the row's. *@
<TbDataGrid TItem="Note" Items="_rows" AriaLabel="Note rows" KeySelector="note => note.Id" EditMode="GridEditMode.Row"
            OnRowEdit="() => _rowSaves++">
    <TbColumn Field="note => note.Text" Editable>
        <EditTemplate>
            <TbTextField TValue="string" AriaLabel="Row text" AutoFocus Value="@(context.Value as string)"
                         ValueChanged="text => context.SetValue(text)" OnBlur="() => _blurs++" />
        </EditTemplate>
    </TbColumn>
    <TbColumn Field="note => note.Tag" Editable />
</TbDataGrid>
<output data-testid="row-saves">@_rowSaves</output>
<output data-testid="blurs">@_blurs</output>

@code {
    private readonly List<Note> _notes = [new() { Id = 1, Text = "Old text", Tag = "Trail" }];
    private readonly List<Note> _rows = [new() { Id = 1, Text = "Row text", Tag = "Ridge" }];
    private int _rowSaves;
    private int _blurs;

    private sealed class Note
    {
        public int Id { get; init; }

        public string Text { get; set; } = "";

        public string Tag { get; set; } = "";
    }
}
