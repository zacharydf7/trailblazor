@page "/dialogs"
@using Trailblazor.BrowserTests.Host.Dialogs
@inject IDialogService Dialogs

<TbStack Row Gap="2" Wrap>
    <TbButton OnClick="RenameAsync">Rename</TbButton>
    <TbButton OnClick="ConfirmAsync">Delete</TbButton>
    <TbButton OnClick="LockedAsync">Locked</TbButton>
    <TbButton OnClick="NestedAsync">Nested</TbButton>
    <TbButton OnClick="PanelAsync">Panel</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.BottomEnd, modal: false)">Docked</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.Top)">Top</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.Start)">Start</TbButton>
    <TbButton OnClick="AboutAsync">About</TbButton>
    <TbButton OnClick="() => NotesAsync(DialogSize.Medium)">Notes</TbButton>
    <TbButton OnClick="() => NotesAsync(DialogSize.Full)">Full notes</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<FormNameDialog, string>("Form name",
                  options: new() { Modal = false, Maximizable = true })'>
        Form name
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<FormNameDialog, string>("Full form name",
                  options: new() { Size = DialogSize.Full })'>
        Full form name
    </TbButton>
    <TbButton OnClick="() => _formDrawer = true">Form drawer</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<PlannerDialog, bool>("Planner", p => p.Set(d => d.Tabs, true),
                  options: new() { Size = DialogSize.Full })'>
        Planner
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<PlannerDialog, bool>("Stops",
                  options: new() { Size = DialogSize.Full })'>
        Stops
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<PlannerDialog, bool>("Form planner",
                  p => p.Set(d => d.Tabs, true).Set(d => d.Form, true), options: new() { Size = DialogSize.Full })'>
        Form planner
    </TbButton>
    <TbButton OnClick="MovableAsync">Movable</TbButton>
    <TbButton OnClick="AnnotatedAsync">Annotated</TbButton>
    <TbButton OnClick="() => TuckedAsync(modal: true)">Tucked</TbButton>
    <TbButton OnClick="() => TuckedAsync(modal: false)">Tucked window</TbButton>
    <TbButton OnClick="StillAsync">Still</TbButton>
    <TbButton OnClick="BarredAsync">Barred</TbButton>
    <TbButton OnClick="() => Dialogs.OpenDialogs[^1].Draggable = true">Let it move</TbButton>
    <TbButton OnClick='() => Dialogs.OpenDialogs[^1].Width = "400px"'>Narrow it</TbButton>
    <TbButton OnClick="WideAsync">Wide</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<SizedDialog, string>("Sized", options: new() { Width = "600px" })'>
        Sized
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<NameDialog, string>("Full sized",
                  options: new() { Size = DialogSize.Full, Width = "600px" })'>
        Full sized
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<NameDialog, string>("Fit", options: new() { Size = DialogSize.Fit })'>
        Fit
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<NameDialog, string>("Capped",
                           options: new() { Size = DialogSize.Fit, Width = "6rem" })'>
        Capped
    </TbButton>
    <TbButton OnClick="() => EditorAsync()">Editor</TbButton>
    <TbButton OnClick="() => EditorAsync(locked: true)">Locked editor</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<NameDialog, string>("Headless", options: new() { ShowHeader = false })'>
        Headless
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<AddressDialog, string>("Address")'>Address</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<PaceDialog, string>("Pace")'>Pace</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<AddressDialog, string>("Address", p => p.Set(d => d.FloorLocked, true))'>
        Address locked
    </TbButton>
    <TbButton OnClick="() => HintedAsync(locked: false)">Hinted</TbButton>
    <TbButton OnClick="() => HintedAsync(locked: true)">Hinted locked</TbButton>
    <TbButton OnClick="SuggestAsync">Suggest</TbButton>
    <TbButton data-testid="page-button" OnClick="() => _pageClicks++">Page button</TbButton>
    <input aria-label="Page note" />
    <TbButton OnClick="() => _outer = true">Outer</TbButton>
    <TbButton OnClick="() => _small = true">Small host</TbButton>
    <TbButton OnClick="() => _drawer = true">Fit drawer</TbButton>
</TbStack>
<output data-testid="result">@_result</output>
@* A modeless dialog with another written inside it, so the inner one is in the outer one's markup. *@
<TbDialog @bind-Open="_outer" Title="Outer" Options="Modeless">
    <TbButton OnClick="() => _inner = true">Inner</TbButton>
    <TbDialog @bind-Open="_inner" Title="Inner" Options="Modeless">
        <TbButton>Inside</TbButton>
    </TbDialog>
</TbDialog>
@* A fitted dialog inside a small one, with words wider than the small one. *@
<TbDialog @bind-Open="_small" Title="Small host" Options="SmallModeless">
    <TbButton OnClick="() => _fitted = true">Fitted</TbButton>
    <TbDialog @bind-Open="_fitted" Title="Fitted" Options="FitModeless">
        <p style="white-space: nowrap">@string.Join(" ", Enumerable.Repeat("Wider than the small dialog.", 4))</p>
    </TbDialog>
</TbDialog>
<TbDrawer @bind-Open="_drawer" Title="Fit drawer" Size="DialogSize.Fit" Width="10rem">
    <p style="white-space: nowrap">@string.Join(" ", Enumerable.Repeat("Wider than the drawer.", 4))</p>
</TbDrawer>
@* A short form whose actions are inside it. *@
<TbDrawer @bind-Open="_formDrawer" Title="Form drawer">
    <TbForm Model="this">
        <TbTextField Label="Trail" @bind-Value="_trail" />
        <TbDialogActions><TbButton Type="ButtonType.Submit">Save</TbButton></TbDialogActions>
    </TbForm>
</TbDrawer>
<output data-testid="page-clicks">@_pageClicks</output>
@* Tall enough to scroll, so the scroll lock can be seen. *@
<div style="height: 200vh"></div>

@code {
    private static readonly DialogOptions Modeless = new() { Modal = false };
    private static readonly DialogOptions SmallModeless = new() { Modal = false, Size = DialogSize.Small };
    private static readonly DialogOptions FitModeless = new() { Modal = false, Size = DialogSize.Fit };
    private string _result = "";
    private bool _outer;
    private bool _small;
    private bool _fitted;
    private bool _drawer;
    private bool _formDrawer;
    private string? _trail;
    private bool _inner;
    private int _pageClicks;

    private async Task RenameAsync()
    {
        var result = await Dialogs.ShowAsync<NameDialog, string>("Rename", p => p.Set(d => d.Name, "Ada"));
        _result = result.Confirmed ? $"saved {result.Value}" : "cancelled";
    }

    private async Task ConfirmAsync() =>
        _result = await Dialogs.ConfirmAsync("Delete?", "This can't be undone.", "Delete") ? "deleted" : "kept";

    private async Task LockedAsync()
    {
        var options = new DialogOptions { DismissOnEscape = false, DismissOnBackdrop = false };
        var result = await Dialogs.ShowAsync<NameDialog, string>("Locked", options: options);
        _result = result.Confirmed ? "saved" : "cancelled";
    }

    private async Task NestedAsync()
    {
        var result = await Dialogs.ShowAsync<OuterDialog, bool>("Outer");
        _result = result.Confirmed ? "outer saved" : "outer cancelled";
    }

    private async Task HintedAsync(bool locked)
    {
        var options = new DialogOptions { DismissOnEscape = !locked };
        var result = await Dialogs.ShowAsync<HintedDialog, string>("Hinted", options: options);
        _result = result.Confirmed ? "hinted saved" : "hinted cancelled";
    }

    private async Task SuggestAsync()
    {
        var result = await Dialogs.ShowAsync<SuggestDialog, string>("Suggest");
        _result = result.Confirmed ? "suggest saved" : "suggest cancelled";
    }

    private async Task PlacedAsync(DialogPosition position, bool modal = true) =>
        await Dialogs.ShowAsync<NameDialog, string>($"Placed {position}",
            options: new() { Position = position, Modal = modal });

    private int _notes;

    private async Task NotesAsync(DialogSize size) =>
        await Dialogs.ShowAsync<NameDialog, string>($"Notes {++_notes}",
            options: new() { Modal = false, Minimizable = true, Maximizable = true, Size = size });

    private async Task MovableAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("Movable", options: new()
        {
            Modal = false, Draggable = true, Resizable = true, Minimizable = true, Maximizable = true,
        });

    private async Task AnnotatedAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("Annotated", p => p.Set(d => d.HeaderActions, true),
            new() { Modal = false, Draggable = true });

    private async Task TuckedAsync(bool modal) =>
        await Dialogs.ShowAsync<NameDialog, string>("Tucked",
            options: new() { Modal = modal, Minimizable = true, WindowState = DialogWindowState.Minimized });

    private async Task BarredAsync() =>
        await Dialogs.ShowAsync<BarDialog, string>("Barred", options: new() { Modal = false, Draggable = true });

    private async Task StillAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("Still", options: new() { Modal = false });

    private async Task WideAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("Wide",
            options: new() { Modal = false, Resizable = true, Width = "600px" });

    private async Task EditorAsync(bool locked = false)
    {
        var result = await Dialogs.ShowAsync<EditorDialog, string>("Editor",
            options: new() { Minimizable = true, Maximizable = true, DismissOnEscape = !locked });
        _result = result.Confirmed ? "editor saved" : "editor cancelled";
    }

    private async Task AboutAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("About", options: new() { InitialFocus = DialogFocus.Dialog });

    private async Task PanelAsync()
    {
        var result = await Dialogs.ShowAsync<NameDialog, string>("Panel", options: new() { Modal = false });
        _result = result.Confirmed ? "panel saved" : "panel cancelled";
    }
}
