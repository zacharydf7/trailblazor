@page "/tabs-beside"

@* Tabs with content before and after them. The narrow one has too many tabs for its row, so the list scrolls between
   what stays at each end, and the column puts the Start content above its tabs and the End content under them. The
   pills draw no line under their row, the filling tabs give their panel the rest of a fixed height, and the last
   column has nothing under its tabs and a panel taller than them. *@
<TbTabs AriaLabel="Report">
    <Start><button type="button">Menu</button></Start>
    <End><button type="button">Share</button></End>
    <ChildContent>
        <TbTab Text="Summary"><button type="button">In the panel</button></TbTab>
        <TbTab Text="Details">Details panel</TbTab>
    </ChildContent>
</TbTabs>

<div style="inline-size: 360px">
    <TbTabs AriaLabel="Narrow" ScrollButtons OnAdd="() => { }">
        <Start><button type="button">Menu</button></Start>
        <End><button type="button">Share</button></End>
        <ChildContent>
            @for (var index = 1; index <= 12; index++)
            {
                <TbTab Text="@($"Section {index}")">Section panel</TbTab>
            }
        </ChildContent>
    </TbTabs>
</div>

<TbTabs AriaLabel="Column" Vertical OnAdd="() => { }">
    <Start><button type="button">Menu</button></Start>
    <End><button type="button">Share</button></End>
    <ChildContent>
        <TbTab Text="First">First panel</TbTab>
        <TbTab Text="Second">Second panel</TbTab>
    </ChildContent>
</TbTabs>

<TbTabs AriaLabel="Pills" Variant="Variant.Soft">
    <Start><button type="button">Menu</button></Start>
    <ChildContent>
        <TbTab Text="First">First panel</TbTab>
    </ChildContent>
</TbTabs>

<div style="block-size: 240px">
    <TbTabs AriaLabel="Filling" Fill>
        <Start><button type="button">Menu</button></Start>
        <ChildContent>
            <TbTab Text="First">First panel</TbTab>
        </ChildContent>
    </TbTabs>
</div>

<TbTabs AriaLabel="Stacked" Vertical>
    <Start><button type="button">Menu</button></Start>
    <ChildContent>
        <TbTab Text="First"><div style="block-size: 200px">A tall panel</div></TbTab>
    </ChildContent>
</TbTabs>
