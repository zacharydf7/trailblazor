@page "/dock-manager"

<TbButton OnClick="() => _layout = Start">Reset</TbButton>
<TbButton OnClick="() => _layout = Moved">Move weather</TbButton>
<TbButton OnClick="() => _layout = Crowded">Crowd</TbButton>
<TbButton OnClick="() => _layout = Columns">Columns</TbButton>
<TbButton OnClick="() => _layout = OnlyNotes">Only notes</TbButton>
<TbButton OnClick="@(() => _layout = _layout.Open("notes"))">Open notes</TbButton>
<TbButton OnClick="@(() => _layout = _layout.Close("gear"))">Close gear</TbButton>
<div style="inline-size: 48rem; block-size: 24rem" dir="@Direction">
    @* Tests narrow this dock to move its separators' limits, so it keeps its groups unless a test asks for the
       compact form. *@
    <TbDockManager @bind-Layout="_layout" AriaLabel="Hike planner" MinGroupSize="64" PersistenceKey="@Key"
                   CompactBelow="@(Compact ? Breakpoint.Sm : Breakpoint.Xs)">
        <EmptyContent>Nothing is open.</EmptyContent>
        <ChildContent>
        <TbDockPanel Id="trails" Title="Trails">
            <input aria-label="Trail name" />
            <button type="button">Add trail</button>
        </TbDockPanel>
        <TbDockPanel Id="map" Title="Map" Closable="false">
            <button type="button">Zoom in</button>
            <TbTabs AriaLabel="Layers">
                <TbTab Text="Roads">Roads</TbTab>
                <TbTab Text="Terrain">Terrain</TbTab>
                <TbTab Text="Satellite">Satellite</TbTab>
            </TbTabs>
            <div style="block-size: 4rem">
                <TbSplitter>
                    <TbSplitterPane Label="Legend" Size="40">Legend</TbSplitterPane>
                    <TbSplitterPane Label="Scale">Scale</TbSplitterPane>
                </TbSplitter>
            </div>
        </TbDockPanel>
        <TbDockPanel Id="notes" Title="Notes">
            <input aria-label="Note" />
            <div style="block-size: 60rem">Pack list</div>
        </TbDockPanel>
        <TbDockPanel Id="gear" Title="Gear">
            <button type="button">Add gear</button>
        </TbDockPanel>
        <TbDockPanel Id="weather" Title="Weather">
            <iframe title="Forecast" srcdoc="<input aria-label='City'>" style="block-size: 3rem"></iframe>
            <button type="button">Refresh</button>
            <div data-testid="days" style="block-size: 3rem; overflow: auto">
                <div style="block-size: 20rem">Five days</div>
            </div>
            <div style="block-size: 60rem">Hourly</div>
        </TbDockPanel>
        </ChildContent>
    </TbDockManager>
</div>
@* Its separator has the name of the dock's first one. *@
<div style="inline-size: 48rem; block-size: 4rem">
    <TbSplitter>
        <TbSplitterPane Label="Trails" Size="30">Trail list</TbSplitterPane>
        <TbSplitterPane Label="Elevation">Profile</TbSplitterPane>
    </TbSplitter>
</div>
@* Below the dock, so text that wraps as the layout changes never moves what a test has measured. *@
<p data-testid="layout">@_layout.ToJson()</p>

@code {
    // Trails and Map share a group beside Notes and Gear, which sit above the weather.
    private static readonly DockLayout Start = new(new DockSplit(
        new DockGroup("trails", "map") { Size = 1 },
        new DockSplit(new DockGroup("notes", "gear") { Size = 3 }, new DockGroup("weather"))
        {
            Vertical = true,
            Size = 3,
        }));

    private static readonly DockLayout Moved = new(new DockSplit(
        new DockGroup("trails", "map", "weather") { Active = "weather" }, new DockGroup("notes", "gear")));

    // Four tabs in a group too narrow for them, with the last one showing.
    private static readonly DockLayout Crowded = new(new DockSplit(
        new DockGroup("trails", "map", "notes", "weather") { Active = "weather", Size = 1 },
        new DockGroup("gear") { Size = 3 }));

    // Three groups side by side, as many as at the start, with Gear now the showing tab of the narrow first one.
    private static readonly DockLayout Columns = new(new DockSplit(
        new DockGroup("trails", "map", "gear") { Active = "gear", Size = 1 },
        new DockGroup("notes") { Size = 2 }, new DockGroup("weather") { Size = 1 }));

    // One panel docked and the rest closed.
    private static readonly DockLayout OnlyNotes = new(new DockGroup("notes"), ["trails", "map", "gear", "weather"]);

    private DockLayout _layout = Start;

    [SupplyParameterFromQuery]
    private string? Direction { get; set; }

    [SupplyParameterFromQuery]
    private string? Layout { get; set; }

    [SupplyParameterFromQuery]
    private string? Key { get; set; }

    [SupplyParameterFromQuery]
    private bool Compact { get; set; }

    protected override void OnInitialized()
    {
        if (Layout == "crowded")
        {
            _layout = Crowded;
        }
        else if (Layout == "corner")
        {
            // Gear floats in the corner where the dock begins, over the trails.
            _layout = Start.FloatAt("gear", 0, 0, 40, 50);
        }
        else if (Layout == "lone")
        {
            // The notes are the only panel docked, with Gear in a window.
            _layout = OnlyNotes.FloatAt("gear", 50, 10, 40, 40);
        }
        else if (Layout == "strips")
        {
            // Gear is put away at the start and the weather at the bottom.
            _layout = Start.AutoHide("gear", DockPosition.Start).AutoHide("weather", DockPosition.Bottom);
        }
        else if (Layout == "adrift")
        {
            // Gear's window is all the dock holds.
            _layout = OnlyNotes.Close("notes").FloatAt("gear", 50, 10, 40, 40);
        }
    }
}
