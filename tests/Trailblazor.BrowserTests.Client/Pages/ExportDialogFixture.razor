@page "/export-dialog"
@using Trailblazor.Docs.Examples
@inject IDialogService Dialogs

@* The docs example's export dialog at 50%, left open until Stop, since the example closes it itself. *@
<TbButton OnClick="OpenAsync">Export report</TbButton>
<TbText>@_status</TbText>

@code {
    private string _status = "";

    private async Task OpenAsync()
    {
        var dialog = Dialogs.Show<ExportDialog>(parameters: dialog => dialog.Set(export => export.Percent, 50));
        _status = (await dialog.Result).Confirmed ? "Exported" : "Export stopped";
    }
}
