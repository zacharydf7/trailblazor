@page "/menu-placement"

@* Room on every side, so no menu has to flip, except the long one, which no side of a short window can hold. *@
<div style="display: grid; justify-items: center; gap: 4rem; padding: 12rem 2rem">
    <TbMenu Label="Above" Placement="Placement.Top" Align="PlacementAlign.End">
        <TbMenuItem>Rename the file</TbMenuItem>
        <TbMenuItem>Remove</TbMenuItem>
    </TbMenu>
    <TbMenu Label="Beside" Placement="Placement.End" Align="PlacementAlign.Center">
        <TbMenuItem>Rename</TbMenuItem>
        <TbMenuItem>Remove</TbMenuItem>
    </TbMenu>
    <div style="width: 30rem">
        <TbMenu Label="Wide" FullWidth="_wide">
            <TbMenuItem>Rename</TbMenuItem>
        </TbMenu>
    </div>
    <TbButton OnClick="() => _wide = false">Fit the wide menu</TbButton>
    <div style="width: 8rem">
        <TbMenu Label="Narrow" FullWidth>
            <TbMenuItem>Cut</TbMenuItem>
        </TbMenu>
    </div>
    <TbMenu Label="Long">
        @foreach (var stop in Enumerable.Range(1, 30))
        {
            <TbMenuItem>Stop @stop</TbMenuItem>
        }
    </TbMenu>
</div>

@code {
    private bool _wide = true;
}
