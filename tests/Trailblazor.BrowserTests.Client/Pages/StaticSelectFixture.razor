@page "/static-select"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-select" OnValidSubmit="Post">
    <TbSelect Label="Size" @bind-Value="Model!.Size" Placeholder="Pick a size">
        <TbOption Value="@("Small")">Small</TbOption>
        <TbOption Value="@("Medium")">Medium</TbOption>
    </TbSelect>
    <TbMultiSelect Label="Toppings" @bind-Value="Model!.Toppings">
        <TbOption Value="@("Cheese")">Cheese</TbOption>
        <TbOption Value="@("Ham")">Ham</TbOption>
        <TbOption Value="@("Olives")">Olives</TbOption>
    </TbMultiSelect>
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>
<TbSelect TValue="string" Label="Saved routes" @bind-Value="_route" />

@code {
    private string? _posted;
    private string? _route;

    [SupplyParameterFromForm]
    private Order? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    // An unchosen select posts an empty value, and a multiple select with nothing chosen posts nothing at all.
    private void Post() => _posted = $"{(string.IsNullOrEmpty(Model!.Size) ? "none" : Model.Size)} | " +
        $"{(Model.Toppings is { Count: > 0 } toppings ? string.Join(", ", toppings) : "none")}";

    private sealed class Order
    {
        public string? Size { get; set; }

        public IReadOnlyList<string>? Toppings { get; set; }
    }
}
