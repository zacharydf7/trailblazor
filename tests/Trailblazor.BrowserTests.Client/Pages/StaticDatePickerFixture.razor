@page "/static-date-picker"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-date-picker" OnValidSubmit="Post">
    <TbDatePicker TDate="DateOnly" Label="Start date" @bind-Value="Model!.Start" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Trip? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = $"{Model!.Start:yyyy-MM-dd}";

    private sealed class Trip
    {
        public DateOnly? Start { get; set; } = new DateOnly(2026, 6, 3);
    }
}
