@page "/sortable"

<TbSortable TItem="string" Items="_rules" Label="Rules" OnMove="move => move.ApplyTo(_rules)"
            CanMove="CheckAsync">
    <ItemTemplate>@context</ItemTemplate>
</TbSortable>
<output data-testid="order">@string.Join(", ", _rules)</output>
@* An item holding a field has more text than its name. *@
<TbSortable TItem="string" Items="_steps" Label="Packing steps" ItemLabel="step => step"
            OnMove="move => move.ApplyTo(_steps)">
    <ItemTemplate>@context <TbTextField TValue="string" Label="@($"Note for {context}")" /></ItemTemplate>
</TbSortable>
@* A list inside a grid's cell moves its own items, and only its own. *@
<TbDataGrid TItem="string" Items="_crews" AriaLabel="Crews" OnRowMove="move => move.ApplyTo(_crews)">
    <TbColumn TItem="string" Title="Crew" Id="crew">
        <CellTemplate>
            @context
            @if (context == "North crew")
            {
                <TbSortable TItem="string" Items="_members" Label="North crew members" Context="member"
                            OnMove="move => move.ApplyTo(_members)">
                    <ItemTemplate>@member</ItemTemplate>
                </TbSortable>
            }
        </CellTemplate>
    </TbColumn>
</TbDataGrid>
<output data-testid="crews">@string.Join(", ", _crews); @string.Join(", ", _members)</output>
<TbDataGrid TItem="string" Items="_stops" AriaLabel="Route stops" OnRowMove="move => move.ApplyTo(_stops)">
    <TbColumn TItem="string" Title="Stop" Id="stop">
        <CellTemplate>@context</CellTemplate>
    </TbColumn>
</TbDataGrid>
@* Rows far wider than the grid's own scroll box, whose middles are out of view. *@
<div style="width: 320px">
    <TbDataGrid TItem="string" Items="_camps" AriaLabel="Camps" Height="160px" OnRowMove="move => move.ApplyTo(_camps)">
        <TbColumn TItem="string" Title="Camp" Id="camp">
            <CellTemplate>@context</CellTemplate>
        </TbColumn>
        <TbColumn TItem="string" Title="Notes" Id="notes">
            <CellTemplate><span style="display: inline-block; width: 900px">Notes on @context</span></CellTemplate>
        </TbColumn>
    </TbDataGrid>
</div>

@code {
    private readonly List<string> _rules = ["Block spam", "Flag invoices", "Star the team", "Catch-all"];
    private readonly List<string> _steps = ["Tent", "Stove"];
    private readonly List<string> _stops = ["Trailhead", "Lake camp", "Summit Gate"];
    private readonly List<string> _camps = ["Pine camp", "Fern camp", "Ridge camp"];
    private readonly List<string> _crews = ["North crew", "South crew"];
    private readonly List<string> _members = ["Ada", "Ben"];

    private Task<MoveCheck> CheckAsync(SortableMove<string> move) =>
        Task.FromResult(move.Item == "Catch-all" || move.To == _rules.Count - 1
            ? MoveCheck.Refuse("The catch-all rule stays last.") : MoveCheck.Allow);
}
