@page "/tree-select-states"

@* Tree selects that can't be used, one without a filter box, one with a choice and a disabled item, and one whose
   region starts partly checked. *@
<TbStack Gap="3">
    <TbTreeSelect TItem="Place" TKey="string" Label="Closed trail" Items="Places" KeySelector="place => place.Id"
                  ItemText="place => place.Name" ChildrenSelector="place => place.Children" Disabled />
    <TbTreeSelect TItem="Place" TKey="string" Label="Fixed trail" Items="Places" KeySelector="place => place.Id"
                  ItemText="place => place.Name" ChildrenSelector="place => place.Children" ReadOnly
                  Value="@("pine")" />
    <TbTreeSelect TItem="Place" TKey="string" Label="Plain trail" Items="Places" KeySelector="place => place.Id"
                  ItemText="place => place.Name" ChildrenSelector="place => place.Children" />
    <TbTreeSelect TItem="Place" TKey="string" Label="Picked trail" Items="Places" KeySelector="place => place.Id"
                  ItemText="place => place.Name" ChildrenSelector="place => place.Children" @bind-Value="_picked"
                  ItemDisabled="@(place => place.Id == "eagle")" />
    <TbMultiTreeSelect TItem="Place" TKey="string" Label="Visited trails" Items="Places"
                       KeySelector="place => place.Id" ItemText="place => place.Name"
                       ChildrenSelector="place => place.Children" @bind-Value="_visited" />
    <output aria-label="Visited">@string.Join(", ", _visited)</output>
    @* The app takes a moment with each choice, after the field has closed or checked the row. *@
    <TbTreeSelect TItem="Place" TKey="string" Label="Slow trail" Items="Places" KeySelector="place => place.Id"
                  ItemText="place => place.Name" ChildrenSelector="place => place.Children" Value="_slow"
                  ValueChanged="@((string? id) => ChooseSlowlyAsync(id))" />
    <output aria-label="Slow">@_slow</output>
    <TbMultiTreeSelect TItem="Place" TKey="string" Label="Slow visits" Items="Places" KeySelector="place => place.Id"
                       ItemText="place => place.Name" ChildrenSelector="place => place.Children" Value="_slowVisits"
                       ValueChanged="@((IReadOnlyList<string> ids) => CheckSlowlyAsync(ids))" />
    <output aria-label="Slow checks">@string.Join(", ", _slowVisits)</output>
</TbStack>

@code {
    private static readonly Place[] Places =
    [
        new("north", "North ridge", [new("pine", "Pine Hollow"), new("eagle", "Eagle Ridge")]),
    ];

    private string? _picked = "pine";
    private IReadOnlyList<string> _visited = ["pine"];
    private string? _slow;
    private IReadOnlyList<string> _slowVisits = [];

    private async Task ChooseSlowlyAsync(string? id)
    {
        await Task.Delay(1500);
        _slow = id;
    }

    private async Task CheckSlowlyAsync(IReadOnlyList<string> ids)
    {
        await Task.Delay(1500);
        _slowVisits = ids;
    }

    private sealed record Place(string Id, string Name, IReadOnlyList<Place>? Children = null);
}
