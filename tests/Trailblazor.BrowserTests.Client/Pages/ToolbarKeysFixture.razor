@page "/toolbar-keys"

@* Controls beyond plain buttons, and a button that turns Loading while it has focus. *@
<TbToolbar AriaLabel="Tools">
    <TbToolbarButton Label="Back" />
    <TbSelect TValue="string" Label="Size" @bind-Value="_size">
        <TbOption Value="@("Small")">Small</TbOption>
        <TbOption Value="@("Large")">Large</TbOption>
    </TbSelect>
    <TbButton Disabled FocusableWhenDisabled>Off button</TbButton>
    <TbButton Href="toolbar" Disabled FocusableWhenDisabled>Off link</TbButton>
    <TbButton Disabled>Gone button</TbButton>
    <TbButton Loading="_saving" OnClick="() => _saving = true">Save</TbButton>
    <TbToolbarButton Label="Next" />
</TbToolbar>
<TbToolbar AriaLabel="With off select">
    <TbToolbarButton Label="First" />
    <TbSelect TValue="string" Label="Off size" Disabled />
    <TbToolbarButton Label="Last" />
</TbToolbar>
<TbToolbar AriaLabel="With links">
    <TbToolbarButton Label="Start" />
    <TbButton Href="toolbar" Disabled="_linkOff">Turning link</TbButton>
    <TbButton Href="toolbar" Disabled>Gone link</TbButton>
    <TbButton Href="toolbar" Disabled FocusableWhenDisabled="_keepLink">Kept link</TbButton>
    <TbSelect TValue="string" Label="Turning size" Disabled="_sizeOff" />
</TbToolbar>
<TbToolbar AriaLabel="Stacked" Vertical>
    <TbSelect TValue="string" Label="Stacked pick" />
    <TbToolbarButton Label="Stacked button" />
    <TbButton Href="toolbar" Disabled="_stackedLinkOff">Stacked link</TbButton>
</TbToolbar>
<TbToolbar AriaLabel="Busy">
    <TbToolbarButton Label="Busy start" />
    <TbButton Href="toolbar" Loading Disabled="_busyLinkOff">Busy link</TbButton>
</TbToolbar>
<TbButton OnClick="() => _linkOff = true">Turn link off</TbButton>
<TbButton OnClick="() => _stackedLinkOff = true">Turn stacked link off</TbButton>
<TbButton OnClick="() => _keepLink = true">Keep link focusable</TbButton>
<TbButton OnClick="() => _sizeOff = true">Turn size off</TbButton>
<TbButton OnClick="() => _busyLinkOff = false">Turn busy link on</TbButton>

@code {
    private string? _size;
    private bool _saving;
    private bool _linkOff;
    private bool _keepLink;
    private bool _sizeOff;
    private bool _stackedLinkOff;
    private bool _busyLinkOff = true;
}
