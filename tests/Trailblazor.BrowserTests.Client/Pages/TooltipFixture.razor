@page "/tooltip"

@* The trigger renders its own aria-describedby, which Blazor rewrites on each change. *@
<TbTooltip Text="Saves a copy">
    <button aria-describedby="@(_saved ? "saved-note" : null)" @onclick="() => _saved = true">Save</button>
</TbTooltip>
<p id="saved-note">Saved.</p>

@* Centered on a trigger at the page's edge, the tooltip shifts to fit, and its arrow follows the trigger. *@
<div style="position: absolute; inset-inline-start: 0; top: 12rem">
    <TbTooltip Text="A description that is much wider than the trigger it describes" ShowArrow>
        <button>Edge</button>
    </TbTooltip>
</div>

@* At the top edge, a tooltip set to show above flips below; one test then moves the trigger down to give it room. *@
<div id="top-edge" style="position: fixed; top: 0; inset-inline-end: 0">
    <TbTooltip Text="Flips when it must">
        <button>Flipping</button>
    </TbTooltip>
</div>

<TbTooltip Text="Takes its time" ShowDelay="TimeSpan.FromSeconds(1)">
    <button>Slow</button>
</TbTooltip>
<TbTooltip Text="Lingers" HideDelay="TimeSpan.FromSeconds(1)">
    <button>Lingering</button>
</TbTooltip>

@* Beside the trigger, the arrow points across at its middle, in either direction. *@
<p>
    <TbTooltip Text="Goes on" Placement="Placement.End" ShowArrow>
        <button>Forward</button>
    </TbTooltip>
</p>
<p dir="rtl">
    <TbTooltip Text="Goes on to the left" Placement="Placement.End" ShowArrow>
        <button>Onward</button>
    </TbTooltip>
</p>

@* Two triggers with one name, told apart by their rows. *@
<ul aria-label="Trails">
    <li>
        <TbTooltip Text="Remove Pine"><button>Remove</button></TbTooltip>
    </li>
    <li>
        <TbTooltip Text="Remove Cedar"><button>Remove</button></TbTooltip>
    </li>
</ul>

@code {
    private bool _saved;
}
