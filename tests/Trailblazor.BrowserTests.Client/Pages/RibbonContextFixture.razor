@page "/ribbon-context"

@* A ribbon whose Design tab belongs to a context and goes away at "x" or "y", pressed anywhere in the ribbon, so a
   test can remove it while it has focus; at "y" the app selects Insert as well. The tabs under it hold a tab that
   can't close but gets an aria-keyshortcuts from HeaderAttributes. The Ledger ribbon is bound by index, and its
   Totals tab goes away at "z" as the app selects Rows. *@
<div @onkeydown="OnKeyDown">
    <TbRibbon AriaLabel="Sketchbook" @bind-ActiveKey="_tab">
        <TbRibbonTab Key="home" Title="Home">
            <TbRibbonGroup Label="Pages">
                <TbRibbonButton Label="Add a page" />
            </TbRibbonGroup>
        </TbRibbonTab>
        <TbRibbonTab Key="insert" Title="Insert">
            <TbRibbonGroup Label="Shapes">
                <TbRibbonButton Label="Add a shape" />
            </TbRibbonGroup>
        </TbRibbonTab>
        <TbRibbonTab Key="view" Title="View">
            <TbRibbonGroup Label="Zoom">
                <TbRibbonButton Label="Zoom in" />
            </TbRibbonGroup>
        </TbRibbonTab>
        @if (_table)
        {
            <TbRibbonTab Key="design" Title="Design" Context="Table tools">
                <TbRibbonGroup Label="Look">
                    <TbRibbonButton Label="Shade rows" />
                </TbRibbonGroup>
            </TbRibbonTab>
        }
    </TbRibbon>
</div>
<div @onkeydown="OnLedgerKeyDown">
    <TbRibbon AriaLabel="Ledger" @bind-ActiveIndex="_ledger">
        <TbRibbonTab Title="Sheet">
            <TbRibbonGroup Label="Files">
                <TbRibbonButton Label="Add a sheet" />
            </TbRibbonGroup>
        </TbRibbonTab>
        <TbRibbonTab Title="Rows">
            <TbRibbonGroup Label="Order">
                <TbRibbonButton Label="Sort rows" />
            </TbRibbonGroup>
        </TbRibbonTab>
        <TbRibbonTab Title="Columns">
            <TbRibbonGroup Label="Widths">
                <TbRibbonButton Label="Fit columns" />
            </TbRibbonGroup>
        </TbRibbonTab>
        @if (_totals)
        {
            <TbRibbonTab Title="Totals" Context="Sum tools">
                <TbRibbonGroup Label="Sums">
                    <TbRibbonButton Label="Add a total" />
                </TbRibbonGroup>
            </TbRibbonTab>
        }
    </TbRibbon>
</div>
<TbTabs AriaLabel="Drawers" @bind-ActiveKey="_drawer">
    <TbTab Key="pens" Text="Pens" HeaderAttributes="Keys">Pens panel</TbTab>
    <TbTab Key="paper" Text="Paper">Paper panel</TbTab>
</TbTabs>

@code {
    private static readonly Dictionary<string, object> Keys = new() { ["aria-keyshortcuts"] = "Control+P" };
    private string? _tab = "home";
    private bool _table = true;
    private string? _drawer = "pens";
    private int _ledger;
    private bool _totals = true;

    private void OnLedgerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "z")
        {
            _totals = false;
            _ledger = 1;
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "x" or "y")
        {
            _table = false;
        }

        if (args.Key == "y")
        {
            _tab = "insert";
        }
    }
}
