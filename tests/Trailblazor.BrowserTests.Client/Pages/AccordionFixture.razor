@page "/accordion"

<TbAccordion>
    @* An unbound input keeps its text only while its element does. *@
    <TbAccordionItem Title="Shipping options"><input aria-label="Notes" /></TbAccordionItem>
    <TbAccordionItem Title="Return policy">Returns content</TbAccordionItem>
    <TbAccordionItem Title="Warranty" Disabled>Warranty content</TbAccordionItem>
    <TbAccordionItem Title="Care" Expanded>
        <TbMenu Label="Care options">
            <TbMenuItem>Order a kit</TbMenuItem>
        </TbMenu>
        <TbAccordion>
            <TbAccordionItem Title="Washing">Washing content</TbAccordionItem>
            <TbAccordionItem Title="Drying">Drying content</TbAccordionItem>
        </TbAccordion>
    </TbAccordionItem>
</TbAccordion>
@* An item that code closes, from a button in its panel or one outside it. *@
<TbAccordion>
    <TbAccordionItem Title="Editing" @bind-Expanded="_editing">
        <TbButton OnClick="() => _editing = false">Save</TbButton>
    </TbAccordionItem>
</TbAccordion>
<TbButton OnClick="() => _editing = !_editing">Toggle editing</TbButton>
@* Items with actions in their headers, one with an item nested in its panel, and an item on its own. *@
<TbAccordion data-testid="trips">
    <TbAccordionItem Title="Day one">
        <HeaderActions>
            <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _deleted++">Delete day one</TbButton>
        </HeaderActions>
        <ChildContent>
            <TbAccordionItem Title="Gear list">Gear content</TbAccordionItem>
        </ChildContent>
    </TbAccordionItem>
    <TbAccordionItem Title="Day two">Day two content</TbAccordionItem>
</TbAccordion>
<output data-testid="deleted">@_deleted</output>
<TbAccordionItem Title="Packing tips">Packing content</TbAccordionItem>
@* Taller than the window, so a key that isn't caught would scroll the page. *@
<div style="block-size: 150vh"></div>

@code {
    private bool _editing = true;
    private int _deleted;
}
