@page "/static-password"
@attribute [ExcludeFromInteractiveRouting]

@* A sign-in form on a static page, where Trailblazor's script runs the show-password button. *@
<TbForm Model="_model" FormName="static-password">
    <TbTextField Label="Password" Type="TextFieldType.Password" Revealable @bind-Value="_model.Password" />
</TbForm>

@code {
    private readonly Login _model = new();

    private sealed class Login
    {
        public string? Password { get; set; }
    }
}
