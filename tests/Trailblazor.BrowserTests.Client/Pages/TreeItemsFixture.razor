@page "/tree-items"

<TbStack Gap="4" Style="max-inline-size: 28rem">
    <TbTreeView TItem="string" TKey="string" AriaLabel="Files" @bind-SelectedKeys="_selected" Checkable
                @bind-CheckedKeys="_checked">
        <TbTreeItem Value="@("docs")" Text="Docs">
            <TbTreeItem Value="@("guide")" Text="Guide" />
            <TbTreeItem Value="@("api")" Text="API" />
        </TbTreeItem>
        @if (_notes)
        {
            <TbTreeItem Value="@("notes")" Text="Notes" />
        }
        @* Content between rows renders where it is written. *@
        <div data-testid="between">Shared with you</div>
        <TbTreeItem Value="@("src")" Text="Source">
            <TextContent><strong>Source</strong> code</TextContent>
        </TbTreeItem>
    </TbTreeView>
    <output data-testid="selected">@string.Join(", ", _selected)</output>
    <output data-testid="checked">@string.Join(", ", _checked.Order())</output>
    <TbButton OnClick="() => _notes = !_notes">Notes</TbButton>
    <TbTreeView TItem="string" TKey="string" AriaLabel="Trails">
        @foreach (var trail in _trails)
        {
            <TbTreeItem @key="trail" Value="trail" />
        }
    </TbTreeView>
    <TbButton OnClick="() => _trails.Reverse()">Reverse</TbButton>
    @* A heading with no value, and a row that holds a tree of its own. *@
    <TbTreeView TItem="string" TKey="string" AriaLabel="Outline" InitialExpandDepth="2"
                @bind-SelectedKeys="_outline" OnMove="(TreeMove<string> _) => { }">
        <TbTreeItem Text="Part one">
            <TbTreeItem Value="@("chapter")" Text="Chapter">
                <TextContent>
                    Chapter
                    <TbTreeView TItem="string" TKey="string" AriaLabel="Sections" @bind-SelectedKeys="_sections">
                        <TbTreeItem Value="@("intro")" Text="Intro" />
                        <TbTreeItem Value="@("body")" Text="Body">
                            <TbTreeItem Value="@("detail")" Text="Detail" />
                        </TbTreeItem>
                    </TbTreeView>
                </TextContent>
                <ChildContent>
                    <TbTreeItem Value="@("page")" Text="Page" />
                </ChildContent>
            </TbTreeItem>
        </TbTreeItem>
        <TbTreeItem Value="@("appendix")" Text="Appendix" />
    </TbTreeView>
    <output data-testid="outline">@string.Join(", ", _outline)</output>
    @* Closed rows to open: two shelves with one name, a row that renders its rows once open, and a tree inside a row
       whose heading, like the shelves, has no value, so the two trees share its key. *@
    <TbTreeView TItem="string" TKey="string" AriaLabel="Library">
        <TbTreeItem Text="Shelf">
            <TbTreeItem Value="@("book")" Text="Book">
                <TextContent>
                    Book
                    <TbTreeView TItem="string" TKey="string" AriaLabel="Index">
                        <TbTreeItem Text="Entries">
                            <TbTreeItem Value="@("entry")" Text="Entry" />
                        </TbTreeItem>
                    </TbTreeView>
                </TextContent>
            </TbTreeItem>
        </TbTreeItem>
        <TbTreeItem Text="Shelf">
            <TbTreeItem Value="@("atlas")" Text="Atlas" HasChildren>
                <TbTreeItem Value="@("map")" Text="Map" HasChildren>
                    <TbTreeItem Value="@("legend")" Text="Legend" />
                </TbTreeItem>
            </TbTreeItem>
        </TbTreeItem>
    </TbTreeView>
    <output data-testid="sections">@string.Join(", ", _sections)</output>
    @* A long name in a narrow tree, drawn by the row's own content in the documented text part. *@
    <div style="inline-size: 10rem">
        <TbTreeView TItem="string" TKey="string" AriaLabel="Long names">
            <TbTreeItem Value="@("long")" Text="Pine Hollow loop">
                <TextContent><span data-part="text">Pine Hollow loop by the north ridge</span></TextContent>
            </TbTreeItem>
        </TbTreeView>
    </div>
    @* Long names in a narrow tree with a button at each row's end. The region's is wrapped in an element of the
       template's own, the loop's in one that lays a mark out beside it, the spur's is a TbText straight in the
       template, and the hut's row holds a label, whose text part isn't the row's. The filter matches the loop and the
       spur, and shows the region and the hut they sit in. *@
    <div style="inline-size: 13rem">
        <TbTreeView TItem="Named" TKey="string" AriaLabel="Wrapped names" Items="Wrapped"
                    KeySelector="named => named.Name" ChildrenSelector="named => named.Children"
                    ItemText="named => named.Name"
                    Filter="@(named => named.Name.Contains("loop") || named.Name.Contains("spur"))">
            <ItemTemplate>
                @if (context.Item.Name.Contains("spur"))
                {
                    <TbText data-part="text">@context.Item.Name</TbText>
                }
                else if (context.Item.Name.Contains("hut"))
                {
                    <TbLabel Text="@context.Item.Name" />
                }
                else if (context.Item.Name.Contains("loop"))
                {
                    <div style="display: flex; align-items: center; gap: 0.25rem">
                        <span data-testid="mark" aria-hidden="true">◆</span>
                        <span data-part="text">@context.Item.Name</span>
                    </div>
                }
                else
                {
                    <div id="@($"wrapped-{context.Item.Name.Length}")">
                        <span data-part="text">@context.Item.Name</span>
                    </div>
                }
            </ItemTemplate>
            <ItemEndTemplate>
                <TbButton Size="Size.Small" Variant="Variant.Text">Info</TbButton>
            </ItemEndTemplate>
        </TbTreeView>
    </div>
    @* Rows deeper than a narrow box is wide. *@
    <div data-testid="deep" style="inline-size: 9rem; overflow-x: auto">
        <TbTreeView TItem="string" TKey="string" AriaLabel="Deep" InitialExpandDepth="9">@Deep(1)</TbTreeView>
    </div>
</TbStack>

@code {
    private IReadOnlyCollection<string> _selected = [];
    private IReadOnlyCollection<string> _checked = [];
    private bool _notes;
    private readonly List<string> _trails = ["Pine Hollow", "Eagle Ridge", "Cedar Flats"];
    private IReadOnlyCollection<string> _outline = [];
    private IReadOnlyCollection<string> _sections = [];

    private static readonly Named[] Wrapped =
    [
        new("North ridge trails and their side paths",
        [
            new("Pine Hollow loop by the north ridge and back", null),
            new("Stone hut above the falls, open in summer", [new("Waterfall spur off the Pine Hollow trail", null)]),
        ]),
    ];

    private sealed record Named(string Name, Named[]? Children);

    private static RenderFragment Deep(int level) =>
        @<TbTreeItem Value="@($"deep-{level}")" Text="@($"Level {level} trail")">
            <ChildContent>
                @if (level < 9)
                {
                    @Deep(level + 1)
                }
            </ChildContent>
            <End><span>12</span></End>
        </TbTreeItem>;
}
