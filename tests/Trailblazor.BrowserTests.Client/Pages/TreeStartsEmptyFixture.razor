@page "/tree-starts-empty"

@* A tree that has no rows when its script attaches, and gets them afterward. *@
<TbButton OnClick="AddStops">Add stops</TbButton>
<TbTreeView TItem="string" TKey="string" AriaLabel="Stops" Items="_stops" KeySelector="stop => stop"
            ItemText="stop => stop" OnDrop="_ => { }"
            CanDrop="@(_ => Task.FromResult(MoveCheck.Refuse("These stops stay put.")))" />

@code {
    private string[] _stops = [];

    private void AddStops() => _stops = ["Trailhead", "Lake camp", "Summit"];
}
