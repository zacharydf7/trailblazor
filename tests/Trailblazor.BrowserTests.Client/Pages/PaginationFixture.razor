@page "/pagination"

@* No siblings, so no page shows between the current one and a far one. *@
<TbPagination @bind-Page="_page" PageCount="30" SiblingCount="0" AriaLabel="Lean" />
<output data-testid="page">@_page</output>
<form @onsubmit="() => _submits++">
    <TbPagination @bind-Page="_boxPage" PageCount="30" Compact AriaLabel="In a form" />
</form>
<output data-testid="box-page">@_boxPage</output>
<output data-testid="submits">@_submits</output>

@code {
    private int _page = 1;
    private int _boxPage = 1;
    private int _submits;
}
