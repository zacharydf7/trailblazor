@page "/file-upload"

<TbStack Gap="4" Style="max-inline-size: 28rem">
    <TbFileUpload Label="Documents" @bind-Value="_documents" Accept=".pdf" Multiple MaxFiles="3" />
    <output data-testid="documents">@Names(_documents)</output>
    <output data-testid="read">@_read</output>
    <TbButton OnClick="ReadAsync">Read</TbButton>
    <TbFileUpload Label="Settings" @bind-Value="_settings" Accept=".json" DropZone="false" />
    <output data-testid="settings">@(_settings?[0].Name ?? "none")</output>
    <TbFileUpload Label="Archive" Disabled />
    <TbFileUpload @ref="_import" Label="Import" Hidden @bind-Value="_imported" Accept=".json" />
    <TbButton OnClick="() => _import.OpenAsync()">Import settings</TbButton>
    <TbButton OnClick="() => _import.ClearAsync()">Forget the import</TbButton>
    <output data-testid="imported">@(_imported?[0].Name ?? "none")</output>
    <TbFileUpload Label="Reports" Multiple Upload="SendAsync" OnUploaded="file => _uploaded.Add(file.Name)" />
    <output data-testid="sent">@_sent bytes, @string.Join(", ", _uploaded)</output>
    <TbFileUpload Label="Held" Upload="(file, progress, stop) => Task.Delay(Timeout.Infinite, stop)" />
</TbStack>

@code {
    private IReadOnlyList<IBrowserFile>? _documents;
    private IReadOnlyList<IBrowserFile>? _settings;
    private IReadOnlyList<IBrowserFile>? _imported;
    private TbFileUpload _import = default!;
    private string _read = "";
    private long _sent;
    private readonly List<string> _uploaded = [];

    private static string Names(IReadOnlyList<IBrowserFile>? files) =>
        files is null ? "none" : string.Join(", ", files.Select(file => file.Name));

    // Reading proves the files are still readable after the field has listed them.
    private async Task ReadAsync()
    {
        var total = 0L;
        foreach (var file in _documents ?? [])
        {
            await using var stream = file.OpenReadStream();
            var buffer = new byte[file.Size];
            total += await stream.ReadAsync(buffer);
        }

        _read = $"{total} bytes";
    }

    // Reads the file's stream to its end in chunks, as an upload to storage would, reporting each one.
    private async Task SendAsync(IBrowserFile file, IProgress<long> progress, CancellationToken stop)
    {
        await using var stream = file.OpenReadStream();
        var buffer = new byte[8_192];
        var sent = 0L;
        int read;
        while ((read = await stream.ReadAsync(buffer, stop)) > 0)
        {
            sent += read;
            progress.Report(sent);
        }

        _sent += sent;
    }
}
