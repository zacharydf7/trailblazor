@page "/number-step"
@using System.Globalization

<TbNumberField TValue="int" Label="Copies" @bind-Value="_copies" Min="0" Max="10" />
<output aria-label="Copies chosen">@_copies</output>
<TbNumberField TValue="decimal" Label="Rate" @bind-Value="_rate" Decimals="2" Step="1" />
<output aria-label="Rate chosen">@_rate</output>
@* Events reach the server in order, so once the count shows, every earlier event has been handled. *@
<button type="button" @onclick="() => _elsewhere++">Elsewhere</button>
<output aria-label="Elsewhere clicks">@_elsewhere</output>

@* Counts each change, so a held step button can be seen to change the value once. *@
<TbNumberField TValue="int" Label="Seats" Value="_seats" ValueChanged="SeatsChanged" Max="500" LargeStep="25" />
<output aria-label="Seats chosen">@_seats</output>
<output aria-label="Seat changes">@_seatChanges</output>
<TbNumberField TValue="decimal" Label="Price" @bind-Value="_price" Format="N2" Culture="CultureInfo.InvariantCulture"
               LargeStep="10" />
<output aria-label="Price chosen">@_price</output>

@code {
    private int _seats = 5;
    private int _seatChanges;
    private decimal _price = 20;

    private void SeatsChanged(int seats) => (_seats, _seatChanges) = (seats, _seatChanges + 1);

    private int _copies = 5;
    private decimal _rate = 0.125m;
    private int _elsewhere;
}
