@page "/static-time-picker"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-time-picker" OnValidSubmit="Post">
    <TbTimePicker TTime="TimeOnly" Label="Start time" @bind-Value="Model!.Start" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Trip? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = Model!.Start?.ToString("HH:mm") ?? "";

    private sealed class Trip
    {
        public TimeOnly? Start { get; set; } = new TimeOnly(8, 30);
    }
}
