@page "/one-each"

@* One each of pagination, grid, tree, banner, carousel, toolbar and chip group, beside look-alikes that aren't
   Trailblazor's (a site nav, a plain table, a plain ARIA tree, region, toolbar and list), so a helper given no name has
   to find its own component and skip them. *@
<nav aria-label="Site"><a href="#top">Home</a></nav>
<ul role="tree" aria-label="Site map"><li role="treeitem" aria-selected="false">Home</li></ul>
<TbTreeView TItem="string" TKey="string" AriaLabel="Days" Items="Trails" KeySelector="day => day"
            ItemText="day => day" />
<TbPagination AriaLabel="Trail reports" PageCount="5" @bind-Page="_page" />
<table aria-label="Plain"><tbody><tr><td>Not a grid</td></tr></tbody></table>
<TbDataGrid TItem="string" Items="Trails" AriaLabel="Trails">
    <TbColumn TItem="string" Field="trail => trail" Title="Trail" Sortable />
</TbDataGrid>
<section aria-label="Plain region">Not a banner</section>
<TbBanner Title="Trail closed">The ridge trail is closed today.</TbBanner>
<TbCarousel AriaLabel="Views">
    <TbCarouselSlide>Ridge</TbCarouselSlide>
    <TbCarouselSlide>Lake</TbCarouselSlide>
</TbCarousel>
<div role="toolbar" aria-label="Plain tools"><button type="button">Plain</button></div>
<TbToolbar AriaLabel="Map tools">
    <TbToolbarButton AriaLabel="Pin" Icon="Square" OnClick="() => _pinned = true" />
</TbToolbar>
<output data-testid="pinned">@_pinned</output>
<ul role="list" aria-label="Plain list"><li>Not a chip</li></ul>
<TbChipGroup AriaLabel="Filters">
    <TbChip Text="Shaded" />
</TbChipGroup>

@code {
    private static readonly string[] Trails = ["Ridge loop", "Lake path"];
    private static readonly Icon Square = new("<path d=\"M5 5h14v14H5z\" />");
    private int _page = 2;
    private bool _pinned;
}
