<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Five minutes with no test finishing ends the run, with a dump and a log of the tests still running. -->
    <TestingPlatformCommandLineArguments>--hangdump --hangdump-timeout 5m --hangdump-type Mini</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- Its source generator builds the validation types that AddValidation registers. -->
    <PackageReference Include="Microsoft.Extensions.Validation" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazor\Trailblazor.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs\Trailblazor.Docs.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs.Recipes\Trailblazor.Docs.Recipes.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs.Examples\Trailblazor.Docs.Examples.csproj" />
    <ProjectReference Include="..\..\src\Trailblazor.Icons.Material\Trailblazor.Icons.Material.csproj" />
    <ProjectReference Include="..\..\src\Trailblazor.Testing\Trailblazor.Testing.csproj" />
    <ProjectReference Include="..\..\tools\Trailblazor.Docs.Markdown\Trailblazor.Docs.Markdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Trailblazor.Testing" />
  </ItemGroup>

</Project>
