<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Five minutes with no test finishing ends the run, with a dump and a log of the tests still running. -->
    <TestingPlatformCommandLineArguments>--hangdump --hangdump-timeout 5m --hangdump-type Mini</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trailblazor.BrowserTests.Host\Trailblazor.BrowserTests.Host.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs.Examples\Trailblazor.Docs.Examples.csproj" />
    <ProjectReference Include="..\..\src\Trailblazor.Testing.Playwright\Trailblazor.Testing.Playwright.csproj" />
    <!-- Built first, so its publish below finds it up to date. -->
    <ProjectReference Include="..\..\docs\Trailblazor.Docs\Trailblazor.Docs.csproj" ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- The docs-site tests serve the published site, as GitHub Pages does. -->
  <Target Name="PublishDocsSite" AfterTargets="Build">
    <MSBuild Projects="..\..\docs\Trailblazor.Docs\Trailblazor.Docs.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)docs-site\" />
    <!-- The Docs workflow writes each page's Markdown into the published site the same way. -->
    <MSBuild Projects="..\..\tools\Trailblazor.Docs.Markdown\Trailblazor.Docs.Markdown.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="DocsMarkdownTool" />
    </MSBuild>
    <!-- A forward slash, since Linux reads a backslash as part of the folder's name. -->
    <Exec Command="dotnet &quot;@(DocsMarkdownTool)&quot; &quot;$(TargetDir)docs-site/wwwroot&quot;" />
  </Target>

  <ItemGroup>
    <!-- Caps parallel test classes: the one shared test host slows under more load and timing tests flake. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
    <Using Include="Microsoft.Playwright.Assertions" Static="true" />
  </ItemGroup>

</Project>
