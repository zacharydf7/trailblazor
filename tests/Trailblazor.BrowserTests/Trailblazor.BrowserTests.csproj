<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trailblazor.BrowserTests.Host\Trailblazor.BrowserTests.Host.csproj" />
    <ProjectReference Include="..\..\docs\Trailblazor.Docs.Examples\Trailblazor.Docs.Examples.csproj" />
    <ProjectReference Include="..\..\src\Trailblazor.Testing.Playwright\Trailblazor.Testing.Playwright.csproj" />
    <!-- Built first, so its publish below finds it up to date. -->
    <ProjectReference Include="..\..\docs\Trailblazor.Docs\Trailblazor.Docs.csproj" ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- The docs-site tests serve the published site, as GitHub Pages does. -->
  <Target Name="PublishDocsSite" AfterTargets="Build">
    <MSBuild Projects="..\..\docs\Trailblazor.Docs\Trailblazor.Docs.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)docs-site\" />
  </Target>

  <ItemGroup>
    <!-- Caps parallel test classes: the one shared test host slows under more load and timing tests flake. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
    <Using Include="Microsoft.Playwright.Assertions" Static="true" />
  </ItemGroup>

</Project>
