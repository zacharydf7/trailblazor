<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Published with full trimming, so a browser test finds what trimming would break in an app's dialogs and fields,
       and the trim analysis fails the build on any warning. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazor\Trailblazor.csproj" />
  </ItemGroup>

</Project>
