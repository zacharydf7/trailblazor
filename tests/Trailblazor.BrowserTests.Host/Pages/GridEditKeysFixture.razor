@page "/grid-edit-keys"

@* A column edited through its own multi-line field, which commits its text only on change, before a column with the grid's own field. *@
<TbDataGrid TItem="Note" Items="_notes" AriaLabel="Notes" KeySelector="note => note.Id">
    <TbColumn Field="note => note.Text" Editable>
        <EditTemplate>
            <TbTextField TValue="string" AriaLabel="Text" Lines="3" AutoFocus Value="@(context.Value as string)"
                         ValueChanged="text => context.SetValue(text)" />
        </EditTemplate>
    </TbColumn>
    <TbColumn Field="note => note.Tag" Editable />
</TbDataGrid>

@code {
    private readonly List<Note> _notes = [new() { Id = 1, Text = "Old text", Tag = "Trail" }];

    private sealed class Note
    {
        public int Id { get; init; }

        public string Text { get; set; } = "";

        public string Tag { get; set; } = "";
    }
}
