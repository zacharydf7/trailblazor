@page "/toasts"
@using Trailblazor.BrowserTests.Host.Dialogs
@inject IToastService Toasts
@inject IDialogService Dialogs

<TbStack Row Gap="2" Wrap>
    <TbButton OnClick='() => Toasts.Show("Saved", Tone.Success)'>Save</TbButton>
    <TbButton OnClick='() => Toasts.Show("Upload failed", Tone.Danger)'>Fail</TbButton>
    <TbButton OnClick="Delete">Delete</TbButton>
    <TbButton OnClick='() => Toasts.Show("Quick note", options: new() { Duration = TimeSpan.FromSeconds(3) })'>
        Quick
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<ToastingDialog, bool>("Toasting")'>Dialog</TbButton>
    <TbButton OnClick="Restore">Restore</TbButton>
</TbStack>
<output data-testid="result">@_result</output>

@code {
    private string _result = "";

    private void Restore()
    {
        _ = Dialogs.ShowAsync<ToastingDialog, bool>("Toasting");
        Toasts.Show("Draft restored");
    }

    private void Delete() => Toasts.Show("Deleted",
        options: new() { Action = new("Undo", EventCallback.Factory.Create(this, () => _result = "undone")) });
}
