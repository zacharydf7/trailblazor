@page "/static-date-time-picker"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-date-time-picker" OnValidSubmit="Post">
    <TbDateTimePicker TDateTime="DateTime" Label="Starts" @bind-Value="Model!.Start" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Hike? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = $"{Model!.Start:yyyy-MM-dd HH:mm}";

    private sealed class Hike
    {
        public DateTime? Start { get; set; } = new DateTime(2026, 6, 3, 14, 30, 0);
    }
}
