@page "/overlays"

@* Two blocking page overlays, the second opened from the first and able to close it, so they close out of order. *@
<TbButton OnClick="() => _first = true">First</TbButton>
@* Opens both in one render, so the first one's block reaches the page after the second is there. *@
<TbButton OnClick="() => _first = _second = true">Both</TbButton>
<TbOverlay Visible="_first" Blocking>
    <TbButton OnClick="() => _second = true">Second</TbButton>
</TbOverlay>
<TbOverlay Visible="_second" Blocking>
    <TbButton OnClick="() => _first = false">Close the first</TbButton>
</TbOverlay>

@* A blocking page overlay and a card's contained one, opened in one render: the card's opens second but is drawn below. *@
<TbButton OnClick="() => _page = _card = true">Page and card</TbButton>
<TbOverlay Visible="_page" Blocking />
<div style="position: relative">
    <TbOverlay Visible="_card" Contained Blocking>
        <TbButton>Cancel loading</TbButton>
    </TbOverlay>
</div>

@* A closable overlay with a menu, a popover and a dialog that open above it. *@
<TbButton OnClick="() => _closable = true">Closable</TbButton>
<TbOverlay @bind-Visible="_closable" CloseOnClick>
    <TbMenu Label="Above menu">
        <TbMenuItem>Stay</TbMenuItem>
    </TbMenu>
    <TbPopover Label="Above popover">Details</TbPopover>
    <TbButton OnClick="() => _dialog = true">Above dialog</TbButton>
    <TbDialog @bind-Open="_dialog" Title="Dialog above" Options="Modeless">Words</TbDialog>
    <TbButton OnClick="() => _modal = true">Above modal</TbButton>
    <TbDialog @bind-Open="_modal" Title="Modal above">Words</TbDialog>
</TbOverlay>

@* A closable overlay inside a dialog that opened first. *@
<TbButton OnClick="() => _holder = true">Holder</TbButton>
<TbDialog @bind-Open="_holder" Title="Holder dialog">
    <TbButton OnClick="() => _inner = true">Cover the dialog</TbButton>
    <TbOverlay @bind-Visible="_inner" CloseOnClick>Inner cover</TbOverlay>
</TbDialog>

@* A page-layer modal, which gets no close request from the browser, holding a closable overlay. *@
<TbButton OnClick="() => _pageHolder = true">Page-layer modal</TbButton>
<TbDialog @bind-Open="_pageHolder" Title="Page-layer dialog" Options="PageLayer">
    <TbButton OnClick="() => _pageInner = true">Cover the dialog</TbButton>
    <TbOverlay @bind-Visible="_pageInner" CloseOnClick>Page inner cover</TbOverlay>
    <TbButton OnClick="() => _closable = true">Cover the page</TbButton>
</TbDialog>

@* Two modeless windows, each holding a closable overlay. *@
<TbButton OnClick="() => _left = _right = true">Windows</TbButton>
<TbDialog @bind-Open="_left" Title="Left window" Options="Modeless">
    <TbButton OnClick="() => _leftCover = true">Cover left</TbButton>
    <TbOverlay @bind-Visible="_leftCover" CloseOnClick>Left cover</TbOverlay>
</TbDialog>
<TbDialog @bind-Open="_right" Title="Right window" Options="Modeless">
    <TbButton OnClick="() => _rightCover = true">Cover right</TbButton>
    <TbOverlay @bind-Visible="_rightCover" CloseOnClick>Right cover</TbOverlay>
</TbDialog>

@code {
    private bool _holder;
    private bool _inner;
    private static readonly DialogOptions PageLayer = new() { TopLayer = false };
    private bool _pageHolder;
    private bool _pageInner;
    private bool _left;
    private bool _right;
    private bool _leftCover;
    private bool _rightCover;
    private static readonly DialogOptions Modeless = new() { Modal = false };
    private bool _closable;
    private bool _dialog;
    private bool _modal;
    private bool _first;
    private bool _second;
    private bool _page;
    private bool _card;
}
