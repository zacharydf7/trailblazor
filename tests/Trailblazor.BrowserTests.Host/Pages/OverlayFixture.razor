@page "/overlays"

@* Two blocking page overlays, the second opened from the first and able to close it, so they close out of order. *@
<TbButton OnClick="() => _first = true">First</TbButton>
<TbOverlay Visible="_first" Blocking>
    <TbButton OnClick="() => _second = true">Second</TbButton>
</TbOverlay>
<TbOverlay Visible="_second" Blocking>
    <TbButton OnClick="() => _first = false">Close the first</TbButton>
</TbOverlay>

@* A closable overlay with a menu, a popover and a dialog that open above it. *@
<TbButton OnClick="() => _closable = true">Closable</TbButton>
<TbOverlay @bind-Visible="_closable" CloseOnClick>
    <TbMenu Label="Above menu">
        <TbMenuItem>Stay</TbMenuItem>
    </TbMenu>
    <TbPopover Label="Above popover">Details</TbPopover>
    <TbButton OnClick="() => _dialog = true">Above dialog</TbButton>
    <TbDialog @bind-Open="_dialog" Title="Dialog above" Options="Modeless">Words</TbDialog>
    <TbButton OnClick="() => _modal = true">Above modal</TbButton>
    <TbDialog @bind-Open="_modal" Title="Modal above">Words</TbDialog>
</TbOverlay>

@* A closable overlay inside a dialog that opened first. *@
<TbButton OnClick="() => _holder = true">Holder</TbButton>
<TbDialog @bind-Open="_holder" Title="Holder dialog">
    <TbButton OnClick="() => _inner = true">Cover the dialog</TbButton>
    <TbOverlay @bind-Visible="_inner" CloseOnClick>Inner cover</TbOverlay>
</TbDialog>

@code {
    private bool _holder;
    private bool _inner;
    private static readonly DialogOptions Modeless = new() { Modal = false };
    private bool _closable;
    private bool _dialog;
    private bool _modal;
    private bool _first;
    private bool _second;
}
