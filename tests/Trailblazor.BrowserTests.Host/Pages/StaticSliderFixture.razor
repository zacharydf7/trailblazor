@page "/static-slider"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-slider" OnValidSubmit="Post">
    <TbSlider Label="Brightness" @bind-Value="Model!.Brightness" />
    <TbRangeSlider Label="Elevation" Max="4000" Step="100" @bind-Value="Model!.Elevation" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Trip? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = $"{Model!.Brightness} | {Model.Elevation.Start}-{Model.Elevation.End}";

    private sealed class Trip
    {
        public int Brightness { get; set; } = 50;

        public SliderRange<int> Elevation { get; set; } = new(800, 2400);
    }
}
