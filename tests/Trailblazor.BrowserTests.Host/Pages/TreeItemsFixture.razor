@page "/tree-items"

<TbStack Gap="4" Style="max-inline-size: 28rem">
    <TbTreeView TItem="string" TKey="string" AriaLabel="Files" @bind-SelectedKeys="_selected" Checkable
                @bind-CheckedKeys="_checked">
        <TbTreeItem Value="@("docs")" Text="Docs">
            <TbTreeItem Value="@("guide")" Text="Guide" />
            <TbTreeItem Value="@("api")" Text="API" />
        </TbTreeItem>
        @if (_notes)
        {
            <TbTreeItem Value="@("notes")" Text="Notes" />
        }
        @* Content between rows renders where it is written. *@
        <div data-testid="between">Shared with you</div>
        <TbTreeItem Value="@("src")" Text="Source">
            <TextContent><strong>Source</strong> code</TextContent>
        </TbTreeItem>
    </TbTreeView>
    <output data-testid="selected">@string.Join(", ", _selected)</output>
    <output data-testid="checked">@string.Join(", ", _checked.Order())</output>
    <TbButton OnClick="() => _notes = !_notes">Notes</TbButton>
    <TbTreeView TItem="string" TKey="string" AriaLabel="Trails">
        @foreach (var trail in _trails)
        {
            <TbTreeItem @key="trail" Value="trail" />
        }
    </TbTreeView>
    <TbButton OnClick="() => _trails.Reverse()">Reverse</TbButton>
    @* A heading with no value, and a row that holds a tree of its own. *@
    <TbTreeView TItem="string" TKey="string" AriaLabel="Outline" InitialExpandDepth="2"
                @bind-SelectedKeys="_outline" OnDrop="(TreeDrop<string> _) => { }">
        <TbTreeItem Text="Part one">
            <TbTreeItem Value="@("chapter")" Text="Chapter">
                <TextContent>
                    Chapter
                    <TbTreeView TItem="string" TKey="string" AriaLabel="Sections" @bind-SelectedKeys="_sections">
                        <TbTreeItem Value="@("intro")" Text="Intro" />
                        <TbTreeItem Value="@("body")" Text="Body">
                            <TbTreeItem Value="@("detail")" Text="Detail" />
                        </TbTreeItem>
                    </TbTreeView>
                </TextContent>
                <ChildContent>
                    <TbTreeItem Value="@("page")" Text="Page" />
                </ChildContent>
            </TbTreeItem>
        </TbTreeItem>
        <TbTreeItem Value="@("appendix")" Text="Appendix" />
    </TbTreeView>
    <output data-testid="outline">@string.Join(", ", _outline)</output>
    <output data-testid="sections">@string.Join(", ", _sections)</output>
</TbStack>

@code {
    private IReadOnlyCollection<string> _selected = [];
    private IReadOnlyCollection<string> _checked = [];
    private bool _notes;
    private readonly List<string> _trails = ["Pine Hollow", "Eagle Ridge", "Cedar Flats"];
    private IReadOnlyCollection<string> _outline = [];
    private IReadOnlyCollection<string> _sections = [];
}
