@page "/dialogs"
@using Trailblazor.BrowserTests.Host.Dialogs
@inject IDialogService Dialogs

<TbStack Row Gap="2" Wrap>
    <TbButton OnClick="RenameAsync">Rename</TbButton>
    <TbButton OnClick="ConfirmAsync">Delete</TbButton>
    <TbButton OnClick="LockedAsync">Locked</TbButton>
    <TbButton OnClick="NestedAsync">Nested</TbButton>
    <TbButton OnClick="PanelAsync">Panel</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.BottomEnd, modal: false)">Docked</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.Top)">Top</TbButton>
    <TbButton OnClick="() => PlacedAsync(DialogPosition.Start)">Start</TbButton>
    <TbButton OnClick="AboutAsync">About</TbButton>
    <TbButton OnClick="() => NotesAsync(DialogSize.Medium)">Notes</TbButton>
    <TbButton OnClick="() => NotesAsync(DialogSize.Full)">Full notes</TbButton>
    <TbButton OnClick="MovableAsync">Movable</TbButton>
    <TbButton OnClick="() => EditorAsync()">Editor</TbButton>
    <TbButton OnClick="() => EditorAsync(locked: true)">Locked editor</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<NameDialog, string>("Headless", options: new() { ShowHeader = false })'>
        Headless
    </TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<AddressDialog, string>("Address")'>Address</TbButton>
    <TbButton OnClick='() => Dialogs.ShowAsync<AddressDialog, string>("Address", p => p.Set(d => d.FloorLocked, true))'>
        Address locked
    </TbButton>
    <TbButton OnClick="() => HintedAsync(locked: false)">Hinted</TbButton>
    <TbButton OnClick="() => HintedAsync(locked: true)">Hinted locked</TbButton>
    <TbButton OnClick="SuggestAsync">Suggest</TbButton>
    <TbButton data-testid="page-button" OnClick="() => _pageClicks++">Page button</TbButton>
</TbStack>
<output data-testid="result">@_result</output>
<output data-testid="page-clicks">@_pageClicks</output>
@* Tall enough to scroll, so the scroll lock can be seen. *@
<div style="height: 200vh"></div>

@code {
    private string _result = "";
    private int _pageClicks;

    private async Task RenameAsync()
    {
        var result = await Dialogs.ShowAsync<NameDialog, string>("Rename", p => p.Set(d => d.Name, "Ada"));
        _result = result.Confirmed ? $"saved {result.Value}" : "cancelled";
    }

    private async Task ConfirmAsync() =>
        _result = await Dialogs.ConfirmAsync("Delete?", "This can't be undone.", "Delete") ? "deleted" : "kept";

    private async Task LockedAsync()
    {
        var options = new DialogOptions { DismissOnEscape = false, DismissOnBackdrop = false };
        var result = await Dialogs.ShowAsync<NameDialog, string>("Locked", options: options);
        _result = result.Confirmed ? "saved" : "cancelled";
    }

    private async Task NestedAsync()
    {
        var result = await Dialogs.ShowAsync<OuterDialog, bool>("Outer");
        _result = result.Confirmed ? "outer saved" : "outer cancelled";
    }

    private async Task HintedAsync(bool locked)
    {
        var options = new DialogOptions { DismissOnEscape = !locked };
        var result = await Dialogs.ShowAsync<HintedDialog, string>("Hinted", options: options);
        _result = result.Confirmed ? "hinted saved" : "hinted cancelled";
    }

    private async Task SuggestAsync()
    {
        var result = await Dialogs.ShowAsync<SuggestDialog, string>("Suggest");
        _result = result.Confirmed ? "suggest saved" : "suggest cancelled";
    }

    private async Task PlacedAsync(DialogPosition position, bool modal = true) =>
        await Dialogs.ShowAsync<NameDialog, string>($"Placed {position}",
            options: new() { Position = position, Modal = modal });

    private int _notes;

    private async Task NotesAsync(DialogSize size) =>
        await Dialogs.ShowAsync<NameDialog, string>($"Notes {++_notes}",
            options: new() { Modal = false, Minimizable = true, Maximizable = true, Size = size });

    private async Task MovableAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("Movable", options: new()
        {
            Modal = false, Draggable = true, Resizable = true, Minimizable = true, Maximizable = true,
        });

    private async Task EditorAsync(bool locked = false)
    {
        var result = await Dialogs.ShowAsync<EditorDialog, string>("Editor",
            options: new() { Minimizable = true, Maximizable = true, DismissOnEscape = !locked });
        _result = result.Confirmed ? "editor saved" : "editor cancelled";
    }

    private async Task AboutAsync() =>
        await Dialogs.ShowAsync<NameDialog, string>("About", options: new() { InitialFocus = DialogFocus.Dialog });

    private async Task PanelAsync()
    {
        var result = await Dialogs.ShowAsync<NameDialog, string>("Panel", options: new() { Modal = false });
        _result = result.Confirmed ? "panel saved" : "panel cancelled";
    }
}
