@page "/static-attempted-reset"
@attribute [ExcludeFromInteractiveRouting]

@* A post that starts over with a fresh model, whose value the field shows instead of the text that failed. *@
<EditForm Model="Model" FormName="static-attempted-reset" OnSubmit="StartOver">
    <TbTextField TValue="int" Label="Age" @bind-Value="Model!.Age" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="state">@_state</output>

@code {
    private string? _state;

    private void StartOver()
    {
        Model = new() { Age = 18 };
        _state = "started over";
    }

    [SupplyParameterFromForm]
    private Person? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private sealed class Person
    {
        public int Age { get; set; } = 30;
    }
}
