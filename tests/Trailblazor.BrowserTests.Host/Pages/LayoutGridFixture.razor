@page "/layout-grid"

<TbGrid data-testid="grid">
    <TbGridItem SpanMd="6" data-testid="half-first">
        <TbSurface Outlined Style="padding: var(--tb-space-3)"><TbText>Full width, half from medium up</TbText></TbSurface>
    </TbGridItem>
    <TbGridItem SpanMd="6" data-testid="half-second">
        <TbSurface Outlined Style="padding: var(--tb-space-3)">
            <TbGrid Gap="2" data-testid="nested-grid">
                <TbGridItem data-testid="nested-item">
                    <TbText>A nested item spans its own grid, not its parent's span</TbText>
                </TbGridItem>
            </TbGrid>
        </TbSurface>
    </TbGridItem>
    <TbGridItem Span="4" Offset="8" data-testid="end">
        <TbSurface Outlined Style="padding: var(--tb-space-3)"><TbText>Starts in column 9</TbText></TbSurface>
    </TbGridItem>
    <TbGridItem Span="8" OffsetMd="2" data-testid="centered">
        <TbSurface Outlined Style="padding: var(--tb-space-3)"><TbText>Centered from medium up</TbText></TbSurface>
    </TbGridItem>
</TbGrid>

@* A label sized to its text, a field that grows into the rest of the row, and a button sized to its text. *@
<TbGrid data-testid="toolbar">
    <TbGridItem Span="GridSpan.Auto" data-testid="auto">
        <TbText>Trail</TbText>
    </TbGridItem>
    <TbGridItem Span="GridSpan.Grow" data-testid="grow">
        <TbSurface Outlined Style="padding: var(--tb-space-2)">
            <TbText>Grows into the rest of the row</TbText>
        </TbSurface>
    </TbGridItem>
    <TbGridItem Span="GridSpan.Auto">
        <TbButton Variant="Variant.Outlined">Find</TbButton>
    </TbGridItem>
</TbGrid>

@* A grid rendered as a list, so screen readers say how many trails there are. *@
<TbGrid As="LayoutElement.Ul" aria-label="Trails nearby">
    @foreach (var trail in Trails)
    {
        <TbGridItem As="LayoutElement.Li" SpanSm="6" SpanLg="4">
            <TbSurface As="LayoutElement.Article" Outlined Style="padding: var(--tb-space-3)">
                <TbText>@trail</TbText>
            </TbSurface>
        </TbGridItem>
    }
</TbGrid>

@code {
    private static readonly string[] Trails = ["Ridge loop", "Creek path", "Old mill"];
}
