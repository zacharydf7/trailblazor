@page "/static-attempted-plain"
@attribute [ExcludeFromInteractiveRouting]

@* A plain form reports no mapping errors, so the field shows the value that was saved, the int's default. *@
<form method="post" @formname="static-attempted-plain" @onsubmit="Post">
    <AntiforgeryToken />
    <TbTextField TValue="int" Label="Age" @bind-Value="Model!.Age" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</form>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Person? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = Model!.Age.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private sealed class Person
    {
        public int Age { get; set; }
    }
}
