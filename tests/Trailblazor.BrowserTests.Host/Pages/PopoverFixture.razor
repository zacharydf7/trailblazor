@page "/popover"

@* A hover hint inside another popover's panel, as a field's info tip is inside a form. *@
<TbPopover Label="Filters">
    <TbText>Status</TbText>
    <TbPopover Label="What does status mean?" Variant="Variant.Text" OpenOnHover>
        <TbText>Open items haven't been shipped yet.</TbText>
    </TbPopover>
</TbPopover>

@* A popover the page opens from code, with the open state the page holds. *@
<TbButton OnClick="() => _notes = true">Open the notes</TbButton>
<TbPopover Label="Notes" @bind-Open="_notes">
    <TbText>Bring water.</TbText>
</TbPopover>
<output data-testid="notes-open">@(_notes ? "open" : "closed")</output>

@code {
    private bool _notes;
}
