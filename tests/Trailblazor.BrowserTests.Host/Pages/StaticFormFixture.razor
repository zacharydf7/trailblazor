@page "/static-form"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-form" OnValidSubmit="() => _posted = Model!.Name">
    <TbTextField Label="Name" @bind-Value="Model!.Name" Validation="RequireName" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Person? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private static IEnumerable<string> RequireName(string? name) =>
        string.IsNullOrWhiteSpace(name) ? ["Enter a name."] : [];

    private sealed class Person
    {
        public string? Name { get; set; }
    }
}
