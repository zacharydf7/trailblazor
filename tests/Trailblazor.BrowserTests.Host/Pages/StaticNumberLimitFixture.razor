@page "/static-number-limit"
@attribute [ExcludeFromInteractiveRouting]

@* A TbForm leaves validation to the server, so a number past its limit reaches the post. *@
<TbForm Model="Model" FormName="static-number-limit" OnValidSubmit="Post">
    <TbNumberField Label="Copies" @bind-Value="Model!.Copies" Max="10" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</TbForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm(FormName = "static-number-limit")]
    private Order? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = $"{Model!.Copies}";

    private sealed class Order
    {
        public int Copies { get; set; } = 2;
    }
}
