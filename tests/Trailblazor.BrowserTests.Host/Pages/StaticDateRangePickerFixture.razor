@page "/static-date-range"
@attribute [ExcludeFromInteractiveRouting]

<EditForm Model="Model" FormName="static-date-range" OnValidSubmit="Post">
    <TbDateRangePicker TDate="DateOnly" Label="Trip dates" @bind-Value="Model!.Dates" />
    <TbButton Type="ButtonType.Submit">Send</TbButton>
</EditForm>
<output data-testid="posted">@_posted</output>

@code {
    private string? _posted;

    [SupplyParameterFromForm]
    private Trip? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Post() => _posted = $"{Model!.Dates.Start:yyyy-MM-dd} to {Model.Dates.End:yyyy-MM-dd}";

    private sealed class Trip
    {
        public DateRange<DateOnly> Dates { get; set; } = new(new DateOnly(2026, 6, 3), new DateOnly(2026, 6, 10));
    }
}
