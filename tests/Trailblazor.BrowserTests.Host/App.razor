<!DOCTYPE html>
<html lang="en" dir="@Direction">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Trailblazor browser tests</title>
    <TbStyles />
    <TbThemeHead />
    <link rel="stylesheet" href="@Assets["host.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" ServerPages="ServerPages" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // A test opens a page right to left with ?dir=rtl, so scripts read the direction from the start.
    private string? Direction => HttpContext.Request.Query["dir"] == "rtl" ? "rtl" : null;

    // Pages marked [ExcludeFromInteractiveRouting] render as static SSR, to test plain form posts. Others run on the
    // server, or in WebAssembly with ?mode=webassembly, or as Blazor chooses with ?mode=auto.
    private IComponentRenderMode? PageRenderMode => !HttpContext.AcceptsInteractiveRouting() ? null
        : HttpContext.Request.Query["mode"].ToString() switch
        {
            "webassembly" => InteractiveWebAssembly,
            "auto" => InteractiveAuto,
            _ => InteractiveServer,
        };

    // The server's own pages render only statically, since WebAssembly can't load them.
    private System.Reflection.Assembly[]? ServerPages => PageRenderMode is null ? [typeof(App).Assembly] : null;
}
