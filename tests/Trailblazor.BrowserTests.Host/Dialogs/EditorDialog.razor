@inherits TbDialogContent<string>

<TbTextField Label="Name" @bind-Value="_name" />
<TbDialogActions>
    <TbButton OnClick="() => Dialog.Modal = !Dialog.Modal">@(Dialog.Modal ? "Pop out" : "Pop in")</TbButton>
    <TbButton OnClick="() => Dialog.Size = DialogSize.Small">Shrink</TbButton>
    <TbButton OnClick="() => CloseDialogAsync(_name ?? string.Empty)">Save</TbButton>
</TbDialogActions>

@code {
    private string? _name;
}
