@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@Layout(Classes, @<text>
    @if (Lines > 1)
    {
        <textarea @attributes="ControlAttributes" @ref="_input" data-part="input" id="@InputId" name="@InputNameAttribute"
                  rows="@Lines" @bind:get="Text" @bind:set="SetTextAsync" @bind:event="@BindEvent"
                  @onchange="CommitOnChange" data-input-delay="@InputDelay" data-max-lines="@(Grows ? MaxLines : null)"
                  style="@(Grows ? $"--tb-text-field-lines: {Lines}; --tb-text-field-max-lines: {MaxLines}" : null)"
                  placeholder="@Placeholder" disabled="@Disabled" readonly="@ReadOnly"
                  aria-required="@AriaRequired" aria-invalid="@(ShowsInvalid ? "true" : null)"
                  aria-describedby="@InputDescribedBy" class="@ClassNames.Join("tb-field__input", Classes?.Input)"></textarea>
    }
    else
    {
        <input @attributes="ControlAttributes" @ref="_input" data-part="input" id="@InputId" name="@InputNameAttribute"
               type="@Type.ToString().ToLowerInvariant()" @bind:get="Text" @bind:set="SetTextAsync"
               @bind:event="@BindEvent" @onchange="CommitOnChange" data-input-delay="@InputDelay"
               placeholder="@(Placeholder ?? _mask?.Hint)"
               inputmode="@InputMode" disabled="@Disabled"
               readonly="@ReadOnly" aria-required="@AriaRequired"
               aria-invalid="@(ShowsInvalid ? "true" : null)" aria-describedby="@InputDescribedBy"
               class="@ClassNames.Join("tb-field__input", Classes?.Input)" />
    }
</text>, Start, EndWithClear)

@code {
    private ElementReference _input;
    private TextMask? _mask;
    private IJSObjectReference? _maskHandle;
    private string? _maskAttached;
    private bool _disposed;

    /// <summary>Content before the input, usually an icon.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the input, such as a unit or a button.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public FieldClasses? Classes { get; set; }

    /// <summary>The kind of text the field takes. Defaults to <see cref="TextFieldType.Text"/>.</summary>
    [Parameter]
    public TextFieldType Type { get; set; } = TextFieldType.Text;

    /// <summary>Updates the value on every keystroke instead of when the field loses focus.</summary>
    [Parameter]
    public bool UpdateOnInput { get; set; }

    /// <summary>The number of text lines. More than one renders a multi-line text area.</summary>
    [Parameter]
    public int Lines { get; set; } = 1;

    /// <summary>Example text shown while the field is empty. It is not a label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Shows a button that empties the field while it holds text and can be changed. Focus goes back to the
    /// input. A value type has to be nullable, such as <c>int?</c>.</summary>
    [Parameter]
    public bool Clearable { get; set; }

    /// <summary>The words the field shows and says to screen readers: the clear button's name and the message for an
    /// incomplete mask. Each one left null uses the app's text.</summary>
    [Parameter]
    public TextFieldLabels Labels { get; set; } = new();

    /// <summary>Lets a text area grow with its text, from <see cref="Lines"/> up to this many lines, and then scroll.
    /// A browser without CSS <c>field-sizing</c> shows a resizable text area of <see cref="Lines"/> instead.</summary>
    [Parameter]
    public int? MaxLines { get; set; }

    /// <summary>With <see cref="UpdateOnInput"/>, waits until typing has paused this long before updating the value.
    /// Enter in a single-line field, or leaving the field, updates it at once. The browser does the waiting, so the
    /// server hears nothing until then.</summary>
    [Parameter]
    public TimeSpan? UpdateDelay { get; set; }

    /// <summary>Fits what is typed to a pattern, such as <c>"(000) 000-0000"</c>: <c>0</c> takes a digit, <c>a</c> a
    /// letter and <c>*</c> either, <c>\</c> makes the next character literal, and every other character is shown as
    /// it is. Text that leaves a slot empty isn't valid. The placeholder shows the pattern unless one is given. A
    /// static form post binds the text as it was sent, so validate it on the model too.</summary>
    [Parameter]
    public string? Mask { get; set; }

    /// <summary>Keeps the <see cref="Mask"/>'s own characters, such as a phone number's brackets and dashes, in the
    /// value. Otherwise the value holds only what was typed into the slots.</summary>
    [Parameter]
    public bool IncludeMaskLiterals { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _input.FocusAsync(preventScroll);

    /// <summary>Moves focus to the field and selects its text, so typing replaces it.</summary>
    public async ValueTask SelectTextAsync()
    {
        var module = await Modules.ImportAsync("./_content/Trailblazor/field.js");
        await module.InvokeVoidAsync("selectText", _input);
    }

    // @bind keeps keystrokes typed during a round trip; only the committing event is bound.
    private string BindEvent => UpdateOnInput ? "oninput" : "onchange";

    private bool Grows => Lines > 1 && MaxLines > Lines;

    // A mask of digits brings up a number keyboard, unless the page asked for another.
    private object? InputMode =>
        InputAttributes?.GetValueOrDefault("inputmode") ?? (_mask?.DigitsOnly == true ? "numeric" : null);

    // debounced-input.js holds keystrokes back in the browser until typing pauses this long, so the server hears one
    // input per pause.
    private string? InputDelay => UpdateOnInput && UpdateDelay is { } delay
        ? delay.TotalMilliseconds.ToString(CultureInfo.InvariantCulture) : null;

    // Enter and leaving the field update it at once. In the browser, debounced-input.js has already sent the waiting
    // text by then, so this matters where that script isn't running, as in bUnit tests that commit with a change.
    private EventCallback<ChangeEventArgs> CommitOnChange => InputDelay is null ? default
        : EventCallback.Factory.Create<ChangeEventArgs>(this, change => SetTextAsync(change.Value as string));

    private RenderFragment? EndWithClear => !Clearable || Disabled || ReadOnly || string.IsNullOrEmpty(Text) ? End :
        @<text>
            <TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.TextFieldClear])"
                          aria-describedby="@ClearDescribedBy"
                          Size="Size.Small" OnClick="ClearAsync" data-part="clear" />
            @End
        </text>;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // A value type's default is a real value, such as 0, so clearing needs a nullable type.
        if (Clearable && typeof(TValue).IsValueType && Nullable.GetUnderlyingType(typeof(TValue)) is null)
        {
            throw new InvalidOperationException(
                $"A clearable text field needs a nullable value type, such as {typeof(TValue).Name}?.");
        }

        if (Mask is not null && Lines > 1)
        {
            throw new InvalidOperationException("A mask fits one line of text, so a text area can't have one.");
        }

        _mask = Mask is null ? null : _mask?.Pattern == Mask ? _mask : new TextMask(Mask);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (Mask == _maskAttached)
        {
            return;
        }

        var mask = _maskAttached = Mask;
        try
        {
            if (_maskHandle is { } old)
            {
                _maskHandle = null;
                await old.DisposeHandleAsync();
            }

            if (mask is null)
            {
                return;
            }

            var module = await Modules.ImportAsync("./_content/Trailblazor/text-mask.js");
            var handle = await module.InvokeAsync<IJSObjectReference>("createMask", _input, mask);
            // The field went, or its mask changed, while this one was being attached.
            if (_disposed || mask != _maskAttached)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _maskHandle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the field went with it.
        }
    }

    private protected override string FieldModifiers => ClassNames.Join(base.FieldModifiers, "tb-text-field");

    private protected override string? FormatValue(TValue? value)
    {
        var text = base.FormatValue(value);
        return _mask is null || string.IsNullOrEmpty(text) ? text : _mask.Fit(text, IncludeMaskLiterals).Text;
    }

    // Text that leaves a slot empty isn't valid; the rest converts what the slots hold, with the literals if asked.
    private protected override bool TryParse(string? text, out TValue? value, out string? error)
    {
        if (_mask is null || string.IsNullOrEmpty(text))
        {
            return base.TryParse(text, out value, out error);
        }

        var (shown, slotted) = _mask.Fit(text, hasLiterals: true);
        if (slotted.Length > 0 && slotted.Length < _mask.Slots)
        {
            value = default;
            error = FormatMessage(Labels.MaskIncomplete ?? Localizer[TbStrings.TextFieldMaskIncomplete]);
            return false;
        }

        return base.TryParse(IncludeMaskLiterals ? shown : slotted, out value, out error);
    }

    private async Task ClearAsync()
    {
        await SetValueAsync(default);
        await _input.FocusAsync();
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync when both exist, so the field's own cleanup has to run from here.
        Dispose();
        _disposed = true;
        return _maskHandle?.DisposeHandleAsync() ?? ValueTask.CompletedTask;
    }
}
