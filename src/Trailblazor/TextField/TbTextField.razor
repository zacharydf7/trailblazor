@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@Layout(Classes, Control, Start, EndWithClear)

@code {
    private ElementReference _input;
    private TextMask? _mask;
    private IJSObjectReference? _maskHandle;
    private string? _maskAttached;
    private bool _disposed;
    private bool _revealed;

    /// <summary>Content before the input, usually an icon.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the input, such as a unit or a button.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public FieldClasses? Classes { get; set; }

    /// <summary>The kind of text the field takes. Defaults to <see cref="TextFieldType.Text"/>.</summary>
    [Parameter]
    public TextFieldType Type { get; set; } = TextFieldType.Text;

    /// <summary>Updates the value on every keystroke instead of when the field loses focus.</summary>
    [Parameter]
    public bool UpdateOnInput { get; set; }

    /// <summary>Raised when the user presses Enter in a single-line field, after the value updates. In a
    /// <c>TbForm</c>, Enter also submits the form. A multi-line field takes Enter as a new line and doesn't raise
    /// this.</summary>
    [Parameter]
    public EventCallback OnEnter { get; set; }

    /// <summary>The number of text lines. More than one renders a multi-line text area.</summary>
    [Parameter]
    public int Lines { get; set; } = 1;

    /// <summary>Example text shown while the field is empty. It is not a label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Shows a button that empties the field while it holds text and can be changed. Focus goes back to the
    /// input. A value type has to be nullable, such as <c>int?</c>.</summary>
    [Parameter]
    public bool Clearable { get; set; }

    /// <summary>Adds a button that shows and hides the password; the button is pressed while the password shows. It
    /// needs <see cref="Type"/> set to <see cref="TextFieldType.Password"/>. A read-only or disabled field keeps it
    /// hidden, and a static page leaves the button out.</summary>
    [Parameter]
    public bool Revealable { get; set; }

    /// <summary>The words the field shows and says to screen readers: the clear and show-password buttons' names, the
    /// counter's words and the messages for an incomplete mask and a value past the limit. Each one left null uses the
    /// app's text.</summary>
    [Parameter]
    public TextFieldLabels Labels { get; set; } = new();

    /// <summary>The most characters the field takes, counted as the browser counts them (UTF-16 code units), so typing
    /// and pasting stop there. A longer value set from code shows an error.</summary>
    [Parameter]
    public int? MaxLength { get; set; }

    /// <summary>Shows a count of the field's characters under the field, as "12 / 200" with a <see cref="MaxLength"/>
    /// or "12" without one. It follows typing in the browser, and screen readers hear it as the field's description.
    /// With a limit, the field announces the characters left as they reach 20 and 0.</summary>
    [Parameter]
    public bool ShowCount { get; set; }

    /// <summary>Lets a text area grow with its text, from <see cref="Lines"/> up to this many lines, and then scroll.
    /// A browser without CSS <c>field-sizing</c> shows a resizable text area of <see cref="Lines"/> instead.</summary>
    [Parameter]
    public int? MaxLines { get; set; }

    /// <summary>With <see cref="UpdateOnInput"/>, waits until typing has paused this long before updating the value.
    /// Enter in a single-line field, or leaving the field, updates it at once. The browser does the waiting, so the
    /// server hears nothing until then.</summary>
    [Parameter]
    public TimeSpan? UpdateDelay { get; set; }

    /// <summary>Fits what is typed to a pattern, such as <c>"(000) 000-0000"</c>: <c>0</c> takes a digit, <c>a</c> a
    /// letter and <c>*</c> either, <c>\</c> makes the next character literal, and every other character is shown as
    /// it is. Text that leaves a slot empty isn't valid. The placeholder shows the pattern unless one is given. A
    /// static form post binds the text as it was sent, so validate it on the model too.</summary>
    [Parameter]
    public string? Mask { get; set; }

    /// <summary>Keeps the <see cref="Mask"/>'s own characters, such as a phone number's brackets and dashes, in the
    /// value. Otherwise the value holds only what was typed into the slots.</summary>
    [Parameter]
    public bool IncludeMaskLiterals { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _input.FocusAsync(preventScroll);

    /// <summary>Moves focus to the field and selects its text, so typing replaces it.</summary>
    public async ValueTask SelectTextAsync()
    {
        var module = await Modules.ImportAsync("./_content/Trailblazor/field.js");
        await module.InvokeVoidAsync("selectText", _input);
    }

    private string BindEvent => UpdateOnInput ? "oninput" : "onchange";

    private bool Grows => Lines > 1 && MaxLines > Lines;

    private bool StaticPage => AssignedRenderMode is null && !RendererInfo.IsInteractive;

    // A mask of digits brings up a number keyboard, unless the page asked for another.
    private object? InputMode =>
        ControlAttributes?.GetValueOrDefault("inputmode") ?? (_mask?.DigitsOnly == true ? "numeric" : null);

    // debounced-input.js holds keystrokes back in the browser until typing pauses this long, so the server hears one
    // input per pause.
    private string? InputDelay => UpdateOnInput && UpdateDelay is { } delay
        ? delay.TotalMilliseconds.ToString(CultureInfo.InvariantCulture) : null;

    // Method groups keep their handler ids between renders, unlike @bind's closures; value syncs as with @bind.
    private RenderFragment Control => builder =>
    {
        var area = Lines > 1;
        builder.OpenElement(0, area ? "textarea" : "input");
        builder.AddMultipleAttributes(1, ControlAttributes);
        builder.AddAttribute(2, "data-part", "input");
        builder.AddAttribute(3, "id", InputId);
        builder.AddAttribute(4, "name", InputNameAttribute);
        if (area)
        {
            builder.AddAttribute(5, "rows", Lines);
            builder.AddAttribute(6, "data-max-lines", Grows ? MaxLines : null);
            builder.AddAttribute(7, "style",
                Grows ? $"--tb-text-field-lines: {Lines}; --tb-text-field-max-lines: {MaxLines}" : null);
        }
        else
        {
            builder.AddAttribute(8, "type", _revealed ? "text" : Type.ToString().ToLowerInvariant());
            builder.AddAttribute(9, "inputmode", InputMode);
        }

        builder.AddAttribute(10, "value", Text);
        builder.AddAttribute(11, BindEvent, EventCallback.Factory.Create<ChangeEventArgs>(this, OnTextAsync));
        builder.SetUpdatesAttributeName("value");
        // Enter and leaving the field commit at once. In a browser, debounced-input.js has sent the text by then, so
        // this is for where that script isn't running, as in bUnit tests that commit with a change.
        if (InputDelay is not null)
        {
            builder.AddAttribute(12, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, OnTextAsync));
        }

        builder.AddAttribute(13, "data-input-delay", InputDelay);
        builder.AddAttribute(14, "placeholder", area ? Placeholder : Placeholder ?? _mask?.Hint);
        builder.AddAttribute(15, "disabled", Disabled);
        builder.AddAttribute(16, "readonly", ReadOnly);
        builder.AddAttribute(17, "aria-required", AriaRequired);
        builder.AddAttribute(18, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(19, "aria-describedby",
            ShowCount ? ClassNames.Join(InputDescribedBy, CountId) : InputDescribedBy);
        builder.AddAttribute(20, "class", ClassNames.Join("tb-field__input", Classes?.Input));
        // Tests wait for data-ready before typing, since a prerendered field is replaced and loses the text.
        builder.AddAttribute(21, "data-static", StaticPage ? "" : null);
        builder.AddAttribute(22, "data-ready", RendererInfo.IsInteractive ? "" : null);
        if (!area && OnEnter.HasDelegate)
        {
            builder.AddAttribute(23, "ontbenter", OnEnter);
        }

        // A shown password is still a password, so the browser mustn't check, correct or capitalize it.
        if (_revealed)
        {
            builder.AddAttribute(24, "spellcheck", "false");
            builder.AddAttribute(25, "autocorrect", "off");
            builder.AddAttribute(26, "autocapitalize", "off");
        }

        builder.AddAttribute(27, "maxlength", MaxLength ?? ControlAttributes?.FirstOrDefault(attribute =>
            string.Equals(attribute.Key, "maxlength", StringComparison.OrdinalIgnoreCase)).Value);
        builder.AddAttribute(28, "data-count", ShowCount ? CountId : null);
        if (ShowCount && MaxLength is not null)
        {
            builder.AddAttribute(29, "ontbcharactersleft",
                EventCallback.Factory.Create<CharactersLeftEventArgs>(this, OnCharactersLeft));
        }

        builder.AddElementReferenceCapture(30, element => _input = element);
        builder.CloseElement();
    };

    private Task OnTextAsync(ChangeEventArgs change) => SetTextAsync(change.Value as string);

    private string CountId => $"{FieldId}-count";

    private protected override RenderFragment? AfterMessages =>
        ShowCount ? FieldCount.Render(CountId, Text?.Length ?? 0, MaxLength, (Commits, Text), SaidTemplate) : null;

    private string SaidTemplate(int count) =>
        FieldCount.Said(Localizer, MaxLength, count, Labels.Count, Labels.CountOfLimit);

    private void OnCharactersLeft(CharactersLeftEventArgs args) =>
        Announcer.Polite(FieldCount.CharactersLeft(Localizer, args.Left, Labels.CharactersLeft));

    private bool ShowsClear => Clearable && !Disabled && !ReadOnly && !string.IsNullOrEmpty(Text);

    // A static page can't switch the type, so it keeps the browser's own show-password button, if any.
    private bool ShowsReveal => Revealable && !StaticPage;

    private RenderFragment? EndWithClear => !ShowsClear && !ShowsReveal ? End :
        @<text>
            @if (ShowsClear)
            {
                <TbIconButton Icon="BuiltInIcons.Close"
                              AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.TextFieldClear])"
                              aria-describedby="@ClearDescribedBy" Size="Size.Small" OnClick="ClearAsync"
                              data-part="clear" />
            }
            @if (ShowsReveal)
            {
                <TbIconButton Icon="@(_revealed ? BuiltInIcons.EyeOff : BuiltInIcons.Eye)"
                              AriaLabel="@(Labels.ShowPassword ?? Localizer[TbStrings.TextFieldShowPassword])"
                              aria-describedby="@ClearDescribedBy" Size="Size.Small" Pressed="_revealed"
                              PressedChanged="Reveal" Disabled="@(Disabled || ReadOnly)" data-part="reveal" />
            }
            @End
        </text>;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // A value type's default is a real value, such as 0, so clearing needs a nullable type.
        if (Clearable && typeof(TValue).IsValueType && Nullable.GetUnderlyingType(typeof(TValue)) is null)
        {
            throw new InvalidOperationException(
                $"A clearable text field needs a nullable value type, such as {typeof(TValue).Name}?.");
        }

        if (Mask is not null && Lines > 1)
        {
            throw new InvalidOperationException("A mask fits one line of text, so a text area can't have one.");
        }

        if (MaxLength < 1)
        {
            throw new InvalidOperationException("A text field's MaxLength has to be at least 1.");
        }

        if (Revealable && (Type != TextFieldType.Password || Lines > 1))
        {
            throw new InvalidOperationException(
                "Only a one-line password field can show and hide its text, so Revealable needs Type set to Password.");
        }

        if (!Revealable || Disabled || ReadOnly)
        {
            _revealed = false;
        }

        _mask = Mask is null ? null : _mask?.Pattern == Mask ? _mask : new TextMask(Mask);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (Mask == _maskAttached)
        {
            return;
        }

        var mask = _maskAttached = Mask;
        try
        {
            if (_maskHandle is { } old)
            {
                _maskHandle = null;
                await old.DisposeHandleAsync();
            }

            if (mask is null)
            {
                return;
            }

            var module = await Modules.ImportAsync("./_content/Trailblazor/text-mask.js");
            var handle = await module.InvokeAsync<IJSObjectReference>("createMask", _input, mask);
            // The field went, or its mask changed, while this one was being attached.
            if (_disposed || mask != _maskAttached)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _maskHandle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the field went with it.
        }
    }

    private protected override string FieldModifiers => ClassNames.Join(base.FieldModifiers, "tb-text-field");

    private protected override string? FormatValue(TValue? value)
    {
        var text = base.FormatValue(value);
        return _mask is null || string.IsNullOrEmpty(text) ? text : _mask.Fit(text, IncludeMaskLiterals).Text;
    }

    // A value set from code can be longer than the browser lets anyone type.
    private protected override string? ValueError(TValue? value) =>
        MaxLength is { } max && FormatValue(value)?.Length > max
            ? Labels.TooLong is { } template ? FormatMessage(template, max)
                : CountedMessage(TbStrings.TextFieldTooLong, max)
            : null;

    // Text that leaves a slot empty isn't valid; the rest converts what the slots hold, with the literals if asked.
    private protected override bool TryParse(string? text, out TValue? value, out string? error)
    {
        if (_mask is null || string.IsNullOrEmpty(text))
        {
            return base.TryParse(text, out value, out error);
        }

        var (shown, slotted) = _mask.Fit(text, hasLiterals: true);
        if (slotted.Length > 0 && slotted.Length < _mask.Slots)
        {
            value = default;
            error = FormatMessage(Labels.MaskIncomplete ?? Localizer[TbStrings.TextFieldMaskIncomplete]);
            return false;
        }

        return base.TryParse(IncludeMaskLiterals ? shown : slotted, out value, out error);
    }

    private void Reveal(bool shown)
    {
        _revealed = shown;
        if (shown)
        {
            Telemetry.Used(TelemetryName, "reveal");
        }
    }

    private async Task ClearAsync()
    {
        await SetValueAsync(default);
        await _input.FocusAsync();
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync when both exist, so the field's own cleanup has to run from here.
        Dispose();
        _disposed = true;
        return _maskHandle?.DisposeHandleAsync() ?? ValueTask.CompletedTask;
    }
}
