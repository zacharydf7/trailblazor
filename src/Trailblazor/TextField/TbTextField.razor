@namespace Trailblazor
@typeparam TValue
@inherits TbFieldBase<TValue>

@Layout(@<text>
    @if (Lines > 1)
    {
        <textarea @attributes="InputAttributes" data-part="input" id="@InputId" name="@InputNameAttribute"
                  rows="@Lines" @bind:get="Text" @bind:set="SetTextAsync" @bind:event="@BindEvent"
                  placeholder="@Placeholder" disabled="@Disabled"
                  aria-required="@(Required ? "true" : null)" aria-invalid="@(Errors.Count > 0 ? "true" : null)"
                  aria-describedby="@InputDescribedBy" class="@ClassNames.Join("tb-field__input", Classes?.Input)"></textarea>
    }
    else
    {
        <input @attributes="InputAttributes" data-part="input" id="@InputId" name="@InputNameAttribute"
               type="@Type.ToString().ToLowerInvariant()" @bind:get="Text" @bind:set="SetTextAsync"
               @bind:event="@BindEvent" placeholder="@Placeholder"
               disabled="@Disabled" aria-required="@(Required ? "true" : null)"
               aria-invalid="@(Errors.Count > 0 ? "true" : null)" aria-describedby="@InputDescribedBy"
               class="@ClassNames.Join("tb-field__input", Classes?.Input)" />
    }
</text>, Start, End)

@code {
    /// <summary>Content before the input, usually an icon.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the input, such as a unit or a button.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>The kind of text the field takes. Defaults to <see cref="TextFieldType.Text"/>.</summary>
    [Parameter]
    public TextFieldType Type { get; set; } = TextFieldType.Text;

    /// <summary>Updates the value on every keystroke instead of when the field loses focus.</summary>
    [Parameter]
    public bool UpdateOnInput { get; set; }

    /// <summary>The number of text lines. More than one renders a multi-line text area.</summary>
    [Parameter]
    public int Lines { get; set; } = 1;

    /// <summary>Example text shown while the field is empty. It is not a label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    // @bind keeps keystrokes typed during a round trip; only the committing event is bound.
    private string BindEvent => UpdateOnInput ? "oninput" : "onchange";
}
