@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules
@inject ITbLocalizer Localizer

@{
    var slots = Arrange();
    // A slid-out panel and the panels the strips keep hidden leave the dock's area empty.
    var empty = !slots.OfType<GroupSlot>().Any(group => group.Edge is null);
    RenderFragment panels = @<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>;
}
@* The groups, panels and separators are siblings, each placed by its box, so a panel that changes group never
   changes parent and keeps its state. The script sets data-ready here once its keys and drags work. *@
@* The frame lays the strips of auto-hidden panels along the dock's edges, around the area the groups share. A
   strip comes before or after the area in the page as it does on the screen. *@
<div @attributes="AdditionalAttributes" data-part="frame" style="@Style"
     class="@ClassNames.Join("tb-dock-frame", Class)">
@* A panel in a browser window of its own has no tab here, so each one keeps a button here that brings its window to
   the front or the panel back. That window can be behind this one, or on another screen. *@
@if (PoppedOut is { Count: > 0 } away && RendererInfo.IsInteractive)
{
    <div role="group" data-part="away" aria-label="@(Labels.Away ?? Localizer[TbStrings.DockAway])"
         class="tb-dock__away">
        @foreach (var id in away)
        {
            var panel = Panel(id)!;
            <TbMenu @key="id" AttachOnFirstUse data-part="away-menu" data-panel="@id"
                    Description="@(Labels.AwayHint ?? Localizer[TbStrings.DockAwayHint])">
                @* The built-in trigger holds only a label, so the unsaved changes dot needs a trigger of its own. *@
                <Trigger>
                    <TbButton Size="Size.Small" Variant="Variant.Text" @attributes="context.Attributes"
                              aria-describedby="@WithModifiedHint(context.Attributes, panel)"
                              data-modified="@(panel.Modified ? "" : null)">
                        <ChildContent>
                            @panel.Title
                            @if (panel.Modified)
                            {
                                <span data-part="modified" aria-hidden="true" class="tb-dock__modified"></span>
                            }
                        </ChildContent>
                        <End><TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" /></End>
                    </TbButton>
                </Trigger>
                <ChildContent>
                    @* The script brings the window forward in the click itself, while the browser still allows it. *@
                    <TbMenuItem data-away="show" data-window="@PanelId(id)">
                        @(Labels.ShowWindow ?? Localizer[TbStrings.DockShowWindow])
                    </TbMenuItem>
                    <TbMenuItem data-away="return" OnClick="() => ReturnFromPageAsync(id, focus: true)">
                        @(Labels.Return ?? Localizer[TbStrings.DockReturn])
                    </TbMenuItem>
                </ChildContent>
            </TbMenu>
        }
    </div>
}
@Strip(DockPosition.Top)
@Strip(DockPosition.Start)
<div @ref="_root" role="group" aria-label="@AriaLabel" data-part="dock"
     tabindex="@(empty ? "-1" : null)"
     data-report="@_reported" data-commits="@(RendererInfo.IsInteractive ? _counted : null)"
     data-min-size="@MinGroupSize" data-focusable-panels="@PanelStops" data-persistence-key="@PersistenceKey"
     data-compact-below="@CompactWidth" data-compact="@_compact" data-locked="@(Locked ? "" : null)"
     data-active-panel="@_active"
     data-connection-lost="@ConnectionLostText"
     class="tb-dock">
    @Content(_declared, panels)
    @* A tab list holds only tabs, so the hint that describes a closable tab sits outside it. *@
    <span id="@_closeHintId" hidden>@(Labels.CloseHint ?? Localizer[TbStrings.DockCloseHint])</span>
    <span id="@_modifiedHintId" hidden>@(Labels.Modified ?? Localizer[TbStrings.DockModified])</span>
    @* The script shows this over the place where a dragged tab's panel would land. *@
    <div data-part="drop-mark" aria-hidden="true" class="tb-dock__drop"></div>
    @foreach (var slot in slots)
    {
        @if (slot is GroupSlot group)
        {
            var others = slots.OfType<GroupSlot>().Where(each => each.Index != group.Index && each.Edge is null)
                .OrderBy(each => each.Index).ToList();
            @* A group that another one covers keeps its row, out of sight and out of reach. The script orders the
               rows by data-group, since a window's row can be rendered out of that order. *@
            <div @key="group.Key" data-part="group" data-group="@group.Index" data-maximized="@group.Maximized"
                 data-floating="@(group.Layer is not null)" data-edge="@EdgeName(group.Edge)"
                 style="@BoxStyle(group.Box.Box, group.Layer)"
                 class="@ClassNames.Join("tb-dock__group", group.Covered ? "tb-dock__group--covered" : null,
                            group.Layer is null ? null : "tb-dock__group--floating",
                            group.Edge is null ? null : "tb-dock__group--revealed")">
                @* A window moves by the button that starts its row: a drag, the arrow keys, or single steps from its
                   menu, for people who can't drag (WCAG 2.5.7). *@
                @if (group.Layer is not null && group.Edge is null && RendererInfo.IsInteractive)
                {
                    <TbMenu Icon="BuiltInIcons.Move" Size="Size.Small" AttachOnFirstUse Class="tb-dock__window-move"
                            data-part="window-move"
                            AriaLabel="@Format(Labels.MoveWindow, TbStrings.DockMoveWindow,
                                           Panel(group.Box.Active)!.Title)"
                            Description="@(Labels.MoveWindowHint ?? Localizer[TbStrings.DockMoveWindowHint])">
                        @foreach (var (step, text) in MoveSteps())
                        {
                            <TbMenuItem @key="step" data-step="@step"
                                        OnClick="() => StepWindowAsync(group.Index, step)">
                                @text
                            </TbMenuItem>
                        }
                    </TbMenu>
                }
                @* A right-click, a long press, Shift+F10 or the context menu key on a tab opens the menu for that
                   tab's panel, and on the row's empty part for the group's showing panel. *@
                <TbContextMenu Class="tb-dock__tab-area"
                               AriaLabel="@(Labels.TabMenu ?? Localizer[TbStrings.DockTabMenu])"
                               Disabled="@(!HasMenu(group, group.Box.Active, others))">
                    <ChildContent>
                        <div role="tablist" data-part="tabs" class="tb-dock__tabs" data-context-key="@group.Box.Active"
                             aria-label="@(group.Edge is not null
                                 ? Labels.RevealedGroup ?? Localizer[TbStrings.DockRevealedGroup]
                                 : group.Layer is null ? Format(Labels.Group, TbStrings.DockGroup, group.Index + 1)
                                 : Format(Labels.FloatingGroup, TbStrings.DockFloatingGroup, group.Index + 1))">
                            @foreach (var id in group.Box.Panels)
                            {
                                var panel = Panel(id)!;
                                var selected = id == group.Box.Active;
                                <button @key="id" @ref="_tabs[id]" type="button" role="tab" id="@TabId(id)"
                                        aria-selected="@(selected ? "true" : "false")"
                                        aria-controls="@(_rendered.Contains(id) ? PanelId(id) : null)"
                                        tabindex="@(selected ? 0 : -1)" data-part="tab" data-panel="@id"
                                        data-context-key="@id"
                                        aria-keyshortcuts="@(panel.Closable ? "Delete Backspace" : null)"
                                        aria-labelledby="@(panel.TabEnd is null ? null : TitleId(id))"
                                        aria-describedby="@TabHints(id, panel)" class="tb-dock__tab"
                                        data-modified="@(panel.Modified ? "" : null)" @onclick="_select.For(id)">
                                    @if (panel.Icon is { } icon)
                                    {
                                        <TbIcon Icon="icon" Size="Size.Small" data-part="icon" />
                                    }
                                    @* With TabEnd content, the tab and its panel are named by the title alone, and
                                       the content describes the tab. *@
                                    <span id="@(panel.TabEnd is null ? null : TitleId(id))" data-part="title"
                                          class="tb-dock__title">@panel.Title</span>
                                    @if (panel.TabEnd is { } end)
                                    {
                                        <span id="@TabEndId(id)" data-part="tab-end" class="tb-dock__tab-end">@end</span>
                                    }
                                    @if (panel.Modified)
                                    {
                                        <span data-part="modified" aria-hidden="true" class="tb-dock__modified"></span>
                                    }
                                    @* A tab can't hold a button, so the mark serves the pointer and the keys in
                                       aria-keyshortcuts serve the keyboard. *@
                                    @if (panel.Closable)
                                    {
                                        <span data-part="close" aria-hidden="true" class="tb-dock__close"
                                              @onclick="_close.For(id)" @onclick:stopPropagation="true">
                                            <TbIcon Icon="BuiltInIcons.Close" Size="Size.Small" />
                                        </span>
                                    }
                                </button>
                            }
                        </div>
                    </ChildContent>
                    <Items Context="opened">
                        @if (opened.Key is { } key && group.Box.Panels.Contains(key))
                        {
                            @MenuItems(group, key, others, CloseFromTabAsync)
                        }
                    </Items>
                </TbContextMenu>
                @* The menu moves a panel with clicks or taps, for people who can't drag its tab (WCAG 2.5.7), and
                   closes a panel where neither its mark nor a key can be reached. It acts on the group's showing
                   panel. *@
                @if (RendererInfo.IsInteractive)
                {
                    @if (group.Maximized)
                    {
                        <TbIconButton Icon="BuiltInIcons.Restore" Size="Size.Small" Variant="Variant.Text"
                                      Class="tb-dock__restore" data-part="restore"
                                      AriaLabel="@(Labels.Restore ?? Localizer[TbStrings.DockRestore])"
                                      OnClick="() => MaximizeAsync(group.Box.Active, false)" />
                    }
                    @if (HasMenu(group, group.Box.Active, others))
                    {
                        <TbMenu Icon="BuiltInIcons.More" Size="Size.Small" Align="PlacementAlign.End" AttachOnFirstUse
                                Class="tb-dock__menu" data-part="group-menu"
                                AriaLabel="@Format(Labels.Menu, TbStrings.DockMenu, Panel(group.Box.Active)!.Title)">
                            @MenuItems(group, group.Box.Active, others, id => CloseAsync(id, true))
                        </TbMenu>
                    }
                }
            </div>
        }
        else if (slot is PanelSlot host)
        {
            @* A hidden panel is inert, so nothing in it can be reached, even what its own styles make visible. A
               panel in a browser window of its own has no tab there to name it, so it names itself, and it gets a bar
               to come back by. The bar comes and goes inside the panel's element, which Blazor never moves. *@
            <div @key="host.Key" @attributes="host.Panel.HostAttributes" role="@(host.Popped ? "region" : "tabpanel")"
                 id="@PanelId(host.Panel.Name)" aria-labelledby="@(host.Popped ? null
                     : host.Panel.TabEnd is null ? TabId(host.Panel.Name) : TitleId(host.Panel.Name))"
                 aria-label="@(host.Popped ? host.Panel.Title : null)" tabindex="@(host.Showing ? PanelStop : null)"
                 inert="@(!host.Showing)" data-part="panel" data-panel="@host.Panel.Name"
                 data-dock-group="@(host.Popped ? null : host.Group)" data-popped="@host.Popped"
                 data-floating="@(host.Layer is not null)" data-edge="@EdgeName(host.Edge)"
                 style="@($"{BoxStyle(host.Box, host.Layer)} {host.Panel.Style}")"
                 class="@ClassNames.Join("tb-dock__panel", host.Showing ? null : "tb-dock__panel--hidden",
                            host.Layer is null ? null : "tb-dock__panel--floating",
                            host.Popped ? "tb-dock__panel--popped" : null,
                            host.Edge is null ? null : "tb-dock__panel--revealed", host.Panel.Class)">
                @if (host.Popped)
                {
                    <div data-part="return-bar" class="tb-dock__return-bar">
                        @* aria-describedby can't reach the page's hint from another window, so the return button
                           gets its own. *@
                        @if (host.Panel.Modified)
                        {
                            <span id="@ReturnHintId(host.Panel.Name)" hidden>
                                @(Labels.Modified ?? Localizer[TbStrings.DockModified])
                            </span>
                        }
                        <TbButton Size="Size.Small" Variant="Variant.Text" data-part="return"
                                  aria-describedby="@(host.Panel.Modified ? ReturnHintId(host.Panel.Name) : null)"
                                  data-modified="@(host.Panel.Modified ? "" : null)"
                                  OnClick="() => ReturnAsync(host.Panel.Name, focus: true)">
                            @(Labels.Return ?? Localizer[TbStrings.DockReturn])
                            @if (host.Panel.Modified)
                            {
                                <span data-part="modified" aria-hidden="true" class="tb-dock__modified"></span>
                            }
                        </TbButton>
                    </div>
                }
                @Content(host.Panel.Version, host.Panel.ChildContent)
            </div>
        }
        else if (slot is WindowGripSlot grip)
        {
            @* A window resizes by the grip in the corner where its box ends: a drag, the arrow keys, or single steps
               from its menu. *@
            <TbMenu @key="grip.Key" Icon="BuiltInIcons.ResizeGrip" Size="Size.Small" AttachOnFirstUse
                    Class="tb-dock__window-grip" data-part="window-grip" data-group="@grip.Index" data-floating
                    Style="@BoxStyle(grip.Box, grip.Layer)"
                    AriaLabel="@Format(Labels.ResizeWindow, TbStrings.DockResizeWindow, grip.Title)"
                    Description="@(Labels.ResizeWindowHint ?? Localizer[TbStrings.DockResizeWindowHint])">
                @foreach (var (step, text) in SizeSteps())
                {
                    <TbMenuItem @key="step" data-step="@step" OnClick="() => StepWindowAsync(grip.Index, step)">
                        @text
                    </TbMenuItem>
                }
            </TbMenu>
        }
        else if (slot is SlideSeparatorSlot slide)
        {
            var (edge, upright) = (EdgeName(slide.Hidden.Edge),
                slide.Hidden.Edge is DockPosition.Start or DockPosition.End);
            @* A slid-out panel resizes by its inner edge, a separator like the ones between groups: a drag, its keys,
               or the steps of its grip's menu (WCAG 2.5.7). *@
            <div @key="slide.Key" role="separator" tabindex="0" data-part="slide-separator" data-group="@slide.Index"
                 data-floating data-edge="@edge" aria-orientation="@(upright ? "vertical" : "horizontal")"
                 aria-controls="@PanelId(slide.Hidden.Panel)" aria-valuenow="@Whole(slide.Hidden.Size)"
                 aria-valuemin="10" aria-valuemax="90"
                 aria-label="@Format(Labels.Resize, TbStrings.DockResize, slide.Title)"
                 style="@BoxStyle(slide.Box, slide.Layer)"
                 class="@($"tb-dock__slide-separator tb-dock__slide-separator--{edge}")">
            </div>
            @if (RendererInfo.IsInteractive)
            {
                <TbMenu @key="@($"{slide.Key}-grip")" data-part="slide-grip" data-group="@slide.Index" data-floating
                        data-edge="@edge" Style="@BoxStyle(slide.Box, slide.Layer)"
                        Class="@($"tb-dock__slide-grip tb-dock__slide-grip--{edge}")"
                        Trigger="GripButton(slide.Title)" ChildContent="GripSteps(slide.Title, StepSlideAsync)" />
            }
        }
        else if (slot is SeparatorSlot separator)
        {
            var box = separator.Box;
            <div @key="separator.Key" role="separator" tabindex="0" data-part="separator"
                 data-index="@separator.Index" data-before="@BoxText(box.BeforeBox)" data-after="@BoxText(box.AfterBox)"
                 aria-orientation="@(box.Split.Vertical ? "horizontal" : "vertical")"
                 aria-controls="@PanelId(separator.Before)" aria-valuenow="@Whole(Fraction(box) * 100)"
                 aria-label="@Format(Labels.Resize, TbStrings.DockResize, Panel(separator.Before)!.Title)"
                 style="@BoxStyle(Line(box))"
                 class="@ClassNames.Join("tb-dock__separator",
                            box.Split.Vertical ? "tb-dock__separator--vertical" : null)">
            </div>
            @* The grip's menu resizes with single clicks or taps (WCAG 2.5.7). It stays out of the tab order, since
               the separator's keys do the same. *@
            @if (RendererInfo.IsInteractive)
            {
                var name = Panel(separator.Before)!.Title;
                <TbMenu @key="@($"grip-{separator.Index}")" data-part="grip" data-index="@separator.Index"
                        Style="@BoxStyle(Line(box))" Class="@ClassNames.Join("tb-dock__grip",
                                   box.Split.Vertical ? "tb-dock__grip--vertical" : null)"
                        Trigger="GripButton(name)"
                        ChildContent="GripSteps(name, percent => StepAsync(separator.Index, percent))" />
            }
        }
    }
    @if (empty)
    {
        <div data-part="empty" class="tb-dock__empty">@EmptyContent</div>
    }
</div>
@Strip(DockPosition.End)
@Strip(DockPosition.Bottom)
</div>

@code {
    private abstract record Slot(string Key);

    // Layer is a window's place among the windows, back to front, and null for what is docked. Edge is the edge an
    // auto-hidden panel slid out from, which is drawn as a window in front of the others.
    private sealed record GroupSlot(string Key, int Index, DockGroupBox Box, bool Maximized, bool Covered,
        int? Layer = null, DockPosition? Edge = null) : Slot(Key);

    // Popped says the panel shows in a browser window of its own.
    private sealed record PanelSlot(string Key, TbDockPanel Panel, int Group, DockBox Box, bool Showing,
        int? Layer = null, DockPosition? Edge = null, bool Popped = false) : Slot(Key);

    // The grip in a window's corner, named by the window's showing panel.
    private sealed record WindowGripSlot(string Key, int Index, DockBox Box, int Layer, string Title) : Slot(Key);

    // The inner edge of the auto-hidden panel that is slid out, which resizes it.
    private sealed record SlideSeparatorSlot(string Key, int Index, DockAutoHidden Hidden, DockBox Box, int Layer,
        string Title) : Slot(Key);

    // Before is the panel showing in the group just before the separator, which names the separator.
    private sealed record SeparatorSlot(string Key, int Index, DockSeparatorBox Box, string Before) : Slot(Key);

    private const string FloatAction = "float";
    private const string AutoHideAction = "auto_hide";
    private const string RevealAction = "reveal";
    private const string ResizeAutoHiddenAction = "resize_auto_hidden";
    private const string DockAction = "dock";
    private const string PopOutAction = "pop_out";
    private const string ReturnAction = "return";

    private readonly string _id = $"tb-dock-{Guid.NewGuid():N}";
    private readonly string _closeHintId;
    private readonly string _modifiedHintId;
    // The panels whose CanClose is being answered.
    private readonly HashSet<string> _asked = [];
    private readonly List<TbDockPanel> _panels = [];
    // Each panel's tab, which the dock focuses when a neighbor closes.
    private readonly Dictionary<string, ElementReference> _tabs = [];
    // Each auto-hidden panel's button on its strip, which takes the focus when the panel goes or slides back there.
    private readonly Dictionary<string, ElementReference> _stripButtons = [];
    // The slots' keys in the order they were first rendered, which never changes, so Blazor never moves a panel.
    private readonly List<string> _order = [];
    // The windows' keys with the panels each held at the last render, oldest window first. A window keeps its key,
    // and so its elements and its number, while it holds a panel it held before, no matter which window is in front.
    private List<(string Key, HashSet<string> Panels)> _windows = [];
    private int _windowsMade;
    private readonly ItemHandlers<string, Func<Task>> _select;
    private readonly ItemHandlers<string, Func<Task>> _close;
    // The panels whose content is rendered: the ones showing, and the ones kept alive since they last showed.
    private HashSet<string> _rendered = [];
    private DockLayout _layout = new();
    private DockLayout? _layoutFromParent;
    private ElementReference _root;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<DockReport>? _report;
    private string? _focusAfterRender;
    private string? _focusStripAfterRender;
    // The panels that show in browser windows of their own, each alone in a floating window of the layout, which
    // keeps a place for it while it is away.
    private readonly HashSet<string> _popped = [];
    // Where each of them was before it floated for its window: the layout it left, that layout with it floated, and
    // its turn among those that went. A panel that floated alone already has no entry, and stays floating.
    private readonly Dictionary<string, (DockLayout Before, DockLayout Floated, int Turn)> _homes = [];
    private int _turns;
    // The panels that stopped showing in a window of their own in the last render, which go back where they were.
    private readonly HashSet<string> _goingHome = [];
    // The panels to move into the browser windows their menu items opened, once they are rendered for them. Two
    // items can be chosen before the dock renders, and each panel is asked for once.
    private readonly HashSet<string> _popOutAfterRender = [];
    // The popped panels whose windows have them, which a window still waiting for its style sheets doesn't yet.
    private readonly HashSet<string> _landed = [];
    // The popped panels the script was last told of.
    private string[] _poppedInScript = [];
    // The browser windows kept open for panels the app took away, by panel id, each with what the script needs.
    private readonly Dictionary<string, EmptyWindow> _keptWindows = [];
    // The element ids of the panels whose kept windows the script has yet to be told to close.
    private readonly List<string> _unkept = [];
    // Whether the app has yet to hear of a layout that changed while a panel registered.
    private bool _layoutOwed;
    // The popped panels the app was last told of.
    private string[] _poppedReported = [];
    // The auto-hidden panels the dock shows on its strips, as of the last render.
    private IReadOnlyList<DockAutoHidden> _strips = [];
    private bool _focusDockAfterRender;
    private bool _saveAfterRender;
    // The key whose saved layout the dock has read.
    private string? _restoredKey;
    // Counts the parent's renders, so the panels take new parameters only then.
    private int _declared;
    private int _stamps;
    // The number of the browser's last resize report this render shows.
    private int _reported;
    // Counts the selections, closes and resizes the dock has finished with, the app's LayoutChanged included, so a
    // test can wait for its own.
    private int _commits;
    // The count the page shows, which catches up once an action's render and the focus it moves are both done.
    private int _counted;
    private bool _disposed;
    // Whether the script found the dock narrower than CompactBelow.
    private bool _narrow;
    // Whether the dock shows its docked panels as the tabs of one group, as of the last render.
    private bool _compact;
    // The docked panel last brought to the front, which is the one a compact dock shows.
    private string? _front;
    // The ActivePanel the dock has, the one the parent last passed, the panels of the group it shows in, and whether
    // it moved and that is still to be reported: after LayoutChanged, or once the dock has rendered.
    private string? _active;
    private string? _activeFromParent;
    private HashSet<string> _activeGroup = [];
    private bool _activeMoved;
    // The tabs of the one group a compact dock showed at the last render, by which the panel that takes a departed
    // one's place is found.
    private List<string> _merged = [];

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    [Inject]
    private IAnnouncer Announcer { get; set; } = default!;

    private ControlTelemetry Telemetry => field ??= new(Services, GetType());

    /// <summary>Creates the dock.</summary>
    public TbDockManager()
    {
        _closeHintId = $"{_id}-close-hint";
        _modifiedHintId = $"{_id}-modified-hint";
        _select = new(panel => () => SelectAsync(panel));
        _close = new(panel => () => CloseFromTabAsync(panel));
    }

    /// <summary>The <see cref="TbDockPanel"/>s. Where each one is comes from <see cref="Layout"/>, not from their
    /// order here.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Where each panel is. Bind it with <c>@bind-Layout</c> to hear the user's changes, and save it with
    /// <see cref="DockLayout.ToJson"/>. Without one, every panel is a tab of a single group. A panel the layout
    /// doesn't hold joins the largest group, and a panel id with no <see cref="TbDockPanel"/> keeps its place for
    /// when the panel comes back.</summary>
    [Parameter]
    public DockLayout? Layout { get; set; }

    /// <summary>Raised with the new layout when the user selects a tab, moves, floats, docks, auto-hides or closes
    /// a panel, slides an auto-hidden panel out or back, moves a separator or a window, or maximizes or restores a
    /// group, and when the dock restores the layout saved under its <see cref="PersistenceKey"/>.</summary>
    [Parameter]
    public EventCallback<DockLayout> LayoutChanged { get; set; }

    /// <summary>What shows in place of the panels when none is docked, such as a hint on how to open one.</summary>
    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>Saves the layout in the browser under this key after each change, and reads it back once the page
    /// is interactive, so a reload keeps the user's arrangement. The saved layout replaces <see cref="Layout"/> and
    /// raises <see cref="LayoutChanged"/>; setting another <see cref="Layout"/> later replaces the saved one, which
    /// is how a Reset button works. Use a key unique to each dock. When the key changes, the dock reads the layout
    /// saved under the new one. To keep layouts on a server instead, bind <see cref="Layout"/> and save
    /// <see cref="DockLayout.ToJson"/> of <see cref="LayoutToSave"/>. With <see cref="AllowPopOut"/>, the dock also
    /// saves where each panel's browser window last was, and its size, beside the layout; without a key it keeps
    /// them for the browser session, under the dock's <see cref="AriaLabel"/>, so docks whose panels share ids need
    /// different names.</summary>
    [Parameter]
    public string? PersistenceKey { get; set; }

    /// <summary>Changes the layout read back under the <see cref="PersistenceKey"/> before the dock shows it, such
    /// as <c>saved => saved.Retain(ids)</c> to forget the panels this version of the app no longer has, which a saved
    /// layout otherwise keeps a place for. Give <c>Retain</c> every panel id the app can show, also those it renders
    /// only at times, or such a panel loses its saved place. What the function returns is shown and handed to
    /// <see cref="LayoutChanged"/>, and is saved in place of what was read when the two differ. It isn't called when
    /// nothing is saved, or for a layout the app sets.</summary>
    [Parameter]
    public Func<DockLayout, DockLayout>? RestoreLayout { get; set; }

    /// <summary>The smallest width or height, in pixels, that a separator leaves a group and that a floating window
    /// or a slid-out panel resizes to. Defaults to 96.</summary>
    [Parameter]
    public int MinGroupSize { get; set; } = 96;

    /// <summary>The width below which a dock with groups side by side shows its docked panels as the tabs of one
    /// group that fills it, one panel at a time, so a dock on a phone or in a narrow column stays readable. The
    /// width is the dock's whole width, strips included, not the window's. The layout keeps every group, and they
    /// show again once the dock is wide enough. Defaults to <see cref="Breakpoint.Sm"/>, 640px;
    /// <see cref="Breakpoint.Xs"/> keeps the groups side by side at every width. Groups that are only above and
    /// below each other stay as they are at any width. The dock's script measures it, so the groups show side by
    /// side until the page is interactive, and on a static page always.</summary>
    [Parameter]
    public Breakpoint CompactBelow { get; set; } = Breakpoint.Sm;

    private int? CompactWidth => CompactBelow > Breakpoint.Xs ? Viewport.MinWidths[(int)CompactBelow - 1] : null;

    /// <summary>Decides when a showing panel is a tab stop of its own, which lets the Tab key reach a panel that
    /// holds no control. Defaults to <see cref="TabPanelFocus.Auto"/>: a panel that starts with a control is no tab
    /// stop, since Tab reaches that control, and any other panel is one. With <see cref="TabPanelFocus.Auto"/>,
    /// the dock's script makes that check, so every showing panel is a tab stop until the page is interactive, and
    /// always in bUnit, which runs no script.</summary>
    [Parameter]
    public TabPanelFocus FocusablePanels { get; set; }

    /// <summary>Adds "Open in new window" to the panels' menus, which shows a panel in a browser window of its own,
    /// with its state, until that window closes or its Return button is pressed. The panel is still part of this
    /// page: the window closes with it, and a script of the app's own inside the panel has to work with the
    /// panel's document and not the page's. A panel whose own <see cref="TbDockPanel.AllowPopOut"/> is false stays
    /// on the page. Off by default.</summary>
    [Parameter]
    public bool AllowPopOut { get; set; }

    /// <summary>Keeps the panels where they are: their menus offer no Move, New group, Auto-hide, Open in new window,
    /// Float or Dock, their tabs and strip buttons can't be dragged, and a group whose menu would be empty shows none.
    /// Selecting a tab, the separators, maximizing, closing, moving a floating window and the app's own layout changes
    /// still work. For a kiosk, for people who must not lose a panel, or for a workspace that is still loading. Off by
    /// default.</summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>The id of the showing panel in the group that last had the focus or a press, for a command such as
    /// Save to act on. It follows that group as the dock shows it: when another of its tabs shows, by people or by
    /// the app's layout, that tab's panel is the active one, and when the active panel leaves the group, by closing or
    /// moving to a strip, the group's showing panel takes its place. Null until people use a group, and again when
    /// its group is gone. Setting it makes the showing panel of that panel's group the active one, and changes neither
    /// the layout nor the focus.</summary>
    [Parameter]
    public string? ActivePanel { get; set; }

    /// <summary>Raised with <see cref="ActivePanel"/> when it changes.</summary>
    [Parameter]
    public EventCallback<string?> ActivePanelChanged { get; set; }

    /// <summary>Raised with <see cref="PoppedOut"/> when a panel goes to a browser window of its own or comes back
    /// from one.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> PoppedOutChanged { get; set; }

    /// <summary>The ids of the panels that show in browser windows of their own, in the order of their floating
    /// windows in the <see cref="Layout"/>. It isn't part of the layout, since a page can't open windows as it loads.
    /// </summary>
    public IReadOnlyList<string> PoppedOut =>
        [.. Shown().Floats.Select(window => window.Active).Where(_landed.Contains)];

    /// <summary>The layout to keep between visits: the current one with each panel that is in a browser window of its
    /// own put back where it was before it went, docked or in the floating window it had to itself, since a page
    /// can't open windows as it loads. The dock saves this one under its <see cref="PersistenceKey"/>. An app that
    /// keeps layouts itself and allows windows saves this layout's <c>ToJson()</c> rather than the layout
    /// <see cref="LayoutChanged"/> hands it, which holds a floating window for each panel that is away. It is up to
    /// date when <see cref="LayoutChanged"/> is raised.</summary>
    public DockLayout LayoutToSave
    {
        get
        {
            // The last to go is the first back, as when the panels come home, so each finds the layout it left.
            var layout = _layout;
            foreach (var (panel, home) in _homes.OrderByDescending(each => each.Value.Turn))
            {
                if (layout.FloatOf(panel) is { Group.Panels.Count: 1 })
                {
                    layout = layout.Redocked(panel, home.Before, home.Floated);
                }
            }

            return layout;
        }
    }

    /// <summary>Brings a panel back to the dock from its own browser window, which closes. The panel shows where it
    /// was docked before it went, or in the floating window it had to itself. Does nothing for a panel that isn't
    /// in a window of its own.</summary>
    public Task ReturnAsync(string panel) => InvokeAsync(() => ReturnFromPageAsync(panel, focus: false));

    /// <summary>Brings a docked panel to the front. The dock sets the layout that <see cref="DockLayout.Open"/>
    /// gives, in which the panel's tab is its group's showing tab and no other group covers it, and raises
    /// <see cref="LayoutChanged"/> when that changes the layout. A compact dock, one narrower than
    /// <see cref="CompactBelow"/> whose groups sit side by side, shows one docked panel at a time; this shows the
    /// panel there even when it is already its group's showing tab, and then the layout doesn't change. Does
    /// nothing for a panel that isn't docked.</summary>
    public Task ShowAsync(string panel) => InvokeAsync(async () =>
    {
        if (!IsDocked(panel))
        {
            return;
        }

        _front = panel;
        var layout = _layout.Open(panel);
        if (!layout.Equals(_layout))
        {
            await ChangeAsync(layout, null);
        }

        StateHasChanged();
    });

    /// <summary>The dock's accessible name, such as "Workbench".</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>The words of the dock's menus and what it says to screen readers. Each one left null uses the app's
    /// text.</summary>
    [Parameter]
    public DockLabels Labels { get; set; } = new();

    /// <summary>A label this dock's use is counted under, such as <c>"workbench"</c>, so the app can count how often
    /// people see it and select, move, close and resize its panels through the <c>Trailblazor</c> meter. Controls
    /// that share a label count together; a control without one isn't counted. It names what the control does, never
    /// the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _declared++;
        if (ActivePanel != _activeFromParent)
        {
            _activeFromParent = ActivePanel;
            _active = ActivePanel;
            _activeGroup = [];
        }

        // The dock replaces its own layout only when the parent passes a different one, so a render with the same
        // layout keeps what the user did since.
        if (!Equals(Layout, _layoutFromParent))
        {
            _layoutFromParent = Layout;
            var layout = Layout ?? new();
            // A binding hands back the layout the dock just raised, which is saved already.
            _saveAfterRender |= !layout.Equals(_layout);
            Follow(layout);
            _layout = layout;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Telemetry.Rendered(TelemetryName);
        try
        {
            // The parent's layout or panels, or a change of width, can move what shows.
            FollowActive();
            if (_activeMoved)
            {
                StateHasChanged();
            }

            await ReportActiveMovedAsync();
            // First, so a panel that came back is in the dock before its tab takes the focus.
            await ShowPoppedAsync();
            if (_focusAfterRender is { } focused)
            {
                _focusAfterRender = null;
                if (_tabs.TryGetValue(focused, out var tab) && Shown() is var shown
                    && (shown.Revealed?.Active == focused
                        || shown.Groups.Concat(shown.Floats).Any(group => group.Panels.Contains(focused))))
                {
                    await tab.FocusAsync();
                }
            }
            else if (_focusStripAfterRender is { } stowed)
            {
                _focusStripAfterRender = null;
                if (_layout.StripOf(stowed) is not null && _stripButtons.TryGetValue(stowed, out var button))
                {
                    await button.FocusAsync();
                }
            }
            else if (_focusDockAfterRender)
            {
                _focusDockAfterRender = false;
                await _root.FocusAsync();
            }

            // A test that waits for an action waits for its focus too, which only now has moved.
            if (_counted != _commits)
            {
                _counted = _commits;
                StateHasChanged();
            }

            if (firstRender)
            {
                await AttachAsync();
            }
            else if (_handle is not null && PersistenceKey != _restoredKey)
            {
                await RestoreAsync();
            }
            else if (_saveAfterRender)
            {
                _saveAfterRender = false;
                await SaveAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the dock went with it.
        }
    }

    private async Task AttachAsync()
    {
        var module = await Modules.ImportAsync("./_content/Trailblazor/dock-manager.js");
        if (_disposed)
        {
            return;
        }

        _report = DotNetObjectReference.Create(new DockReport(DispatchExceptionAsync, SelectFromScriptAsync,
            CloseFromScriptAsync, OnResizeAsync, MoveFromScriptAsync, ToggleMaximizedFromScriptAsync,
            RaiseFromScriptAsync, OnFloatAsync, PullOutFromScriptAsync, ConcealFromScriptAsync, SlideFromScriptAsync,
            AutoHideFromScriptAsync, OnNarrowAsync,
            panel => ReturnAsync(panel, focus: false),
            panel =>
            {
                _keptWindows.Remove(panel);
                return Task.CompletedTask;
            },
            EngageFromScriptAsync, tab => tab.StartsWith($"{_id}-tab-", StringComparison.Ordinal)));
        var handle = await module.InvokeAsync<IJSObjectReference?>("attachDock", _root, _report);
        if (handle is not null && _disposed)
        {
            await handle.DisposeHandleAsync();
            return;
        }

        _handle = handle;
        await RestoreAsync();
    }

    // Shows the layout saved under the current key, on attach and each time the key changes.
    private async Task RestoreAsync()
    {
        _restoredKey = PersistenceKey;
        // The layout the app starts with isn't saved, only what follows it, so a later version of the app can start
        // with another one.
        _saveAfterRender = false;
        if (_handle is null || PersistenceKey is not { } key
            || !DockLayout.TryParse(await _handle.InvokeAsync<string?>("saved", key), out var read) || _disposed)
        {
            return;
        }

        var restored = RestoreLayout?.Invoke(read) ?? read;
        if (!restored.Equals(_layout))
        {
            _layout = restored;
            await LayoutChanged.InvokeAsync(restored);
            StateHasChanged();
        }

        // The layout as RestoreLayout left it replaces the one read from the browser.
        if (!restored.Equals(read))
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_handle is not null && PersistenceKey is { } key)
        {
            await _handle.InvokeVoidAsync("save", key, LayoutToSave.ToJson());
        }
    }

    internal void Add(TbDockPanel panel)
    {
        _panels.Add(panel);
        if (!_keptWindows.Remove(panel.Name, out var window))
        {
            return;
        }

        // A panel the app made again goes straight to the browser window kept for it, before the render that
        // would show it in the dock. No window is asked for, so no click is needed, and no user action is
        // counted. The app hears of the layout after that render.
        if (CanPopOut(panel.Name))
        {
            _goingHome.Remove(panel.Name);
            _layout = FloatedForItsWindow(panel.Name);
            _layoutOwed = true;
        }
        else
        {
            _unkept.Add(window.Id);
        }
    }

    internal void Remove(TbDockPanel panel)
    {
        _panels.Remove(panel);
        if (panel.KeepWindowFor is { } time && (time > TimeSpan.Zero || time == Timeout.InfiniteTimeSpan)
            && _landed.Contains(panel.Name) && Panel(panel.Name) is null)
        {
            // A browser's timer fires at once when asked to wait longer than about 24 days.
            var endless = time == Timeout.InfiniteTimeSpan || time.TotalMilliseconds > int.MaxValue;
            _keptWindows[panel.Name] = new(PanelId(panel.Name),
                Format(Labels.EmptyWindow, TbStrings.DockEmptyWindow, panel.Title),
                endless ? null : time.TotalMilliseconds);
        }

        _select.KeepOnly(id => Panel(id) is not null);
        _close.KeepOnly(id => Panel(id) is not null);
        if (Panel(panel.Name) is null)
        {
            _tabs.Remove(panel.Name);
        }

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    internal void Refresh() => StateHasChanged();

    // A number no panel of this dock has had, so content renders again for a panel made anew under an old id.
    internal int Stamp() => ++_stamps;

    private TbDockPanel? Panel(string id) => _panels.Find(panel => panel.Name == id);

    // Tells the script which panels are tab stops; with no mark, it decides by how each showing panel starts.
    private string? PanelStops => FocusablePanels switch
    {
        TabPanelFocus.Always => "always",
        TabPanelFocus.Never => "never",
        _ => null,
    };

    // With Never a showing panel still gets -1, not no tabindex, since the script focuses a panel as it arrives in
    // a window of its own.
    private int PanelStop => FocusablePanels == TabPanelFocus.Never ? -1 : 0;

    private bool CanPopOut(string panel) => AllowPopOut && Panel(panel) is { AllowPopOut: true };

    // DockContent is internal, so Razor can't name it.
    private static RenderFragment Content(int version, RenderFragment? content) => builder =>
    {
        builder.OpenComponent<DockContent>(0);
        builder.AddComponentParameter(1, nameof(DockContent.Version), version);
        builder.AddComponentParameter(2, nameof(DockContent.ChildContent), content);
        builder.CloseComponent();
    };

    private string TabId(string panel) => $"{_id}-tab-{panel}";

    private string PanelId(string panel) => $"{_id}-panel-{panel}";

    private string ReturnHintId(string panel) => $"{PanelId(panel)}-modified";

    private string? WithModifiedHint(IReadOnlyDictionary<string, object> trigger, TbDockPanel panel) =>
        panel.Modified ? $"{trigger.GetValueOrDefault("aria-describedby")} {_modifiedHintId}".Trim()
            : trigger.GetValueOrDefault("aria-describedby") as string;

    // Only a dock that runs on the server stops working when the connection to the server is lost.
    private string? ConnectionLostText => AllowPopOut && RendererInfo.Name == "Server"
        ? Labels.ConnectionLost ?? Localizer[TbStrings.DockConnectionLost] : null;

    private static string? EdgeName(DockPosition? edge) => edge?.ToString().ToLowerInvariant();

    // What the layout shows now. The server can hold renders back while the browser catches up, so what the script
    // reports is matched against this, not against what was last rendered.
    private DockArrangement Shown() => Shown(_layout, out _);

    private DockArrangement Shown(DockLayout layout, out bool compact)
    {
        var shown = layout.Arrange(id => Panel(id) is not null);
        compact = _narrow && CompactWidth is not null
            && shown.Separators.Any(separator => !separator.Split.Vertical);
        return compact ? Merged(shown) : shown;
    }

    // A compact dock shows its docked panels as the tabs of one group that fills it, in the groups' order. The panel
    // last brought to the front shows, or the one that took its place among the tabs when it has gone.
    private DockArrangement Merged(DockArrangement shown)
    {
        var panels = shown.Groups.SelectMany(group => group.Panels).ToList();
        var first = shown.Groups[shown.Maximized ?? 0];
        var active = _front is not null && panels.Contains(_front) ? _front
            : _merged.IndexOf(_front!) is >= 0 and var at ? panels[Math.Min(at, panels.Count - 1)] : first.Active;
        return shown with
        {
            Groups = [new DockGroupBox(first.Group, new DockBox(0, 0, 100, 100), panels, active)],
            Separators = [],
            Maximized = null,
        };
    }

    private bool IsDocked(string panel) => Shown().Groups.Any(group => group.Panels.Contains(panel));

    // A layout that brings a panel to the front of a docked group brings it to the front of a compact dock too: a
    // panel that wasn't docked, or one that now shows in a group that still holds a tab which showed before. A tab
    // that shows only because the one in front of it left its group wasn't brought there.
    private void Follow(DockLayout layout)
    {
        var before = _layout.Arrange(id => Panel(id) is not null).Groups;
        var (docked, showed) = (before.SelectMany(group => group.Panels).ToHashSet(),
            before.Select(group => group.Active).ToHashSet());
        foreach (var group in layout.Arrange(id => Panel(id) is not null).Groups)
        {
            if (!docked.Contains(group.Active)
                || group.Panels.Any(panel => panel != group.Active && showed.Contains(panel)))
            {
                _front = group.Active;
                return;
            }
        }
    }

    // Works out what shows and where, and keeps every slot rendered before at its place among the slots.
    private List<Slot> Arrange()
    {
        // Checked here and not as a panel registers, since a panel made anew registers before the old one goes.
        if (_panels.GroupBy(panel => panel.Name).FirstOrDefault(same => same.Count() > 1) is { } twice)
        {
            throw new InvalidOperationException($"Two panels of a {nameof(TbDockManager)} have the id '{twice.Key}'.");
        }

        // A panel the layout doesn't hold is docked now, so everything the user does next starts from what shows.
        foreach (var panel in _panels.Where(panel => !_layout.Closed.Contains(panel.Name)))
        {
            _layout = _layout.Place(panel.Name);
        }

        var shown = Shown(_layout, out _compact);
        _merged = _compact ? [.. shown.Groups[0].Panels] : [];
        _front = _compact ? shown.Groups[0].Active : _front;
        var slots = new List<Slot>();
        for (var index = 0; index < shown.Groups.Count; index++)
        {
            var (maximized, covered) = (shown.Maximized == index, shown.Maximized is { } filling && filling != index);
            var group = shown.Groups[index];
            if (maximized)
            {
                group = group with { Box = new DockBox(0, 0, 100, 100) };
            }

            slots.Add(new GroupSlot($"group-{index}", index, group, maximized, covered));
            foreach (var id in group.Panels)
            {
                var panel = Panel(id)!;
                var showing = id == group.Active && !covered;
                if (showing || (panel.KeepAlive && _rendered.Contains(id)))
                {
                    slots.Add(new PanelSlot($"panel-{id}", panel, index, group.Box, showing));
                }
            }

            if (index < shown.Separators.Count && shown.Maximized is null)
            {
                var separator = shown.Separators[index];
                slots.Add(new SeparatorSlot($"separator-{index}", index, separator, group.Active));
            }
        }

        // A panel shows in a browser window of its own only while it is alone in a window of the layout. One the
        // app took away, or that may no longer be in a window, goes back where it was; one the layout has moved is
        // where the app or the user put it.
        foreach (var id in _popped.Where(id => _layout.FloatOf(id) is not { Group.Panels.Count: 1 }).ToList())
        {
            _popped.Remove(id);
            _homes.Remove(id);
        }

        foreach (var id in _popped.Where(id => !CanPopOut(id)).ToList())
        {
            _popped.Remove(id);
            _goingHome.Add(id);
        }

        _landed.IntersectWith(_popped);
        var windows = WindowKeys(shown.Floats);
        for (var layer = 0; layer < shown.Floats.Count; layer++)
        {
            // Windows are numbered after the docked groups, oldest first.
            var (window, key) = (shown.Floats[layer], windows[layer]);
            var index = shown.Groups.Count + _windows.FindIndex(each => each.Key == key);
            if (_popped.Contains(window.Active))
            {
                // Its row and its grip aren't drawn until it comes back, and the layout keeps its box.
                slots.Add(new PanelSlot($"panel-{window.Active}", Panel(window.Active)!, index, window.Box, true,
                    Popped: true));
                continue;
            }

            slots.Add(new GroupSlot(key, index, window, false, false, layer));
            foreach (var id in window.Panels)
            {
                var panel = Panel(id)!;
                var showing = id == window.Active;
                if (showing || (panel.KeepAlive && _rendered.Contains(id)))
                {
                    slots.Add(new PanelSlot($"panel-{id}", panel, index, window.Box, showing, layer));
                }
            }

            if (RendererInfo.IsInteractive)
            {
                slots.Add(new WindowGripSlot($"{key}-grip", index, window.Box, layer, Panel(window.Active)!.Title));
            }
        }

        // A slid-out panel is drawn as a window with one tab, in front of the windows and numbered after them. The
        // strips' other panels share its number and stay hidden where they are.
        var (strip, front) = (shown.Groups.Count + _windows.Count, shown.Floats.Count);
        _strips = shown.Strips;
        foreach (var hidden in shown.Strips)
        {
            var panel = Panel(hidden.Panel)!;
            if (shown.Revealed is { } revealed && revealed.Active == hidden.Panel)
            {
                slots.Add(new GroupSlot("revealed", strip, revealed, false, false, front, hidden.Edge));
                slots.Add(new PanelSlot($"panel-{hidden.Panel}", panel, strip, revealed.Box, true, front, hidden.Edge));
                slots.Add(new SlideSeparatorSlot("revealed-edge", strip, hidden, revealed.Box, front, panel.Title));
            }
            else if (panel.KeepAlive && _rendered.Contains(hidden.Panel))
            {
                slots.Add(new PanelSlot($"panel-{hidden.Panel}", panel, strip, hidden.Box, false, front));
            }
        }

        _rendered = slots.OfType<PanelSlot>().Select(slot => slot.Panel.Name).ToHashSet();
        var keys = slots.ToDictionary(slot => slot.Key);
        _order.RemoveAll(key => !keys.ContainsKey(key));
        _order.AddRange(slots.Select(slot => slot.Key).Except(_order).ToList());
        return _order.ConvertAll(key => keys[key]);
    }

    // A key for each window that shows, in the windows' order: the key of a window that held one of its panels at
    // the last render, or a new one.
    private List<string> WindowKeys(IReadOnlyList<DockGroupBox> floats)
    {
        var keys = new List<string>();
        foreach (var window in floats)
        {
            var known = _windows.FindIndex(each => each.Panels.Overlaps(window.Panels) && !keys.Contains(each.Key));
            keys.Add(known < 0 ? $"window-{++_windowsMade}" : _windows[known].Key);
        }

        _windows = [.. _windows.Select(each => each.Key).Where(keys.Contains).Concat(keys).Distinct()
            .Select(key => (key, floats[keys.IndexOf(key)].Panels.ToHashSet()))];
        return keys;
    }

    private async Task SelectAsync(string panel)
    {
        try
        {
            var showed = _front;
            if (IsDocked(panel))
            {
                _front = panel;
            }

            if (_layout.GroupOf(panel) is { } group && group.Active != panel)
            {
                await ChangeAsync(_layout.Open(panel), "select");
            }
            else if (_compact && _front != showed)
            {
                // Its own group showed the panel already, so the layout stays as it is.
                Telemetry.Used(TelemetryName, "select");
            }

            // A compact dock brings a panel to the front without a new layout.
            FollowActive();
            await ReportActiveMovedAsync();
        }
        finally
        {
            _commits++;
        }
    }

    // A press on a tab's mark, or Close in the tab's own menu, leaves the focus where it was, so the script says
    // whether the tab or its panel holds it.
    private async Task CloseFromTabAsync(string panel) => await CloseAsync(panel,
        _handle is not null && await _handle.InvokeAsync<bool>("holdsFocus", TabId(panel)));

    // The focus the closed tab or its panel held goes to a neighbor, to a button on its strip or a tab that shows, or
    // to the dock when none is left.
    private async Task CloseAsync(string panel, bool focused)
    {
        try
        {
            // The answer can take a while, and the panel can have gone by another way meanwhile, or the whole dock.
            if (Panel(panel) is { Closable: true } closing && InLayout(panel) && await MayCloseAsync(closing)
                && !_disposed && InLayout(panel))
            {
                var button = StripAfterClosing(panel);
                // When the closed panel was on a strip and no other button is left there, a tab that shows takes the
                // focus.
                var tab = TabAfterClosing(panel)
                    ?? (button is null && _layout.StripOf(panel) is not null ? FirstShowingTab() : null);
                _focusAfterRender = focused ? tab : null;
                _focusStripAfterRender = focused && tab is null ? button : null;
                _focusDockAfterRender = focused && tab is null && button is null;
                await ChangeAsync(_layout.Close(panel), "close");
            }
        }
        finally
        {
            _commits++;
        }
    }

    private bool InLayout(string panel) => _layout.GroupOf(panel) is not null || _layout.StripOf(panel) is not null;

    // A second request to close a panel is dropped while its CanClose is being answered.
    private async Task<bool> MayCloseAsync(TbDockPanel panel)
    {
        if (panel.CanClose is not { } canClose)
        {
            return true;
        }

        if (!_asked.Add(panel.Name))
        {
            return false;
        }

        try
        {
            return await canClose();
        }
        finally
        {
            _asked.Remove(panel.Name);
        }
    }

    // What screen readers hear after a tab's name: its TabEnd content, then that it is modified and how to close it.
    private string? TabHints(string id, TbDockPanel panel)
    {
        var hints = new[]
        {
            panel.TabEnd is null ? null : TabEndId(id), panel.Modified ? _modifiedHintId : null,
            panel.Closable ? _closeHintId : null,
        }.OfType<string>().ToList();
        return hints.Count == 0 ? null : string.Join(' ', hints);
    }

    // Prefixes that no other id here uses, so a panel whose id has a hyphen can't take another's.
    private string TitleId(string panel) => $"{_id}-title-{panel}";

    private string TabEndId(string panel) => $"{_id}-end-{panel}";

    // The showing tab of the group that fills the dock, which covers the others, or else of the first group or window.
    private string? FirstShowingTab()
    {
        var shown = Shown();
        return shown.Maximized is { } filling ? shown.Groups[filling].Active
            : shown.Groups.Concat(InDock(shown.Floats)).FirstOrDefault()?.Active;
    }

    // The windows that show in the dock, which a panel in a browser window of its own doesn't: it has no tab there.
    private IEnumerable<DockGroupBox> InDock(IEnumerable<DockGroupBox> windows) =>
        windows.Where(window => !_popped.Contains(window.Active));

    // The button that takes focus from a closed panel that was on a strip: the next one on its strip, or else the
    // one before it.
    private string? StripAfterClosing(string panel)
    {
        if (_layout.StripOf(panel) is not { } closing)
        {
            return null;
        }

        var strip = Shown().Strips.Where(each => each.Edge == closing.Edge).Select(each => each.Panel).ToList();
        var at = strip.IndexOf(panel);
        return strip.ElementAtOrDefault(at + 1) ?? strip.ElementAtOrDefault(at - 1);
    }

    // The tab that takes focus from a closed one: the next tab of its group, or else the one before it; with the
    // group gone, the tab showing in the next group, or else in the one before, or else in the group that fills the
    // dock when it covers every neighbor. A tab that wasn't showing gives the focus to its group's showing tab, the
    // row's one tab stop.
    private string? TabAfterClosing(string panel)
    {
        var shown = Shown();
        var groups = shown.Groups.Concat(shown.Floats).ToList();
        var index = groups.FindIndex(group => group.Panels.Contains(panel));
        if (index < 0)
        {
            return null;
        }

        if (groups[index].Active != panel)
        {
            return groups[index].Active;
        }

        var tabs = groups[index].Panels.ToList();
        var at = tabs.IndexOf(panel);
        if ((tabs.ElementAtOrDefault(at + 1) ?? tabs.ElementAtOrDefault(at - 1)) is { } beside)
        {
            return beside;
        }

        // The group goes with its last tab, and a group that the maximized one covers can't take the focus.
        var after = Shown(_layout.Close(panel), out _);
        var reachable = (after.Maximized is { } filling ? after.Groups.Skip(filling).Take(1) : after.Groups)
            .Concat(InDock(after.Floats)).Select(group => group.Active).ToList();
        return new[] { groups.ElementAtOrDefault(index + 1)?.Active, groups.ElementAtOrDefault(index - 1)?.Active }
            .FirstOrDefault(tab => tab is not null && reachable.Contains(tab)) ?? reachable.FirstOrDefault();
    }

    // A move from a menu keeps the focus on the moved panel's tab, wherever the tab is drawn now, and says where the
    // panel went.
    private async Task MoveAsync(string panel, DockLayout layout, string action = "move")
    {
        try
        {
            if (!layout.Equals(_layout))
            {
                // Read before the app's LayoutChanged runs, since the app may take the panel away in it.
                var title = Panel(panel)!.Title;
                var group = Shown(layout, out _).Groups.ToList().FindIndex(each => each.Panels.Contains(panel));
                _focusAfterRender = panel;
                // A moved tab shows where it lands, in a compact dock too, where its own group may have shown it
                // already behind another group's panel.
                _front = group >= 0 ? panel : _front;
                await ChangeAsync(layout, action);
                // A panel that isn't in a docked group now is in a window.
                Announcer.Polite(group < 0 ? Format(Labels.Floated, TbStrings.DockFloated, title)
                    : Format(Labels.Moved, TbStrings.DockMoved, title, group + 1));
            }
        }
        finally
        {
            _commits++;
        }
    }

    private Task MoveAsync(string panel, string target, DockPosition position) =>
        MoveAsync(panel, _layout.Move(panel, target, position));

    private Task MoveAsync(string panel, DockPosition edge) => MoveAsync(panel, _layout.MoveToEdge(panel, edge));

    // Has the group of a panel fill the dock, or shows every group again. The focus goes to the group's showing
    // tab, the row's one tab stop, since the button that restores goes away with the click.
    private async Task MaximizeAsync(string panel, bool maximize)
    {
        try
        {
            var groups = Shown().Groups.ToList();
            var group = groups.FindIndex(each => each.Panels.Contains(panel));
            var layout = !maximize ? _layout.Restore()
                : group >= 0 && groups.Count > 1 ? _layout.Maximize(panel) : _layout;
            if (!layout.Equals(_layout))
            {
                _focusAfterRender = maximize || group < 0 ? panel : groups[group].Active;
                await ChangeAsync(layout, maximize ? "maximize" : "restore");
                Announcer.Polite(maximize ? Format(Labels.Maximized, TbStrings.DockMaximized, group + 1)
                    : Labels.Restored ?? Localizer[TbStrings.DockRestored]);
            }
        }
        finally
        {
            _commits++;
        }
    }

    // The script moves the separator as its keys do, so no group gets smaller than MinGroupSize.
    private async Task StepAsync(int separator, int percent)
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("step", separator, percent);
        }
    }

    // The script moves the slid-out panel's inner edge as its keys do, so the panel stays within its limits.
    private async Task StepSlideAsync(int percent)
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("stepSlide", percent);
        }
    }

    // The script takes this tenth-of-the-dock step, as it does the arrow keys' smaller ones, so the window stays
    // inside the dock and no smaller than a group may be.
    private async Task StepWindowAsync(int window, string step)
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("stepWindow", window, step);
        }
    }

    // The single steps of a window's Move menu and of its grip's, each with a name for the script and for tests.
    private IEnumerable<(string Name, string Text)> MoveSteps() =>
    [
        ("left", Labels.Left ?? Localizer[TbStrings.DockLeft]),
        ("right", Labels.Right ?? Localizer[TbStrings.DockRight]),
        ("up", Labels.Up ?? Localizer[TbStrings.DockUp]),
        ("down", Labels.Down ?? Localizer[TbStrings.DockDown]),
    ];

    private IEnumerable<(string Name, string Text)> SizeSteps() =>
    [
        ("wider", Labels.Wider ?? Localizer[TbStrings.DockWider]),
        ("narrower", Labels.Narrower ?? Localizer[TbStrings.DockNarrower]),
        ("taller", Labels.Taller ?? Localizer[TbStrings.DockTaller]),
        ("shorter", Labels.Shorter ?? Localizer[TbStrings.DockShorter]),
    ];

    // The button and the two steps of a grip's menu, on a separator and on a slid-out panel's edge.
    private RenderFragment<MenuTrigger> GripButton(string name) => context => __builder =>
    {
        <TbIconButton Icon="BuiltInIcons.DragHandle" Size="Size.Small"
                      AriaLabel="@Format(Labels.SizeMenu, TbStrings.DockSizeMenu, name)"
                      @attributes="context.Attributes" tabindex="-1" />
    };

    private RenderFragment GripSteps(string name, Func<int, Task> step) => __builder =>
    {
        <TbMenuItem data-step="larger" OnClick="() => step(10)">
            @Format(Labels.Larger, TbStrings.DockLarger, name)
        </TbMenuItem>
        <TbMenuItem data-step="smaller" OnClick="() => step(-10)">
            @Format(Labels.Smaller, TbStrings.DockSmaller, name)
        </TbMenuItem>
    };

    // What a group's menu, and the context menu of its tabs, offer for one of the group's panels.
    private RenderFragment MenuItems(GroupSlot group, string panel, List<GroupSlot> others,
        Func<string, Task> close) => __builder =>
    {
        var tabs = group.Box.Panels;
        var canMaximize = CanMaximize(group, others);
        @if (!Locked)
        {
            @MoveItems(group, panel, others)
        }
        @if (tabs.Count > 1)
        {
            @* A row with too many tabs scrolls sideways, so the menu lists them all. *@
            <TbSubMenu Label="@(Labels.GoToTab ?? Localizer[TbStrings.DockGoToTab])">
                @foreach (var each in tabs)
                {
                    <TbMenuItem @key="each" data-go-to="@each" OnClick="() => SelectAsync(each)">
                        @Panel(each)!.Title
                    </TbMenuItem>
                }
            </TbSubMenu>
        }
        @if (group.Maximized)
        {
            <TbMenuItem data-move="restore" OnClick="() => MaximizeAsync(panel, false)">
                @(Labels.Restore ?? Localizer[TbStrings.DockRestore])
            </TbMenuItem>
        }
        else if (canMaximize)
        {
            <TbMenuItem data-move="maximize" OnClick="() => MaximizeAsync(panel, true)">
                @(Labels.Maximize ?? Localizer[TbStrings.DockMaximize])
            </TbMenuItem>
        }
        @if (Panel(panel)!.Closable)
        {
            @if (!Locked || tabs.Count > 1 || group.Maximized || canMaximize)
            {
                <TbMenuSeparator />
            }
            <TbMenuItem data-move="close" OnClick="() => close(panel)">
                @(Labels.Close ?? Localizer[TbStrings.DockClose])
            </TbMenuItem>
        }
    };

    // Whether the menu for one of a group's panels has anything to offer: a locked dock can leave it empty.
    private bool HasMenu(GroupSlot group, string panel, List<GroupSlot> others) => !Locked || group.Box.Panels.Count > 1
        || group.Maximized || CanMaximize(group, others) || Panel(panel)!.Closable;

    private static bool CanMaximize(GroupSlot group, List<GroupSlot> others) =>
        group.Layer is null && others.Any(each => each.Layer is null);

    // The items that move a panel, which a locked dock leaves out.
    private RenderFragment MoveItems(GroupSlot group, string panel, List<GroupSlot> others) => __builder =>
    {
        var tabs = group.Box.Panels;
        var at = tabs.TakeWhile(each => each != panel).Count();
        var sibling = tabs.FirstOrDefault(each => each != panel);
        <TbMenuItem Disabled="at == 0" data-move="back"
                    OnClick="() => MoveAsync(panel, tabs[at - 1], DockPosition.Before)">
            @(Labels.MoveTabBack ?? Localizer[TbStrings.DockMoveTabBack])
        </TbMenuItem>
        <TbMenuItem Disabled="at == tabs.Count - 1" data-move="forward"
                    OnClick="() => MoveAsync(panel, tabs[at + 1], DockPosition.After)">
            @(Labels.MoveTabForward ?? Localizer[TbStrings.DockMoveTabForward])
        </TbMenuItem>
        @if (others.Count > 0)
        {
            <TbSubMenu Label="@(Labels.MoveToGroup ?? Localizer[TbStrings.DockMoveToGroup])">
                @foreach (var other in others)
                {
                    var last = other.Box.Panels[^1];
                    <TbMenuItem @key="other.Index" data-move-group="@(other.Index + 1)"
                                OnClick="() => MoveAsync(panel, last, DockPosition.After)">
                        @Format(Labels.GroupItem, TbStrings.DockGroupItem, other.Index + 1,
                            Panel(other.Box.Active)!.Title)
                    </TbMenuItem>
                }
            </TbSubMenu>
        }
        @* A compact dock shows one group, so a new one would show nowhere. *@
        @if (sibling is not null && group.Layer is null && !_compact)
        {
            <TbSubMenu Label="@(Labels.NewGroup ?? Localizer[TbStrings.DockNewGroup])">
                @foreach (var (position, label, text) in Sides(edge: false))
                {
                    <TbMenuItem @key="position" data-move-beside="@label"
                                OnClick="() => MoveAsync(panel, sibling, position)">
                        @text
                    </TbMenuItem>
                }
            </TbSubMenu>
        }
        @if (!_compact && (sibling is not null || group.Layer is not null || others.Any(each => each.Layer is null)))
        {
            <TbSubMenu Label="@(Labels.NewGroupAtEdge ?? Localizer[TbStrings.DockNewGroupAtEdge])">
                @foreach (var (position, label, text) in Sides(edge: true))
                {
                    <TbMenuItem @key="position" data-move-edge="@label" OnClick="() => MoveAsync(panel, position)">
                        @text
                    </TbMenuItem>
                }
            </TbSubMenu>
        }
        <TbSubMenu Label="@(Labels.AutoHide ?? Localizer[TbStrings.DockAutoHide])">
            @foreach (var (position, label, text) in Sides(edge: true))
            {
                @if (position != group.Edge)
                {
                    <TbMenuItem @key="position" data-move-hide="@label"
                                OnClick="() => AutoHideAsync(panel, position)">
                        @text
                    </TbMenuItem>
                }
            }
        </TbSubMenu>
        @if (CanPopOut(panel))
        {
            @* The script opens the window in the click, and keeps it for this panel until the dock asks for it. *@
            <TbMenuItem data-move="pop-out" data-pop="@PanelId(panel)" data-pop-panel="@panel"
                        OnClick="() => PopOutAsync(panel)">
                @(Labels.PopOut ?? Localizer[TbStrings.DockPopOut])
            </TbMenuItem>
        }
        @* A panel alone in its window has a window to itself already. *@
        @if (group.Layer is null || sibling is not null || group.Edge is not null)
        {
            <TbMenuItem data-move="float" OnClick="() => MoveAsync(panel, _layout.Float(panel), FloatAction)">
                @(Labels.Float ?? Localizer[TbStrings.DockFloat])
            </TbMenuItem>
        }
        @if (group.Layer is not null)
        {
            @* Close then Open docks it the way Open docks a panel the layout doesn't hold: as the showing tab of
               the largest group. *@
            <TbMenuItem data-move="dock"
                        OnClick="() => MoveAsync(panel, _layout.Close(panel).Open(panel), DockAction)">
                @(Labels.Dock ?? Localizer[TbStrings.DockDock])
            </TbMenuItem>
        }
    };

    // The four sides a panel's new group can go to, each with a name for tests and its menu text. Beside a group they
    // read Above and Below; along the dock's edge, At the top and At the bottom.
    private IEnumerable<(DockPosition Position, string Name, string Text)> Sides(bool edge) =>
    [
        (DockPosition.Start, "start", Labels.AtStart ?? Localizer[TbStrings.DockAtStart]),
        (DockPosition.End, "end", Labels.AtEnd ?? Localizer[TbStrings.DockAtEnd]),
        (DockPosition.Top, "top", edge ? Labels.AtTop ?? Localizer[TbStrings.DockAtTop]
            : Labels.Above ?? Localizer[TbStrings.DockAbove]),
        (DockPosition.Bottom, "bottom", edge ? Labels.AtBottom ?? Localizer[TbStrings.DockAtBottom]
            : Labels.Below ?? Localizer[TbStrings.DockBelow]),
    ];

    // The strip along one edge of the dock: a button for each panel put away there, which slides its panel out over
    // the dock and back.
    private RenderFragment Strip(DockPosition edge) => __builder =>
    {
        var hidden = _strips.Where(each => each.Edge == edge).ToList();
        if (hidden.Count > 0)
        {
            var (_, name, side) = Sides(edge: true).First(each => each.Position == edge);
            <div role="group" data-part="strip" data-edge="@name"
                 aria-label="@Format(Labels.Strip, TbStrings.DockStrip, side)"
                 class="@($"tb-dock__strip tb-dock__strip--{name}")">
                @foreach (var each in hidden)
                {
                    var (id, panel) = (each.Panel, Panel(each.Panel)!);
                    <button @key="id" @ref="_stripButtons[id]" type="button" id="@($"{_id}-strip-{id}")"
                            data-part="strip-button" data-panel="@id"
                            aria-expanded="@(_layout.Revealed == id ? "true" : "false")"
                            aria-controls="@(_rendered.Contains(id) ? PanelId(id) : null)"
                            aria-describedby="@(panel.Modified ? _modifiedHintId : null)"
                            data-modified="@(panel.Modified ? "" : null)"
                            class="tb-dock__strip-button" @onclick="() => ToggleRevealAsync(id)">
                        @if (panel.Icon is { } icon)
                        {
                            <TbIcon Icon="icon" Size="Size.Small" data-part="icon" />
                        }
                        <span data-part="title" class="tb-dock__title">@panel.Title</span>
                        @if (panel.Modified)
                        {
                            <span data-part="modified" aria-hidden="true" class="tb-dock__modified"></span>
                        }
                    </button>
                }
            </div>
        }
    };

    // Shows a panel in the browser window that the script opened as the menu's item was clicked. The panel first
    // gets a floating window of its own in the layout, which keeps a place for it until it goes back where it was.
    private async Task PopOutAsync(string panel)
    {
        try
        {
            await ChangeAsync(FloatedForItsWindow(panel), PopOutAction);
        }
        finally
        {
            _commits++;
        }
    }

    // Marks the panel as on its way to a browser window, and gives the layout that floats it alone meanwhile.
    private DockLayout FloatedForItsWindow(string panel)
    {
        var alone = _layout.FloatOf(panel) is { Group.Panels.Count: 1 };
        var floated = alone ? _layout : _layout.Float(panel);
        if (!alone)
        {
            _homes[panel] = (_layout, floated, _turns++);
        }

        _popped.Add(panel);
        _popOutAfterRender.Add(panel);
        return floated;
    }

    // Tells the script which panels show in browser windows of their own, after the render that draws them so.
    private async Task ShowPoppedAsync()
    {
        // The last to go is the first back: its layout is the one the dock has, so each finds the layout it left.
        foreach (var gone in _goingHome.OrderByDescending(id => _homes.GetValueOrDefault(id).Turn).ToList())
        {
            _goingHome.Remove(gone);
            await GoHomeAsync(gone);
        }

        if (_layoutOwed)
        {
            _layoutOwed = false;
            await ChangeAsync(_layout, null);
        }

        if (_handle is null)
        {
            return;
        }

        foreach (var panel in _popOutAfterRender.ToList())
        {
            // A render that comes while the script answers for one panel takes the next, so each is asked for once.
            if (_popOutAfterRender.Remove(panel) && _popped.Contains(panel) && Panel(panel) is { } opened)
            {
                // The script hears of the panel in this call, so the panel counts in what the script was last told
                // from here on. When the panel is dropped while its window loads, the next list differs from that,
                // and the script, told so, closes the window.
                var id = PanelId(panel);
                _poppedInScript = [.. _poppedInScript.Union([id]).Order(StringComparer.Ordinal)];
                // The script answers with what went wrong, and with nothing when the panel is in its window. The
                // answer can take a moment: the panel waits for its window's style sheets. When the panel was asked
                // for again meanwhile, that ask answers for it, and this one's answer changes nothing.
                var wrong = await _handle.InvokeAsync<string?>("popOut", id);
                // The dock can have gone while the window loaded, as when the app goes to another page.
                if (_disposed)
                {
                    return;
                }

                if (wrong is null)
                {
                    Announcer.Polite(Format(Labels.PoppedOut, TbStrings.DockPoppedOut, opened.Title));
                    // The panel may have come back while its window loaded.
                    if (_popped.Contains(panel))
                    {
                        _landed.Add(panel);
                        StateHasChanged();
                    }
                }
                else if (wrong != "replaced" && _popped.Remove(panel))
                {
                    // The browser refused the window, the window closed before the panel got there, it closed because
                    // the dock asked too late, or no click opened one for this panel, so the panel goes back where it
                    // was. A refusal and a late ask are said; a window the user closed isn't, nor one never opened,
                    // which also leaves the focus where it is.
                    _focusAfterRender = wrong == "unasked" ? null : panel;
                    if (wrong == "blocked")
                    {
                        Announcer.Polite(Format(Labels.PopOutBlocked, TbStrings.DockPopOutBlocked, opened.Title));
                    }
                    else if (wrong == "lapsed")
                    {
                        Announcer.Polite(Format(Labels.PopOutLapsed, TbStrings.DockPopOutLapsed, opened.Title));
                    }

                    await GoHomeAsync(panel);
                    // The app can take its time over the layout it is handed, and the dock can go meanwhile.
                    if (_disposed)
                    {
                        return;
                    }

                    FocusStripIfStowed(panel);
                    StateHasChanged();
                }
            }
        }

        var popped = _popped.Select(PanelId).Order(StringComparer.Ordinal).ToArray();
        if (!popped.SequenceEqual(_poppedInScript))
        {
            _poppedInScript = popped;
            await _handle.InvokeVoidAsync("popped", popped, _keptWindows.Values);
        }

        // A kept window closes when its panel comes back unable to show in one, and when the dock stops allowing
        // windows. Each id leaves the list before the script is called, so a render that comes while the script
        // answers takes only those left, and none is closed twice.
        if (!AllowPopOut)
        {
            _unkept.AddRange(_keptWindows.Values.Select(window => window.Id));
            _keptWindows.Clear();
        }

        // The dock can go while its script answers, and then nothing more is asked of the script or told to the app.
        foreach (var id in _unkept.ToList())
        {
            if (!_disposed && _unkept.Remove(id))
            {
                await _handle.InvokeVoidAsync("unkeep", id);
            }
        }

        // The app is told here, after the window has opened or been refused, however the panel came back.
        if (!_disposed && PoppedOut is var away && !away.SequenceEqual(_poppedReported))
        {
            _poppedReported = [.. away];
            await PoppedOutChanged.InvokeAsync(away);
        }
    }

    // A return that starts on the page, from the panel's button there or from the app's code. The dock draws the
    // panel as its own before the script moves it, which loses its scroll positions, so the script notes them first.
    private async Task ReturnFromPageAsync(string panel, bool focus)
    {
        if (_landed.Contains(panel) && _handle is not null)
        {
            await _handle.InvokeVoidAsync("noteScrolls", PanelId(panel));
        }

        await ReturnAsync(panel, focus);
    }

    // A panel comes back from its browser window to where it was docked, or to the floating window it had to
    // itself: its Return button was pressed, which leaves the focus on its tab, or its browser window closed.
    private async Task ReturnAsync(string panel, bool focus)
    {
        if (_popped.Remove(panel) && Panel(panel) is { } back)
        {
            _focusAfterRender = focus ? panel : null;
            Telemetry.Used(TelemetryName, ReturnAction);
            Announcer.Polite(Format(Labels.Returned, TbStrings.DockReturned, back.Title));
            _commits++;
            await GoHomeAsync(panel);
            FocusStripIfStowed(panel);
            StateHasChanged();
        }
    }

    // A panel that went back to a strip has no tab to take the focus, so its button on the strip takes it.
    private void FocusStripIfStowed(string panel)
    {
        if (_focusAfterRender == panel && _layout.StripOf(panel) is not null && _layout.Revealed != panel)
        {
            (_focusAfterRender, _focusStripAfterRender) = (null, panel);
        }
    }

    // Puts a panel that no longer shows in a browser window of its own back where it was before it floated for
    // that window, as near as the layout still allows, and tells the app.
    private async Task GoHomeAsync(string panel)
    {
        if (!_homes.Remove(panel, out var home))
        {
            return;
        }

        // A panel that went after this one left a layout in which this one floated, which isn't where this one
        // is now, so the layout it goes back to is one with this panel docked again.
        foreach (var (other, later) in _homes.Where(each => each.Value.Turn > home.Turn).ToList())
        {
            _homes[other] = (later.Before.Redocked(panel, home.Before, home.Floated), later.Floated, later.Turn);
        }

        if (_layout.FloatOf(panel) is { Group.Panels.Count: 1 }
            && _layout.Redocked(panel, home.Before, home.Floated) is var docked && !docked.Equals(_layout))
        {
            await ChangeAsync(docked, null);
            StateHasChanged();
        }
    }

    // Puts a panel away on a strip, with the focus on its button there, and says where it went.
    private async Task AutoHideAsync(string panel, DockPosition edge)
    {
        try
        {
            // Read before the app's LayoutChanged runs, since the app may take the panel away in it.
            var title = Panel(panel)!.Title;
            _focusStripAfterRender = panel;
            await ChangeAsync(_layout.AutoHide(panel, edge), AutoHideAction);
            Announcer.Polite(Format(Labels.AutoHidden, TbStrings.DockAutoHidden, title));
        }
        finally
        {
            _commits++;
        }
    }

    // A dragged tab or strip button was dropped on a strip, which puts its panel away there.
    private async Task AutoHideFromScriptAsync(string panel, string edge)
    {
        // A drop the dock can't use, in a locked dock, for a panel it doesn't have or a name that isn't one of the four
        // edges, keeps the layout and still counts.
        if (!Locked && Panel(panel) is not null && Enum.TryParse<DockPosition>(edge, ignoreCase: true, out var where)
            && where is DockPosition.Start or DockPosition.End or DockPosition.Top or DockPosition.Bottom)
        {
            await AutoHideAsync(panel, where);
        }
        else
        {
            _commits++;
        }

        StateHasChanged();
    }

    // A strip's button slides its panel out, with the focus on the panel's tab, and slides it back.
    private async Task ToggleRevealAsync(string panel)
    {
        try
        {
            if (_layout.Revealed == panel)
            {
                await ChangeAsync(_layout.Conceal(), null);
            }
            else
            {
                _focusAfterRender = panel;
                await ChangeAsync(_layout.Open(panel), RevealAction);
            }
        }
        finally
        {
            _commits++;
        }
    }

    // The script moved the inner edge of the slid-out panel.
    private async Task SlideFromScriptAsync(string panel, double size, int report)
    {
        // Set first, as for a separator, so the render that the app's LayoutChanged brings carries the number.
        _reported = report;
        try
        {
            // Rounded as the panel's style is, so a step at a limit reports the size the layout has.
            var layout = _layout.ResizeAutoHidden(panel, Round(size));
            if (!layout.Equals(_layout))
            {
                await ChangeAsync(layout, ResizeAutoHiddenAction);
            }
        }
        finally
        {
            _commits++;
            StateHasChanged();
        }
    }

    // Escape in a slid-out panel slides it back and returns the focus to its button. A press or the focus anywhere
    // else slides it back too, leaves the focus where it went and, like a window coming forward, isn't counted.
    private async Task ConcealFromScriptAsync(bool escaped)
    {
        if (_layout.Revealed is not { } panel)
        {
            return;
        }

        try
        {
            _focusStripAfterRender = escaped ? panel : null;
            await ChangeAsync(_layout.Conceal(), null);
        }
        finally
        {
            _commits += escaped ? 1 : 0;
            StateHasChanged();
        }
    }

    private async Task ChangeAsync(DockLayout layout, string? action)
    {
        Follow(layout);
        _layout = layout;
        if (action is not null)
        {
            Telemetry.Used(TelemetryName, action);
        }

        await LayoutChanged.InvokeAsync(layout);
        await SaveAsync();
        FollowActive();
        await ReportActiveMovedAsync();
    }

    // Keeps ActivePanel on the showing panel of its group as the dock shows it, which in a compact dock is the one
    // group of every docked panel. When the active panel leaves the groups, the showing panel of the group that held
    // it takes its place.
    private void FollowActive()
    {
        if (_active is null)
        {
            return;
        }

        var shown = Shown();
        var groups = shown.Groups.Concat(shown.Floats).Append(shown.Revealed).OfType<DockGroupBox>().ToList();
        var group = groups.FirstOrDefault(each => each.Panels.Contains(_active))
            ?? groups.FirstOrDefault(each => each.Panels.Any(_activeGroup.Contains));
        _activeGroup = group is null ? [] : [.. group.Panels];
        if (group?.Active != _active)
        {
            _active = group?.Active;
            _activeMoved = true;
        }
    }

    private async Task ReportActiveMovedAsync()
    {
        if (_activeMoved)
        {
            _activeMoved = false;
            await ActivePanelChanged.InvokeAsync(_active);
        }
    }

    private async Task SetActiveAsync(string panel)
    {
        if (panel != _active)
        {
            _active = panel;
            _activeGroup = [];
            _activeMoved = true;
            FollowActive();
            await ReportActiveMovedAsync();
        }
    }

    private async Task EngageFromScriptAsync(string panel)
    {
        if (Panel(panel) is not null)
        {
            await SetActiveAsync(panel);
            StateHasChanged();
        }
    }

    // A press or the focus went into a window that isn't in front. Which window is in front is part of the layout,
    // though coming forward isn't counted as use or as a finished action.
    private async Task RaiseFromScriptAsync(string panel)
    {
        var layout = _layout.Raise(panel);
        if (!ReferenceEquals(layout, _layout))
        {
            await ChangeAsync(layout, null);
            StateHasChanged();
        }
    }

    // The dock got narrower than CompactBelow, or wide enough again. Focused is the panel whose tab holds the focus, or
    // that holds it inside, which stays in front. The tabs are drawn anew in the one row, or back in their groups'
    // rows, so a tab that held the focus takes it again.
    private Task OnNarrowAsync(bool narrow, string? focused, bool onTab)
    {
        _narrow = narrow;
        if (focused is not null && IsDocked(focused))
        {
            _front = focused;
            _focusAfterRender = onTab ? focused : _focusAfterRender;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    // The script's calls arrive outside Blazor's events, so the dock renders what they changed itself.
    private async Task SelectFromScriptAsync(string panel)
    {
        await SelectAsync(panel);
        StateHasChanged();
    }

    private async Task CloseFromScriptAsync(string panel, bool focused)
    {
        await CloseAsync(panel, focused);
        StateHasChanged();
    }

    // A dragged tab or strip button was dropped beside the target panel, or along an edge of the dock when there is
    // no target.
    private async Task MoveFromScriptAsync(string panel, string? target, string position)
    {
        // A drop the dock can't use keeps the layout: one in a locked dock, a panel or a place it doesn't have, or an
        // edge given Before or After. It still counts as a move that changed nothing, so a test that waits for the
        // drop goes on.
        var layout = _layout;
        if (!Locked && Panel(panel) is not null && Enum.TryParse<DockPosition>(position, out var where)
            && Enum.IsDefined(where))
        {
            layout = target is not null ? _layout.Move(panel, target, where)
                : where is DockPosition.Before or DockPosition.After ? _layout : _layout.MoveToEdge(panel, where);
        }

        await MoveAsync(panel, layout);
        StateHasChanged();
    }

    // A dragged tab was dropped on the middle of its own group, which pulls its panel out into a window there.
    private async Task PullOutFromScriptAsync(string panel, DockBox box)
    {
        // Rounded as a window's style is. A locked dock, or a panel the dock doesn't have, keeps the layout, as any
        // other drop does.
        await MoveAsync(panel, Locked || Panel(panel) is null ? _layout
            : _layout.FloatAt(panel, Round(box.X), Round(box.Y), Round(box.Width), Round(box.Height)), FloatAction);
        StateHasChanged();
    }

    // A tab was double-clicked: its group fills the dock or, when it already does, every group shows again.
    private async Task ToggleMaximizedFromScriptAsync(string panel)
    {
        var shown = Shown();
        await MaximizeAsync(panel,
            !(shown.Maximized is { } filling && shown.Groups[filling].Panels.Contains(panel)));
        StateHasChanged();
    }

    // The script moved or resized the window that holds the panel.
    private async Task OnFloatAsync(string panel, DockBox box, bool resized, int report)
    {
        // Set first, as for a separator, so the render that the app's LayoutChanged brings carries the number.
        _reported = report;
        try
        {
            // Rounded as the window's style is, so a step that changes nothing reports the box the layout has.
            var layout = _layout.MoveWindow(panel, Round(box.X), Round(box.Y), Round(box.Width), Round(box.Height));
            if (!layout.Equals(_layout))
            {
                await ChangeAsync(layout, resized ? "resize_window" : "move_window");
                // The layout keeps a box inside the dock, whatever was reported.
                var kept = layout.FloatOf(panel)!;
                Announcer.Polite(resized
                    ? Format(Labels.ResizedWindow, TbStrings.DockResizedWindow, Whole(kept.Width), Whole(kept.Height))
                    : Format(Labels.MovedWindow, TbStrings.DockMovedWindow, Whole(kept.X), Whole(kept.Y)));
            }
        }
        finally
        {
            _commits++;
            StateHasChanged();
        }
    }

    private async Task OnResizeAsync(int index, double fraction, int report)
    {
        // Set first, so the render that the app's LayoutChanged brings carries the number along with the sizes. The
        // script would otherwise show those sizes for a moment in place of a later move's.
        _reported = report;
        try
        {
            if (Shown().Separators.ElementAtOrDefault(index) is { } separator && fraction is > 0 and < 1)
            {
                await ChangeAsync(_layout.Resize(separator.Split, separator.Before, separator.After, fraction),
                    "resize");
            }
        }
        finally
        {
            _commits++;
            StateHasChanged();
        }
    }

    // A separator is a line along the edge its two parts share.
    private static DockBox Line(DockSeparatorBox separator) => separator.Split.Vertical
        ? separator.BeforeBox with { Y = separator.AfterBox.Y, Height = 0 }
        : separator.BeforeBox with { X = separator.AfterBox.X, Width = 0 };

    // The share that the part before a separator has of what it and the part after hold together.
    private static double Fraction(DockSeparatorBox separator)
    {
        var before = separator.Split.Children[separator.Before].Size;
        return before / (before + separator.Split.Children[separator.After].Size);
    }

    // A window's layer sets how high it draws among the windows.
    private static string BoxStyle(DockBox box, int? layer = null) => string.Create(CultureInfo.InvariantCulture,
        $"--tb-dock-x: {Round(box.X)}; --tb-dock-y: {Round(box.Y)}; --tb-dock-w: {Round(box.Width)}; "
            + $"--tb-dock-h: {Round(box.Height)};{(layer is null ? "" : $" --tb-dock-z: {layer};")}");

    private static string BoxText(DockBox box) => string.Create(CultureInfo.InvariantCulture,
        $"{Round(box.X)} {Round(box.Y)} {Round(box.Width)} {Round(box.Height)}");

    private static double Round(double value) => Math.Round(value, 4);

    // Screen readers hear whole percentages, rounded as the script rounds them: a half goes up.
    private static string Whole(double value) =>
        Math.Round(value, MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture);

    // A window the script keeps open for a panel that is away: the panel's element id, what the window says, and
    // how long it stays, in milliseconds, or null for as long as the page does.
    private sealed record EmptyWindow(string Id, string Text, double? Lifetime);

    private string Format(string? label, string key, params object[] values) =>
        string.Format(CultureInfo.CurrentCulture, label ?? Localizer[key], values);

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // Cleared, so what checks for the script after the dock has gone, such as a save, finds none.
        if (_handle is { } handle)
        {
            _handle = null;
            await handle.DisposeHandleAsync();
        }

        _report?.Dispose();
    }
}
