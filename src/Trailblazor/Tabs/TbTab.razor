@namespace Trailblazor
@inherits TbComponentBase
@implements IDisposable

@* Marks the tab's place in the markup, which the tabs script reports so the headers can follow it. *@
<span hidden data-part="tab-anchor" data-tab="@TabId"></span>
@if (IsPanelRendered)
{
    <div @attributes="AttributesWithoutId" role="tabpanel" id="@PanelId" aria-labelledby="@TabId"
         tabindex="@(IsSelected ? 0 : null)" hidden="@PanelHidden" data-part="panel" class="@ClassNames.Join("tb-tabs__panel", Class)"
         style="@Style">
        @ChildContent
    </div>
}

@code {
    private readonly string _id = $"tb-tab-{Guid.NewGuid():N}";
    private bool _shown;
    private string? _text;
    private bool _disabled;
    private bool _closable;
    private string? _givenId;
    private string? _key;
    private string? _headerClass;
    private Icon? _icon;
    private RenderFragment? _header;
    private ControlTelemetry? _telemetry;

    /// <summary>The tab's label. Give this or <see cref="TextContent"/>.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Content for the tab's header in place of <see cref="Text"/>, such as a label with a count. It becomes
    /// the tab's accessible name, so keep it short and leave controls out of it.</summary>
    [Parameter]
    public RenderFragment? TextContent { get; set; }

    /// <summary>An icon before the header's text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Names the tab for <see cref="TbTabs.ActiveKey"/>, which selects it by this key rather than by its
    /// position. Keys must be unique within the tabs.</summary>
    [Parameter]
    public string? Key { get; set; }

    /// <summary>Turns this tab off while the others stay usable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when the user closes the tab, by its close mark or by Delete or Backspace while it has focus.
    /// With it, the tab shows a close mark; a disabled tab, or one on a static page, can't be closed. Remove the tab
    /// here to close it, and focus moves to the next enabled tab, or to the one before it when none follows. Keep
    /// rendering it to leave it open, such as after asking about unsaved work. With <see cref="TbTabs.ActiveKey"/>,
    /// closing the selected tab leaves none selected until you set another key.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Extra CSS classes for the tab's header, such as one marking a tab whose fields need attention.
    /// <c>Class</c> styles its panel. A class only changes how the header looks, so say what it means in the header's
    /// text too.
    /// </summary>
    [Parameter]
    public string? HeaderClass { get; set; }

    /// <summary>Raised each time the user clicks the tab's header, or presses Enter or Space on it, whether or not it
    /// was already selected. It is raised after the tab is selected. The arrow keys select tabs without raising
    /// it.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The panel shown while this tab is selected. Leave it out for tabs that only switch a view rendered
    /// elsewhere.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>A label this tab's use is counted under, such as <c>"billing-tab"</c>, so the app can count how often
    /// people see it and switch to it through the <c>Trailblazor</c> meter. Its header counts as shown when it renders,
    /// and as used each time the user selects the tab. It names what the tab holds, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [CascadingParameter]
    private TbTabs? Tabs { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    // A given id names the tab users click, rather than its panel.
    internal string TabId => GivenId ?? $"{_id}-tab";

    internal string PanelId => $"{_id}-panel";

    // Until the page is interactive, every panel renders, so the startup script and find-in-page can show any of them.
    internal bool IsPanelRendered => ChildContent is not null
        && (IsSelected || !RendererInfo.IsInteractive || Tabs!.RenderAllPanels || Tabs.KeepAlive && _shown);

    private object? PanelHidden => IsSelected ? null : RendererInfo.IsInteractive || Disabled ? true : "until-found";

    // TabHeader is internal, so Razor can't name it; the list renders it through this.
    internal RenderFragment HeaderContent => builder =>
    {
        builder.OpenComponent<TabHeader>(0);
        builder.AddComponentParameter(1, nameof(TabHeader.Tab), this);
        builder.CloseComponent();
    };

    internal TabHeader? HeaderView { get; set; }

    // The header button, which takes focus when a neighboring tab is closed.
    internal ElementReference Header { get; set; }

    // Closing needs the page to be interactive, so a static page shows no close mark.
    internal bool CanClose => OnClose.HasDelegate && !Disabled && RendererInfo.IsInteractive;

    // Closing counts as a use, as removing a chip does.
    internal Task CloseAsync()
    {
        Telemetry.Used(TelemetryName, "close");
        return Tabs!.CloseAsync(this);
    }

    private bool IsSelected => Tabs!.ActiveTab == this;

    internal void CountUse() => Telemetry.Used(TelemetryName);

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => Telemetry.Rendered(TelemetryName);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Tabs is null)
        {
            throw new InvalidOperationException($"{nameof(TbTab)} must be inside a {nameof(TbTabs)}.");
        }

        _text = Text;
        _disabled = Disabled;
        _closable = OnClose.HasDelegate;
        _key = Key;
        _headerClass = HeaderClass;
        _icon = Icon;
        _givenId = GivenId;
        Tabs.Add(this);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (TextContent is null && string.IsNullOrWhiteSpace(Text))
        {
            throw new InvalidOperationException($"{nameof(TbTab)} needs a {nameof(Text)} or a {nameof(TextContent)}.");
        }

        if (Key is null && Tabs!.SelectsByKey)
        {
            throw new InvalidOperationException(
                $"Every {nameof(TbTab)} needs a {nameof(Key)} when its {nameof(TbTabs)} has an ActiveKey.");
        }

        _shown |= IsSelected;
        if (Text != _text || Disabled != _disabled || Key != _key || HeaderClass != _headerClass || Icon != _icon
            || GivenId != _givenId || OnClose.HasDelegate != _closable)
        {
            _text = Text;
            _disabled = Disabled;
            _closable = OnClose.HasDelegate;
            _givenId = GivenId;
            _key = Key;
            _headerClass = HeaderClass;
            _icon = Icon;
            Tabs!.Refresh();
        }

        // A header that changes on its own would otherwise keep what the list drew before it changed.
        if (TextContent != _header)
        {
            _header = TextContent;
            HeaderView?.Refresh();
        }
    }

    /// <inheritdoc />
    public void Dispose() => Tabs?.Remove(this);
}
