@namespace Trailblazor
@using System.ComponentModel.DataAnnotations
@using System.Diagnostics.CodeAnalysis
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Validation
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IDisposable
@inject JsModuleLoader Modules
@inject IServiceProvider Services

@* The fields check themselves, so the browser's own validation bubbles are turned off. *@
<EditForm @attributes="FormAttributes" id="@Id" EditContext="_editContext" FormName="@FormName"
          OnSubmit="SubmitAsync" novalidate class="@ClassNames.Join("tb-form", Class)" style="@Style">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
</EditForm>
@Reporter

@code {
    private readonly List<IFormField> _fields = [];
    private readonly string _id = $"tb-form-{Guid.NewGuid():N}";
    private readonly object _noModel = new();
    private EditContext _editContext;
    private object? _model;
    private IDisposable? _annotations;
    private bool _focusError;
    // Whether IsValid or Errors may have changed since the last report.
    private bool _stale = true;
    // While a field's edit, a reset or a validation is under way, renders and the context's events hold their report
    // until it ends.
    private int _edits;
    private FormReporter? _reporter;
    // The model's own check from the last report, kept until a value may have changed.
    private bool? _modelPasses;
    private ControlTelemetry? _telemetry;
    private (bool Disabled, bool ReadOnly) _fieldState;

    /// <inheritdoc />
    public TbForm() => _editContext = new EditContext(_noModel);

    /// <summary>The form's fields and buttons, and any validators such as <c>DataAnnotationsValidator</c>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The object the fields edit, which validators check. Leave it and <see cref="EditContext"/> out for a
    /// form whose fields carry their own <c>Validation</c>.</summary>
    [Parameter]
    public object? Model { get; set; }

    /// <summary>The edit context to use instead of one made for <see cref="Model"/>.</summary>
    [Parameter]
    public EditContext? EditContext { get; set; }

    /// <summary>Validates the model's data annotations, as a <c>DataAnnotationsValidator</c> would, and counts them in
    /// <see cref="IsValid"/> before any message shows. Use it instead of adding the validator inside the form. When
    /// the app calls <c>AddValidation</c> and marks the model <c>[ValidatableType]</c>, both also check its nested
    /// objects.</summary>
    [Parameter]
    public bool DataAnnotations { get; set; }

    /// <summary>Names the form, so it posts as a static SSR form.</summary>
    [Parameter]
    public string? FormName { get; set; }

    /// <summary>Turns off every field in the form, as a field's own <c>Disabled</c> does: the fields can't be focused
    /// or changed, and they aren't posted. A field's own <c>Disabled</c> still applies while this is false.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Makes every field in the form read only, as a field's own <c>ReadOnly</c> does: their values can be
    /// read and copied, and still post, but not changed. A field's own <c>ReadOnly</c> still applies while this is
    /// false.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Whether the form would pass now: no <c>Required</c> field is empty, no field holds a number past its
    /// limits, every field's <c>Validation</c> passes, the model's data annotations pass when <see
    /// cref="DataAnnotations"/> is on, and no validator's message or field's <c>Error</c> is showing. It is worked out
    /// without showing any message and updates as the form changes, so it can drive a hint such as "Ready to send".
    /// Leave the submit button on, so a submit can show what to fix. Bind it with <c>@bind-IsValid</c>.</summary>
    [Parameter]
    public bool IsValid { get; set; }

    /// <summary>Raised when <see cref="IsValid"/> changes.</summary>
    [Parameter]
    public EventCallback<bool> IsValidChanged { get; set; }

    /// <summary>The messages the form is showing. Bind it with <c>@bind-Errors</c>.</summary>
    [Parameter]
    public IReadOnlyList<string> Errors { get; set; } = [];

    /// <summary>Raised when the messages the form is showing change.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> ErrorsChanged { get; set; }

    /// <summary>Raised on submit instead of the form validating; check it yourself with
    /// <see cref="ValidateAsync"/>. Focus stays where it is, so the handler can move it, for example to an error
    /// summary. The submit isn't counted under <see cref="TelemetryName"/>.</summary>
    [Parameter]
    public EventCallback<EditContext> OnSubmit { get; set; }

    /// <summary>Raised on submit when the form is valid.</summary>
    [Parameter]
    public EventCallback<EditContext> OnValidSubmit { get; set; }

    /// <summary>Raised on submit when the form isn't valid. Focus then moves to the first field with an error, once
    /// the fields have shown their messages.</summary>
    [Parameter]
    public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    /// <summary>Raised when the form resets, once its fields are back, so the app can reset anything else, such as a
    /// plain input. Use it instead of <c>onreset</c>, which the form takes for itself.</summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    /// <summary>A label this form's use is counted under, such as <c>"new-trail"</c>, so the app can see how often
    /// people submit it, and how often it fails, through the <c>Trailblazor</c> meter: counted in
    /// <c>trailblazor.control.shown</c> when it first renders, and in <c>trailblazor.form.submitted</c> with
    /// <c>trailblazor.outcome</c> <c>valid</c> or <c>invalid</c> on each submit it validates. On an invalid submit,
    /// each field with a <c>TelemetryName</c> and an error counts in <c>trailblazor.field.invalid</c>. No value is ever
    /// recorded. It names the form, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    private object Id => AdditionalAttributes?.GetValueOrDefault("id") ?? _id;

    // FormReporter is internal, so Razor can't name it; the form renders it through this.
    private RenderFragment Reporter => builder =>
    {
        builder.OpenComponent<FormReporter>(0);
        builder.AddComponentParameter(1, nameof(FormReporter.Form), this);
        builder.AddComponentReferenceCapture(2, reporter => _reporter = (FormReporter)reporter);
        builder.CloseComponent();
    };

    // The browser's reset would clear the inputs and leave what they're bound to, so the fields do it instead. A
    // component can't take @onreset:preventDefault, so the attribute it compiles to goes in by name.
    private Dictionary<string, object> FormAttributes
    {
        get
        {
            var attributes = AdditionalAttributes?.ToDictionary() ?? [];
            attributes["onreset"] = EventCallback.Factory.Create(this, ResetAsync);
            attributes["__internal_preventDefault_onreset"] = true;
            return attributes;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // A field whose own parameters didn't change isn't rendered again, so it's told to follow the form.
        if ((Disabled, ReadOnly) != _fieldState)
        {
            _fieldState = (Disabled, ReadOnly);
            foreach (var field in _fields.ToList())
            {
                await field.FollowFormAsync();
            }
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var context = EditContext ?? (Model is null ? _editContext
            : ReferenceEquals(Model, _model) ? _editContext : new EditContext(Model));
        _model = Model;
        if (!ReferenceEquals(context, _editContext))
        {
            _editContext.OnFieldChanged -= OnFieldChanged;
            _editContext.OnValidationStateChanged -= OnValidationStateChanged;
            _annotations?.Dispose();
            _annotations = null;
            _editContext = context;
        }

        if (DataAnnotations != _annotations is not null)
        {
            _annotations?.Dispose();
            _annotations = DataAnnotations ? _editContext.EnableDataAnnotationsValidation(Services) : null;
        }

        _editContext.OnFieldChanged -= OnFieldChanged;
        _editContext.OnValidationStateChanged -= OnValidationStateChanged;
        _editContext.OnFieldChanged += OnFieldChanged;
        _editContext.OnValidationStateChanged += OnValidationStateChanged;
        // The parent can change a value or the model without any field reporting it.
        _stale = true;
        _modelPasses = null;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Telemetry.Rendered(TelemetryName);
        if (_edits == 0)
        {
            await ReportIfStaleAsync();
        }

        if (_focusError)
        {
            _focusError = false;
            await FocusFirstErrorAsync();
        }
    }

    /// <summary>Shows every field's messages and returns whether the form is valid.</summary>
    public async Task<bool> ValidateAsync()
    {
        // Code may have changed the model without any field reporting it.
        _modelPasses = null;
        bool valid;
        _edits++;
        try
        {
            valid = _editContext.Validate();
            // Validate only asks the fields to check themselves, so they are told to show what they found.
            _editContext.NotifyValidationStateChanged();
        }
        finally
        {
            _edits--;
        }

        await ReportAsync();
        return valid;
    }

    /// <summary>Hides the messages from the fields' own <c>Required</c> and <c>Validation</c> checks, as on a form the
    /// user hasn't touched yet.
    /// Messages a validator such as <c>DataAnnotationsValidator</c> added stay until it validates again.</summary>
    public async Task ResetValidationAsync()
    {
        foreach (var field in _fields)
        {
            field.HideMessages();
        }

        _edits++;
        try
        {
            _editContext.NotifyValidationStateChanged();
        }
        finally
        {
            _edits--;
        }

        await ReportAsync();
    }

    /// <summary>Takes every field back to the value its parent last gave it, updating what it's bound to, and hides
    /// the messages from the fields' own checks and from <see cref="DataAnnotations"/>, as a button with
    /// <see cref="ButtonType.Reset"/> does. Focus stays where it is. A field's <c>Error</c> from the parent stays. A
    /// message from a validator inside the form stays too, unless the reset changes the field's value, in which case the
    /// validator checks the field again. A value the parent set in answer to an edit, such as a trimmed one, is the value
    /// the field goes back to. Text still being typed in a focused input isn't part of the reset: if the field's value
    /// doesn't change, the text stays and becomes the value once it's committed.</summary>
    public async Task ResetAsync()
    {
        _modelPasses = null;
        _edits++;
        try
        {
            foreach (var field in _fields.ToList())
            {
                await field.ResetAsync();
            }

            // The data annotations validation clears its messages only when disposed, so a new one takes its place.
            if (_annotations is not null)
            {
                _annotations.Dispose();
                _annotations = _editContext.EnableDataAnnotationsValidation(Services);
            }

            _editContext.MarkAsUnmodified();
            _editContext.NotifyValidationStateChanged();
        }
        finally
        {
            _edits--;
        }

        await ReportAsync();
        await OnReset.InvokeAsync();
    }

    internal void Add(IFormField field) => _fields.Add(field);

    // One edit renders the parent and raises several events, so they share one report, made once the edit's renders are
    // done.
    internal async Task EditAsync(Func<Task> edit)
    {
        _edits++;
        try
        {
            await edit();
        }
        finally
        {
            _edits--;
        }

        // The field's own problems may have changed even if no event marked the form stale. Another field's edit may
        // still be open, waiting on a slow handler, but this one's report doesn't wait for it.
        _stale = true;
        _reporter!.Queue();
    }

    internal async Task ReportIfStaleAsync()
    {
        if (_stale)
        {
            await ReportAsync();
        }
    }

    internal void Remove(IFormField field) => _fields.Remove(field);

    private async Task SubmitAsync(EditContext context)
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(context);
            return;
        }

        if (await ValidateAsync())
        {
            Telemetry.Submitted(TelemetryName, valid: true);
            await OnValidSubmit.InvokeAsync(context);
            return;
        }

        Telemetry.Submitted(TelemetryName, valid: false);
        foreach (var field in _fields)
        {
            field.CountIfInvalid();
        }

        // Focus moves once the render that shows the messages has reached the browser.
        _focusError = true;
        StateHasChanged();
        await OnInvalidSubmit.InvokeAsync(context);
    }

    // A statically rendered form has no script, and the browser's own focus stays where it was.
    private async Task FocusFirstErrorAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/form.js");
            await module.InvokeVoidAsync("focusFirstError", Id);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the form went with it.
        }
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _modelPasses = null;
        ReportFromEvent();
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => ReportFromEvent();

    // An event raised in a render batch, such as by a parent setting a field's Error, reports with the batch.
    private void ReportFromEvent()
    {
        _stale = true;
        if (_edits == 0 && _reporter is { } reporter)
        {
            _ = InvokeAsync(reporter.Queue);
        }
    }

    // The parent hears only when the validity or the shown messages actually change.
    private async Task ReportAsync()
    {
        _stale = false;
        var valid = !_fields.Any(field => field.HasProblems()) && !_editContext.GetValidationMessages().Any()
            && (_modelPasses ??= await ModelPassesAsync());
        if (valid != IsValid)
        {
            IsValid = valid;
            await IsValidChanged.InvokeAsync(valid);
        }

        var errors = _editContext.GetValidationMessages().ToList();
        foreach (var hidden in _fields.SelectMany(field => field.HiddenMessages()).ToList())
        {
            errors.Remove(hidden);
        }

        if (!errors.SequenceEqual(Errors))
        {
            Errors = errors;
            await ErrorsChanged.InvokeAsync(errors);
        }
    }

    // Checked like the form's validator, with its services: AddValidation's types if registered, else the model's own.
#pragma warning disable ASP0029 // The validation types are experimental; the validator itself uses them.
    [UnconditionalSuppressMessage("Trimming", "IL2026", Justification = "DataAnnotations reads the app's model by "
        + "reflection, as Blazor's DataAnnotationsValidator does; the Forms guide tells a trimmed app to keep the "
        + "model's properties.")]
    private async Task<bool> ModelPassesAsync()
    {
        if (!DataAnnotations || ReferenceEquals(_editContext.Model, _noModel))
        {
            return true;
        }

        var model = _editContext.Model;
        var validation = new ValidationContext(model, Services, null);
        var options = Services.GetService<IOptions<ValidationOptions>>()?.Value;
        if (options is null || !options.TryGetValidatableTypeInfo(model.GetType(), out var type))
        {
            return Validator.TryValidateObject(model, validation, null, true);
        }

        var context = new ValidateContext { ValidationOptions = options, ValidationContext = validation };
        await type.ValidateAsync(model, context, CancellationToken.None);
        return context.ValidationErrors is not { Count: > 0 };
    }
#pragma warning restore ASP0029

    /// <inheritdoc />
    public void Dispose()
    {
        _editContext.OnFieldChanged -= OnFieldChanged;
        _editContext.OnValidationStateChanged -= OnValidationStateChanged;
        _annotations?.Dispose();
    }
}
