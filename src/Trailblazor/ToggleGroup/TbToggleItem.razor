@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

@if (ChildContent is null && string.IsNullOrEmpty(Text) && Icon is Icon icon)
{
    <TbIconButton @attributes="AdditionalAttributes" Icon="icon" AriaLabel="@(AriaLabel ?? "")" Variant="Group!.Variant"
                  Tone="Group.Tone" Size="Group.Size" Disabled="@(Disabled || Group.Disabled)"
                  Pressed="Group.IsPressed(Value)" PressedChanged="OnPressedChanged" data-part="item" Class="@Class"
                  Style="@Style" ShowTooltip />
}
else
{
    <TbButton @attributes="AdditionalAttributes" Variant="Group!.Variant" Tone="Group.Tone" Size="Group.Size"
              Disabled="@(Disabled || Group.Disabled)" Pressed="Group.IsPressed(Value)" PressedChanged="OnPressedChanged"
              Start="StartIcon" data-part="item" Class="@Class" Style="@Style">
        @if (ChildContent is null)
        {
            @Text
        }
        else
        {
            @ChildContent
        }
    </TbButton>
}

@code {
    private ControlTelemetry? _telemetry;

    /// <summary>The value the group takes, or adds, when this item is pressed.</summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>The item's text. Use <see cref="ChildContent"/> for richer content.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Content shown instead of <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>An icon before the text, or in place of it, when the item has only an icon and an
    /// <see cref="AriaLabel"/>.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>The name of an item that shows only an icon. Required then, since an icon says nothing to a screen
    /// reader. The name also shows in a tooltip on hover and keyboard focus.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Turns this item off while the rest stay usable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>A label this item's use is counted under, such as <c>"view-as-list"</c>, so the app can see how often
    /// people see it and press it through the <c>Trailblazor</c> meter. It names what the item does, never the
    /// user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    [CascadingParameter]
    private IToggleGroup? Group { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Group is null)
        {
            throw new InvalidOperationException(
                $"{nameof(TbToggleItem<TValue>)} must be inside a TbToggleGroup or a TbMultiToggleGroup.");
        }

        Group.Accept(Value);
    }

    private RenderFragment? StartIcon => Icon is Icon icon ? @<TbIcon Icon="icon" Size="Group!.Size" /> : null;

    // The group decides what pressing means, so the button's own idea of its new state is ignored.
    private Task OnPressedChanged(bool _)
    {
        Telemetry.Used(TelemetryName);
        return Group!.ToggleAsync(Value);
    }

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => Telemetry.Rendered(TelemetryName);
}
