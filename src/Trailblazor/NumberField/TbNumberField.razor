@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@Layout(Classes, @<text>
    @* The step buttons repeat the arrow keys for pointers, so they stay out of the tab order. *@
    @if (!HideStepButtons)
    {
        <TbIconButton Icon="BuiltInIcons.Minus"
                      AriaLabel="@(Labels.Decrease ?? Localizer[TbStrings.NumberFieldDecrease])" Size="Size.Small"
                      tabindex="-1" data-part="decrement" Disabled="@(Disabled || ReadOnly || !CanStep(-1))"
                      OnClick="() => StepAsync(-1)" />
    }
    @Input
    @if (!HideStepButtons)
    {
        <TbIconButton Icon="BuiltInIcons.Plus"
                      AriaLabel="@(Labels.Increase ?? Localizer[TbStrings.NumberFieldIncrease])" Size="Size.Small"
                      tabindex="-1" data-part="increment" Disabled="@(Disabled || ReadOnly || !CanStep(1))"
                      OnClick="() => StepAsync(1)" />
    }
</text>, Start, End)

@code {
    private ElementReference _input;

    // While a step button is held, its steps show in the field, and the value changes once, when it's let go.
    private decimal? _held;

    // Hides the step buttons while the field is too narrow for them and a few digits.
    private IJSObjectReference? _widthHandle;
    private bool _disposed;

    /// <summary>Content before the input, usually an icon.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the input, such as a unit or a button.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public FieldClasses? Classes { get; set; }

    /// <summary>The smallest value allowed. Step buttons stop here, and a smaller value is an error, whether typed,
    /// posted by a static form or set by code; one the user didn't type shows its error once the form validates. A
    /// disabled or read-only field isn't checked, since the user can't change it.</summary>
    [Parameter]
    public decimal? Min { get; set; }

    /// <summary>The largest value allowed. Step buttons stop here, and a larger value is an error, whether typed,
    /// posted by a static form or set by code; one the user didn't type shows its error once the form validates. A
    /// disabled or read-only field isn't checked, since the user can't change it.</summary>
    [Parameter]
    public decimal? Max { get; set; }

    /// <summary>How much the step buttons and arrow keys change the value. Defaults to 1.</summary>
    [Parameter]
    public decimal Step { get; set; } = 1;

    /// <summary>How much Page Up and Page Down change the value. Defaults to ten steps.</summary>
    [Parameter]
    public decimal? LargeStep { get; set; }

    /// <summary>Hides the decrease and increase buttons; the arrow keys still step the value. A field too narrow for
    /// the buttons and about four digits hides them on its own.</summary>
    [Parameter]
    public bool HideStepButtons { get; set; }

    /// <summary>The words the field shows and says to screen readers: the step buttons' names and its messages. Each
    /// one left null uses the app's text.</summary>
    [Parameter]
    public NumberFieldLabels Labels { get; set; } = new();

    /// <summary>A .NET number format, such as <c>N2</c> for grouped digits, <c>C</c> for currency or <c>P0</c> for a
    /// percent. Once the page is interactive, the field then shows and reads the value in <see cref="Culture"/>'s
    /// format; in a percent field, a typed 15 is 15%. Without one, or before then, it is the browser's own number box,
    /// which writes numbers in the browser's language. A custom format with words in it, such as <c>0.0 kg</c>, can't
    /// be read back; put the unit in the <see cref="End"/> slot instead.</summary>
    [Parameter]
    public string? Format { get; set; }

    /// <summary>The culture <see cref="Format"/> writes and reads numbers in. Defaults to the current culture.
    /// </summary>
    [Parameter]
    public CultureInfo? Culture { get; set; }

    /// <summary>Rounds a typed value to this many decimal places, half away from zero.</summary>
    [Parameter]
    public int? Decimals { get; set; }

    /// <summary>Moves a typed value outside <see cref="Min"/> and <see cref="Max"/>, or beyond what the value's type
    /// can hold, to the nearer limit instead of showing an error.</summary>
    [Parameter]
    public bool ClampToRange { get; set; }

    /// <summary>Updates the value as the user types, not only when they leave the field or press Enter. What they type
    /// stays as typed until then; text that isn't a number yet, such as a lone minus sign, waits for it.</summary>
    [Parameter]
    public bool UpdateOnInput { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _input.FocusAsync(preventScroll);

    private static Type NumberType => Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private CultureInfo NumberCulture => Culture ?? CultureInfo.CurrentCulture;

    // A formatted field is a text box that acts as a spin button, since a number box can't show grouping or symbols.
    // Without a circuit it stays the number box, since Blazor's form binding reads posted numbers in the invariant
    // culture.
    private bool Formatted => Format is not null && RendererInfo.IsInteractive;

    // Built here to mark the events as updating value, as @bind does, so a round trip can't undo newer steps.
    private RenderFragment Input => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, ControlAttributes);
        builder.AddAttribute(2, "data-part", "input");
        builder.AddAttribute(3, "id", InputId);
        builder.AddAttribute(4, "name", InputNameAttribute);
        builder.AddAttribute(5, "type", Formatted ? "text" : "number");
        builder.AddAttribute(6, "value", ShownText);
        builder.AddAttribute(7, "min", Formatted ? null : Invariant(Min));
        builder.AddAttribute(8, "max", Formatted ? null : Invariant(Max));
        // Before the page is interactive, a formatted field's number box takes any number, as the formatted field does.
        builder.AddAttribute(9, "step", Formatted ? null : Format is not null ? "any" : Invariant(Step));
        builder.AddAttribute(10, "disabled", Disabled);
        builder.AddAttribute(11, "readonly", ReadOnly);
        builder.AddAttribute(12, "aria-required", AriaRequired);
        builder.AddAttribute(13, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(14, "aria-describedby", InputDescribedBy);
        builder.AddAttribute(15, "class", ClassNames.Join("tb-field__input", Classes?.Input));
        if (Formatted)
        {
            builder.AddAttribute(16, "inputmode", "decimal");
            builder.AddAttribute(17, "autocomplete", "off");
            builder.AddAttribute(18, "role", "spinbutton");
            builder.AddAttribute(19, "aria-valuenow",
                TryGetSteppable(out var number) ? Invariant(_held ?? number) : null);
            builder.AddAttribute(20, "aria-valuemin", Invariant(Min));
            builder.AddAttribute(21, "aria-valuemax", Invariant(Max));
            builder.AddAttribute(22, "aria-valuetext", ShownText);
            builder.AddAttribute(23, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                change => SetTextAsync(change.Value as string)));
            builder.SetUpdatesAttributeName("value");
            builder.AddAttribute(24, "onkeydown",
                EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));
            if (UpdateOnInput)
            {
                builder.AddAttribute(30, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this,
                    input => SetTypedTextAsync(input.Value as string)));
                builder.SetUpdatesAttributeName("value");
            }
        }
        else
        {
            builder.AddAttribute(25, "ontbnumberchange",
                EventCallback.Factory.Create<NumberChangeEventArgs>(this, OnChangeAsync));
            builder.SetUpdatesAttributeName("value");
            builder.AddAttribute(26, "ontbnumberleave",
                EventCallback.Factory.Create<NumberChangeEventArgs>(this, OnLeaveAsync));
            builder.SetUpdatesAttributeName("value");
            if (UpdateOnInput)
            {
                // Text the browser can't read yet, such as "4-", waits for the change, which shows the error.
                builder.AddAttribute(31, "ontbnumberinput", EventCallback.Factory.Create<NumberChangeEventArgs>(this,
                    input => SetTypedTextAsync(input.Value, parse: !input.BadInput)));
                builder.SetUpdatesAttributeName("value");
            }
        }

        builder.AddAttribute(32, "ontbnumberstep",
            EventCallback.Factory.Create<NumberStepEventArgs>(this, OnStepAsync));
        builder.SetUpdatesAttributeName("value");
        // Tests wait for data-ready before typing, since a prerendered field is replaced and loses the text.
        builder.AddAttribute(27, "data-static", AssignedRenderMode is null && !RendererInfo.IsInteractive ? "" : null);
        builder.AddAttribute(28, "data-ready", RendererInfo.IsInteractive ? "" : null);
        builder.AddElementReferenceCapture(29, element => _input = element);
        builder.CloseElement();
    };

    private decimal Lower => Math.Max(Min ?? decimal.MinValue, NumberTypes.Limits(NumberType).Min);

    private decimal Upper => Math.Min(Max ?? decimal.MaxValue, NumberTypes.Limits(NumberType).Max);

    private string NotANumber => FormatMessage(Labels.NotANumber ?? Localizer[TbStrings.NumberFieldNotANumber]);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!NumberTypes.IsNumber(NumberType))
        {
            throw new InvalidOperationException(
                $"{nameof(TbNumberField<TValue>)} needs a number type, not {NumberType.Name}.");
        }

        if (Decimals is < 0 or > 28)
        {
            throw new InvalidOperationException(
                $"{nameof(Decimals)} must be from 0 to 28, the places a decimal can hold, not {Decimals}.");
        }
    }

    // A double that decimal can't hold, such as NaN or 1e30, can't be stepped.
    private bool TryGetSteppable(out decimal? number)
    {
        number = null;
        if (Value is null)
        {
            return true;
        }

        if (!NumberTypes.TryToDecimal(Value, out var exact))
        {
            return false;
        }

        number = exact;
        return true;
    }

    private bool CanStep(int direction) =>
        TryGetSteppable(out var number) && (number is null || (direction < 0 ? number > Lower : number < Upper));

    // A text box would move the caret on the arrows, so number-field.js holds the caret and the keys step instead, as
    // in a number box.
    private Task OnKeyDownAsync(KeyboardEventArgs e) => ReadOnly || e.IsComposing ? Task.CompletedTask : e.Key switch
    {
        "ArrowUp" => StepAsync(1),
        "ArrowDown" => StepAsync(-1),
        _ => Task.CompletedTask,
    };

    private string? ShownText => _held is { } held ? FormatValue(ToValue(held)) : Text;

    private Task StepAsync(int direction) => StepAsync(direction, Step, held: false);

    // An empty field steps from the minimum, or zero without one; a held button steps on from what it shows.
    private Task StepAsync(int direction, decimal size, bool held)
    {
        if (!TryGetSteppable(out var number))
        {
            return Task.CompletedTask;
        }

        var stepped = Math.Clamp((_held ?? number ?? Min ?? 0) + direction * size, Lower, Upper);
        if (held)
        {
            _held = stepped;
            return Task.CompletedTask;
        }

        _held = null;
        return SetValueAsync(ToValue(stepped));
    }

    // number-field.js asks for these steps; letting go of a held button sends a direction of 0.
    private Task OnStepAsync(NumberStepEventArgs e)
    {
        if (e.Direction == 0)
        {
            return _held is not null ? StepAsync(0, 0, held: false) : Task.CompletedTask;
        }

        return Disabled || ReadOnly ? Task.CompletedTask
            : StepAsync(e.Direction, e.Large ? LargeStep ?? Step * 10 : Step, e.Held);
    }

    // Going to or from text the browser can't read in an empty field fires no change event, so leaving commits that. Any
    // other text is unedited or has had its change, and committing it could undo a step that hasn't rendered yet.
    private Task OnLeaveAsync(NumberChangeEventArgs e) =>
        e.BadInput || HasParseError ? OnChangeAsync(e) : Task.CompletedTask;

    // The browser reports text it can't read, such as "4-", as an empty value, which would clear a nullable field.
    private Task OnChangeAsync(NumberChangeEventArgs e)
    {
        if (e.BadInput)
        {
            // The browser reports unreadable text as empty, so empty is what renders, and the text stays put.
            ShowParseError(NotANumber, e.Value);
            return Task.CompletedTask;
        }

        return SetTextAsync(e.Value);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/number-field.js");
            var handle = await module.InvokeAsync<IJSObjectReference?>("watchWidth", _input);
            if (handle is null)
            {
                return;
            }

            if (_disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _widthHandle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the field went with it.
        }
    }

    // A number input always holds its value with a period; the browser shows it in the user's own format.
    private protected override string? FormatValue(TValue? value) => Formatted && value is IFormattable number
        ? number.ToString(Format, NumberCulture)
        : BindConverter.FormatValue(value, CultureInfo.InvariantCulture)?.ToString();

    private protected override bool TryParse(string? text, out TValue? value, out string? error)
    {
        if (!(Formatted ? TryConvertFormatted(text, out value) : TryConvert(text, out value))
            && !(ClampToRange && TryClampBeyondType(text, out value)))
        {
            error = NotANumber;
            return false;
        }

        if (Decimals is int decimals && NumberTypes.TryToDecimal(value, out var exact))
        {
            value = ToValue(Math.Round(exact, decimals, MidpointRounding.AwayFromZero));
        }

        // A double past decimal's range moves to the nearer of Min and Max too, when the field has one.
        if (ClampToRange && value is not null)
        {
            value = NumberTypes.TryToDecimal(value, out var unclamped)
                ? ToValue(Math.Clamp(unclamped, Lower, Upper))
                : (Convert.ToDouble(value, CultureInfo.InvariantCulture) > 0 ? Max : Min) is { } limit ? ToValue(limit)
                : value;
        }

        error = ValueError(value);
        return error is null;
    }

    private protected override string? ValueError(TValue? value)
    {
        // Compared as doubles, which hold the range of every number type.
        var number = value is null ? (double?)null : Convert.ToDouble(value, CultureInfo.InvariantCulture);
        return (number < (double?)Min, number > (double?)Max) switch
        {
            (true, _) or (_, true) when Min is not null && Max is not null =>
                FormatMessage(Labels.Range ?? Localizer[TbStrings.NumberFieldRange], Limit(Min), Limit(Max)),
            (true, _) => FormatMessage(Labels.AtLeast ?? Localizer[TbStrings.NumberFieldAtLeast], Limit(Min)),
            (_, true) => FormatMessage(Labels.AtMost ?? Localizer[TbStrings.NumberFieldAtMost], Limit(Max)),
            _ => null,
        };
    }

    // A formatted field's message gives its limits as the field shows numbers, such as 0 % and 100 %.
    private object? Limit(decimal? limit) =>
        Formatted && limit is { } value ? value.ToString(Format, NumberCulture) : limit;

    // .NET writes large doubles with exponents, such as 1E+29, which BindConverter can't read back.
    private static bool TryConvert(string? text, out TValue? value)
    {
        if ((NumberType != typeof(double) && NumberType != typeof(float)) || string.IsNullOrEmpty(text))
        {
            return BindConverter.TryConvertTo(text, CultureInfo.InvariantCulture, out value);
        }

        var parsed = double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var number);
        value = parsed ? (TValue)Convert.ChangeType(number, NumberType, CultureInfo.InvariantCulture) : default;
        // Too large for the type parses as infinity, which the input can't show.
        return parsed && double.IsFinite(Convert.ToDouble(value, CultureInfo.InvariantCulture));
    }

    // Text in the field's culture, with its group separators and currency symbol; a percent is a hundredth.
    private bool TryConvertFormatted(string? text, out TValue? value)
    {
        value = default;
        if (string.IsNullOrWhiteSpace(text))
        {
            return Nullable.GetUnderlyingType(typeof(TValue)) is not null;
        }

        if (!decimal.TryParse(text.Replace(NumberCulture.NumberFormat.PercentSymbol, "", StringComparison.Ordinal),
                NumberStyles.Currency | NumberStyles.AllowExponent, NumberCulture, out var number))
        {
            return false;
        }

        number = Percent ? number / 100 : number;
        var (lower, upper) = NumberTypes.Limits(NumberType);
        if (number < lower || number > upper || (NumberTypes.IsWhole(NumberType) && number != Math.Truncate(number)))
        {
            return false;
        }

        value = ToValue(number);
        return true;
    }

    // The field's own format says whether it holds a percent, so "15" in a percent field is 15%, as "15%" is.
    private bool Percent => Formatted && 1m.ToString(Format, NumberCulture)
        .Contains(NumberCulture.NumberFormat.PercentSymbol, StringComparison.Ordinal);

    // A number beyond the value's type, read as a decimal, which holds every whole type exactly, or past that as a
    // double; a fraction within a whole type's range stays an error, and so does NaN, which has no nearer limit.
    private bool TryClampBeyondType(string? text, out TValue? value)
    {
        value = default;
        var culture = Formatted ? NumberCulture : CultureInfo.InvariantCulture;
        var digits = Formatted ? text?.Replace(culture.NumberFormat.PercentSymbol, "", StringComparison.Ordinal) : text;
        var styles = Formatted ? NumberStyles.Currency | NumberStyles.AllowExponent : NumberStyles.Float;
        if (string.IsNullOrWhiteSpace(digits))
        {
            return false;
        }

        if (decimal.TryParse(digits, styles, culture, out var number))
        {
            number = Percent ? number / 100 : number;
            var (lower, upper) = NumberTypes.Limits(NumberType);
            if (number >= lower && number <= upper)
            {
                return false;
            }

            value = ToValue(number > upper ? Upper : Lower);
            return true;
        }

        if (!double.TryParse(digits, styles, culture, out var huge) || double.IsNaN(huge))
        {
            return false;
        }

        huge = Percent ? huge / 100 : huge;

        // A float or double keeps the number within its own range; the clamp after this moves it within Min and Max.
        value = NumberType == typeof(float) ? (TValue)(object)(float)Math.Clamp(huge, float.MinValue, float.MaxValue)
            : NumberType == typeof(double) ? (TValue)(object)Math.Clamp(huge, double.MinValue, double.MaxValue)
            : ToValue(huge > 0 ? Upper : Lower);
        return true;
    }

    private static TValue ToValue(decimal number) =>
        (TValue)Convert.ChangeType(number, NumberType, CultureInfo.InvariantCulture);

    private static string? Invariant(decimal? number) => number?.ToString(CultureInfo.InvariantCulture);

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync when both exist, so the field's own cleanup has to run from here.
        Dispose();
        _disposed = true;
        return _widthHandle?.DisposeHandleAsync() ?? ValueTask.CompletedTask;
    }
}
