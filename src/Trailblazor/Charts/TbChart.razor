@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@using static Trailblazor.ChartPath
@typeparam TItem
@inherits TbComponentBase
@implements IAsyncDisposable
@inject ITbLocalizer Localizer
@inject JsModuleLoader Modules

@{ _changed = false; }
<figure @attributes="AdditionalAttributes" aria-label="@AriaLabel"
        style="@Styles.Join(Height is null ? null : $"--tb-chart-height: {Height}", Style)"
        class="@ClassNames.Join("tb-chart", Horizontal ? "tb-chart--horizontal" : null, Class)">
    <CascadingValue Value="this" IsFixed="true">
        <CascadingValue Value="Axes" IsFixed="true">
            <CascadingValue Value="References" IsFixed="true">@ChildContent</CascadingValue>
        </CascadingValue>
    </CascadingValue>
    @* Every position is a share of the plot, so the same markup fits any size and nothing is measured: marks the
       browser can place by percentage are plain SVG shapes, lines are paths in a nested SVG stretched over the plot,
       and text is HTML around the plot. *@
    @{
        var plan = Plan();
        var series = _series;
        var empty = plan.Places.Count == 0 || series.Count == 0;
        // With every series hidden there is nothing to draw, and the legend and the table stay.
        var blank = empty || plan.Series.All(one => one.Hidden);
        var markers = plan.Places.Count <= MostMarkers;
        var tones = ItemTones(plan, markers);
        // The values' labels run up the plot's side and the places' along its base, or the other way around when
        // the chart is horizontal.
        List<(double At, string Text, int Stride)> values = [.. ValueLabels(plan)];
        List<(double At, string Text, int Stride)> names = [.. plan.Labels];
        var (side, below) = Horizontal ? (names, values) : (values, names);
        var toggles = CanHideSeries && RendererInfo.IsInteractive;
        // The references stay in the list under the data table while every series is hidden, as the table stays.
        var references = empty ? [] : PlaceReferences(plan);
        var onMarks = blank ? [] : ValueLabelsOnMarks(plan);
    }
    @if (Title is not null)
    {
        <figcaption data-part="title" class="@ClassNames.Join("tb-chart__title", Classes?.Title)">@Title</figcaption>
    }
    @if (series.Count > 1)
    {
        <ul data-part="legend" class="@ClassNames.Join("tb-chart__legend", Classes?.Legend)">
            @for (var index = 0; index < series.Count; index++)
            {
                var one = series[index];
                var number = index;
                @* A key is drawn as its series' own mark, so it looks as the mark does in every theme and mode. *@
                RenderFragment entry =
                    @<text>
                        @if (one.Bars)
                        {
                            <svg class="@ClassNames.Join("tb-chart__key", Slot(number))" style="@Color(number)"
                                 aria-hidden="true" focusable="false">
                                <rect class="tb-chart__bar" x="1" y="1" width="10" height="10" />
                            </svg>
                        }
                        else if (one.Dots)
                        {
                            <svg class="@ClassNames.Join("tb-chart__key", Slot(number))" style="@Color(number)"
                                 aria-hidden="true" focusable="false">
                                @Dot(ShapeOf(number), "6", "6")
                            </svg>
                        }
                        else if (one.Filled)
                        {
                            <svg class="@ClassNames.Join("tb-chart__key tb-chart__key--line", Slot(number))"
                                 style="@Color(number)" aria-hidden="true" focusable="false">
                                <rect class="tb-chart__area" x="1" y="3" width="22" height="9" />
                                <line class="@ClassNames.Join("tb-chart__line", Slot(number))" x1="1" y1="3" x2="23"
                                      y2="3" />
                            </svg>
                        }
                        else
                        {
                            <svg class="tb-chart__key tb-chart__key--line" aria-hidden="true" focusable="false">
                                <line class="@ClassNames.Join("tb-chart__line", Slot(number))" style="@Color(number)"
                                      x1="1" y1="6" x2="23" y2="6" />
                            </svg>
                        }
                        @one.Name
                    </text>;
                <li data-hidden="@(one.IsHidden ? "" : null)">
                    @if (toggles)
                    {
                        @* Pressed while its series shows. *@
                        <button type="button" class="tb-chart__legend-button"
                                aria-pressed="@(one.IsHidden ? "false" : "true")"
                                @onclick="() => ToggleAsync(one)">@entry</button>
                    }
                    else
                    {
                        @entry
                        @* Without a button to say so, a screen reader hears that the series is hidden in words. *@
                        if (one.IsHidden)
                        {
                            <span class="tb-visually-hidden">@(Labels.Hidden ?? Localizer[TbStrings.ChartHidden])</span>
                        }
                    }
                </li>
            }
        </ul>
    }
    @* The title of the axis up the plot's side shows above it, and the title of the one along its base under it. *@
    @if (!blank && (Horizontal ? Axes.X?.Title : Axes.Y?.Title) is { } sideTitle)
    {
        <div data-part="@(Horizontal ? "x-title" : "y-title")" class="tb-chart__y-title">@sideTitle</div>
    }
    <div class="@ClassNames.Join("tb-chart__body", ValueRoom(onMarks))"
         style="@(onMarks.Count == 0 ? null : $"--_tb-chart-value-chars: {onMarks.Max(label => label.Chars)}")">
        @if (!blank)
        {
            <div class="tb-chart__y" aria-hidden="true"
                 style="@(Horizontal ? $"--_tb-chart-count: {Steps(plan)}" : null)">
                @* The longest label, unseen, gives the column its width; WebKit won't place the labels by percentage
                   inside a column sized by the grid alone. Names differ in how wide their letters are, so a
                   horizontal chart has every name there, with no height. *@
                @if (Horizontal)
                {
                    foreach (var label in side)
                    {
                        <span class="tb-chart__y-sizer">@label.Text</span>
                    }
                }
                else
                {
                    <span class="tb-chart__y-sizer">
                        @side.Select(label => label.Text).MaxBy(text => text.Length)
                    </span>
                }
                @foreach (var label in side)
                {
                    <span style="@SideStyle(label.At, label.Stride)">@label.Text</span>
                }
            </div>
        }
        @* The plot is one element whether it has anything to draw or not, so the script stays on it. The script reads
           each place's name from it, and each series' values and points from the series' own element. *@
        <div @ref="_plot" id="@_plotId" data-part="plot" data-places="@(blank ? null : Places(plan))"
             data-at="@(blank ? null : At(plan))" data-horizontal="@(Horizontal ? "" : null)"
             data-activates="@(RendererInfo.IsInteractive && OnPointClick.HasDelegate ? "" : null)"
             data-commits="@(RendererInfo.IsInteractive ? _commits : null)"
             class="@ClassNames.Join("tb-chart__plot", blank ? "tb-chart__plot--empty" : null, Classes?.Plot)">
            @if (empty)
            {
                @(Labels.Empty ?? Localizer[TbStrings.ChartEmpty])
            }
            else if (blank)
            {
                @(Labels.AllHidden ?? Localizer[TbStrings.ChartAllHidden])
            }
            else
            {
                <svg class="tb-chart__marks" role="img" aria-label="@Summary()" focusable="false">
                    @foreach (var tick in plan.ValueTicks)
                    {
                        var (from, to) = (Turn(0, tick.Y), Turn(1, tick.Y));
                        <line class="@(tick.Zero ? "tb-chart__grid tb-chart__grid--zero" : "tb-chart__grid")"
                              x1="@Percent(from.X)" x2="@Percent(to.X)" y1="@Percent(from.Y)" y2="@Percent(to.Y)" />
                    }
                    @* A reference band is under every mark, and a reference line, further down, over them. *@
                    @foreach (var band in references.Where(one => one.Band && one.Drawn))
                    {
                        var box = Box(band);
                        <rect class="@ClassNames.Join("tb-chart__band", ToneClass(band.Reference.Tone))"
                              x="@Percent(box.X)" y="@Percent(box.Y)" width="@Percent(box.Width)"
                              height="@Percent(box.Height)" />
                    }
                    @* The areas' fills are under the bars and every line, so no fill covers another series' marks,
                       and their drawing ends at the plot's edge when zero is beyond it. In a stack no two fills
                       overlap, so each carries its series' number and a click inside it is on that series. *@
                    @if (series.Any(one => one.Filled && !one.IsHidden))
                    {
                        <svg class="tb-chart__fills" viewBox="@LinesBox" preserveAspectRatio="none"
                             aria-hidden="true" width="100%" height="100%">
                            @for (var index = 0; index < series.Count; index++)
                            {
                                if (series[index].Filled && !plan.Series[index].Hidden)
                                {
                                    <path class="@ClassNames.Join("tb-chart__area", Slot(index))"
                                          style="@Color(index)" d="@plan.Series[index].Fill"
                                          data-number="@(Stacking == ChartStacking.None ? null : index)" />
                                }
                            }
                        </svg>
                    }
                    @for (var index = 0; index < series.Count; index++)
                    {
                        var drawn = plan.Series[index];
                        if (drawn.Bars && !drawn.Hidden)
                        {
                            <g data-series="@drawn.Name" data-number="@index" data-values="@Values(drawn)"
                               data-points="@Points(drawn)" data-tones="@Tones(tones[index])" class="@Slot(index)"
                               style="@Color(index)">
                                @for (var place = 0; place < drawn.Marks.Count; place++)
                                {
                                    if (drawn.Marks[place] is { } bar)
                                    {
                                        var box = Box(bar);
                                        <rect class="@ClassNames.Join(BarClass(bar.End),
                                                         ToneClass(tones[index]?[place]))"
                                              x="@Percent(box.X)" y="@Percent(box.Y)" width="@Percent(box.Width)"
                                              height="@Percent(box.Height)" />
                                    }
                                }
                            </g>
                        }
                    }
                    @* A bar inside a stack ends where the next one starts; a line in the surface's color parts them. *@
                    @foreach (var drawn in plan.Series)
                    {
                        foreach (var mark in drawn.Marks)
                        {
                            if (mark is { End: ChartBarEnd.None, Height: > 0 } bar)
                            {
                                var end = bar.Up ? bar.Y : bar.Y + bar.Height;
                                var (from, to) = (Turn(bar.X, end), Turn(bar.X + bar.Width, end));
                                <line class="tb-chart__gap" x1="@Percent(from.X)" x2="@Percent(to.X)"
                                      y1="@Percent(from.Y)" y2="@Percent(to.Y)" />
                            }
                        }
                    }
                    @* An SVG inside another is an image of its own to a screen reader unless it is hidden from it. *@
                    <svg class="tb-chart__lines" viewBox="@LinesBox" preserveAspectRatio="none" aria-hidden="true"
                         width="100%" height="100%">
                        @for (var index = 0; index < series.Count; index++)
                        {
                            var drawn = plan.Series[index];
                            if (!drawn.Bars && !drawn.Hidden && !series[index].Dots)
                            {
                                <path data-series="@drawn.Name" data-number="@index" data-values="@Values(drawn)"
                                      data-points="@Points(drawn)" data-tones="@Tones(tones[index])"
                                      style="@Color(index)" d="@drawn.Path"
                                      class="@ClassNames.Join("tb-chart__line", Slot(index))" />
                            }
                        }
                    </svg>
                    @for (var index = 0; index < series.Count; index++)
                    {
                        var drawn = plan.Series[index];
                        if (drawn.Hidden || drawn.Bars)
                        {
                            continue;
                        }

                        @* A scatter series' group of marks is its series element: it carries what the script
                           reads. Each mark says which place it is, since two marks may share a spot along the
                           chart. *@
                        if (series[index].Dots)
                        {
                            <g data-series="@drawn.Name" data-number="@index" data-values="@Values(drawn)"
                               data-points="@Points(drawn)" data-tones="@Tones(tones[index])" class="@Slot(index)"
                               style="@Color(index)">
                                @for (var place = 0; place < drawn.Points.Count; place++)
                                {
                                    if (drawn.Points[place] is { } at)
                                    {
                                        @Dot(ShapeOf(index), Percent(at.X), Percent(at.Y), place,
                                            ToneClass(tones[index]?[place]))
                                    }
                                }
                            </g>
                        }
                        else if (series[index].HasMarkers ?? markers)
                        {
                            <g class="@Slot(index)" style="@Color(index)">
                                @for (var place = 0; place < drawn.Points.Count; place++)
                                {
                                    if (drawn.Points[place] is { } at)
                                    {
                                        <circle class="@ClassNames.Join("tb-chart__marker",
                                                           ToneClass(tones[index]?[place]))"
                                                r="4" cx="@Percent(at.X)" cy="@Percent(at.Y)" />
                                    }
                                }
                            </g>
                        }
                    }
                    @foreach (var line in references.Where(one => !one.Band && one.Drawn))
                    {
                        var (from, to) = Ends(line);
                        <line class="@ClassNames.Join("tb-chart__reference", ToneClass(line.Reference.Tone))"
                              x1="@Percent(from.X)" x2="@Percent(to.X)" y1="@Percent(from.Y)" y2="@Percent(to.Y)" />
                    }
                </svg>
                @* Each value on its mark, which the data table already gives screen readers. *@
                @if (onMarks.Count > 0)
                {
                    <div data-part="values" class="tb-chart__values" aria-hidden="true">
                        @foreach (var label in onMarks)
                        {
                            <span data-side="@SideName(label)" data-edge="@ValueEdge(label)"
                                  style="@ValueStyle(label)">@label.Text</span>
                        }
                    </div>
                }
                @* Each reference's name and values, as text over the plot that screen readers read after the
                   drawing: at a line's end, or in a band's corner. *@
                @foreach (var placed in references.Where(one => one.Drawn))
                {
                    <span data-part="reference" style="@NameStyle(placed)"
                          class="@ClassNames.Join("tb-chart__reference-name",
                                     placed.Band ? "tb-chart__reference-name--band" : null,
                                     RunsUp(placed) ? "tb-chart__reference-name--up" : null,
                                     TextUnder(placed) ? "tb-chart__reference-name--under" : null)">@placed.Text</span>
                }
            }
            @* The script shows these, moves them and names them, and Blazor never writes inside them: the line at the
               place the pointer or the keys are on, the tooltip, and the two elements focus moves between. *@
            <div class="tb-chart__crosshair" hidden></div>
            <div data-part="tooltip" class="tb-chart__tooltip" hidden></div>
            <span class="tb-chart__focus"></span>
            <span class="tb-chart__focus"></span>
        </div>
        @if (!blank)
        {
            @* WebKit sizes a grid item that is itself a query container by the whole grid, so the query container is
               a child of the grid item instead. *@
            <div class="tb-chart__x-row" aria-hidden="true">
                <div class="tb-chart__x"
                     style="--_tb-chart-count: @BaseSteps(plan); --_tb-chart-chars: @Longest(below)">
                    @foreach (var label in below)
                    {
                        @* A mark on the plot's edge has its label inside the plot, not half out of it. *@
                        var edge = label.At <= 0 ? "start" : label.At >= 1 ? "end" : null;
                        <span data-edge="@edge" style="@Along(label.At, edge); --_tb-chart-stride: @label.Stride">
                            @label.Text
                        </span>
                    }
                </div>
            </div>
        }
    </div>
    @if (!blank && (Horizontal ? Axes.Y?.Title : Axes.X?.Title) is { } baseTitle)
    {
        <div data-part="@(Horizontal ? "y-title" : "x-title")" class="tb-chart__x-title">@baseTitle</div>
    }
    @if (!empty)
    {
        <details data-part="table" class="@ClassNames.Join("tb-chart__table", Classes?.Table)">
            <summary>@(Labels.Table ?? Localizer[TbStrings.ChartTable])</summary>
            <TbTable Size="Size.Small" aria-label="@(Title ?? AriaLabel)">
                <thead>
                    <tr>
                        @if (Axes.X?.Title is { } heading)
                        {
                            <th scope="col">@heading</th>
                        }
                        else
                        {
                            <td></td>
                        }
                        @foreach (var one in plan.Series)
                        {
                            <th scope="col">@one.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var place = 0; place < plan.Places.Count; place++)
                    {
                        <tr>
                            <th scope="row">@plan.Places[place]</th>
                            @* A cell with a value says its mark's tone, the item's or else the series', for tests
                               to read. *@
                            @for (var index = 0; index < plan.Series.Count; index++)
                            {
                                var text = plan.Series[index].Text[place];
                                var tone = text is null ? null : tones[index]?[place] ?? series[index].Tone;
                                <td data-tone="@ToneName(tone)">@text</td>
                            }
                        </tr>
                    }
                </tbody>
            </TbTable>
            @if (references.Count > 0)
            {
                <ul data-part="references" class="tb-chart__references">
                    @foreach (var placed in references)
                    {
                        <li data-tone="@ToneName(placed.Reference.Tone)">@placed.Text</li>
                    }
                </ul>
            }
        </details>
    }
</figure>

@code {
    // A scatter series' mark, at a spot given as lengths or shares of its drawing: a circle, a square that the
    // stylesheet centers on the spot, the square turned for a diamond, or a ring whose line is as far out as a
    // circle's edge. A mark in the plot says which place it is, and has its item's tone when it has one.
    private static RenderFragment Dot(int shape, string x, string y, int? place = null, string? tone = null)
    {
        var marker = ClassNames.Join("tb-chart__marker", tone);
        return (shape % 4) switch
        {
            1 => @<rect class="@marker tb-chart__marker--square" data-place="@place" x="@x" y="@y" width="8"
                        height="8" />,
            2 => @<rect class="@marker tb-chart__marker--diamond" data-place="@place" x="@x" y="@y" width="8"
                        height="8" />,
            3 => @<circle class="@marker tb-chart__marker--ring" data-place="@place" r="3" cx="@x" cy="@y" />,
            _ => @<circle class="@marker" data-place="@place" r="4" cx="@x" cy="@y" />,
        };
    }
}
