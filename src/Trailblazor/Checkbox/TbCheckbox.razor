@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbFieldBase<TValue>
@inject JsModuleLoader Modules

@* In a static-SSR form an unchecked box posts nothing, so a bool? left unchecked posts as null rather than false. *@

<div @attributes="RootAttributes" style="@Style"
     class="@ClassNames.Join(Block, ClassNames.Modifier(Block, Tone), ClassNames.Modifier(Block, Size),
                ShowsInvalid ? $"{Block}--invalid" : null,
                Disabled ? $"{Block}--disabled" : null, Class)">
    @WithInfo(ChoiceLabel)
    @Messages(Classes?.Helper, Classes?.Error)
</div>

@code {
    private ElementReference _input;
    private bool _shownIndeterminate;

    private RenderFragment ChoiceLabel =>
        @<label data-part="label" class="@ClassNames.Join($"{Block}__label", Classes?.Label)">
            @if (OverInput is { } over)
            {
                <span class="@($"{Block}__control")">@Input@over</span>
            }
            else
            {
                @Input
            }
            <span class="@(ChildContent is null ? LabelHiddenClass : null)">
                @if (ChildContent is null)
                {
                    @ShownLabel
                }
                else
                {
                    @ChildContent
                }
                @RequiredMarker
            </span>
        </label>;

    private RenderFragment Input =>
        @<input @attributes="ControlAttributes" @ref="_input" data-part="input" id="@InputId"
                name="@InputNameAttribute" type="checkbox" role="@Role" value="true" checked="@(Value is true)"
                disabled="@Disabled"
                aria-readonly="@(ReadOnly ? "true" : null)" aria-required="@AriaRequired"
                aria-invalid="@(ShowsInvalid ? "true" : null)" aria-describedby="@InputDescribedBy"
                class="@ClassNames.Join($"{Block}__input", Classes?.Input)"
                @onchange="OnChangeAsync" />;

    // Content drawn over the input, such as a switch's thumb icons.
    private protected virtual RenderFragment? OverInput => null;

    /// <summary>The label as rich content, such as "I agree to the <c>&lt;a&gt;</c>terms<c>&lt;/a&gt;</c>", shown
    /// in place of <see cref="TbFieldBase{TValue}.Label"/>. It names the control, so keep a link in it short.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The color the control takes when on. Defaults to <see cref="Trailblazor.Tone.Primary"/>.</summary>
    [Parameter]
    public Tone Tone { get; set; } = Tone.Primary;

    /// <summary>The size of the control and its label. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public ChoiceClasses? Classes { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _input.FocusAsync(preventScroll);

    private protected virtual string Block => "tb-checkbox";

    private protected virtual string? Role => null;

    // A required checkbox, such as one accepting terms, needs to be checked.
    private protected override bool IsMissing(TValue? value) => value is not true;

    // Only a bool? can be null, so only it is ever mixed.
    private bool Indeterminate => Value is null;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (typeof(TValue) != typeof(bool) && typeof(TValue) != typeof(bool?))
        {
            throw new InvalidOperationException(
                $"{nameof(TbCheckbox<TValue>)} needs bool or bool?, not {typeof(TValue).Name}.");
        }
    }

    // A click clears the browser's mixed state itself, so it must be set again if the value stays null.
    private Task OnChangeAsync(ChangeEventArgs e)
    {
        _shownIndeterminate = false;
        Telemetry.Used(TelemetryName);
        return SetValueAsync((TValue)(object)(e.Value is true));
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (Indeterminate == _shownIndeterminate)
        {
            return;
        }

        _shownIndeterminate = Indeterminate;
        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/checkbox.js");
            await module.InvokeVoidAsync("setIndeterminate", _input, _shownIndeterminate);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the checkbox went with it.
        }
    }
}
