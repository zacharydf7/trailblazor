@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbFieldBase<TValue>
@inject JsModuleLoader Modules

@* In a static-SSR form an unchecked box posts nothing, so a bool? left unchecked posts as null rather than false. *@

<div @attributes="AdditionalAttributes" style="@Style"
     class="@ClassNames.Join(Block, Errors.Count > 0 ? $"{Block}--invalid" : null,
                Disabled ? $"{Block}--disabled" : null, Class)">
    <label data-part="label" class="@ClassNames.Join($"{Block}__label", Classes?.Label)">
        <input @attributes="InputAttributes" @ref="_input" data-part="input" id="@InputId" name="@InputNameAttribute"
               type="checkbox" role="@Role" value="true" checked="@(Value is true)" disabled="@Disabled"
               aria-required="@(Required ? "true" : null)" aria-invalid="@(Errors.Count > 0 ? "true" : null)"
               aria-describedby="@InputDescribedBy" class="@ClassNames.Join($"{Block}__input", Classes?.Input)"
               @onchange="OnChangeAsync" />
        <span>@Label @RequiredMarker</span>
    </label>
    @Messages
</div>

@code {
    private ElementReference _input;
    private bool _shownIndeterminate;

    private protected virtual string Block => "tb-checkbox";

    private protected virtual string? Role => null;

    // Only a bool? can be null, so only it is ever mixed.
    private bool Indeterminate => Value is null;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (typeof(TValue) != typeof(bool) && typeof(TValue) != typeof(bool?))
        {
            throw new InvalidOperationException(
                $"{nameof(TbCheckbox<TValue>)} needs bool or bool?, not {typeof(TValue).Name}.");
        }
    }

    // A click clears the browser's mixed state itself, so it must be set again if the value stays null.
    private Task OnChangeAsync(ChangeEventArgs e)
    {
        _shownIndeterminate = false;
        return SetValueAsync((TValue)(object)(e.Value is true));
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Indeterminate == _shownIndeterminate)
        {
            return;
        }

        _shownIndeterminate = Indeterminate;
        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/checkbox.js");
            await module.InvokeVoidAsync("setIndeterminate", _input, _shownIndeterminate);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the checkbox went with it.
        }
    }
}
