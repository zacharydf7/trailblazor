@namespace Trailblazor
@inherits TbComponentBase
@implements IAsyncDisposable

@* The controls come first, so a keyboard user reaches the button that stops the slides before the slides. *@
<section @ref="_section" @attributes="AdditionalAttributes" aria-roledescription="carousel" aria-label="@AriaLabel"
         style="@Style" class="@ClassNames.Join("tb-carousel", Class)" @onmouseenter="() => _hovered = true"
         @onmouseleave="() => _hovered = false">
    <div data-part="controls" class="tb-carousel__controls">
        @if (AutoPlay is not null)
        {
            <TbIconButton Icon="@(_stopped ? BuiltInIcons.Play : BuiltInIcons.Pause)"
                          AriaLabel="@RotationLabel"
                          Variant="Variant.Text" Size="Size.Small" OnClick="ToggleRotation" data-part="rotation" />
        }
        <TbIconButton Icon="BuiltInIcons.ChevronStart" AriaLabel="@Text(Labels?.Previous, TbStrings.CarouselPrevious)"
                      Variant="Variant.Text" Size="Size.Small" Disabled="@(!Loop && Current == 0)" FocusableWhenDisabled
                      OnClick="() => GoToAsync(Current - 1)" aria-controls="@_slidesId" data-part="previous" />
        <TbIconButton Icon="BuiltInIcons.ChevronEnd" AriaLabel="@Text(Labels?.Next, TbStrings.CarouselNext)"
                      Variant="Variant.Text" Size="Size.Small" Disabled="@(!Loop && Current == _slides.Count - 1)"
                      FocusableWhenDisabled
                      OnClick="() => GoToAsync(Current + 1)" aria-controls="@_slidesId" data-part="next" />
    </div>
    @* Screen readers hear a slide the user brought in, but not each one that turns by itself. *@
    <div id="@_slidesId" data-part="slides" class="tb-carousel__slides" aria-live="@(Rotating ? "off" : "polite")">
        <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    </div>
    @if (ShowPicker && _slides.Count > 1)
    {
        <div data-part="picker" class="tb-carousel__picker">
            @for (var index = 0; index < _slides.Count; index++)
            {
                var at = index;
                <button type="button" data-part="pick" class="tb-carousel__pick" aria-controls="@_slidesId"
                        aria-label="@Format(Text(Labels?.Slide, TbStrings.CarouselSlide), at + 1)"
                        aria-current="@(at == Current ? "true" : null)" @onclick="_goTo.For(at)"></button>
            }
        </div>
    }
</section>
