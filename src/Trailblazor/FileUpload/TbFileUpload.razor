@namespace Trailblazor
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inherits TbFieldBase<IReadOnlyList<IBrowserFile>?>

<div @attributes="RootAttributes" style="@Style"
     class="@ClassNames.Join("tb-field", "tb-file-upload", ShowsInvalid ? "tb-field--invalid" : null,
                Disabled ? "tb-field--disabled" : null, ReadOnly ? "tb-field--readonly" : null, Class)">
    @* A hidden field keeps its input so code can open the picker, out of sight and reach; its errors still show. *@
    @if (ShownLabel is not null)
    {
        <label data-part="label" id="@LabelId" for="@InputId" aria-hidden="@(Hidden ? "true" : null)"
               class="@ClassNames.Join("tb-field__label", Hidden ? "tb-visually-hidden" : LabelHiddenClass,
                          Classes?.Label)">
            @ShownLabel
            @RequiredMarker
        </label>
    }
    @* The file input lies over the whole zone, so a click, Enter or Space, or a dropped file all reach it. *@
    <div data-part="zone" data-dragging="@(_dragging ? "" : null)" aria-hidden="@(Hidden ? "true" : null)"
         class="@ClassNames.Join(DropZone ? "tb-file-upload__zone" : "tb-file-upload__button",
                    Hidden ? "tb-visually-hidden" : null, Classes?.Control)">
        <span class="tb-file-upload__prompt" aria-hidden="true">
            @if (!DropZone)
            {
                @ChooseLabel
            }
            else if (ZoneContent is not null)
            {
                @ZoneContent
            }
            else
            {
                <TbIcon Icon="BuiltInIcons.Upload" />
                @ZoneLabel
            }
        </span>
        @Input
    </div>
    @if (Files.Count > 0 && !Hidden)
    {
        <ul data-part="files" class="tb-file-upload__files">
            @foreach (var file in Files)
            {
                <li data-part="file" class="tb-file-upload__file">
                    <span class="tb-file-upload__name">@file.Name</span>
                    <span class="tb-file-upload__size">@FormatSize(file.Size)</span>
                    <TbIconButton Icon="BuiltInIcons.Close" Size="Size.Small" Variant="Variant.Text"
                                  AriaLabel="@string.Format(CultureInfo.CurrentCulture, RemoveLabel, file.Name)"
                                  Disabled="@(Disabled || ReadOnly)" OnClick="() => RemoveAsync(file)"
                                  data-part="remove" />
                </li>
            }
        </ul>
        <TbButton Variant="Variant.Text" Size="Size.Small" Disabled="@(Disabled || ReadOnly)"
                  OnClick="OnClearClickedAsync" data-part="clear"
                  class="tb-file-upload__clear">@ClearLabel</TbButton>
    }
    @if (_rejected.Count > 0)
    {
        <div data-part="rejected" id="@RejectedId" class="tb-field__error">
            @foreach (var reason in _rejected)
            {
                <div>@reason</div>
            }
        </div>
    }
    @Messages(Classes?.Helper, Classes?.Error)
</div>
