@namespace Trailblazor
@inherits TbComponentBase

<div @attributes="AdditionalAttributes" class="@ClassNames.Join("tb-grid-item", Class)"
     style="@Styles.Join(SpanStyle, Style)">
    @ChildContent
</div>

@code {
    private const int Columns = 12;

    /// <summary>How many of the grid's 12 columns the item covers at every width. Defaults to 12.</summary>
    [Parameter]
    public int Span { get; set; } = Columns;

    /// <summary>The span from the small breakpoint (640px) up. Defaults to the next smaller span.</summary>
    [Parameter]
    public int? SpanSm { get; set; }

    /// <summary>The span from the medium breakpoint (768px) up. Defaults to the next smaller span.</summary>
    [Parameter]
    public int? SpanMd { get; set; }

    /// <summary>The span from the large breakpoint (1024px) up. Defaults to the next smaller span.</summary>
    [Parameter]
    public int? SpanLg { get; set; }

    /// <summary>The span from the extra-large breakpoint (1280px) up. Defaults to the next smaller span.</summary>
    [Parameter]
    public int? SpanXl { get; set; }

    /// <summary>The column (1 to 12) the item starts in, at every width, so the item must fit from there at every
    /// breakpoint. Leave it null to place the item after the previous one.</summary>
    [Parameter]
    public int? Start { get; set; }

    /// <summary>The item's content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private int _sm, _md, _lg, _xl;

    // Every item sets every breakpoint's span, so a nested item never inherits its parent's.
    private string SpanStyle => $"--tb-grid-start: {Start?.ToString() ?? "auto"}; --tb-grid-span: {Span}; "
        + $"--tb-grid-span-sm: {_sm}; --tb-grid-span-md: {_md}; --tb-grid-span-lg: {_lg}; --tb-grid-span-xl: {_xl}";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        CheckColumn(Span, nameof(Span));
        CheckColumn(SpanSm, nameof(SpanSm));
        CheckColumn(SpanMd, nameof(SpanMd));
        CheckColumn(SpanLg, nameof(SpanLg));
        CheckColumn(SpanXl, nameof(SpanXl));
        CheckColumn(Start, nameof(Start));

        _sm = SpanSm ?? Span;
        _md = SpanMd ?? _sm;
        _lg = SpanLg ?? _md;
        _xl = SpanXl ?? _lg;
        if (Start + Math.Max(Math.Max(Span, _sm), Math.Max(Math.Max(_md, _lg), _xl)) - 1 > Columns)
        {
            throw new ArgumentOutOfRangeException(nameof(Start), Start, "The item runs past column 12 at some width.");
        }
    }

    private static void CheckColumn(int? value, string name)
    {
        if (value is < 1 or > Columns)
        {
            throw new ArgumentOutOfRangeException(name, value, "Spans and starts run from 1 to 12.");
        }
    }
}
