@namespace Trailblazor
@inherits TbComponentBase

<div @attributes="AdditionalAttributes" style="@Style"
     class="@ClassNames.Join("tb-container", ClassNames.Modifier("tb-container", MaxWidth), Class)">
    @ChildContent
</div>

@code {
    /// <summary>The widest the container grows. Defaults to <see cref="ContainerWidth.Large"/>.</summary>
    [Parameter]
    public ContainerWidth MaxWidth { get; set; } = ContainerWidth.Large;

    /// <summary>The container's content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
