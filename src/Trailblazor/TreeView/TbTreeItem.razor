@namespace Trailblazor
@typeparam TItem
@inherits TbComponentBase
@implements IDisposable

@if (RendererInfo.IsInteractive)
{
    @Tree!.RowOf(this)
    @* The rows inside it, and anything else written there, shown while it is open. *@
    var open = Tree.IsOpen(this);
    <div role="@(ChildContent is null ? null : "group")" data-part="group" data-tree-item="@_id"
         class="tb-tree__group" hidden="@(!open)">
        @if (open || !HasChildren)
        {
            <CascadingValue Value="Inner" IsFixed="true">@ChildContent</CascadingValue>
        }
    </div>
}
else
{
    @* Without a circuit the tree can't render rows from what registered, so each item renders its own. *@
    var open = ChildContent is not null && (ExpandedGiven ? Expanded : Level <= Tree!.InitialExpandDepth);
    var classes = Tree!.Classes;
    <div @attributes="AdditionalAttributes" role="treeitem" data-part="item" aria-level="@Level"
         aria-disabled="@(Disabled ? "true" : null)"
         aria-expanded="@(ChildContent is null ? null : open ? "true" : "false")" style="@RowStyle"
         class="@ClassNames.Join("tb-tree__item", classes?.Item, Class)">
        <span class="@ClassNames.Join("tb-tree__toggle", classes?.Toggle)" aria-hidden="true"></span>
        <span data-part="content" class="@ClassNames.Join("tb-tree__content", classes?.Content)">@Row</span>
        @if (EndContent is not null)
        {
            <span data-part="end" class="@ClassNames.Join("tb-tree__end", classes?.End)">@EndContent</span>
        }
    </div>
    @if (open)
    {
        <CascadingValue Value="Inner" IsFixed="true">@ChildContent</CascadingValue>
    }
}

@code {
    private readonly string _id = $"tb-tree-item-{Guid.NewGuid():N}";
    private (object Key, string? Text, Icon? Icon, bool Disabled, bool HasChildren) _last;
    private TreeScope<TItem>? _inner;
    private bool? _lastExpanded;

    /// <summary>The item this row stands for. With no <c>KeySelector</c> on the tree, it is also the key, so it must
    /// stay equal across renders. Selection, checks and expansion report these keys. A row with no value, such as a
    /// heading for the rows inside it, opens, closes and is found by typing, but it can't be selected, dragged or
    /// activated, and the tree's item functions and templates aren't called for it. It has a checkbox only when checks
    /// cascade to rows inside it, and it is never in the bound keys.</summary>
    [Parameter]
    public TItem Value { get; set; } = default!;

    /// <summary>The row's text, which typing finds it by. Defaults to the value's text.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Stops this row from being selected, checked or activated.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The row's content in place of its <see cref="Icon"/> and <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? TextContent { get; set; }

    /// <summary>Content at the end of the row, such as badges or controls. Clicks and keys in it never select, expand
    /// or activate the row, so a row's controls go here rather than in its <see cref="TextContent"/>.</summary>
    [Parameter]
    public RenderFragment? EndContent { get; set; }

    /// <summary>Whether this row is open. Bind it with <c>@bind-Expanded</c> to open it from code or to know when the
    /// user does, which also works for a row with no <see cref="Value"/>.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>Raised when the row opens or closes.</summary>
    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Shows the row's toggle before the rows inside it exist, and renders its <see cref="ChildContent"/> only
    /// while it is open, for a large tree or rows that load their own content.</summary>
    [Parameter]
    public bool HasChildren { get; set; }

    /// <summary>The <see cref="TbTreeItem{TItem}"/>s inside this one, and any other content, shown where it is written
    /// while this row is open.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    private TreeScope<TItem>? Scope { get; set; }

    // Changes each time the tree renders, so this item draws its row again.
    [CascadingParameter(Name = TbTreeView<TItem, object>.TreeVersion)]
    private int TreeVersion { get; set; }

    private ITreeItemHost<TItem>? Tree => Scope?.Tree;

    private TbTreeItem<TItem>? Parent => Scope?.Parent;

    private TreeScope<TItem> Inner => _inner ??= new(Tree!, this);

    internal string Id => _id;

    internal bool HasValue { get; private set; }

    // Whether the parent gave Expanded, so the tree's initial depth leaves this row as the parent says.
    internal bool ExpandedGiven { get; private set; }

    // A row with no value is keyed by the item itself, which stays the same while it renders in its place.
    internal object Key => HasValue ? Tree!.KeyOf(Value) : this;

    internal List<TbTreeItem<TItem>> Children { get; } = [];

    internal int Level => (Parent?.Level ?? 0) + 1;

    // The row's indent, with the item's own style after it.
    internal string RowStyle =>
        Style is null ? $"--tb-tree-level: {Level - 1}" : $"--tb-tree-level: {Level - 1}; {Style}";

    // What the row shows, here or in the tree's rows.
    internal RenderFragment Row => TextContent ?? (builder =>
    {
        if (Icon is not null)
        {
            builder.OpenComponent<TbIcon>(0);
            builder.AddComponentParameter(1, nameof(TbIcon.Icon), Icon);
            builder.AddComponentParameter(2, nameof(TbIcon.Size), Size.Small);
            builder.CloseComponent();
        }

        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "tb-tree__text");
        builder.AddContent(5, Text ?? (HasValue ? Value?.ToString() : null));
        builder.CloseElement();
    });

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        HasValue = parameters.TryGetValue<TItem>(nameof(Value), out _);
        ExpandedGiven = parameters.TryGetValue<bool>(nameof(Expanded), out _);
        return base.SetParametersAsync(parameters);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Tree is null)
        {
            throw new InvalidOperationException($"{nameof(TbTreeItem<TItem>)} must be inside a TbTreeView.");
        }

        _last = (Key, Text, Icon, Disabled, HasChildren);
        Tree.AddItem(this, Parent);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // Keys rather than values, so a value made anew on each render doesn't rebuild the tree forever.
        var current = (Key, Text, Icon, Disabled, HasChildren);
        if (!current.Equals(_last))
        {
            _last = current;
            Tree!.ItemChanged();
        }

        // Only a new value from the parent opens or closes the row, so rendering again with the old one keeps what the
        // user did.
        if (ExpandedGiven && Expanded != _lastExpanded)
        {
            _lastExpanded = Expanded;
            await Tree!.SetExpandedAsync(this, Expanded);
        }
    }

    // The tree says when the row opens or closes, other than when its parent asked.
    internal Task ReportExpandedAsync(bool open) => ExpandedChanged.InvokeAsync(open);

    /// <inheritdoc />
    public void Dispose() => Tree?.RemoveItem(this, Parent);
}
