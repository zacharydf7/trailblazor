@namespace Trailblazor
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@typeparam TItem
@typeparam TKey where TKey : notnull
@inherits TbComponentBase

@* Given Items, the rows are flat, each saying its own level, so a row keeps its element and state wherever the tree
   changes. Written as TbTreeItems, each item draws its row where it is written. The scope covers the rows too, so a
   tree inside a row knows it is nested; the version tells the items to draw their rows again. *@
@{ _version++; }
<CascadingValue Value="Scope" IsFixed="true">
<CascadingValue Value="_version" Name="@TreeVersion">
<div @ref="_tree" @attributes="AdditionalAttributes" role="@(ShowsEmpty ? "group" : "tree")" aria-label="@AriaLabel"
     aria-multiselectable="@(!ShowsEmpty && SelectionMode == SelectionMode.Multiple ? "true" : null)"
     aria-disabled="@(Disabled ? "true" : null)" aria-busy="@(Building ? "true" : null)"
     @ontbtreedrop="OnDropAsync" @ontbtreedrop:stopPropagation
     data-virtual="@(Virtualize ? "" : null)" data-rows="@(Virtualize ? _rows.Count : null)"
     data-follows-focus="@(FollowsFocus ? "" : null)" data-no-typeahead="@(TypeAhead ? null : "")"
     data-row-size="@(Virtualize ? RowSize : null)"
     style="@(Virtualize ? Styles.Join($"--tb-tree-row-size: {RowSize}px", Style) : Style)"
     class="@ClassNames.Join("tb-tree", Disabled ? "tb-tree--disabled" : null,
                Virtualize ? "tb-tree--virtual" : null, InsertTemplate is null ? null : "tb-tree--inserts", Class)"
     @onclick:stopPropagation="Nested" @ondblclick:stopPropagation="Nested">
    @ChildContent
    @if (ShowsEmpty)
    {
        <div data-part="empty" class="@ClassNames.Join("tb-tree__empty", Classes?.Empty)">
            @if (EmptyContent is null)
            {
                @EmptyLabel
            }
            else
            {
                @EmptyContent
            }
        </div>
    }
    @if (OnDrop.HasDelegate)
    {
        <span id="@MoveHintId" hidden>@Localizer[TbStrings.TreeViewMoveHint]</span>
        @* Shown by tree-view.js beside a place a drag can't drop, with the reason. *@
        <div data-part="drop-reason" class="tb-tree__drop-reason" aria-hidden="true" hidden></div>
    }
    @{ _scrollRendered = _scrollAfterRender?.Done; }
    @if (ChildContent is null)
    {
        @((RenderFragment)RenderRows)
    }
</div>
</CascadingValue>
</CascadingValue>

@code {
    // The rows for Items, with spacers for those a virtualized tree leaves out, as siblings so their keys hold.
    private void RenderRows(RenderTreeBuilder __builder)
    {
        var focusId = FocusId();
        var next = 0;
        // Every spacer comes from this line: a keyed spacer that moves between lines loses its attributes in the
        // browser.
        foreach (var index in ShownIndexes(focusId).Append(_rows.Count))
        {
            if (index > next)
            {
                <div @key="new Gap(next)" data-part="spacer" aria-hidden="true" class="tb-tree__spacer"
                     style="--tb-tree-gap: @(index - next)"></div>
            }
            if (index == _rows.Count)
            {
                break;
            }
            next = index + 1;
            var row = _rows[index];
            var node = row.Node;
            int? place = Virtualize ? index : null;
            if (row.IsItem)
            {
                RenderItemRow(__builder, row, index, place, focusId);
            }
            else if (row.Kind == TreeRowKind.Loading)
            {
                <div @key="@($"{node.Id}-loading")" role="treeitem" aria-level="@(node.Level + 1)" aria-setsize="1"
                     aria-posinset="1" aria-disabled="true" aria-busy="true" tabindex="-1" data-part="loading"
                     data-index="@place" data-inside="@(Virtualize ? _inside[index] : null)"
                     style="@($"--tb-tree-level: {node.Level}")" class="tb-tree__item tb-tree__item--status">
                    <span class="tb-tree__toggle" aria-hidden="true"></span>
                    <span class="tb-tree__spinner" aria-hidden="true"></span>
                    <span>@LoadingLabel</span>
                </div>
            }
            else
            {
                <div @key="@($"{node.Id}-failed")" role="treeitem" aria-level="@(node.Level + 1)" aria-setsize="1"
                     aria-posinset="1" aria-disabled="true" tabindex="-1" data-part="failed" data-index="@place"
                     data-inside="@(Virtualize ? _inside[index] : null)"
                     style="@($"--tb-tree-level: {node.Level}")" class="tb-tree__item tb-tree__item--status">
                    <span class="tb-tree__toggle" aria-hidden="true"></span>
                    <span class="tb-tree__failed">@LoadFailedLabel</span>
                    <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="() => RetryAsync(node)">
                        @RetryLabel
                    </TbButton>
                </div>
            }
        }
    }

    // One row, drawn by the loop for Items, or in place by the TbTreeItem it stands for.
    private void RenderRow(RenderTreeBuilder __builder, TreeRow<TItem> row, int index, int? place, string? focusId)
    {
        var node = row.Node;
        var context = ContextOf(node);
        var valued = HasValue(node);
        var checkable = CanCheck(node);
        var disabled = Disabled || IsItemDisabled(node);
        var declared = _declared.GetValueOrDefault(node.Key);
        var draggable = CanDragRow(node);
        var nameId = $"{TreeId}-row{index}";
        @* A row is named by all it shows, its end slot included, as the tree pattern's rows are. *@
        <div @attributes="declared?.AdditionalAttributes" @key="node.Key" @ref="_rowRefs[node.Key]" role="treeitem"
             data-part="item" data-key="@node.Id" data-index="@place"
             data-inside="@(Virtualize ? _inside[index] : null)"
             data-text="@TextOf(node)" data-level="@node.Level" aria-level="@node.Level"
             aria-setsize="@(declared is null ? row.SetSize : null)"
             aria-posinset="@(declared is null ? row.Position : null)"
             aria-expanded="@(node.HasChildren ? Flag(context.Expanded) : null)"
             aria-selected="@(CanSelect(node) || context.Selected ? Flag(context.Selected) : null)"
             aria-checked="@(checkable ? context.Checked is { } isChecked ? Flag(isChecked) : "mixed" : null)"
             aria-disabled="@(disabled ? "true" : null)" tabindex="@(node.Id == focusId ? 0 : -1)"
             data-draggable="@(draggable ? "" : null)" aria-describedby="@(draggable ? MoveHintId : null)"
             aria-labelledby="@(InsertTemplate is null ? null : $"{nameId}-content {nameId}-end")"
             style="@(declared?.RowStyle ?? $"--tb-tree-level: {node.Level - 1}")"
             class="@ClassNames.Join("tb-tree__item", context.Selected ? "tb-tree__item--selected" : null,
                        context.Matches ? "tb-tree__item--match" : null, Classes?.Item, declared?.Class,
                        valued ? ItemClass?.Invoke(node.Item) : null)"
             @onclick="_rowClick.For(node.Key)" @ondblclick="_rowDoubleClick.For(node.Key)">
            <span data-part="toggle" aria-hidden="true" class="@ClassNames.Join("tb-tree__toggle", Classes?.Toggle)"
                  @onclick="_toggle.For(node.Key)" @onclick:stopPropagation @ondblclick:stopPropagation>
                @if (node.HasChildren)
                {
                    @Chevron
                }
            </span>
            @if (checkable)
            {
                <span data-part="check" aria-hidden="true"
                      class="@ClassNames.Join(CheckClass(context.Checked), Classes?.Check)"
                      @onclick="_toggleCheck.For(node.Key)" @onclick:stopPropagation @ondblclick:stopPropagation>
                </span>
            }
            <span data-part="content" id="@(InsertTemplate is null ? null : $"{nameId}-content")"
                  class="@ClassNames.Join("tb-tree__content", Classes?.Content)">
                @if (ItemTemplate is not null && valued)
                {
                    @ItemTemplate(context)
                }
                else if (declared is not null)
                {
                    @declared.Row
                }
                else
                {
                    @if (ItemIcon?.Invoke(node.Item) is { } icon)
                    {
                        <TbIcon Icon="icon" Size="Size.Small" />
                    }
                    <span class="tb-tree__text">@TextOf(node)</span>
                }
            </span>
            @if ((declared?.EndContent ?? (ItemEnd is not null && valued ? ItemEnd(context) : null)) is { } end)
            {
                @* The end slot's own controls keep their clicks and keys from the row. *@
                <span data-part="end" id="@(InsertTemplate is null ? null : $"{nameId}-end")"
                      class="@ClassNames.Join("tb-tree__end", Classes?.End)"
                      @onclick:stopPropagation @ondblclick:stopPropagation @onkeydown:stopPropagation>
                    @end
                </span>
            }
            @if (InsertTemplate is not null)
            {
                @if (index == 0)
                {
                    <span data-part="insert" data-edge="start"
                          class="@ClassNames.Join("tb-tree__insert", Classes?.Insert)"
                          @onclick:stopPropagation
                          @ondblclick:stopPropagation @onkeydown:stopPropagation>
                        @InsertTemplate(new(default, 0))
                    </span>
                }
                @if (InsertBelow(node, context) is { } below)
                {
                    <span data-part="insert" class="@ClassNames.Join("tb-tree__insert", Classes?.Insert)"
                          @onclick:stopPropagation
                          @ondblclick:stopPropagation @onkeydown:stopPropagation>
                        @InsertTemplate(below)
                    </span>
                }
            }
        </div>
    }

    private string RowSize => ItemSize.ToString(CultureInfo.InvariantCulture);

    // Keys the spacer that stands for the rows a virtualized tree leaves out, apart from any item's key.
    private sealed record Gap(int Start);

    private static string Flag(bool value) => value ? "true" : "false";

    private static string CheckClass(bool? state) => ClassNames.Join("tb-tree__check",
        state switch { true => "tb-tree__check--checked", null => "tb-tree__check--mixed", _ => null });
}
