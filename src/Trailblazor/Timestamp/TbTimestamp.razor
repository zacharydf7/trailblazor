@namespace Trailblazor
@inherits TbComponentBase

@if (Value is { } value)
{
    @if (Format == TimestampFormat.Relative)
    {
        @* The exact moment is the tooltip and the description; tabindex lets keyboard users reach it too. *@
        <TbTooltip Text="@ExactText(value)">
            <time @attributes="AdditionalAttributes" class="@ClassNames.Join("tb-timestamp", Class)" style="@Style"
                  datetime="@ShownTime.Iso(value)" tabindex="0">@TextOf(value)</time>
        </TbTooltip>
    }
    else
    {
        <time @attributes="AdditionalAttributes" class="@ClassNames.Join("tb-timestamp", Class)" style="@Style"
              datetime="@ShownTime.Iso(value)">@TextOf(value)</time>
    }
}
else
{
    <span @attributes="AdditionalAttributes" class="@ClassNames.Join("tb-timestamp", "tb-timestamp--empty", Class)"
          style="@Style">@EmptyValue.Of(Localizer[TbStrings.EmptyValue])</span>
}
