@namespace Trailblazor
@inherits TbButtonBase
@using Microsoft.Extensions.DependencyInjection

@Root(FullWidth ? "tb-button--full-width" : null, null, @<text>
    @if (Busy)
    {
        <span data-part="spinner" class="@ClassNames.Join("tb-button__spinner", Classes?.Spinner)"></span>
    }
    @if (Start is not null || StartIcon is not null)
    {
        <span data-part="start" class="@ClassNames.Join("tb-button__start", Classes?.Start)">
            @if (StartIcon is { } startIcon)
            {
                <TbIcon Icon="startIcon" Size="ShownSize" />
            }
            @Start
        </span>
    }
    <span data-part="label" class="@ClassNames.Join("tb-button__label", Classes?.Label)">@ChildContent</span>
    @if (CooldownLeft is { } left)
    {
        @* Hidden from screen readers so the countdown isn't read every second; the description says it once. *@
        <span aria-hidden="true" data-part="cooldown" class="tb-button__cooldown">@LeftText(left)</span>
    }
    @if (End is not null || EndIcon is not null)
    {
        <span data-part="end" class="@ClassNames.Join("tb-button__end", Classes?.End)">
            @End
            @if (EndIcon is { } endIcon)
            {
                <TbIcon Icon="endIcon" Size="ShownSize" />
            }
        </span>
    }
</text>)

@code {
    /// <summary>The button's label.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Makes the button as wide as its container, which suits the main action on a narrow form.</summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Content before the label, usually an icon.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the label, usually an icon.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>An icon before the label: the short form of a <see cref="TbIcon"/> in <see cref="Start"/>.</summary>
    [Parameter]
    public Icon? StartIcon { get; set; }

    /// <summary>An icon after the label: the short form of a <see cref="TbIcon"/> in <see cref="End"/>.</summary>
    [Parameter]
    public Icon? EndIcon { get; set; }

    /// <summary>Extra CSS classes for the button's inner parts.</summary>
    [Parameter]
    public ButtonClasses? Classes { get; set; }

    /// <summary>How long the button ignores clicks after its <c>OnClick</c> finishes without throwing, for an action
    /// such as Resend code. It stays focusable and shows the seconds left after its text. Its description says how
    /// many seconds are left, and screen readers hear it once as the cooldown starts. Toggle buttons and links never
    /// cool down. A reload ends it, so enforce any limit that must hold on the server.</summary>
    [Parameter]
    public TimeSpan? Cooldown { get; set; }

    /// <summary>The words the button shows and says while its <see cref="Cooldown"/> runs.</summary>
    [Parameter]
    public ButtonLabels Labels { get; set; } = new();

    // Asked for only once a cooldown runs, so a button works without AddTrailblazor.
    private ITbLocalizer Localizer => Services.GetRequiredService<ITbLocalizer>();

    private protected override TimeSpan? CooldownLength => Cooldown;

    private string LeftText(int left) => string.Format(
        System.Globalization.CultureInfo.CurrentCulture, Labels.CooldownLeft ?? Localizer[TbStrings.ButtonCooldownLeft],
        left);

    private protected override string CooldownWords(int seconds) => string.Format(
        System.Globalization.CultureInfo.CurrentCulture,
        Labels.Cooldown ?? Localizer.Plural(TbStrings.ButtonCooldown, seconds), seconds);
}
