@namespace Trailblazor
@typeparam TItem
@inherits TbComponentBase
@implements IAsyncDisposable

@* The script sets data-ready here once the drags and keys are heard, which tests wait for. *@
<div @attributes="AdditionalAttributes" style="@Style"
     class="@ClassNames.Join("tb-sortable", Disabled ? "tb-sortable--disabled" : null, Class)">
    @* Safari drops a list's semantics when its markers are hidden, so the role is set as well. *@
    <ul @ref="_list" role="list" aria-label="@Label" data-part="list" data-sortable
        data-commits="@_answered" data-group="@Group" data-list-id="@ListId" class="tb-sortable__list">
        @for (var index = 0; index < Items.Count; index++)
        {
            var item = Items[index];
            var at = index;
            @* Test helpers find an item by its label, since an item holding a field has more text than its name. *@
            <li @key="KeyOf(item)" data-part="item" data-key="@IdOf(item)" data-text="@ItemLabel?.Invoke(item)"
                class="tb-sortable__item">
                @((RenderFragment)(handle => MoveHandle.Add(handle, 0, HandleLabel(item), at, Items.Count, Disabled,
                    Labels, Localizer,
                    (to, args) => UserMoveAsync(item, to, args.Detail > 0 ? "pointer" : "keyboard"),
                    Group is null ? null : () => MoveTargets(item), GroupHint)))
                <div class="tb-sortable__content">@ItemTemplate(item)</div>
            </li>
        }
    </ul>
    @* The announcer reads the reason out, so this is only for sight. *@
    <div data-part="drop-reason" class="tb-sortable__reason" aria-hidden="true" hidden></div>
</div>
