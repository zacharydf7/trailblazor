@namespace Trailblazor
@inherits TbComponentBase

@* Safari drops the list role from a list without bullets, so it is set again. *@
<ol @attributes="AdditionalAttributes" role="list" aria-label="@AriaLabel" data-part="timeline" style="@Style"
    class="@ClassNames.Join("tb-timeline", Class)">
    @ChildContent
</ol>

@code {
    /// <summary>A label this timeline's use is counted under, such as <c>"trip-history"</c>, so the app can count how
    /// often people see it through the <c>Trailblazor</c> meter. Controls that share a label count together; a control
    /// without one isn't counted. It names what the control shows, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => field ??= new(Services, GetType());

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => Telemetry.Rendered(TelemetryName);

    /// <summary>The <see cref="TbTimelineItem"/> events, in the order they happened or will happen.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Names the list for screen readers, such as "Trip history". Leave it out when a heading just before the
    /// timeline already says what it is.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }
}
