@namespace Trailblazor
@typeparam TItem
@typeparam TKey where TKey : notnull
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>
@implements ITreeChoice

@Layout(Classes, @<text>
    @if (ReadOnly)
    {
        @* A read-only field can be focused and read, but opens nothing. *@
        <button @ref="_trigger" type="button" @attributes="ControlAttributes" id="@InputId" data-part="input"
                aria-labelledby="@NamedBy" aria-describedby="@InputDescribedBy" class="@TriggerClass">
            @ValueContent
        </button>
    }
    else
    {
        <TbPopover @bind-Open="_open" @bind-Open:after="ToggledAsync" id="@InputId" Disabled="Disabled"
                   Class="tb-tree-select__popover">
            <Trigger>
                @* The label and the chosen items name the button, as they would a select. The popup is named by the
                   button's id, which skips the button's aria-labelledby, so it takes just the label from aria-label. *@
                <button @ref="_trigger" type="button" @attributes="TriggerAttributes(context)" id="@InputId"
                        data-part="input" aria-labelledby="@NamedBy" aria-label="@ShownLabel"
                        aria-required="@AriaRequired"
                        aria-invalid="@(ShowsInvalid ? "true" : null)" aria-describedby="@InputDescribedBy"
                        class="@TriggerClass">
                    @ValueContent
                    <TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" />
                </button>
            </Trigger>
            <ChildContent>
                @if (Searchable)
                {
                    @* The search waits for a pause in typing, and Down Arrow is the only key it sends to the server. *@
                    <input type="search" data-part="search" autocomplete="off" aria-label="@SearchText"
                           placeholder="@SearchText" @bind="_search" @bind:event="oninput" @bind:after="Searched"
                           data-input-delay="@SearchDelay" @ontbtreesearchdown="SearchDownAsync"
                           class="tb-select__filter tb-tree-select__search" />
                }
                <CascadingValue TValue="ITreeChoice" Value="this" IsFixed="true">
                    <TbTreeView @ref="_tree" TItem="TItem" TKey="TKey" Items="Items" KeySelector="KeySelector"
                                ChildrenSelector="ChildrenSelector"
                                LoadChildren="@(LoadChildren is null ? null : LoadAndKeepAsync)"
                                HasChildren="HasChildren" ItemText="ItemText" ItemIcon="ItemIcon"
                                IsSelectable="IsSelectable" IsDisabled="IsDisabled"
                                InitialExpandDepth="InitialExpandDepth" AriaLabel="@ShownLabel" Filter="SearchFilter"
                                FilterKeepsDescendants SelectedKeys="SelectedKeys" Checkable="ChecksRows"
                                CheckedKeys="CheckedKeys" CheckedKeysChanged="CheckedAsync"
                                CascadeChecks="CascadesChecks"
                                EmptyContent="@(SearchFilter is null ? null : NoMatches)"
                                Labels="@(Labels.Tree ?? new())" Class="tb-tree-select__tree" />
                </CascadingValue>
            </ChildContent>
        </TbPopover>
    }
</text>, null, RendererInfo.IsInteractive && Clearable && !Disabled && !ReadOnly && !IsMissing(Value)
    ? ClearButton : null)

@code {
    // Milliseconds of quiet in the search before it filters.
    private const int SearchDelay = 200;

    private readonly Dictionary<TKey, TItem> _loaded = [];
    private OrderedDictionary<TKey, TItem>? _byKey;
    private object? _byKeyFor;
    private ElementReference _trigger;
    private TbTreeView<TItem, TKey>? _tree;
    private bool _open;
    private bool _lastOpen;
    private string? _search;
    private bool _saidNoMatches;

    /// <summary>The items at the top of the tree. The tree and the field's text read them again when this is a new
    /// collection; call <see cref="RefreshAsync"/> after changing it, or the children it holds, in place.</summary>
    [Parameter, EditorRequired]
    public IEnumerable<TItem> Items { get; set; } = [];

    /// <summary>Gives each item the key the value holds. Required.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, TKey> KeySelector { get; set; } = default!;

    /// <summary>The text an item shows in the tree and, once chosen, in the field. Required.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, string> ItemText { get; set; } = default!;

    /// <summary>An item's children, held in memory.</summary>
    [Parameter]
    public Func<TItem, IEnumerable<TItem>?>? ChildrenSelector { get; set; }

    /// <summary>Loads an item's children when it first opens, in place of <see cref="ChildrenSelector"/>.</summary>
    [Parameter]
    public Func<TItem, CancellationToken, Task<IEnumerable<TItem>>>? LoadChildren { get; set; }

    /// <summary>Whether an item has children to load, so it shows as openable before they load.</summary>
    [Parameter]
    public Func<TItem, bool>? HasChildren { get; set; }

    /// <summary>The text the field shows for a chosen key whose item hasn't loaded, such as a saved choice under a
    /// branch that <see cref="LoadChildren"/> hasn't opened yet. Defaults to the key's own text.</summary>
    [Parameter]
    public Func<TKey, string>? UnmatchedText { get; set; }

    /// <summary>An icon before an item's text.</summary>
    [Parameter]
    public Func<TItem, Icon?>? ItemIcon { get; set; }

    /// <summary>Whether an item can be chosen, so a heading such as a country can open without being chosen.
    /// Defaults to every item.</summary>
    [Parameter]
    public Func<TItem, bool>? IsSelectable { get; set; }

    /// <summary>Whether an item is turned off: it shows, but can't be chosen.</summary>
    [Parameter]
    public Func<TItem, bool>? IsDisabled { get; set; }

    /// <summary>How many levels of the tree start open.</summary>
    [Parameter]
    public int InitialExpandDepth { get; set; }

    /// <summary>Adds a search field above the tree. It keeps the items whose text contains what's typed, with the
    /// items above and below them. It searches only the items loaded so far, so with <see cref="LoadChildren"/> it
    /// skips branches that haven't been opened.</summary>
    [Parameter]
    public bool Searchable { get; set; }

    /// <summary>The words the field shows and says to screen readers, such as the search box's name. Each one left
    /// null uses the app's text.</summary>
    [Parameter]
    public TreeSelectLabels Labels { get; set; } = new();

    /// <summary>Adds a button that clears the choice.</summary>
    [Parameter]
    public bool Clearable { get; set; }

    /// <summary>Whether the tree is open. Bind it with <c>@bind-Open</c> to open or close the tree from code; only a
    /// new value from the parent opens or closes it, so a render that passes the same value again leaves the user's
    /// choice alone.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Raised when the user opens or closes the tree, or when it can't open as asked because the field is
    /// disabled or read only.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The text the field shows with nothing chosen.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Extra CSS classes for the field's parts.</summary>
    [Parameter]
    public FieldClasses? Classes { get; set; }

    // The text the field shows for its value, or null to show the placeholder.
    private protected abstract string? ValueText { get; }

    // Empties the value for the clear button.
    private protected abstract Task ClearValueAsync();

    // The rows the tree marks selected.
    private protected virtual IReadOnlyCollection<TKey>? SelectedKeys => null;

    // Whether rows carry checks, which a click, Enter or Space toggles, rather than being chosen one at a time.
    private protected virtual bool ChecksRows => false;

    private protected virtual IReadOnlyCollection<TKey>? CheckedKeys => null;

    private protected virtual bool CascadesChecks => false;

    private protected virtual Task CheckedAsync(IReadOnlyCollection<TKey> keys) => Task.CompletedTask;

    // A row the user chose in a tree without checks.
    private protected virtual Task ChosenAsync(TKey key) => Task.CompletedTask;

    private string ValueId => $"{FieldId}-value";

    private string NamedBy => ShownLabel is null ? ValueId : $"{LabelId} {ValueId}";

    private string TriggerClass => ClassNames.Join("tb-field__input", "tb-select__trigger", "tb-tree-select__trigger",
        Classes?.Input);

    private string SearchText => Labels.Search ?? Localizer[TbStrings.TreeSelectSearch];

    private string NoResultsText => Labels.NoResults ?? Localizer[TbStrings.SelectNoResults];

    private RenderFragment ValueContent => ValueText is { } text
        ? @<span id="@ValueId" data-part="value" class="tb-select__value">@text</span>
        : @<span id="@ValueId" data-part="value" class="tb-select__placeholder">@Placeholder</span>;

    private RenderFragment ClearButton =>
        @<TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.TreeSelectClear])"
                       aria-describedby="@ClearDescribedBy" Size="Size.Small" OnClick="ClearAsync" data-part="clear" />;

    private RenderFragment NoMatches => @<div data-part="no-results" class="tb-select__no-results">
        @NoResultsText
    </div>;

    // Made once per search, since the tree lays out its rows again for each new filter.
    private Func<TItem, bool>? SearchFilter { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _trigger.FocusAsync(preventScroll);

    // The children it loads are kept, so the field can show a chosen one's text.
    private async Task<IEnumerable<TItem>> LoadAndKeepAsync(TItem item, CancellationToken cancel)
    {
        List<TItem> children = [.. await LoadChildren!(item, cancel)];
        children.ForEach(child => _loaded[KeySelector(child)] = child);
        return children;
    }

    // A live region that joins the page already holding its text isn't spoken, so the announcer says it.
    private void Searched()
    {
        var text = _search?.Trim();
        SearchFilter = string.IsNullOrEmpty(text) ? null
            : item => ItemText(item).Contains(text, StringComparison.CurrentCultureIgnoreCase);
        var none = SearchFilter is { } filter && !Known().Any(filter);
        if (none && !_saidNoMatches)
        {
            Announcer.Polite(NoResultsText);
        }

        _saidNoMatches = none;
    }

    private async Task SearchDownAsync()
    {
        if (_tree is not null)
        {
            await _tree.FocusRowAsync(SearchFilter);
        }
    }

    private async Task ToggledAsync()
    {
        if (!_open)
        {
            ClearSearch();
        }

        await OpenChanged.InvokeAsync(_open);
    }

    private void ClearSearch()
    {
        _search = null;
        SearchFilter = null;
        _saidNoMatches = false;
    }

    // Closes the tree and its search, as a select closes its list once an option is chosen.
    private protected async Task CloseAsync()
    {
        _open = false;
        ClearSearch();
        await OpenChanged.InvokeAsync(false);
    }

    // The clear button goes away with the value, so focus moves to the field's button instead of the page.
    private async Task ClearAsync()
    {
        await ClearValueAsync();
        StateHasChanged();
        await _trigger.FocusAsync();
    }

    // A new Open from the parent opens or closes the tree; a disabled or read-only field stays closed and reports
    // false, so the parent's value matches.
    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (Open == _lastOpen)
        {
            return;
        }

        _lastOpen = Open;
        var open = Open && !Disabled && !ReadOnly;
        if (open != _open)
        {
            _open = open;
            if (!open)
            {
                ClearSearch();
            }
        }

        if (open != Open)
        {
            await OpenChanged.InvokeAsync(open);
        }
    }

    // The items held in memory, in tree order, then the children loaded so far.
    private protected IEnumerable<TItem> Known() => Walk(Items).Concat(_loaded.Values);

    // Each item, then the items inside it, without recursing, so a deep tree can't overflow the stack.
    private IEnumerable<TItem> Walk(IEnumerable<TItem>? items)
    {
        var levels = new Stack<IEnumerator<TItem>>();
        levels.Push((items ?? []).GetEnumerator());
        try
        {
            while (levels.TryPeek(out var level))
            {
                if (!level.MoveNext())
                {
                    levels.Pop().Dispose();
                    continue;
                }

                yield return level.Current;
                if (ChildrenSelector?.Invoke(level.Current) is { } children)
                {
                    levels.Push(children.GetEnumerator());
                }
            }
        }
        finally
        {
            // A caller that stops early, as Any does, leaves levels open.
            while (levels.TryPop(out var open))
            {
                open.Dispose();
            }
        }
    }

    // An element takes one set of splatted attributes, so the field's and the popover's go together.
    private Dictionary<string, object> TriggerAttributes(PopoverTrigger trigger)
    {
        var attributes = new Dictionary<string, object>(ControlAttributes ?? new Dictionary<string, object>());
        foreach (var (name, value) in trigger.Attributes)
        {
            attributes[name] = value;
        }

        return attributes;
    }

    // Each known item by its key: those held in memory in tree order, then the children loaded so far. Like the tree's
    // rows, it's rebuilt for new items or selectors, a loaded child or RefreshAsync, but not on every render.
    private protected OrderedDictionary<TKey, TItem> ByKey()
    {
        var builtFor = (Items, _loaded.Count, KeySelector.Method, ChildrenSelector?.Method);
        if (_byKey is null || !builtFor.Equals(_byKeyFor))
        {
            _byKey = [];
            foreach (var item in Known())
            {
                _byKey.TryAdd(KeySelector(item), item);
            }

            _byKeyFor = builtFor;
        }

        return _byKey;
    }

    /// <summary>Reads <see cref="Items"/> again, after it, or the children it holds, changed in place, or after what
    /// <see cref="KeySelector"/> or <see cref="ChildrenSelector"/> read from outside the item changed. Children already
    /// loaded with <see cref="LoadChildren"/> stay.</summary>
    public Task RefreshAsync()
    {
        _byKey = null;
        StateHasChanged();
        return _tree?.RefreshAsync() ?? Task.CompletedTask;
    }

    private protected string TextOf(TKey key, OrderedDictionary<TKey, TItem> items) =>
        items.TryGetValue(key, out var item) ? ItemText(item) : UnmatchedText?.Invoke(key) ?? key.ToString() ?? "";

    Task ITreeChoice.ChosenAsync(object key) => ChosenAsync((TKey)key);
}
