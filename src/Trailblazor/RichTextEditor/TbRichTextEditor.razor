@namespace Trailblazor
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbBoxedFieldBase<string>
@implements IAsyncDisposable
@inject JsModuleLoader Modules
@inject IDialogService Dialogs

@Layout(Classes, @<text>
    <div data-part="editor" class="tb-rich-text-editor">
        @if (ShowToolbar && (Tools.Count > 0 || ShowsImageButton || ShowSource))
        {
            <TbToolbar AriaLabel="@(Labels.Toolbar ?? Localizer[TbStrings.RichTextEditorToolbar])" data-part="toolbar"
                       aria-controls="@InputId" Class="tb-rich-text-editor__toolbar">
                @foreach (var tool in Tools)
                {
                    @* The script keeps aria-pressed up to date as the selection moves, so .NET never changes it. *@
                    <TbIconButton Icon="tool.Icon" AriaLabel="@tool.Label" ShowTooltip Size="Size.Small"
                                  Disabled="@(Disabled || ReadOnly || _source)" data-format="@tool.Format"
                                  data-block="@tool.Block" data-command="@tool.Command"
                                  aria-pressed="@(tool.Command is null ? "false" : null)"
                                  aria-haspopup="@(tool.Command == "link" ? "dialog" : null)"
                                  aria-keyshortcuts="@tool.Shortcuts" />
                    @if (tool.Command == "table")
                    {
                        @* The script says where the caret is as the menu opens, so its commands fit the table there,
                           and it runs the command chosen. *@
                        <TbMenu Icon="RichTextEditorIcons.TableMenu" Variant="Trailblazor.Variant.Text"
                                Size="Size.Small" Disabled="@(Disabled || ReadOnly || _source)" data-part="table-menu"
                                AriaLabel="@(Labels.TableMenu ?? Localizer[TbStrings.RichTextEditorTableMenu])"
                                OpenChanged="OpenTableMenuAsync">
                            <TbMenuItem Disabled="@(!_table.InCell || _table.InHeaderRow)"
                                        data-table-command="rowAbove">
                                @(Labels.AddRowAbove ?? Localizer[TbStrings.RichTextEditorAddRowAbove])
                            </TbMenuItem>
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="rowBelow">
                                @(Labels.AddRowBelow ?? Localizer[TbStrings.RichTextEditorAddRowBelow])
                            </TbMenuItem>
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="columnLeft">
                                @(Labels.AddColumnLeft ?? Localizer[TbStrings.RichTextEditorAddColumnLeft])
                            </TbMenuItem>
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="columnRight">
                                @(Labels.AddColumnRight ?? Localizer[TbStrings.RichTextEditorAddColumnRight])
                            </TbMenuItem>
                            <TbMenuSeparator />
                            <TbMenuCheckboxItem Disabled="!_table.InCell" Checked="_table.HasHeaderRow"
                                                data-table-command="header">
                                @(Labels.HeaderRow ?? Localizer[TbStrings.RichTextEditorHeaderRow])
                            </TbMenuCheckboxItem>
                            <TbMenuSeparator />
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="deleteRow">
                                @(Labels.DeleteRow ?? Localizer[TbStrings.RichTextEditorDeleteRow])
                            </TbMenuItem>
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="deleteColumn">
                                @(Labels.DeleteColumn ?? Localizer[TbStrings.RichTextEditorDeleteColumn])
                            </TbMenuItem>
                            <TbMenuItem Disabled="!_table.InCell" data-table-command="deleteTable">
                                @(Labels.DeleteTable ?? Localizer[TbStrings.RichTextEditorDeleteTable])
                            </TbMenuItem>
                        </TbMenu>
                    }
                }
                @if (ShowsImageButton)
                {
                    <TbIconButton Icon="RichTextEditorIcons.Image" ShowTooltip Size="Size.Small"
                                  Disabled="@(Disabled || ReadOnly || _source)" aria-haspopup="dialog"
                                  AriaLabel="@(Labels.Image ?? Localizer[TbStrings.RichTextEditorImage])"
                                  OnClick="InsertImageAsync" data-part="image" />
                }
                @if (ShowSource)
                {
                    <TbIconButton Icon="RichTextEditorIcons.Source" ShowTooltip Size="Size.Small" Disabled="Disabled"
                                  AriaLabel="@(Labels.Source ?? Localizer[TbStrings.RichTextEditorSource])"
                                  Pressed="_source" PressedChanged="ShowSourceAsync" data-part="source-toggle" />
                }
            </TbToolbar>
        }
        @* The script owns everything inside the editing area once the page is interactive. Text typed before it
           attaches would be lost, so the area becomes editable only then, together with data-ready, which tests
           wait for. *@
        <div @attributes="ControlAttributes" @ref="_content" @ontbrichtextchange="OnChangedAsync"
             @ontbrichtextlink="OnLinkAsync" @ontbrichtextpaste="OnPasteAsync" data-part="input"
             id="@InputId" role="textbox" aria-autocomplete="@(SuggestsMentions ? "list" : null)"
             aria-controls="@(SuggestsMentions ? MentionListId : null)"
             data-triggers="@(SuggestsMentions ? MentionTriggers : null)"
             aria-multiline="true" aria-labelledby="@(ShownLabel is null ? null : LabelId)"
             aria-describedby="@(ShowCount ? ClassNames.Join(InputDescribedBy, CountId) : InputDescribedBy)"
             aria-required="@AriaRequired"
             aria-invalid="@(ShowsInvalid && !_source ? "true" : null)" aria-readonly="@(ReadOnly ? "true" : null)"
             aria-disabled="@(Disabled ? "true" : null)" aria-placeholder="@Placeholder" data-placeholder="@Placeholder"
             contenteditable="@(Disabled || _handle is null ? "false" : "true")" tabindex="@(Disabled ? "-1" : "0")"
             data-ready="@(_handle is null ? null : "")" data-count="@(ShowCount ? CountId : null)" hidden="@_source"
             data-sends-answered="@_sendsAnswered"
             @ontbcharactersleft="OnCharactersLeft"
             inputmode="@(ReadOnly ? "none" : null)" spellcheck="true"
             style="--tb-rich-text-editor-lines: @Lines; --tb-rich-text-editor-max-lines: @(MaxLines ?? 0)"
             class="@ClassNames.Join("tb-field__input", "tb-rich-text-editor__content",
                        MaxLines is null ? null : "tb-rich-text-editor__content--limited", Classes?.Input)">
            @if (!RendererInfo.IsInteractive)
            {
                @((MarkupString)Canonical)
            }
        </div>
        @if (SuggestsMentions)
        {
            @* The script moves this mark to the trigger being typed, and the list of suggestions opens under it. *@
            <span data-part="mention-caret" class="tb-mention-input__caret" aria-hidden="true"></span>
            <div @ref="_mentionList" id="@MentionListId" popover="manual" role="listbox" data-part="mention-list"
                 aria-labelledby="@(ShownLabel is null ? null : LabelId)"
                 data-results-for="@_suggestions.ResultsFor" class="tb-select__listbox tb-mention-input__listbox">
                @_suggestions.Options(MentionListId, MentionItemTemplate, withIds: true)
            </div>
        }
        @if (_source)
        {
            @* Re-keyed whenever the parse cleans up an edit, so the text area shows what was kept even when the
               value didn't change. *@
            <textarea @key="_sourceChanges" @ref="_sourceArea" data-part="source"
                      aria-labelledby="@(ShownLabel is null ? null : LabelId)"
                      aria-describedby="@(ShowCount ? ClassNames.Join(InputDescribedBy, CountId) : InputDescribedBy)"
                      aria-required="@AriaRequired" aria-invalid="@(ShowsInvalid ? "true" : null)"
                      readonly="@ReadOnly" disabled="@Disabled" spellcheck="false" rows="@Lines" value="@_sent"
                      @onchange="OnSourceChangedAsync" class="tb-field__input tb-rich-text-editor__source"></textarea>
        }
    </div>
</text>, null, null)

@code {
    private ElementReference _content;
    private ElementReference _mentionList;
    private IJSObjectReference? _handle;
    private readonly MentionSuggestions _suggestions = new();
    private DotNetObjectReference<MentionInputEvents>? _mentionEvents;
    // Whether the script has the list of suggestions, so it hears when the editor starts or stops suggesting.
    private bool _suggesting;
    private int? _announcedSuggestions;
    // The mentions in the value the app last had, so it hears only of changes the user makes. The value the parent
    // last passed in is kept too, since a parent that doesn't store the value passes the same old one with every
    // render.
    private IReadOnlyList<Mention> _mentions = [];
    private string? _mentionsOf;
    private string? _mentionsParameter;
    private IReadOnlyList<Mention>? _mentionsToReport;
    // How many values the script has sent, and how many of those the app has taken with their callbacks finished.
    // The script counts its sends in data-sends and this count goes out in data-sends-answered, so a test helper can
    // wait until the two match.
    private int _sendsReceived;
    private int _sendsAnswered;
    // The value the script holds, so the value coming back from the parent isn't sent to it again.
    private string? _sent;
    // A long value or paste comes in parts, one event each.
    private readonly StringBuilder _parts = new();
    private readonly StringBuilder _pasteParts = new();
    // Values given to the parent while its handler runs. A parent that stores each one late passes older ones back
    // while typing goes on, and those must not replace what the script now holds.
    private readonly List<string> _echoes = [];
    // The ValueChanged now running; the parent gets one at a time, so it can't store an older value after a newer one.
    private Task? _delivering;
    private string? _parameterValue;
    private object? _sentOptions;
    private bool _disposed;
    private (string? Value, bool Missing)? _missing;
    private bool _source;
    private RichTextTableState _table = new(false, false, false);
    private int _sourceChanges;
    private ElementReference _sourceArea;

    /// <summary>The formats the editor allows: the toolbar has a button for each, and text pasted in keeps only these.
    /// <see cref="RichTextFormats.Link"/> adds a link button that opens a dialog, which needs a <see cref="TbRoot"/> in
    /// the layout. Defaults to all of them; with <see cref="RichTextFormats.None"/> and
    /// <see cref="RichTextBlocks.None"/> in <see cref="Blocks"/>, it's a plain multi-line field.</summary>
    [Parameter]
    public RichTextFormats Formats { get; set; } = RichTextHtmlReader.AllFormats;

    /// <summary>The kinds of block the editor allows: the toolbar has a button for each (three for headings, and
    /// Horizontal line for <see cref="RichTextBlocks.Rules"/>), with outdent and indent buttons when it allows a list,
    /// and text pasted in keeps only these. Defaults to all of them but <see cref="RichTextBlocks.Images"/> and
    /// <see cref="RichTextBlocks.Tables"/>;
    /// <see cref="RichTextBlocks.None"/> allows only plain paragraphs.</summary>
    [Parameter]
    public RichTextBlocks Blocks { get; set; } = RichTextHtmlReader.AllBlocks;

    /// <summary>The URL schemes a link may use, as <see cref="RichTextSchema.LinkSchemes"/> describes: a link pasted in
    /// with any other is dropped, and the link dialog won't take one. Defaults to <c>http</c>, <c>https</c>,
    /// <c>mailto</c> and <c>tel</c>.</summary>
    [Parameter]
    public IReadOnlyList<string> LinkSchemes { get; set; } = RichTextSchema.Default.LinkSchemes;

    /// <summary>The URL schemes an image's source may use when <see cref="Blocks"/> has
    /// <see cref="RichTextBlocks.Images"/>, as <see cref="RichTextSchema.ImageSchemes"/> describes: an image with any
    /// other is dropped, whether it's in the value or pasted in. Defaults to <c>https</c> and <c>http</c>.</summary>
    [Parameter]
    public IReadOnlyList<string> ImageSchemes { get; set; } = RichTextSchema.Default.ImageSchemes;

    /// <summary>The characters that start a mention, such as <c>"@"</c>, or <c>"@#"</c> for people and tags. With
    /// any set, the editor keeps the mentions in its value and in what is pasted, whatever their trigger, as
    /// <see cref="RichTextSchema.Mentions"/> describes, each as one unit that the caret steps over and Backspace or
    /// Delete removes whole. With <see cref="MentionSearch"/> or <see cref="MentionItems"/> too, typing one of
    /// them at the start of a word suggests what to mention. It can't hold whitespace. Without triggers, a mention
    /// reads as its text. Defaults to none.</summary>
    [Parameter]
    public string? MentionTriggers { get; set; }

    /// <summary>Finds the suggestions for a trigger and the text typed after it, such as people whose names start
    /// with it. Typing more cancels the previous search. Without it, <see cref="MentionItems"/> are filtered by the
    /// text.</summary>
    [Parameter]
    public Func<MentionQuery, CancellationToken, Task<IEnumerable<MentionItem>>>? MentionSearch { get; set; }

    /// <summary>Suggestions to filter by the text typed after a trigger, when there is no
    /// <see cref="MentionSearch"/>.</summary>
    [Parameter]
    public IEnumerable<MentionItem>? MentionItems { get; set; }

    /// <summary>The most suggestions the list shows. Defaults to 8.</summary>
    [Parameter]
    public int MaxMentionItems { get; set; } = 8;

    /// <summary>Shows each suggestion in the list, in place of its text and description.</summary>
    [Parameter]
    public RenderFragment<MentionItem>? MentionItemTemplate { get; set; }

    /// <summary>Raised with the mentions in the value, in order, when the user's edit changes them: one is chosen,
    /// pasted or deleted. Each has the id of its item, so the app needn't read the HTML;
    /// <see cref="RichTextDocument.Mentions"/> gives the same list for a saved value.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<Mention>> OnMentionsChanged { get; set; }

    /// <summary>Raised when <see cref="MentionSearch"/> fails. The list closes, screen readers hear that
    /// suggestions couldn't load, and typing again searches again. The failure is also logged as a warning, and
    /// counted in <c>trailblazor.control.failed</c> when the editor has a <c>TelemetryName</c>.</summary>
    [Parameter]
    public EventCallback<Exception> OnMentionSearchFailed { get; set; }

    /// <summary>Stores an image file the user chose, such as in the app's storage, and returns its URL. Read the file
    /// with <c>OpenReadStream(MaxImageSize, token)</c>, since the stream's default limit is only 512 KB, and pass the
    /// token to any other work too: it's canceled if the dialog closes first, as when the user cancels. With this and
    /// <see cref="RichTextBlocks.Images"/> in <see cref="Blocks"/>, the toolbar gets an Image button that opens a
    /// dialog to choose the file and give its alt text, or mark it decorative. The URL must be one
    /// <see cref="ImageSchemes"/> allows.</summary>
    [Parameter]
    public Func<IBrowserFile, CancellationToken, Task<string>>? UploadImage { get; set; }

    /// <summary>The largest image file the Image button takes, in bytes; pass it on to <c>OpenReadStream</c> in
    /// <see cref="UploadImage"/>. Defaults to 5 MB.</summary>
    [Parameter]
    public long MaxImageSize { get; set; } = 5_000_000;

    /// <summary>Changes what is pasted or dropped in, after the editor's own cleanup: it gets the pasted text as a
    /// document and returns the document to put in, such as one without its links, or
    /// <see cref="RichTextDocument.Empty"/> to put in nothing. Without it, pasted text goes in as cleaned.</summary>
    [Parameter]
    public Func<RichTextDocument, RichTextDocument>? TransformPaste { get; set; }

    /// <summary>Shows the toolbar of formats. Turn it off for an editor whose formats come from shortcuts and paste
    /// only. Defaults to true.</summary>
    [Parameter]
    public bool ShowToolbar { get; set; } = true;

    /// <summary>Example text shown while the editor is empty. It is not a label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>The editing area's starting height, in lines of text; it grows as text is added. Defaults to 3.
    /// </summary>
    [Parameter]
    public int Lines { get; set; } = 3;

    /// <summary>Stops the editing area from growing at this many lines, after which it scrolls. Without it, the
    /// area grows with its text.</summary>
    [Parameter]
    public int? MaxLines { get; set; }

    /// <summary>The most characters the text can have, counted as the browser counts them (UTF-16 code units) and
    /// leaving out paragraph and line breaks. A longer value shows an error; typing past the limit isn't stopped, so
    /// nothing a user pastes is cut off.</summary>
    [Parameter]
    public int? MaxLength { get; set; }

    /// <summary>Shows a count of the text's characters under the editor, as "12 / 200" with a
    /// <see cref="MaxLength"/> or "12" without one, counted as <see cref="MaxLength"/> counts them. It follows typing in
    /// the browser, and screen readers hear it as the editor's description. With a limit, the editor announces the
    /// characters left as they reach 20 and 0.</summary>
    [Parameter]
    public bool ShowCount { get; set; }

    /// <summary>Adds an HTML source button to the toolbar, which swaps the editing area for a text area of the value's
    /// HTML. What's typed there goes through <see cref="RichTextDocument"/> like any other value, so it keeps only what
    /// the editor allows.</summary>
    [Parameter]
    public bool ShowSource { get; set; }

    /// <summary>Updates the value on every change instead of when focus leaves the editor.</summary>
    [Parameter]
    public bool UpdateOnInput { get; set; }

    /// <summary>With <see cref="UpdateOnInput"/>, waits until typing has paused this long before updating the value.
    /// Leaving the editor updates it at once.</summary>
    [Parameter]
    public TimeSpan? UpdateDelay { get; set; }

    /// <summary>The words the editor shows and says to screen readers, such as its buttons' names.</summary>
    [Parameter]
    public RichTextEditorLabels Labels { get; set; } = new();

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public FieldClasses? Classes { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) =>
        (_source ? _sourceArea : _content).FocusAsync(preventScroll);

    // A button applies a format, sets a kind of block, or runs a command; the script reads which from its data.
    private sealed record Tool(string? Format, string? Block, string? Command, Icon Icon, string Label,
        string? Shortcuts);

    private IReadOnlyList<Tool> Tools => [.. MarkTools, .. LinkTools, .. BlockTools, .. ClearTools];

    private IEnumerable<Tool> ClearTools => MarkTools.Any()
        ? [new(null, null, "clear", RichTextEditorIcons.ClearFormatting,
            Labels.ClearFormatting ?? Localizer[TbStrings.RichTextEditorClearFormatting], "Control+\\ Meta+\\")]
        : [];

    private IEnumerable<Tool> MarkTools =>
        new (RichTextFormats Format, string Mark, Icon Icon, string? Label, string Key, string Shortcuts)[]
        {
            (RichTextFormats.Bold, "bold", RichTextEditorIcons.Bold, Labels.Bold, TbStrings.RichTextEditorBold,
                "Control+B Meta+B"),
            (RichTextFormats.Italic, "italic", RichTextEditorIcons.Italic, Labels.Italic,
                TbStrings.RichTextEditorItalic, "Control+I Meta+I"),
            (RichTextFormats.Underline, "underline", RichTextEditorIcons.Underline, Labels.Underline,
                TbStrings.RichTextEditorUnderline, "Control+U Meta+U"),
            (RichTextFormats.Strikethrough, "strikethrough", RichTextEditorIcons.Strikethrough, Labels.Strikethrough,
                TbStrings.RichTextEditorStrikethrough, "Control+Shift+X Meta+Shift+X"),
            (RichTextFormats.Subscript, "subscript", RichTextEditorIcons.Subscript, Labels.Subscript,
                TbStrings.RichTextEditorSubscript, "Control+, Meta+,"),
            (RichTextFormats.Superscript, "superscript", RichTextEditorIcons.Superscript, Labels.Superscript,
                TbStrings.RichTextEditorSuperscript, "Control+. Meta+."),
            (RichTextFormats.Code, "code", RichTextEditorIcons.Code, Labels.Code, TbStrings.RichTextEditorCode,
                "Control+E Meta+E"),
        }
        .Where(tool => Formats.HasFlag(tool.Format))
        .Select(tool => new Tool(tool.Mark, null, null, tool.Icon, tool.Label ?? Localizer[tool.Key], tool.Shortcuts));

    private IEnumerable<Tool> LinkTools => Formats.HasFlag(RichTextFormats.Link)
        ? [new(null, null, "link", RichTextEditorIcons.Link, Labels.Link ?? Localizer[TbStrings.RichTextEditorLink],
            "Control+K Meta+K")]
        : [];

    private IEnumerable<Tool> BlockTools
    {
        get
        {
            var blocks = new (RichTextBlocks Block, string Kind, Icon Icon, string? Label, string Key, string Shortcuts)[]
            {
                (RichTextBlocks.Headings, "heading1", RichTextEditorIcons.Heading1, Labels.Heading1,
                    TbStrings.RichTextEditorHeading1, "Control+Alt+1 Meta+Alt+1"),
                (RichTextBlocks.Headings, "heading2", RichTextEditorIcons.Heading2, Labels.Heading2,
                    TbStrings.RichTextEditorHeading2, "Control+Alt+2 Meta+Alt+2"),
                (RichTextBlocks.Headings, "heading3", RichTextEditorIcons.Heading3, Labels.Heading3,
                    TbStrings.RichTextEditorHeading3, "Control+Alt+3 Meta+Alt+3"),
                (RichTextBlocks.Quotes, "quote", RichTextEditorIcons.Quote, Labels.Quote,
                    TbStrings.RichTextEditorQuote, "Control+Shift+9 Meta+Shift+9"),
                (RichTextBlocks.BulletedLists, "bullet", RichTextEditorIcons.BulletedList, Labels.BulletedList,
                    TbStrings.RichTextEditorBulletedList, "Control+Shift+8 Meta+Shift+8"),
                (RichTextBlocks.NumberedLists, "number", RichTextEditorIcons.NumberedList, Labels.NumberedList,
                    TbStrings.RichTextEditorNumberedList, "Control+Shift+7 Meta+Shift+7"),
            };
            foreach (var tool in blocks.Where(tool => Blocks.HasFlag(tool.Block)))
            {
                yield return new Tool(null, tool.Kind, null, tool.Icon, tool.Label ?? Localizer[tool.Key],
                    tool.Shortcuts);
            }

            if ((Blocks & (RichTextBlocks.BulletedLists | RichTextBlocks.NumberedLists)) != 0)
            {
                yield return new Tool(null, null, "outdent", RichTextEditorIcons.Outdent,
                    Labels.Outdent ?? Localizer[TbStrings.RichTextEditorOutdent], null);
                yield return new Tool(null, null, "indent", RichTextEditorIcons.Indent,
                    Labels.Indent ?? Localizer[TbStrings.RichTextEditorIndent], null);
            }

            if (Blocks.HasFlag(RichTextBlocks.Rules))
            {
                yield return new Tool(null, null, "rule", RichTextEditorIcons.HorizontalRule,
                    Labels.HorizontalRule ?? Localizer[TbStrings.RichTextEditorHorizontalRule], null);
            }

            if (Blocks.HasFlag(RichTextBlocks.Tables))
            {
                yield return new Tool(null, null, "table", RichTextEditorIcons.Table,
                    Labels.Table ?? Localizer[TbStrings.RichTextEditorTable], null);
            }
        }
    }

    private bool ShowsImageButton => Blocks.HasFlag(RichTextBlocks.Images) && UploadImage is not null;

    private bool KeepsMentions => !string.IsNullOrEmpty(MentionTriggers);

    private bool SuggestsMentions => KeepsMentions && RendererInfo.IsInteractive
        && (MentionSearch is not null || MentionItems is not null);

    private string MentionListId => $"{FieldId}-mentions";

    private RichTextSchema Schema => new()
    {
        Formats = Formats, Blocks = Blocks, LinkSchemes = LinkSchemes, ImageSchemes = ImageSchemes,
        Mentions = KeepsMentions,
    };

    // The value as the editor holds it: parsed, so only the allowed formats and safe markup reach the page.
    private string Canonical => RichTextDocument.Parse(Value, Schema).ToHtml();

    private string CountId => $"{FieldId}-count";

    // The editing area's text reaches .NET before the source shows it: flush sends it as a change.
    private async Task ShowSourceAsync(bool show)
    {
        if (show && _handle is not null)
        {
            await _handle.InvokeVoidAsync("flush");
        }

        _source = show;
    }

    // The source is parsed the same way as anything the editor sends, so the value holds only what the editor allows.
    private Task OnSourceChangedAsync(ChangeEventArgs change)
    {
        var html = change.Value as string;
        var canonical = RichTextDocument.Parse(html, Schema).ToHtml();
        if (canonical != html)
        {
            _sourceChanges++;
        }

        return TakeAsync(html, canonical, load: true);
    }

    // The text's characters without its breaks, as text-count.js counts the editing area's text. Each render and each
    // check of a form asks again, so the last answer is kept.
    private (string? Value, RichTextSchema Schema, int Count)? _count;

    private int CountOf(string? value)
    {
        var schema = Schema;
        if (_count is not { } last || last.Value != value || last.Schema != schema)
        {
            _count = (value, schema, RichTextDocument.Parse(value, schema).Paragraphs
                .Sum(paragraph => paragraph.Text.Count(c => c != '\n')));
        }

        return _count.Value.Count;
    }

    private protected override string? ValueError(string? value) =>
        MaxLength is { } max && CountOf(value) > max
            ? Labels.TooLong is { } template ? FormatMessage(template, max)
                : CountedMessage(TbStrings.TextFieldTooLong, max)
            : null;

    private protected override RenderFragment? AfterMessages => ShowCount
        ? FieldCount.Render(CountId, CountOf(Value), MaxLength, (Commits, Value),
            count => FieldCount.Said(Localizer, MaxLength, count, Labels.Count, Labels.CountOfLimit))
        : null;

    private void OnCharactersLeft(CharactersLeftEventArgs args) =>
        Announcer.Polite(FieldCount.CharactersLeft(Localizer, args.Left, Labels.CharactersLeft));

    // An anonymous object compares by value, so the script hears of options only when they change.
    private object Options => new
    {
        formats = string.Join(' ', MarkTools.Select(tool => tool.Format)),
        blocks = string.Join(' ', BlockTools.Select(tool => tool.Block).OfType<string>()
            .Concat(Blocks.HasFlag(RichTextBlocks.Rules) ? ["rule"] : [])
            .Concat(Blocks.HasFlag(RichTextBlocks.Tables) ? ["table"] : [])),
        links = Formats.HasFlag(RichTextFormats.Link) ? string.Join(' ', LinkSchemes) : null,
        images = Blocks.HasFlag(RichTextBlocks.Images) ? string.Join(' ', ImageSchemes) : null,
        mentions = KeepsMentions ? MentionTriggers : null,
        transformsPaste = TransformPaste is not null,
        readOnly = ReadOnly,
        updateOnInput = UpdateOnInput,
        updateDelay = UpdateDelay?.TotalMilliseconds,
    };

    private protected override bool LabelTargetsInput => false;

    // Paragraphs with no text are still empty. Each check of a form asks again, so the last answer is kept.
    private protected override bool IsMissing(string? value)
    {
        if (_missing is not { } last || last.Value != value)
        {
            last = (value, string.IsNullOrWhiteSpace(RichTextDocument.Parse(value).ToPlainText()));
            _missing = last;
        }

        return last.Missing;
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (MentionTriggers?.Any(char.IsWhiteSpace) == true)
        {
            throw new InvalidOperationException(
                $"{nameof(TbRichTextEditor)}'s {nameof(MentionTriggers)} can't have whitespace in it.");
        }

        await base.OnParametersSetAsync();
        // A value the app sets is its own news; only what the user changes after it is reported.
        if (OnMentionsChanged.HasDelegate && Value != _mentionsParameter)
        {
            _mentionsParameter = Value;
            if (Value != _mentionsOf)
            {
                (_mentionsOf, _mentions) = (Value, RichTextDocument.Parse(Value, Schema).Mentions);
            }
        }

        // A parent that takes away the source button or the toolbar takes the source away with it.
        _source &= ShowSource && ShowToolbar;
        if (_handle is null)
        {
            return;
        }

        try
        {
            if (!Equals(Options, _sentOptions))
            {
                _sentOptions = Options;
                await _handle.InvokeVoidAsync("setOptions", _sentOptions);
            }

            if (Value != _parameterValue)
            {
                _parameterValue = Value;
                var canonical = Canonical;
                if (canonical != _sent && !_echoes.Contains(canonical))
                {
                    _sent = canonical;
                    await _handle.InvokeVoidAsync("setValue", _sent);
                }
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            await SetMentionsAsync();
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/rich-text-editor.js");
            _sent = Canonical;
            _parameterValue = Value;
            _sentOptions = Options;
            var handle = await module.InvokeAsync<IJSObjectReference>("attachRichTextEditor", _content, _sent,
                _sentOptions);
            if (_disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
            // The parent may have set a value while the script loaded.
            await OnParametersSetAsync();
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    // The script gets the list of suggestions once it is rendered, and loses it when the editor stops suggesting.
    private async Task SetMentionsAsync()
    {
        if (_handle is null || _disposed || _suggesting == SuggestsMentions)
        {
            return;
        }

        _suggesting = SuggestsMentions;
        _mentionEvents ??= DotNetObjectReference.Create(
            new MentionInputEvents(DispatchExceptionAsync, InputId, OnMentionQueryAsync, OnMentionChosenAsync));
        try
        {
            await _handle.InvokeVoidAsync("setMentions", _suggesting ? _mentionList : null, _mentionEvents);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    private async Task OnMentionQueryAsync(string? trigger, string text, int number)
    {
        var query = trigger is null || ReadOnly || Disabled ? null : new MentionQuery(trigger, text);
        try
        {
            if (!await _suggestions.FindAsync(query, number, MentionSearch, MentionItems, MaxMentionItems))
            {
                return;
            }

            var count = query is null ? (int?)null : _suggestions.Results.Count;
            // Only a new count is spoken, so typing doesn't bring an announcement with every key.
            if (count is not null && count != _announcedSuggestions)
            {
                Announcer.Polite(string.Format(System.Globalization.CultureInfo.CurrentCulture,
                    Labels.MentionSuggestions ?? Localizer[TbStrings.MentionInputSuggestions], count));
            }

            _announcedSuggestions = count;
            StateHasChanged();
        }
        catch (Exception exception)
        {
            _announcedSuggestions = null;
            StateHasChanged();
            Announcer.Polite(Labels.MentionSearchFailed ?? Localizer[TbStrings.MentionInputSearchFailed]);
            Telemetry.Failed(TelemetryName, Label ?? AriaLabel, "search", exception);
            await OnMentionSearchFailed.InvokeAsync(exception);
        }
    }

    // The script has the chosen item's id and text from its option, so the list only needs emptying.
    private Task OnMentionChosenAsync(int index, int resultsFor)
    {
        _suggestions.Stop();
        _suggestions.Clear(_suggestions.ResultsFor);
        StateHasChanged();
        return Task.CompletedTask;
    }

    // What the script sends is read again here, so the value holds only what the editor allows, whatever the
    // browser sent.
    private async Task OnChangedAsync(RichTextChangeEventArgs change)
    {
        _parts.Append(change.Html);
        if (change.Continues)
        {
            return;
        }

        var html = _parts.ToString();
        _parts.Clear();
        _sendsReceived++;
        await TakeAsync(html, RichTextDocument.Parse(html, Schema).ToHtml(), load: false);
    }

    // The script holds the canonical value, loaded when it differs from what it sent or when the source changed it.
    private async Task TakeAsync(string? html, string canonical, bool load)
    {
        _sent = canonical;
        if ((load || canonical != html) && _handle is not null)
        {
            await _handle.InvokeVoidAsync("setValue", canonical);
        }

        // A value typed while the parent's handler runs waits for it, and only the newest is delivered.
        if (_delivering is null)
        {
            await DeliverAsync();
        }
    }

    // With a paste transform, the script hands over the cleaned paste and puts in what the app returns.
    private async Task OnPasteAsync(RichTextChangeEventArgs paste)
    {
        _pasteParts.Append(paste.Html);
        if (paste.Continues)
        {
            return;
        }

        var html = _pasteParts.ToString();
        _pasteParts.Clear();
        if (_handle is null || _disposed)
        {
            return;
        }

        // A paste sent just before the transform was removed still goes in, as cleaned.
        var pasted = TransformPaste is null ? html : TransformPaste(RichTextDocument.Parse(html, Schema)).ToHtml();
        try
        {
            await _handle.InvokeVoidAsync("insertPasted", pasted);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    // The Image button asks for a file and its alt text, has the app store the file, and puts the image in at the
    // editor's last selection.
    private async Task InsertImageAsync()
    {
        var result = await Dialogs.ShowAsync<RichTextImageDialog, RichTextImage>(
            Labels.InsertImage ?? Localizer[TbStrings.RichTextEditorInsertImage], parameters => parameters
                .Set(dialog => dialog.Upload, UploadImage!).Set(dialog => dialog.MaxFileSize, MaxImageSize)
                .Set(dialog => dialog.Schema, Schema).Set(dialog => dialog.Labels, Labels),
            new DialogOptions { Size = DialogSize.Small });
        if (_disposed || result is not { Confirmed: true, Value: { } image } || _handle is null)
        {
            return;
        }

        try
        {
            await _handle.InvokeVoidAsync("insertImage", image.Source, image.Alt);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    // The table menu's commands fit where the caret is as it opens.
    private async Task OpenTableMenuAsync(bool open)
    {
        if (!open || _handle is null)
        {
            return;
        }

        try
        {
            _table = await _handle.InvokeAsync<RichTextTableState>("tableState");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    // The script asks for the link dialog on Ctrl+K or the link button, and puts in what it returns.
    private async Task OnLinkAsync(RichTextLinkEventArgs request)
    {
        var title = request.Link is null ? Labels.AddLink ?? Localizer[TbStrings.RichTextEditorAddLink]
            : Labels.EditLink ?? Localizer[TbStrings.RichTextEditorEditLink];
        var result = await Dialogs.ShowAsync<RichTextLinkDialog, RichTextLinkEdit>(title, parameters => parameters
            .Set(dialog => dialog.Link, request.Link).Set(dialog => dialog.Insert, request.Insert)
            .Set(dialog => dialog.Schema, Schema).Set(dialog => dialog.Labels, Labels),
            new DialogOptions { Size = DialogSize.Small });
        if (_disposed || result is not { Confirmed: true, Value: { } edit } || _handle is null)
        {
            return;
        }

        try
        {
            await _handle.InvokeVoidAsync("setLink", edit.Url, edit.Text);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the editor went with it.
        }
    }

    private async Task DeliverAsync()
    {
        try
        {
            for (string? delivered = null; delivered != _sent;)
            {
                delivered = _sent!;
                _echoes.Add(delivered);
                // While a handler runs, the parent can only hold the value it was given or the one before.
                if (_echoes.Count > 2)
                {
                    _echoes.RemoveAt(0);
                }

                // Worked out before the parent has the value: its render sets the value here again, which counts
                // as the app's own.
                var mentions = OnMentionsChanged.HasDelegate
                    ? RichTextDocument.Parse(delivered, Schema).Mentions : _mentions;
                _mentionsToReport = mentions.SequenceEqual(_mentions) ? null : mentions;
                (_mentionsOf, _mentions) = (delivered, mentions);
                _delivering = SetValueAsync(delivered);
                await _delivering;
                // A value the parent already holds raises no ValueChanged, as when an edit is undone back to a value
                // the parent never replaced, but its mentions can still be news.
                await ValueDeliveredAsync(delivered);
            }
        }
        finally
        {
            // Once the last handler finishes, renders show the parent's current value, so an older one is a real change.
            _delivering = null;
            _echoes.Clear();
            _sendsAnswered = _sendsReceived;
        }
    }

    // Raises OnMentionsChanged right after ValueChanged, so a change counts as answered only once the app has heard
    // of its mentions too.
    private protected override async Task ValueDeliveredAsync(string? value)
    {
        if (_mentionsToReport is { } mentions)
        {
            _mentionsToReport = null;
            await OnMentionsChanged.InvokeAsync(mentions);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync when both exist, so the field's own cleanup has to run from here.
        Dispose();
        _disposed = true;
        _suggestions.Dispose();
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _mentionEvents?.Dispose();
    }
}
