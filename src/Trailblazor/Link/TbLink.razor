@namespace Trailblazor
@inherits TbComponentBase
@inject ITbLocalizer Localizer

@* Without an address it runs an action, and an anchor with no href can't be focused or reached as a link. *@
@if (Href is null)
{
    <button @ref="_element" type="button" @attributes="AdditionalAttributes" disabled="@Disabled"
            class="@ClassNames.Join("tb-link", "tb-link--button", Class)" style="@Style" @onclick="OnClickAsync">
        @ChildContent
    </button>
}
else
{
    @* An anchor without an address isn't a link to assistive technology, so a disabled one gets role="link". *@
    <a @ref="_element" @attributes="AdditionalAttributes" href="@(Disabled ? null : Href)" target="@TargetAttribute"
       rel="@RelAttribute" role="@(Disabled ? "link" : AdditionalAttributes?.GetValueOrDefault("role"))"
       tabindex="@(Disabled ? null : AdditionalAttributes?.GetValueOrDefault("tabindex"))"
       aria-disabled="@(Disabled ? "true" : null)" class="@ClassNames.Join("tb-link", Class)" style="@Style"
       @onclick="OnClickAsync">
        @ChildContent
        @if (NewTab)
        {
            <span class="tb-visually-hidden"> (@(NewTabHint ?? Localizer[TbStrings.NewTabHint]))</span>
        }
    </a>
}

@code {
    private ElementReference _element;
    private ControlTelemetry? _telemetry;

    /// <summary>The address the link goes to. Without one, the link is a button that runs <see cref="OnClick"/>.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Opens the address in a new tab, and tells screen reader users that it does.</summary>
    [Parameter]
    public bool NewTab { get; set; }

    /// <summary>What screen readers hear after the text of a link that opens a new tab.
    /// Defaults to the app's text for <see cref="TbStrings.NewTabHint"/>, "opens in a new tab" in English.</summary>
    [Parameter]
    public string? NewTabHint { get; set; }

    /// <summary>Turns the link off: it keeps its text but loses its address, says it is disabled, and runs no
    /// <see cref="OnClick"/>.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when the link is clicked, or chosen with the keyboard.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>A label this link's use is counted under, such as <c>"trail-guide"</c>, so the app can count how often
    /// people see it and use it through the <c>Trailblazor</c> meter. Controls that share a label count together; a
    /// control without one isn't counted. It names what the link does, never the user, and must never hold a
    /// credential.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => Telemetry.Rendered(TelemetryName);

    /// <summary>The link's text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Moves focus to the link.</summary>
    /// <param name="preventScroll">Whether to keep the page from scrolling the link into view.</param>
    public ValueTask FocusAsync(bool preventScroll = false) => _element.FocusAsync(preventScroll);

    private Task OnClickAsync(MouseEventArgs args)
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        Telemetry.Used(TelemetryName);
        return OnClick.InvokeAsync(args);
    }

    // These come after the consumer's attributes, so they carry the consumer's own target and rel along.
    private object? TargetAttribute => NewTab ? "_blank" : AdditionalAttributes?.GetValueOrDefault("target");

    private object? RelAttribute => NewTab
        ? $"{AdditionalAttributes?.GetValueOrDefault("rel")} noopener noreferrer".TrimStart()
        : AdditionalAttributes?.GetValueOrDefault("rel");
}
