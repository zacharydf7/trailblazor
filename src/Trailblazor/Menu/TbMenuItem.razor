@namespace Trailblazor
@inherits TbComponentBase
@inject ITbLocalizer Localizer

@* A disabled item stays focusable, as the menu pattern asks, but does nothing when chosen. *@
@if (Href is not null)
{
    @* A disabled link loses its address, so it can't be followed. *@
    <a @attributes="AdditionalAttributes" href="@(Disabled ? null : Href)" target="@TargetAttribute"
       rel="@RelAttribute" role="menuitem" tabindex="-1" style="@Style"
       aria-disabled="@(Disabled ? "true" : null)" aria-describedby="@DescribedBy" aria-keyshortcuts="@KeyShortcuts"
       class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)" @onclick="OnClickAsync">
        @Content
        @if (NewTab)
        {
            <span class="tb-visually-hidden"> (@(NewTabHint ?? Localizer[TbStrings.NewTabHint]))</span>
        }
    </a>
}
else
{
    <button @attributes="AdditionalAttributes" type="button" role="menuitem" tabindex="-1" style="@Style"
            aria-disabled="@(Disabled ? "true" : null)" aria-describedby="@DescribedBy"
            aria-keyshortcuts="@KeyShortcuts" class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)"
            @onclick="OnClickAsync">
        @Content
    </button>
}

@code {
    [CascadingParameter]
    private MenuClasses? Classes { get; set; }

    [CascadingParameter]
    private MenuCommits? Commits { get; set; }
    private ControlTelemetry? _telemetry;

    /// <summary>The item's text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Content at the item's end, such as a badge or a count. It's part of the item's name, so keep it
    /// short; put a hint in <see cref="Description"/> and a key combination in <see cref="Shortcut"/>, which describe
    /// the item without naming it.</summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>A line of muted text under the item's text, such as what it does. Screen readers hear it as the
    /// item's description, after its name, so the item is still found by its text alone.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The keys that do what the item does, written as <see cref="TbKbd.Keys"/> are, such as
    /// <c>"Mod+S"</c>. The item shows them at its end and tells screen readers through <c>aria-keyshortcuts</c>; it
    /// doesn't listen for them, so pair it with a <see cref="TbHotkey"/> that does.</summary>
    [Parameter]
    public string? Shortcut { get; set; }

    /// <summary>Keeps the item in the menu but stops it from being chosen.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Makes the item a link to this address, followed when the item is chosen.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Opens the <see cref="Href"/> in a new tab, and tells screen reader users that it does.</summary>
    [Parameter]
    public bool NewTab { get; set; }

    /// <summary>What screen readers hear after the text of an item that opens a new tab. Defaults to the app's text
    /// for <see cref="TbStrings.NewTabHint"/>, "opens in a new tab" in English.</summary>
    [Parameter]
    public string? NewTabHint { get; set; }

    /// <summary>Raised when the item is chosen, by click, Enter or Space; the menu then closes.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>A label this item's use is counted under, such as <c>"export-csv"</c>, so the app can see how often
    /// people choose it through the <c>Trailblazor</c> meter. An item renders hidden until its menu opens, so it counts
    /// uses only; give the menu a <see cref="TbMenu.TelemetryName"/> to count how often it is shown and opened.
    /// Controls that share a label count together. It names what the item does, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    private readonly string _descriptionId = $"tb-menu-item-{Guid.NewGuid():N}-description";

    // Each keeps what the consumer set and adds the item's own.
    private object? DescribedBy => Description is null ? AdditionalAttributes?.GetValueOrDefault("aria-describedby")
        : $"{AdditionalAttributes?.GetValueOrDefault("aria-describedby")} {_descriptionId}".TrimStart();

    private object? KeyShortcuts => Shortcut is null ? AdditionalAttributes?.GetValueOrDefault("aria-keyshortcuts")
        : $"{AdditionalAttributes?.GetValueOrDefault("aria-keyshortcuts")} {KeyShortcut.Aria(Shortcut)}".TrimStart();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Shortcut is not null && !KeyShortcut.IsValid(Shortcut))
        {
            throw new InvalidOperationException($"{nameof(TbMenuItem)} can't read the shortcut \"{Shortcut}\": end "
                + "it with one key, after any of Mod, Ctrl, Alt, Shift and Meta, as in \"Mod+S\".");
        }
    }

    private RenderFragment Content => @<text>
        @if (Icon is { } icon)
        {
            <TbIcon Icon="icon" Size="Size.Small" Class="@Classes?.Icon" data-part="icon" />
        }
        @if (Description is null)
        {
            <span data-part="label" class="@Classes?.Label">@ChildContent</span>
        }
        else
        {
            @* aria-hidden keeps the description out of the item's name; aria-describedby still reads it. *@
            <span class="tb-menu__text">
                <span data-part="label" class="@Classes?.Label">@ChildContent</span>
                <span id="@_descriptionId" data-part="description" class="tb-menu__description"
                      aria-hidden="true">@Description</span>
            </span>
        }
        @if (End is not null)
        {
            @* Razor drops the whitespace here, so this space keeps the label and end apart in the item's name. *@
            @(" ")<span data-part="end" class="tb-menu__end">@End</span>
        }
        @if (Shortcut is not null)
        {
            @* aria-keyshortcuts tells screen readers the keys, so the keycaps stay out of the item's name. *@
            <span data-part="shortcut" class="tb-menu__shortcut" aria-hidden="true"><TbKbd Keys="@Shortcut" /></span>
        }
    </text>;

    // These come after the consumer's attributes, so they carry the consumer's own target and rel along.
    private object? TargetAttribute => NewTab ? "_blank" : AdditionalAttributes?.GetValueOrDefault("target");

    private object? RelAttribute => NewTab
        ? $"{AdditionalAttributes?.GetValueOrDefault("rel")} noopener noreferrer".TrimStart()
        : AdditionalAttributes?.GetValueOrDefault("rel");

    private Task OnClickAsync(MouseEventArgs args)
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        Telemetry.Used(TelemetryName);
        return Commits is null ? OnClick.InvokeAsync(args) : Commits.RunAsync(() => OnClick.InvokeAsync(args));
    }
}
