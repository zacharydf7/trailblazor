@namespace Trailblazor
@inherits TbComponentBase
@inject ITbLocalizer Localizer

@* A disabled item stays focusable, as the menu pattern asks, but does nothing when chosen. *@
@if (Href is not null)
{
    @* A disabled link loses its address, so it can't be followed. *@
    <a @attributes="AdditionalAttributes" href="@(Disabled ? null : Href)" target="@TargetAttribute"
       rel="@RelAttribute" role="menuitem" tabindex="-1" style="@Style"
       aria-disabled="@(Disabled ? "true" : null)" class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)"
       @onclick="OnClickAsync">
        @Content
        @if (NewTab)
        {
            <span class="tb-visually-hidden"> (@(NewTabHint ?? Localizer[TbStrings.NewTabHint]))</span>
        }
    </a>
}
else
{
    <button @attributes="AdditionalAttributes" type="button" role="menuitem" tabindex="-1" style="@Style"
            aria-disabled="@(Disabled ? "true" : null)" class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)"
            @onclick="OnClickAsync">
        @Content
    </button>
}

@code {
    [CascadingParameter]
    private MenuClasses? Classes { get; set; }
    private ControlTelemetry? _telemetry;

    /// <summary>The item's text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Keeps the item in the menu but stops it from being chosen.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Makes the item a link to this address, followed when the item is chosen.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Opens the <see cref="Href"/> in a new tab, and tells screen reader users that it does.</summary>
    [Parameter]
    public bool NewTab { get; set; }

    /// <summary>What screen readers hear after the text of an item that opens a new tab. Defaults to the app's text
    /// for <see cref="TbStrings.NewTabHint"/>, "opens in a new tab" in English.</summary>
    [Parameter]
    public string? NewTabHint { get; set; }

    /// <summary>Raised when the item is chosen, by click, Enter or Space; the menu then closes.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>A label this item's use is counted under, such as <c>"export-csv"</c>, so the app can see how often
    /// people choose it through the <c>Trailblazor</c> meter. An item renders hidden until its menu opens, so it counts
    /// uses only; give the menu a <see cref="TbMenu.TelemetryName"/> to count how often it is shown and opened.
    /// Controls that share a label count together. It names what the item does, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    private RenderFragment Content => @<text>
        @if (Icon is { } icon)
        {
            <TbIcon Icon="icon" Size="Size.Small" Class="@Classes?.Icon" data-part="icon" />
        }
        <span data-part="label" class="@Classes?.Label">@ChildContent</span>
    </text>;

    // These come after the consumer's attributes, so they carry the consumer's own target and rel along.
    private object? TargetAttribute => NewTab ? "_blank" : AdditionalAttributes?.GetValueOrDefault("target");

    private object? RelAttribute => NewTab
        ? $"{AdditionalAttributes?.GetValueOrDefault("rel")} noopener noreferrer".TrimStart()
        : AdditionalAttributes?.GetValueOrDefault("rel");

    private Task OnClickAsync(MouseEventArgs args)
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        Telemetry.Used(TelemetryName);
        return OnClick.InvokeAsync(args);
    }
}
