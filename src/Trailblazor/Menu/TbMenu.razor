@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@* popovertarget opens the menu natively before the script attaches; the script adds keys and aria-expanded. *@
<div @ref="_root" @attributes="AttributesWithoutId" style="@Style"
     class="@ClassNames.Join("tb-menu", FullWidth ? "tb-menu--full-width" : null, Class)">
    @if (Trigger is not null)
    {
        @Trigger(new MenuTrigger { Attributes = TriggerAttributes })
    }
    else if (Icon is { } icon)
    {
        <TbIconButton Icon="icon" AriaLabel="@(Label ?? "")" Size="TriggerSize" Disabled="Disabled"
                      @attributes="TriggerAttributes" />
    }
    else
    {
        <TbButton Variant="TriggerVariant" Size="TriggerSize" Disabled="Disabled" @attributes="TriggerAttributes">
            <ChildContent>@Label</ChildContent>
            <End><TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" /></End>
        </TbButton>
    }
    @if (Description is not null)
    {
        <span id="@DescriptionId" class="tb-visually-hidden">@Description</span>
    }
    @* data-open comes with the items drawn as the menu opened, which tests wait for. *@
    <div @ref="_menu" id="@MenuId" popover="auto" role="menu" aria-labelledby="@TriggerId" data-part="menu"
         data-open="@(_open ? "" : null)" class="tb-menu__list">
        @ChildContent
    </div>
</div>

@code {
    private readonly string _id = $"tb-menu-{Guid.NewGuid():N}";
    private ElementReference _root;
    private ElementReference _menu;
    private IJSObjectReference? _handle;
    private bool _disposed;
    private ControlTelemetry? _telemetry;
    private DotNetObjectReference<MenuEvents>? _events;
    private bool _open;
    private bool _lastOpen;
    private bool _openFromParent;

    /// <summary>The trigger's text, or with an <see cref="Icon"/>, the icon button's accessible name. Required
    /// unless <see cref="Trigger"/> gives a trigger of your own.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>A trigger of your own, such as an avatar button or the arrow half of a split button, in place of the
    /// built-in one. Put the context's attributes on the button: <c>@attributes="context.Attributes"</c>.</summary>
    [Parameter]
    public RenderFragment<MenuTrigger>? Trigger { get; set; }

    /// <summary>Stops the trigger from opening the menu.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the menu is open. Bind it with <c>@bind-Open</c> to open or close it from code and hear when
    /// the user does; only a new value from the parent opens or closes it.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Raised when the user opens or closes the menu.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Shows an icon button as the trigger instead of a text button.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>How the text trigger is drawn. Defaults to <see cref="Trailblazor.Variant.Outlined"/>.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>How big the trigger is. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Which side of the trigger the menu opens on, read on the first render. It flips to the other side
    /// when there's no room. Placed to the side in a narrow window, it wraps to fit or else overlaps the trigger.
    /// Defaults to <see cref="Placement.Bottom"/>.</summary>
    [Parameter]
    public Placement Placement { get; set; } = Placement.Bottom;

    /// <summary>How the menu lines up with the trigger along that side, read on the first render. Defaults to
    /// <see cref="PlacementAlign.Start"/>.</summary>
    [Parameter]
    public PlacementAlign Align { get; set; } = PlacementAlign.Start;

    /// <summary>Stretches the trigger across its container and makes the menu at least as wide as the trigger.
    /// </summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Text screen readers read after the trigger's name, such as a hint about keys it also takes.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The menu's items: <see cref="TbMenuItem"/>s, <see cref="TbMenuCheckboxItem"/>s, a
    /// <see cref="TbMenuRadioGroup{TValue}"/>, <see cref="TbSubMenu"/>s, and <see cref="TbMenuGroup"/>s and
    /// <see cref="TbMenuSeparator"/>s to arrange them.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>A label the menu's use is counted under, such as <c>"row-actions"</c>, through the <c>Trailblazor</c>
    /// meter: shown when it first renders, and used each time it opens, by pointer or key, which is how often its items
    /// are seen. It names what the menu does, never the user. Read on the first render.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    private bool _givenVariant;
    private bool _givenSize;

    [CascadingParameter]
    private TbButtonGroup? Group { get; set; }

    private Variant TriggerVariant => TbButtonGroup.Choose(_givenVariant, Variant, Group?.Variant);

    private Size TriggerSize => TbButtonGroup.Choose(_givenSize, Size, Group?.Size);

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        // In a button group, the trigger takes the group's settings unless the menu was given its own.
        _givenVariant = parameters.TryGetValue<Variant>(nameof(Variant), out _);
        _givenSize = parameters.TryGetValue<Size>(nameof(Size), out _);
        return base.SetParametersAsync(parameters);
    }

    // A given id names the trigger, built in or the app's own, since Attributes sets a custom trigger's id.
    private string TriggerId => GivenId ?? $"{_id}-trigger";

    private string MenuId => $"{_id}-list";

    private string? DescriptionId => Description is null ? null : $"{_id}-description";

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["id"] = TriggerId,
                ["popovertarget"] = MenuId,
                ["aria-haspopup"] = "menu",
                ["aria-controls"] = MenuId,
                ["data-part"] = "trigger",
            };
            if (DescriptionId is not null)
            {
                attributes["aria-describedby"] = DescriptionId;
            }

            // A static page never runs the script, so tests know not to wait for it; popovertarget still opens it.
            if (AssignedRenderMode is null && !RendererInfo.IsInteractive)
            {
                attributes["data-static"] = "";
            }

            // The built-in triggers take Disabled as a parameter; a custom one gets the attribute.
            if (Disabled && Trigger is not null)
            {
                attributes["disabled"] = true;
            }

            return attributes;
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Trigger is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException($"{nameof(TbMenu)} needs a {nameof(Label)} or a {nameof(Trigger)}.");
        }

        // Only a new value from the parent opens or closes the menu, so re-rendering with the old one keeps the menu
        // as the user left it.
        if (Open != _lastOpen)
        {
            _lastOpen = Open;
            if (Open != _open)
            {
                _open = Open;
                _openFromParent = true;
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Telemetry.Rendered(TelemetryName);
        try
        {
            if (firstRender)
            {
                await AttachAsync();
            }

            if (_handle is not null && _openFromParent)
            {
                _openFromParent = false;
                await _handle.InvokeVoidAsync("setOpen", _open);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the menu went with it.
        }
    }

    private async Task AttachAsync()
    {
        var module = await Modules.ImportAsync("./_content/Trailblazor/menu.js");
        if (_disposed)
        {
            return;
        }

        var options = new AnchoredPositionOptions
        {
            Side = Anchors.Side(Placement), Align = Anchors.Align(Align), Offset = 4,
        };
        _events = DotNetObjectReference.Create(new MenuEvents(OnToggleAsync));
        var handle = await module.InvokeAsync<IJSObjectReference?>("createMenu", _root, _menu, options, _events);
        if (handle is null)
        {
            return;
        }

        if (_disposed)
        {
            await handle.DisposeHandleAsync();
            return;
        }

        _handle = handle;
    }

    // The script reports the menu opening or closing, by pointer, key or code. The menu is drawn again each time, so
    // items that depend on state changed since the page last rendered, such as a file that finished loading, show it.
    internal async Task OnToggleAsync(bool open)
    {
        if (open)
        {
            Telemetry.Used(TelemetryName);
        }

        // Set before the render, which can run at once, outside any event.
        var changed = open != _open;
        _open = open;
        StateHasChanged();
        if (changed)
        {
            await OpenChanged.InvokeAsync(open);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _events?.Dispose();
    }
}
