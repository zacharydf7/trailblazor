@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@* popovertarget opens the menu natively before the script attaches; the script adds keys and aria-expanded. *@
<div @ref="_root" @attributes="AdditionalAttributes" style="@Style"
     class="@ClassNames.Join("tb-menu", FullWidth ? "tb-menu--full-width" : null, Class)">
    @if (Icon is { } icon)
    {
        <TbIconButton Icon="icon" AriaLabel="@Label" Size="Size" id="@TriggerId" popovertarget="@MenuId"
                      aria-haspopup="menu" aria-controls="@MenuId" aria-describedby="@DescriptionId"
                      data-part="trigger" />
    }
    else
    {
        <TbButton Variant="Variant" Size="Size" id="@TriggerId" popovertarget="@MenuId" aria-haspopup="menu"
                  aria-controls="@MenuId" aria-describedby="@DescriptionId" data-part="trigger">
            <ChildContent>@Label</ChildContent>
            <End><TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" /></End>
        </TbButton>
    }
    @if (Description is not null)
    {
        <span id="@DescriptionId" class="tb-visually-hidden">@Description</span>
    }
    <div @ref="_menu" id="@MenuId" popover="auto" role="menu" aria-labelledby="@TriggerId" data-part="menu"
         class="tb-menu__list">
        @ChildContent
    </div>
</div>

@code {
    private readonly string _id = $"tb-menu-{Guid.NewGuid():N}";
    private ElementReference _root;
    private ElementReference _menu;
    private IJSObjectReference? _handle;
    private bool _disposed;

    /// <summary>The trigger's text, or with an <see cref="Icon"/>, the icon button's accessible name. Required.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Shows an icon button as the trigger instead of a text button.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>How the text trigger is drawn. Defaults to <see cref="Trailblazor.Variant.Outlined"/>.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>How big the trigger is. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Which side of the trigger the menu opens on, read on the first render. It flips to the other side
    /// when there's no room. Defaults to <see cref="Placement.Bottom"/>.</summary>
    [Parameter]
    public Placement Placement { get; set; } = Placement.Bottom;

    /// <summary>How the menu lines up with the trigger along that side, read on the first render. Defaults to
    /// <see cref="PlacementAlign.Start"/>.</summary>
    [Parameter]
    public PlacementAlign Align { get; set; } = PlacementAlign.Start;

    /// <summary>Stretches the trigger across its container and makes the menu at least as wide as the trigger.
    /// </summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Text screen readers read after the trigger's name, such as a hint about keys it also takes.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The menu's <see cref="TbMenuItem"/>s and <see cref="TbSubMenu"/>s.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string TriggerId => $"{_id}-trigger";

    private string MenuId => $"{_id}-list";

    private string? DescriptionId => Description is null ? null : $"{_id}-description";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/menu.js");
            if (_disposed)
            {
                return;
            }

            var options = new AnchoredPositionOptions
            {
                Side = Anchors.Side(Placement), Align = Anchors.Align(Align), Offset = 4,
            };
            var handle = await module.InvokeAsync<IJSObjectReference?>("createMenu", _root, _menu, options);
            if (handle is null)
            {
                return;
            }

            if (_disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the menu went with it.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }
    }
}
