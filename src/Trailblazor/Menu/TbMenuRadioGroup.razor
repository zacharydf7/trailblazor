@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

<TbMenuGroup @attributes="AdditionalAttributes" Label="@Label" Class="@Class" Style="@Style">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</TbMenuGroup>

@code {
    /// <summary>A heading shown above the items, which also names the group for screen readers.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The chosen item's value. Bind it with <c>@bind-Value</c>.</summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>Raised with the value of the item chosen; the menu then closes, unless the item has
    /// <c>KeepOpen</c>.</summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>Decides whether two values are the same, such as entities matched by id, so a value loaded again
    /// still matches its item. Defaults to the values' own equality.</summary>
    [Parameter]
    public IEqualityComparer<TValue>? Comparer { get; set; }

    /// <summary>The group's <see cref="TbMenuRadioItem{TValue}"/>s.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    bool IMenuRadioGroup.Accepts(object? value) => GroupValues.TryFit<TValue>(value, out _);

    bool IMenuRadioGroup.IsChosen(object? value) => OptionValues.Same(Comparer, GroupValues.Fit<TValue>(value), Value);

    // The click belongs to the chosen item, so the group re-renders itself to move the mark.
    async Task IMenuRadioGroup.ChooseAsync(object? value)
    {
        Value = GroupValues.Fit<TValue>(value);
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
}
