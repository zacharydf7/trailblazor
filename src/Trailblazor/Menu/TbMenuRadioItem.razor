@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

<button @attributes="AdditionalAttributes" type="button" role="menuitemradio" tabindex="-1" style="@Style"
        aria-checked="@(Chosen ? "true" : "false")" aria-disabled="@(Disabled ? "true" : null)"
        data-keep-open="@(KeepOpen ? "" : null)"
        class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)" @onclick="ChooseAsync">
    <span data-part="indicator" class="@ClassNames.Join("tb-menu__indicator", Classes?.Indicator)"></span>
    <span data-part="label" class="@Classes?.Label">@ChildContent</span>
</button>

@code {
    [CascadingParameter]
    private MenuClasses? Classes { get; set; }
    /// <summary>The value the group takes when this item is chosen. A plain value fits a group of its nullable type,
    /// such as <c>Value="2"</c> in a group bound to an <c>int?</c>.</summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>The item's text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Keeps the item in the menu but stops it from being chosen.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Keeps the menu open when the item is chosen, by a click, Enter or Space, so other items can be set
    /// next, as in a filter menu. Escape, Tab or a click outside closes it.</summary>
    [Parameter]
    public bool KeepOpen { get; set; }

    [CascadingParameter]
    private IMenuRadioGroup? Group { get; set; }

    private bool Chosen => Group!.IsChosen(Value);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Group is null || !Group.Accepts(Value))
        {
            throw new InvalidOperationException($"{nameof(TbMenuRadioItem<TValue>)} must be inside a "
                + $"{nameof(TbMenuRadioGroup<TValue>)} its value fits.");
        }
    }

    private Task ChooseAsync() => Disabled ? Task.CompletedTask : Group!.ChooseAsync(Value);
}
