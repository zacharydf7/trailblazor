@namespace Trailblazor
@inherits TbComponentBase

<button @attributes="AdditionalAttributes" type="button" role="menuitemcheckbox" tabindex="-1" style="@Style"
        aria-checked="@(Checked ? "true" : "false")" aria-disabled="@(Disabled ? "true" : null)"
        data-keep-open="@(KeepOpen ? "" : null)"
        class="@ClassNames.Join("tb-menu__item", Classes?.Item, Class)" @onclick="ToggleAsync">
    <span data-part="indicator" class="@ClassNames.Join("tb-menu__indicator", Classes?.Indicator)">
        @if (Checked)
        {
            <TbIcon Icon="BuiltInIcons.Check" Size="Size.Small" />
        }
    </span>
    @if (Icon is { } icon)
    {
        <TbIcon Icon="icon" Size="Size.Small" Class="@Classes?.Icon" data-part="icon" />
    }
    <span data-part="label" class="@Classes?.Label">@ChildContent</span>
</button>

@code {
    [CascadingParameter]
    private MenuClasses? Classes { get; set; }
    /// <summary>The item's text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Keeps the menu open when the item is chosen, by a click, Enter or Space, so several can be set in a
    /// row, as in a filter menu. Escape, Tab or a click outside closes it.</summary>
    [Parameter]
    public bool KeepOpen { get; set; }

    /// <summary>Whether the item is checked. Bind it with <c>@bind-Checked</c>.</summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>Raised with the new state when the item is chosen; the menu then closes, unless the item has
    /// <see cref="KeepOpen"/>.</summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Keeps the item in the menu but stops it from being chosen.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private async Task ToggleAsync()
    {
        if (Disabled)
        {
            return;
        }

        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
