@namespace Trailblazor
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>

@Layout(Classes, @<text>
    @Input
    @if (RendererInfo.IsInteractive)
    {
        <div @ref="_listbox" id="@ListboxId" popover="manual" role="listbox" data-part="listbox"
             aria-labelledby="@(ShownLabel is null ? null : LabelId)" aria-busy="@(_searching ? "true" : null)"
             class="tb-select__listbox tb-autocomplete__listbox">
            @* A listbox must hold options, so a message that stands in for them is one that can't be chosen. *@
            @if (_results.Count == 0)
            {
                <div role="option" aria-disabled="true" aria-selected="false" data-part="status"
                     class="tb-autocomplete__status">
                    @(_searching ? Labels.Searching ?? Localizer[TbStrings.AutocompleteSearching]
                        : _failed ? SearchFailedLabel
                        : _searched ? Labels.NoResults ?? Localizer[TbStrings.AutocompleteNoResults]
                        : Labels.TypeToSearch ?? Localizer[TbStrings.AutocompleteTypeToSearch])
                </div>
            }
            @for (var index = 0; index < _results.Count; index++)
            {
                var item = _results[index];
                <div id="@($"{ListboxId}-{index}")" role="option" data-part="option" class="tb-select__option"
                     aria-selected="@(IsChosen(item) ? "true" : "false")" @onclick="_choose.For(item)">
                    @if (ItemTemplate is null)
                    {
                        @TextOf(item)
                    }
                    else
                    {
                        @ItemTemplate(item)
                    }
                </div>
            }
        </div>
    }
</text>, Start, End)

@code {
    // Method groups keep their handler ids between renders, unlike @bind's closures; value syncs as with @bind.
    private RenderFragment Input => builder =>
    {
        var interactive = RendererInfo.IsInteractive;
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, ControlAttributes);
        builder.AddAttribute(2, "data-part", "input");
        builder.AddAttribute(3, "id", InputId);
        builder.AddAttribute(4, "name", InputNameAttribute);
        builder.AddAttribute(5, "type", "text");
        builder.AddAttribute(6, "autocomplete", "off");
        builder.AddAttribute(7, "value", _text);
        builder.AddAttribute(8, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnTypedInputAsync));
        builder.SetUpdatesAttributeName("value");
        builder.AddAttribute(9, "onchange", EventCallback.Factory.Create(this, CommitAsync));
        builder.AddAttribute(10, "data-input-delay", InputDelay);
        builder.AddAttribute(11, "data-open-on-focus", OpenOnFocus ? "" : null);
        builder.AddAttribute(12, "placeholder", Placeholder);
        builder.AddAttribute(13, "disabled", Disabled);
        builder.AddAttribute(14, "readonly", ReadOnly);
        builder.AddAttribute(15, "data-static", AssignedRenderMode is null && !interactive ? "" : null);
        builder.AddAttribute(16, "role", interactive ? "combobox" : null);
        builder.AddAttribute(17, "aria-autocomplete", interactive ? "list" : null);
        builder.AddAttribute(18, "aria-expanded", interactive ? "false" : null);
        builder.AddAttribute(19, "aria-controls", interactive ? ListboxId : null);
        builder.AddAttribute(20, "aria-required", AriaRequired);
        builder.AddAttribute(21, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(22, "aria-describedby", InputDescribedBy);
        builder.AddAttribute(23, "class", ClassNames.Join("tb-field__input", Classes?.Input));
        builder.AddElementReferenceCapture(24, input => _input = input);
        builder.CloseElement();
    };

    private Task OnTypedInputAsync(ChangeEventArgs args) => OnTypedAsync(args.Value as string);

    private RenderFragment? End => !Clearable || Disabled || ReadOnly || string.IsNullOrEmpty(_text) ? null :
        @<TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.AutocompleteClear])"
                       aria-describedby="@ClearDescribedBy" Size="Size.Small" OnClick="ClearAsync"
                       data-part="clear" />;
}
