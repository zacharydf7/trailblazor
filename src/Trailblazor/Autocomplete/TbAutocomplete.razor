@namespace Trailblazor
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>

@Layout(Classes, @<text>
    @* @bind keeps what the user typed while a round trip is in flight; leaving or Enter commits it. *@
    <input @attributes="ControlAttributes" @ref="_input" data-part="input" id="@InputId" name="@InputNameAttribute"
           type="text" autocomplete="off" @bind:get="_text" @bind:set="OnTypedAsync" @bind:event="oninput"
           @onchange="CommitAsync" data-input-delay="@InputDelay" data-open-on-focus="@(OpenOnFocus ? "" : null)"
           placeholder="@Placeholder" disabled="@Disabled"
           readonly="@ReadOnly"
           data-static="@(AssignedRenderMode is null && !RendererInfo.IsInteractive ? "" : null)"
           role="@(RendererInfo.IsInteractive ? "combobox" : null)"
           aria-autocomplete="@(RendererInfo.IsInteractive ? "list" : null)"
           aria-expanded="@(RendererInfo.IsInteractive ? "false" : null)"
           aria-controls="@(RendererInfo.IsInteractive ? ListboxId : null)"
           aria-required="@AriaRequired" aria-invalid="@(ShowsInvalid ? "true" : null)"
           aria-describedby="@InputDescribedBy" class="@ClassNames.Join("tb-field__input", Classes?.Input)" />
    @if (RendererInfo.IsInteractive)
    {
        <div @ref="_listbox" id="@ListboxId" popover="manual" role="listbox" data-part="listbox"
             aria-labelledby="@(ShownLabel is null ? null : LabelId)" aria-busy="@(_searching ? "true" : null)"
             class="tb-select__listbox tb-autocomplete__listbox">
            @* A listbox must hold options, so a message that stands in for them is one that can't be chosen. *@
            @if (_results.Count == 0)
            {
                <div role="option" aria-disabled="true" aria-selected="false" data-part="status"
                     class="tb-autocomplete__status">
                    @(_searching ? Labels.Searching ?? Localizer[TbStrings.AutocompleteSearching]
                        : _failed ? SearchFailedLabel
                        : _searched ? Labels.NoResults ?? Localizer[TbStrings.AutocompleteNoResults]
                        : Labels.TypeToSearch ?? Localizer[TbStrings.AutocompleteTypeToSearch])
                </div>
            }
            @for (var index = 0; index < _results.Count; index++)
            {
                var item = _results[index];
                <div id="@($"{ListboxId}-{index}")" role="option" data-part="option" class="tb-select__option"
                     aria-selected="@(IsChosen(item) ? "true" : "false")" @onclick="_choose.For(item)">
                    @if (ItemTemplate is null)
                    {
                        @TextOf(item)
                    }
                    else
                    {
                        @ItemTemplate(item)
                    }
                </div>
            }
        </div>
    }
</text>, Start, End)

@code {
    private RenderFragment? End => !Clearable || Disabled || ReadOnly || string.IsNullOrEmpty(_text) ? null :
        @<TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.AutocompleteClear])"
                       aria-describedby="@ClearDescribedBy" Size="Size.Small" OnClick="ClearAsync"
                       data-part="clear" />;
}
