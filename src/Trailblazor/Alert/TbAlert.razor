@namespace Trailblazor
@inherits TbComponentBase
@inject ITbLocalizer Localizer

<div role="@(Tone is Tone.Danger or Tone.Warning ? "alert" : "status")" @attributes="AdditionalAttributes"
     class="@ClassNames.Join("tb-alert", ClassNames.Modifier("tb-alert", Tone),
                ClassNames.Modifier("tb-alert", Variant), Class)"
     style="@Style">
    @if (ShowIcon)
    {
        <TbIcon Icon="@(Icon ?? ToneIcon)" data-part="icon" Class="@ClassNames.Join("tb-alert__icon", Classes?.Icon)" />
    }
    <div class="tb-alert__content">
        @if (Title is not null)
        {
            <div data-part="title" class="@ClassNames.Join("tb-alert__title", Classes?.Title)">@Title</div>
        }
        <div data-part="message" class="@ClassNames.Join("tb-alert__message", Classes?.Message)">@ChildContent</div>
        @if (Actions is not null)
        {
            <div data-part="actions" class="@ClassNames.Join("tb-alert__actions", Classes?.Actions)">@Actions</div>
        }
    </div>
    @if (OnClose.HasDelegate)
    {
        <TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(CloseLabel ?? Localizer[TbStrings.AlertClose])"
                      Size="Size.Small" OnClick="OnClose"
                      data-part="close" Class="@ClassNames.Join("tb-alert__close", Classes?.Close)" />
    }
</div>

@code {
    /// <summary>The alert's meaning, which sets its color and role: <c>alert</c> for danger and warning,
    /// <c>status</c> for the others. Screen readers may not announce a status alert that is added to the page
    /// with its message already in it. Defaults to <see cref="Trailblazor.Tone.Info"/>.</summary>
    [Parameter]
    public Tone Tone { get; set; } = Tone.Info;

    /// <summary>How strongly the alert stands out. Defaults to <see cref="AlertVariant.Soft"/>.</summary>
    [Parameter]
    public AlertVariant Variant { get; set; }

    /// <summary>A short heading above the message, such as "Payment failed".</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The icon before the message. Defaults to one that matches the <see cref="Tone"/>.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>Shows the icon. Turn it off for an alert with no icon at all.</summary>
    [Parameter]
    public bool ShowIcon { get; set; } = true;

    /// <summary>Buttons or links under the message that act on it, such as "Retry".</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Raised when the close button is clicked. The close button is shown only when this is set.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClose { get; set; }

    /// <summary>The close button's accessible name. Defaults to the app's text for <see cref="TbStrings.AlertClose"/>,
    /// "Close" in English.</summary>
    [Parameter]
    public string? CloseLabel { get; set; }

    /// <summary>The message.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS classes for the alert's inner parts.</summary>
    [Parameter]
    public AlertClasses? Classes { get; set; }

    private Icon ToneIcon => BuiltInIcons.ForTone(Tone) ?? BuiltInIcons.Info;
}
