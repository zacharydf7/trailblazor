@namespace Trailblazor
@inherits TbComponentBase
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inject JsModuleLoader Modules

@* popovertarget opens the panel natively before the script attaches; the script adds focus, hover and aria-expanded. *@
<div @ref="_root" @attributes="AttributesWithoutId" style="@Style" class="@ClassNames.Join("tb-popover", Class)">
    @if (Trigger is not null)
    {
        @Trigger(new PopoverTrigger { Attributes = TriggerAttributes })
    }
    else if (Icon is { } icon)
    {
        <TbIconButton Icon="icon" AriaLabel="@(AriaLabel ?? "")" Variant="TriggerVariant" Size="TriggerSize"
                      Disabled="Disabled" @attributes="TriggerAttributes" />
    }
    else
    {
        <TbButton Variant="TriggerVariant" Size="TriggerSize" Disabled="Disabled" @attributes="TriggerAttributes">
            @Label
        </TbButton>
    }
    <div @ref="_panel" id="@PanelId" popover="auto" role="dialog" tabindex="-1" data-part="panel"
         aria-labelledby="@(Title is null ? TriggerId : TitleId)" aria-describedby="@Described?.Id"
         class="tb-popover__panel">
        @if (Title is not null)
        {
            <p id="@TitleId" data-part="title" class="tb-popover__title">@Title</p>
        }
        @* A button group or description around the popover belongs to this popover, so neither cascades into what
           the panel holds. *@
        <CascadingValue TValue="TbButtonGroup" Value="null">
            <CascadingValue TValue="PopoverDescription" Value="null">@ChildContent</CascadingValue>
        </CascadingValue>
    </div>
</div>

@code {
    private ControlTelemetry? _telemetry;
    private readonly string _id = $"tb-popover-{Guid.NewGuid():N}";
    private ElementReference _root;
    private ElementReference _panel;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<PopoverEvents>? _reference;
    private bool _lastOpen;
    // Whether the panel is open, as the script last reported it or was told; a script attached again reports it again.
    private bool _panelOpen;
    // What the script was attached with, so a change attaches it again.
    private (Placement, PlacementAlign, bool) _attachedWith;
    private bool _attaching;
    private bool _disposed;

    /// <summary>The text on the trigger button. Required unless an <see cref="Icon"/> or a <see cref="Trigger"/>
    /// gives the trigger.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The icon trigger's accessible name, which screen readers read and which is never shown. Required
    /// with an <see cref="Icon"/>.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Shows an icon button as the trigger instead of a text button.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>A trigger of your own, such as an avatar button. Put the context's attributes on the button:
    /// <c>@attributes="context.Attributes"</c>.</summary>
    [Parameter]
    public RenderFragment<PopoverTrigger>? Trigger { get; set; }

    /// <summary>How the built-in trigger is drawn. Defaults to <see cref="Trailblazor.Variant.Outlined"/>.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>How big the built-in trigger is. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>A title at the top of the panel, which also names it for screen readers. Without it, the trigger
    /// names the panel.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Which side of the trigger the panel opens on. It flips to the other side
    /// when there's no room. Placed to the side in a narrow window, it wraps to fit or else overlaps the trigger.
    /// Defaults to <see cref="Placement.Bottom"/>.</summary>
    [Parameter]
    public Placement Placement { get; set; } = Placement.Bottom;

    /// <summary>How the panel lines up with the trigger along that side. Defaults to
    /// <see cref="PlacementAlign.Start"/>.</summary>
    [Parameter]
    public PlacementAlign Align { get; set; } = PlacementAlign.Start;

    /// <summary>Also opens the panel when the pointer rests on the trigger, and closes it a moment after the pointer
    /// leaves both. Clicks and the keyboard still open it.</summary>
    [Parameter]
    public bool OpenOnHover { get; set; }

    /// <summary>Stops the trigger from opening the panel, by click, keyboard or hover.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the panel is open. Bind it with <c>@bind-Open</c> to open or close it from code.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Raised when the panel opens or closes.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>A label this popover's use is counted under, such as <c>"trail-details"</c>, through the
    /// <c>Trailblazor</c> meter: shown as it renders, and used each time the user opens it, by pointer or key.
    /// Controls that share a label count together. It names what the popover does, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    /// <summary>The panel's content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Sets up the popover's script when its trigger is first focused, pointed at or clicked, or the panel is
    /// opened from code, not when the popover first renders. That saves a call to the browser for each popover in a
    /// long list, such as a popover on every row.</summary>
    [Parameter]
    public bool AttachOnFirstUse { get; set; }

    private bool _givenVariant;
    private bool _givenSize;

    [CascadingParameter]
    private TbButtonGroup? Group { get; set; }

    private Variant TriggerVariant => TbButtonGroup.Choose(_givenVariant, Variant, Group?.Variant);

    private Size TriggerSize => TbButtonGroup.Choose(_givenSize, Size, Group?.Size);

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        // In a button group, the trigger takes the group's settings unless the popover was given its own.
        _givenVariant = parameters.TryGetValue<Variant>(nameof(Variant), out _);
        _givenSize = parameters.TryGetValue<Size>(nameof(Size), out _);
        return base.SetParametersAsync(parameters);
    }

    // A given id names the trigger, built in or the app's own, since Attributes sets a custom trigger's id.
    private string TriggerId => GivenId ?? $"{_id}-trigger";

    private string PanelId => $"{_id}-panel";

    private string TitleId => $"{_id}-title";

    // Set by a component built on the popover, such as a popconfirm, whose panel content describes the panel.
    [CascadingParameter]
    private PopoverDescription? Described { get; set; }

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["id"] = TriggerId,
                ["popovertarget"] = PanelId,
                ["aria-haspopup"] = "dialog",
                ["aria-controls"] = PanelId,
                ["aria-expanded"] = "false",
                ["data-part"] = "trigger",
            };
            // A static page never runs the script, so tests know not to wait for it; popovertarget still opens it.
            if (AssignedRenderMode is null && !RendererInfo.IsInteractive)
            {
                attributes["data-static"] = "";
            }

            // A popover that waits for its first use listens on its trigger and marks it, so tests know to focus it
            // first. A prerendered trigger is replaced as the page turns interactive, so only the interactive one is
            // marked. A popover opened from code isn't marked either: it attaches after this render, its last until
            // it's used.
            if (AttachOnFirstUse && RendererInfo.IsInteractive && !_attaching && !Open)
            {
                attributes["data-attach-on-use"] = "";
                attributes["onfocus"] = EventCallback.Factory.Create(this, AttachOnUseAsync);
                attributes["onpointerenter"] = EventCallback.Factory.Create(this, AttachOnUseAsync);
                attributes["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, AttachOnUseAsync);
            }

            // The built-in triggers take Disabled as a parameter; a custom one gets the attribute.
            if (Disabled && Trigger is not null)
            {
                attributes["disabled"] = true;
            }

            return attributes;
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Trigger is null && Icon is not null && string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException($"{nameof(TbPopover)} with an {nameof(Icon)} needs an "
                + $"{nameof(AriaLabel)}, which names the icon button; {nameof(Label)} is for a text trigger.");
        }

        if (Trigger is null && Icon is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException(
                $"{nameof(TbPopover)} needs a {nameof(Label)} or a {nameof(Trigger)}.");
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Telemetry.Rendered(TelemetryName);
        try
        {
            if ((!AttachOnFirstUse || Open) && !_attaching)
            {
                _attaching = true;
                await AttachAsync();
            }
            else if (_handle is not null && _attachedWith != (Placement, Align, OpenOnHover))
            {
                // Taken out first, so a render during the awaits neither disposes it twice nor skips the new one.
                var old = _handle;
                _handle = null;
                // The new script would inherit a panel left open, so a close from the parent goes to the old one first.
                if (Open != _lastOpen)
                {
                    _lastOpen = _panelOpen = Open;
                    await old.InvokeVoidAsync("setOpen", Open);
                }

                await old.DisposeHandleAsync();
                _reference?.Dispose();
                await AttachAsync();
            }
            else if (_handle is not null && Open != _lastOpen)
            {
                _lastOpen = _panelOpen = Open;
                await _handle.InvokeVoidAsync("setOpen", Open);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the popover went with it.
        }
    }

    private async Task AttachOnUseAsync()
    {
        if (_attaching)
        {
            return;
        }

        _attaching = true;
        try
        {
            await AttachAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the popover went with it.
        }
    }

    private async Task AttachAsync()
    {
        var module = await Modules.ImportAsync("./_content/Trailblazor/popover.js");
        if (_disposed)
        {
            return;
        }

        // Only a bound Open or a TelemetryName needs to hear about toggles, so a popover with neither costs no round
        // trips.
        _reference = OpenChanged.HasDelegate || TelemetryName is not null
            ? DotNetObjectReference.Create(new PopoverEvents(OnToggleAsync)) : null;
        var options = new AnchoredPositionOptions
        {
            Side = Anchors.Side(Placement), Align = Anchors.Align(Align), Offset = 8,
        };
        _attachedWith = (Placement, Align, OpenOnHover);
        var handle = await module.InvokeAsync<IJSObjectReference?>("createPopover", _root, _panel, options,
            OpenOnHover, _reference);
        if (handle is null)
        {
            return;
        }

        if (_disposed)
        {
            await handle.DisposeHandleAsync();
            return;
        }

        _handle = handle;
        if (Open)
        {
            _lastOpen = _panelOpen = true;
            await _handle.InvokeVoidAsync("setOpen", true);
        }

        // An option or Open that changed during the awaits takes effect on the next render.
        if (_attachedWith != (Placement, Align, OpenOnHover) || Open != _lastOpen)
        {
            StateHasChanged();
        }
    }

    // The popover's script reports the panel opening or closing, as a click or Escape changes it.
    internal async Task OnToggleAsync(bool open)
    {
        if (open == _panelOpen || (OpenChanged.HasDelegate && open == Open))
        {
            return;
        }

        _panelOpen = open;
        if (open)
        {
            Telemetry.Used(TelemetryName);
        }

        // Without a binding, leave Open alone: the parent's next render would put its value back anyway.
        if (!OpenChanged.HasDelegate)
        {
            return;
        }

        Open = open;
        _lastOpen = open;
        await OpenChanged.InvokeAsync(open);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _reference?.Dispose();
    }
}
