@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

@code {
    // The label, the box with the input and its slots, then the helper text and messages, shared by the text fields.
    private protected RenderFragment Layout(FieldClasses? classes, RenderFragment input, RenderFragment? start,
        RenderFragment? end) =>
        @<div @attributes="AdditionalAttributes" style="@Style"
              class="@ClassNames.Join("tb-field", Errors.Count > 0 ? "tb-field--invalid" : null,
                         Disabled ? "tb-field--disabled" : null, Class)">
            @if (Label is not null)
            {
                <label data-part="label" id="@LabelId" for="@(LabelTargetsInput ? InputId : null)"
                       class="@ClassNames.Join("tb-field__label", classes?.Label)">
                    @Label
                    @RequiredMarker
                </label>
            }
            <div data-part="control" class="@ClassNames.Join("tb-field__control", classes?.Control)">
                @if (start is not null)
                {
                    <span data-part="start" class="@ClassNames.Join("tb-field__start", classes?.Start)">@start</span>
                }
                @input
                @if (end is not null)
                {
                    <span data-part="end" class="@ClassNames.Join("tb-field__end", classes?.End)">@end</span>
                }
            </div>
            @Messages(classes?.Helper, classes?.Error)
        </div>;

    private protected RenderFragment RequiredMarker =>
        @<text>
            @if (Required)
            {
                <span class="tb-field__required" aria-hidden="true">*</span>
            }
        </text>;

    private protected RenderFragment Messages(string? helperClass, string? errorClass) =>
        @<text>
            @if (HelperText is not null)
            {
                <div data-part="helper" id="@HelperId" class="@ClassNames.Join("tb-field__helper", helperClass)">
                    @HelperText
                </div>
            }
            @if (Errors.Count > 0)
            {
                <div data-part="error" id="@ErrorId" class="@ClassNames.Join("tb-field__error", errorClass)">
                    @foreach (var error in Errors)
                    {
                        <div>@error</div>
                    }
                </div>
            }
        </text>;
}
