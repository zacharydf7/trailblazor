@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

@code {
    // The label, the box with the input and its slots, then the helper text and messages, shared by the text fields.
    // `before` and `after` sit at the box's edges, outside the Start and End content.
    private protected RenderFragment Layout(FieldClasses? classes, RenderFragment input, RenderFragment? start,
        RenderFragment? end, RenderFragment? before = null, RenderFragment? after = null) =>
        @<div @attributes="RootAttributes" style="@Style" data-commits="@_commits"
              class="@ClassNames.Join("tb-field", FieldModifiers, ShowsInvalid ? "tb-field--invalid" : null,
                         Disabled ? "tb-field--disabled" : null, ReadOnly ? "tb-field--readonly" : null, Class)">
            @if (ShownLabel is not null)
            {
                @WithInfo(FieldLabel(classes))
            }
            <div data-part="control" class="@ClassNames.Join("tb-field__control", classes?.Control)">
                @before
                @if (start is not null)
                {
                    <span data-part="start" class="@ClassNames.Join("tb-field__start", classes?.Start)">@start</span>
                }
                @input
                @if (end is not null)
                {
                    <span data-part="end" class="@ClassNames.Join("tb-field__end", classes?.End)">@end</span>
                }
                @after
            </div>
            @Messages(classes?.Helper, classes?.Status, classes?.Error)
            @AfterMessages
        </div>;

    // The app's content and the field's own in one slot, or null when neither has any. Each keeps its own region
    // whether or not the other is there, so the app's content isn't rebuilt when a clear button comes and goes.
    private protected static RenderFragment? Joined(RenderFragment? first, RenderFragment? second) =>
        first is null && second is null ? null : builder =>
        {
            builder.AddContent(0, first);
            builder.AddContent(1, second);
        };

    private RenderFragment FieldLabel(FieldClasses? classes) =>
        @<label data-part="label" id="@LabelId" for="@(LabelTargetsInput ? InputId : null)"
                class="@ClassNames.Join("tb-field__label", LabelHiddenClass, classes?.Label)">
            @* The mark's margin is its only gap, so it follows the text with no space. *@
            @ShownLabel@RequiredMarker
        </label>;

    private protected RenderFragment RequiredMarker =>
        @<text>
            @if (IsRequired && !MarkersHidden)
            {
                <span class="tb-field__required" aria-hidden="true">*</span>
            }
        </text>;

    // A group or grid can't carry aria-required, so hidden text describes it as required instead. Keeping that text out
    // of the label leaves its name, which test helpers match, unchanged.
    private protected RenderFragment RequiredDescription =>
        @<text>
            @if (IsRequired)
            {
                <span id="@RequiredId" hidden>@Localizer[TbStrings.FieldRequiredMark]</span>
            }
        </text>;

    private protected RenderFragment Messages(string? helperClass, string? statusClass, string? errorClass) =>
        @<text>
            @if (HelperText is not null)
            {
                <div data-part="helper" id="@HelperId" class="@ClassNames.Join("tb-field__helper", helperClass)">
                    @HelperText
                </div>
            }
            @if (ShownStatus is { } status)
            {
                <div data-part="validation-status" id="@StatusId" data-status="@status.ToString().ToLowerInvariant()"
                     class="@ClassNames.Join("tb-field__status", statusClass)">
                    @if (StatusTemplate is not null)
                    {
                        @StatusTemplate(status)
                    }
                    else
                    {
                        @if (StatusIcon(status) is { } icon)
                        {
                            <TbIcon Icon="icon" Size="Size.Small" />
                        }
                        else
                        {
                            <span class="tb-field__spinner" aria-hidden="true"></span>
                        }
                        <span>@StatusText(status)</span>
                    }
                </div>
            }
            @if (Errors.Count > 0)
            {
                <div data-part="error" id="@ErrorId" class="@ClassNames.Join("tb-field__error", errorClass)">
                    @foreach (var error in Errors)
                    {
                        <div data-part="message">
                            @if (ShowsStatus)
                            {
                                <TbIcon Icon="ErrorIcon" Size="Size.Small" />
                            }
                            @error
                        </div>
                    }
                </div>
            }
        </text>;
}
