@namespace Trailblazor
@typeparam TValue
@inherits TbFieldBase<TValue>

@Layout(Classes, @<text>
    @if (RendererInfo.IsInteractive)
    {
        @* Focus stays on the listbox; the script moves the active option and points aria-activedescendant at it. *@
        <div @attributes="ControlAttributes" @ref="_listbox" data-part="input" id="@InputId" role="listbox"
             tabindex="@(Disabled ? "-1" : "0")" aria-labelledby="@(ShownLabel is null ? null : LabelId)"
             aria-multiselectable="@(Multiple ? "true" : null)" aria-disabled="@(Disabled ? "true" : null)"
             aria-readonly="@(ReadOnly ? "true" : null)" aria-required="@AriaRequired"
             aria-invalid="@(ShowsInvalid ? "true" : null)"
             aria-describedby="@InputDescribedBy" style="--tb-listbox-rows: @Rows"
             class="@ClassNames.Join("tb-field__input", "tb-listbox", ClassNames.Modifier("tb-listbox", Size),
                        Classes?.Input)">
            <CascadingValue Value="this">@ChildContent</CascadingValue>
            @if (_options.Count == 0)
            {
                @* A listbox holds only options, so the message is one that can't be chosen, in muted text rather
                   than disabled. *@
                <div role="option" aria-disabled="true" aria-selected="false" data-part="status"
                     class="tb-select__status">
                    @EmptyText
                </div>
            }
        </div>
    }
    else
    {
        @* A native list works without a circuit; data-prerender marks one a listbox will replace. *@
        <select @attributes="ControlAttributes" data-part="input" id="@InputId" name="@InputNameAttribute"
                data-prerender="@(AssignedRenderMode is null ? null : "")" size="@Rows" multiple="@Multiple"
                disabled="@Disabled" aria-readonly="@(ReadOnly ? "true" : null)"
                aria-required="@AriaRequired"
                aria-invalid="@(ShowsInvalid ? "true" : null)" aria-describedby="@InputDescribedBy"
                class="@ClassNames.Join("tb-field__input", "tb-listbox", "tb-listbox--native",
                           ClassNames.Modifier("tb-listbox", Size), Classes?.Input)">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
            @if (_options.Count == 0)
            {
                <option disabled data-part="status">@EmptyText</option>
            }
        </select>
    }
</text>, null, null)
