@namespace Trailblazor
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inherits TbComponentBase
@inject NavigationManager Navigation
@inject ITbLocalizer Localizer

@* The testing helper reads data-page and data-page-count, and waits for data-ready before a click that needs the
   page to be interactive. *@
<nav @attributes="AdditionalAttributes" data-page="@CurrentPage"
     aria-label="@(AriaLabel ?? NavigationLabel)"
     data-page-count="@Count" data-ready="@(RendererInfo.IsInteractive ? "" : null)" style="@Style"
     class="@ClassNames.Join("tb-pagination", ClassNames.Modifier("tb-pagination", Size),
                Compact ? "tb-pagination--compact" : null, Class)">
    @* Safari drops the list role from a list without bullets, so it is set again. *@
    <ul role="list" class="tb-pagination__list">
        @if (ShowFirstLast)
        {
            <li>@Step(BuiltInIcons.PageFirst, FirstLabel, 1, "first")</li>
        }
        @if (ShowPreviousNext)
        {
            <li>@Step(BuiltInIcons.ChevronStart, PreviousLabel, CurrentPage - 1, "previous")</li>
        }
        @if (Compact)
        {
            <li class="tb-pagination__jump">
                @* The page box is the pager's own, so a form around it neither counts it nor turns it off. *@
                <CascadingValue TValue="EditContext" Value="null">
                    <CascadingValue TValue="TbForm" Value="null">
                        <TbNumberField TValue="int?" Value="CurrentPage" ValueChanged="GoToTypedPageAsync"
                                       HideStepButtons Disabled="Disabled" InputAttributes="PageBoxAttributes"
                                       data-part="page-box" Class="tb-pagination__box" />
                    </CascadingValue>
                </CascadingValue>
                <span id="@CountId" data-part="page-count">
                    @string.Format(CultureInfo.CurrentCulture, OfLabel, Count)
                </span>
            </li>
        }
        else
        {
            @* Keyed by page, so the button chosen keeps its focus when the pages shown shift around it. *@
            var gap = "gap-start";
            @foreach (var page in PageRange.For(CurrentPage, Count, SiblingCount, BoundaryCount))
            {
                @if (page is int number)
                {
                    <li @key="number">
                        <TbButton Href="@PageHref?.Invoke(number)" Size="Size"
                                  Variant="@(number == CurrentPage ? Variant.Soft : Variant.Text)"
                                  Tone="@(number == CurrentPage ? Tone.Primary : Tone.Neutral)"
                                  Disabled="Disabled" aria-current="@(number == CurrentPage ? "page" : null)"
                                  aria-label="@string.Format(CultureInfo.CurrentCulture, PageLabel, number)"
                                  OnClick="args => OnClickedAsync(args, number)" data-part="page" Class="tb-pagination__page">
                            @number
                        </TbButton>
                    </li>
                }
                else
                {
                    <li @key="gap" aria-hidden="true" data-part="ellipsis" class="tb-pagination__ellipsis">…</li>
                    gap = "gap-end";
                }
            }
        }
        @if (ShowPreviousNext)
        {
            <li>@Step(BuiltInIcons.ChevronEnd, NextLabel, CurrentPage + 1, "next")</li>
        }
        @if (ShowFirstLast)
        {
            <li>@Step(BuiltInIcons.PageLast, LastLabel, Count, "last")</li>
        }
    </ul>
</nav>

@code {
    /// <summary>The current page, from 1. Bind it with <c>@bind-Page</c>.</summary>
    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>Raised, and awaited, when the user goes to another page.</summary>
    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    /// <summary>How many pages there are. Required.</summary>
    [Parameter, EditorRequired]
    public int PageCount { get; set; }

    /// <summary>How many pages show on each side of the current one. Defaults to 1.</summary>
    [Parameter]
    public int SiblingCount { get; set; } = 1;

    /// <summary>How many pages always show at each end. Defaults to 1.</summary>
    [Parameter]
    public int BoundaryCount { get; set; } = 1;

    /// <summary>Shows buttons that go to the first and last pages.</summary>
    [Parameter]
    public bool ShowFirstLast { get; set; }

    /// <summary>Shows buttons that go to the previous and next pages. On by default.</summary>
    [Parameter]
    public bool ShowPreviousNext { get; set; } = true;

    /// <summary>Shows a box for the current page and the page count instead of numbered buttons, for long lists or
    /// tight spaces.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Makes every button a link to the address this returns for its page, so the pages can be crawled and
    /// work before the page is interactive.</summary>
    [Parameter]
    public Func<int, string>? PageHref { get; set; }

    /// <summary>The buttons' size. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Turns every button off.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The navigation's accessible name. Defaults to <see cref="PaginationLabels.Navigation"/>; name each
    /// one when a page has several.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>The words read to screen readers and shown in compact mode.</summary>
    [Parameter]
    public PaginationLabels Labels { get; set; } = new();

    // A list with no pages still has one, so the pagination always has a current page.
    private int Count => Math.Max(PageCount, 1);

    private int CurrentPage => Math.Clamp(Page, 1, Count);

    private string CountId { get; } = $"tb-pagination-{Guid.NewGuid():N}-count";

    private IReadOnlyDictionary<string, object> PageBoxAttributes => new Dictionary<string, object>
    {
        ["aria-label"] = PageBoxLabel,
        ["aria-describedby"] = CountId,
    };

    private RenderFragment Step(Icon icon, string label, int page, string part) =>
        @<TbIconButton Icon="icon" AriaLabel="@label" Href="@PageHref?.Invoke(Math.Clamp(page, 1, Count))" Size="Size"
                       Disabled="@(Disabled || page < 1 || page > Count || page == Page)"
                       FocusableWhenDisabled="!Disabled"
                       OnClick="args => OnClickedAsync(args, page)"
                       data-part="@part" Class="tb-pagination__step" />;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (PageCount < 0 || SiblingCount < 0 || BoundaryCount < 1)
        {
            throw new InvalidOperationException(
                "A pagination needs a PageCount and SiblingCount of 0 or more, and a BoundaryCount of 1 or more.");
        }
    }

    // A modified click opens the link in a new tab or window. This tab's address stays put, so its page must too.
    private Task OnClickedAsync(MouseEventArgs args, int page) =>
        PageHref is not null && (args.CtrlKey || args.MetaKey || args.ShiftKey || args.AltKey)
            ? Task.CompletedTask : GoToAsync(page);

    // Compared with Page, not the clamped page shown, so a parent left on a page past a shrunken count can come back.
    private async Task GoToAsync(int page)
    {
        page = Math.Clamp(page, 1, Count);
        if (page == Page)
        {
            return;
        }

        Page = page;
        await PageChanged.InvokeAsync(page);
    }

    // Typed pages past either end go to that end, and a cleared box goes back to the current page. With links, the
    // typed page is navigated to as a click on its link would be.
    private async Task GoToTypedPageAsync(int? page)
    {
        var target = Math.Clamp(page ?? Page, 1, Count);
        if (page is null || target == Page)
        {
            return;
        }

        await GoToAsync(target);
        if (PageHref is not null)
        {
            Navigation.NavigateTo(PageHref(target));
        }
    }

    private string NavigationLabel => Labels.Navigation ?? Localizer[TbStrings.PaginationNavigation];
    private string PageLabel => Labels.Page ?? Localizer[TbStrings.PaginationPage];
    private string PageBoxLabel => Labels.PageBox ?? Localizer[TbStrings.PaginationPageBox];
    private string OfLabel => Labels.Of ?? Localizer[TbStrings.PaginationOf];
    private string PreviousLabel => Labels.Previous ?? Localizer[TbStrings.PaginationPrevious];
    private string NextLabel => Labels.Next ?? Localizer[TbStrings.PaginationNext];
    private string FirstLabel => Labels.First ?? Localizer[TbStrings.PaginationFirst];
    private string LastLabel => Labels.Last ?? Localizer[TbStrings.PaginationLast];
}
