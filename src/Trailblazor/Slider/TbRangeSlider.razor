@namespace Trailblazor
@typeparam TValue
@inherits TbSliderBase<SliderRange<TValue>>

@* Two native range inputs share one track, each taking the pointer only on its thumb. range-slider.js takes the rest. *@
@Layout(StartId, Fraction(Start), Fraction(End), @<text>
    <span id="@($"{StartId}-name")" hidden>@(Labels.Start ?? Localizer[TbStrings.RangeSliderStart])</span>
    <span id="@($"{EndId}-name")" hidden>@(Labels.End ?? Localizer[TbStrings.RangeSliderEnd])</span>
    @Thumb(start: true)
    @Thumb(start: false)
    @Bubble(Fraction(Start), Format(Start))
    @Bubble(Fraction(End), Format(End))
</text>)

@code {
    private ElementReference _start;

    // Method groups keep their handler ids between renders, unlike @bind's closures; value syncs as with @bind.
    private RenderFragment Thumb(bool start) => builder =>
    {
        var id = start ? StartId : EndId;
        var value = start ? Start : End;
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, InputAttributes);
        builder.AddAttribute(2, "data-part", start ? "start-thumb" : "end-thumb");
        builder.AddAttribute(3, "id", id);
        builder.AddAttribute(4, "data-tb-autofocus", start ? AutoFocusMark : null);
        builder.AddAttribute(5, "name", NameOf(start ? "Start" : "End"));
        builder.AddAttribute(6, "type", "range");
        builder.AddAttribute(7, "data-value", Invariant(value));
        builder.AddAttribute(8, "data-static", StaticMark);
        builder.AddAttribute(9, "data-ready", ReadyMark);
        builder.AddAttribute(10, "min", Invariant(Min));
        builder.AddAttribute(11, "max", Invariant(Max));
        builder.AddAttribute(12, "step", Invariant(Step));
        builder.AddAttribute(13, "value", Invariant(value));
        builder.AddAttribute(14, "oninput", start
            ? EventCallback.Factory.Create<ChangeEventArgs>(this, OnStartSlideAsync)
            : EventCallback.Factory.Create<ChangeEventArgs>(this, OnEndSlideAsync));
        builder.SetUpdatesAttributeName("value");
        builder.AddAttribute(15, "onchange", EventCallback.Factory.Create(this, CommitAsync));
        builder.AddAttribute(16, "disabled", CantChange);
        builder.AddAttribute(17, "aria-valuetext", Format(value));
        builder.AddAttribute(18, "aria-labelledby", Names(id));
        builder.AddAttribute(19, "aria-readonly", ReadOnly ? "true" : null);
        builder.AddAttribute(20, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(21, "aria-describedby", InputDescribedBy);
        builder.AddAttribute(22, "class", ClassNames.Join("tb-slider__input", SharedClass, Classes?.Input));
        if (start)
        {
            builder.AddElementReferenceCapture(23, input => _start = input);
        }

        builder.CloseElement();
    };

    private Task OnStartSlideAsync(ChangeEventArgs args) => SetStartAsync(args.Value as string);

    private Task OnEndSlideAsync(ChangeEventArgs args) => SetEndAsync(args.Value as string);

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _start.FocusAsync(preventScroll);

    /// <summary>The words that name the thumbs, after the field's label. Each one left null uses the app's text.
    /// </summary>
    [Parameter]
    public RangeSliderLabels Labels { get; set; } = new();

    /// <summary>Turns a thumb's value into the text shown above it and read by screen readers, such as "40%".
    /// Defaults to the number itself.</summary>
    [Parameter]
    public Func<TValue, string>? ValueFormatter { get; set; }

    private protected override Type NumberType => Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    // Its two thumbs are named from the field's own ids, so an id it is given stays on its root.
    private protected override bool IdNamesControl => false;

    private string StartId => $"{InputId}-start";

    private string EndId => $"{InputId}-end";

    // A range the parent left empty, or turned around, still draws its thumbs in order.
    private decimal Start => Math.Clamp(Math.Min(ToNumber(Value.Start) ?? Min, ToNumber(Value.End) ?? Max), Min, Max);

    private decimal End => Math.Clamp(Math.Max(ToNumber(Value.Start) ?? Min, ToNumber(Value.End) ?? Max), Min, Max);

    // Only a drag's direction can tell which of two thumbs on one value it means, so range-slider.js handles the press.
    private string? SharedClass => Start == End ? "tb-slider__input--shared" : null;

    private string Names(string thumb) => ShownLabel is null ? $"{thumb}-name" : $"{LabelId} {thumb}-name";

    private string? NameOf(string part) => InputNameAttribute is null ? null : $"{InputNameAttribute}.{part}";

    private string Format(decimal number) =>
        ValueFormatter?.Invoke((TValue)ToValue(number)) ?? Invariant(number);

    // A thumb stops at the other, so the range never turns around.
    // Assistive technology sets a range input's value without keys or the pointer, so read-only holds here too.
    private Task SetStartAsync(string? text) => !ReadOnly && Parse(text) is decimal number
        ? SetValueAsync(new((TValue)ToValue(Math.Min(number, End)), (TValue)ToValue(End)))
        : Task.CompletedTask;

    private Task SetEndAsync(string? text) => !ReadOnly && Parse(text) is decimal number
        ? SetValueAsync(new((TValue)ToValue(Start), (TValue)ToValue(Math.Max(number, Start))))
        : Task.CompletedTask;
}
