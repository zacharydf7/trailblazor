@namespace Trailblazor
@using System.Globalization
@typeparam TValue
@inherits TbFieldBase<TValue>

@code {
    // The label, the track with its fill, marks and thumbs, then the helper text and messages. The fill runs from the
    // track's start, or for a range from the first fraction, to the second; each slider renders its own thumbs.
    private RenderFragment SliderLabel(string? labelFor) =>
        @<label data-part="label" id="@LabelId" for="@labelFor"
                class="@ClassNames.Join("tb-slider__label", LabelHiddenClass, Classes?.Label)">
            @ShownLabel
            @RequiredMarker
        </label>;

    private protected RenderFragment Layout(string? labelFor, double? from, double to, RenderFragment thumbs) =>
        @<div @attributes="RootAttributes" style="@Style"
              class="@ClassNames.Join("tb-slider", ClassNames.Modifier("tb-slider", Size),
                         from is null ? null : "tb-slider--range",
                         ShowsInvalid ? "tb-slider--invalid" : null, Disabled ? "tb-slider--disabled" : null,
                         Class)">
            @if (ShownLabel is not null)
            {
                @WithInfo(SliderLabel(labelFor))
            }
            <div class="tb-slider__control"
                 style="@($"--tb-slider-from: {Ratio(from ?? 0)}; --tb-slider-to: {Ratio(to)}")">
                <span data-part="track" class="tb-slider__track">
                    <span data-part="fill" class="tb-slider__fill"></span>
                </span>
                @thumbs
            </div>
            @if (Marks is { Count: > 0 })
            {
                <div class="tb-slider__marks" aria-hidden="true">
                    @foreach (var mark in Marks)
                    {
                        <span data-part="mark" class="tb-slider__mark"
                              style="@($"--tb-slider-at: {Ratio(Fraction(mark.Value))}")">@mark.Label</span>
                    }
                </div>
            }
            @Messages(Classes?.Helper, Classes?.Error)
        </div>;

    // A thumb's value, shown above it when ShowValue is set.
    private protected RenderFragment Bubble(double at, string text) =>
        @<text>
            @if (ShowValue)
            {
                <span data-part="value" class="tb-slider__value" aria-hidden="true"
                      style="@($"--tb-slider-at: {Ratio(at)}")">@text</span>
            }
        </text>;

    private static string Ratio(double fraction) => fraction.ToString("0.####", CultureInfo.InvariantCulture);
}
