@namespace Trailblazor
@typeparam TValue
@inherits TbSliderBase<TValue>

@Layout(InputId, null, Fraction(Number), @<text>
    @Input
    @Bubble(Fraction(Number), ValueText)
</text>)

@code {
    private ElementReference _input;

    // Method groups keep their handler ids between renders, unlike @bind's closures; value syncs as with @bind.
    private RenderFragment Input => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, ControlAttributes);
        builder.AddAttribute(2, "data-part", "input");
        builder.AddAttribute(3, "id", InputId);
        builder.AddAttribute(4, "name", InputNameAttribute);
        builder.AddAttribute(5, "type", "range");
        // Tests read data-value to know a round trip is done.
        builder.AddAttribute(6, "data-value", Invariant(Number));
        builder.AddAttribute(7, "data-static", StaticMark);
        builder.AddAttribute(8, "data-ready", ReadyMark);
        builder.AddAttribute(9, "min", Invariant(Min));
        builder.AddAttribute(10, "max", Invariant(Max));
        builder.AddAttribute(11, "step", Invariant(Step));
        builder.AddAttribute(12, "value", Invariant(Number));
        builder.AddAttribute(13, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, OnSlideAsync));
        builder.SetUpdatesAttributeName("value");
        builder.AddAttribute(14, "onchange", EventCallback.Factory.Create(this, CommitAsync));
        builder.AddAttribute(15, "disabled", CantChange);
        builder.AddAttribute(16, "aria-valuetext", ValueText);
        builder.AddAttribute(17, "aria-readonly", ReadOnly ? "true" : null);
        builder.AddAttribute(18, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(19, "aria-describedby", InputDescribedBy);
        builder.AddAttribute(20, "class", ClassNames.Join("tb-slider__input", Classes?.Input));
        builder.AddElementReferenceCapture(21, input => _input = input);
        builder.CloseElement();
    };

    private Task OnSlideAsync(ChangeEventArgs args) => SetAsync(args.Value as string);

    /// <summary>Turns a value into the text shown above the thumb and read by screen readers, such as "40%".
    /// Defaults to the number itself.</summary>
    [Parameter]
    public Func<TValue?, string>? ValueFormatter { get; set; }

    /// <inheritdoc />
    public override ValueTask FocusAsync(bool preventScroll = false) => _input.FocusAsync(preventScroll);

    private protected override Type NumberType => Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    // A slider always has a value, so an empty one sits at the start.
    private decimal Number => Math.Clamp(ToNumber(Value) ?? Min, Min, Max);

    private string ValueText => ValueFormatter?.Invoke((TValue)ToValue(Number)) ?? Invariant(Number);

    // Assistive technology sets a range input's value without keys or the pointer, so read-only holds here too.
    private Task SetAsync(string? text) =>
        !ReadOnly && Parse(text) is decimal number ? SetValueAsync((TValue)ToValue(number)) : Task.CompletedTask;
}
