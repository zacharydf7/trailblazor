@namespace Trailblazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@typeparam TItem
@inherits TbComponentBase

<div @attributes="AdditionalAttributes" data-part="grid" style="@Style"
     data-commits="@(RendererInfo.IsInteractive ? _answered : null)"
     class="@ClassNames.Join("tb-data-grid", ClassNames.Modifier("tb-data-grid", Size),
                Striped ? "tb-data-grid--striped" : null, IsLoading ? "tb-data-grid--loading" : null,
                IsLoading && !HasNoRows ? "tb-data-grid--reloading" : null,
                Scrolls ? "tb-data-grid--scrolls" : null, Fill ? "tb-data-grid--fill" : null,
                Virtualize ? "tb-data-grid--virtual" : null, Class)">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    @{ CheckColumnKeys(); ArrangeColumns(); ArrangeDrawnColumns(); ArrangeForColumns(); UpdateRange(); DrawRowsForReorder(); }
    @{ TakeRenderWait(); }
    @if (CanAdd || HasGroupBy || HideableColumns || Exportable)
    {
        <div data-part="toolbar" class="@ClassNames.Join("tb-data-grid__toolbar", Classes?.Toolbar)">
            @if (CanAdd)
            {
                <TbButton @ref="_addButton" Variant="Variant.Text" Size="Size.Small" StartIcon="BuiltInIcons.Plus"
                          data-part="add-row" OnClick="() => AnsweredAsync(AddRowAsync)">
                    @Text(Labels.AddRow, TbStrings.DataGridAddRow)
                </TbButton>
            }
            @if (HasGroupBy)
            {
                @* As with the filters, a page's form around the grid doesn't own the list. *@
                <div data-part="group-by" class="tb-data-grid__group-by-bar">
                    <CascadingValue TValue="EditContext" Value="null">
                        <CascadingValue TValue="TbForm" Value="null">
                            <TbMultiSelect TItem="string" Label="@Text(Labels.GroupBy, TbStrings.DataGridGroupBy)"
                                           Size="Size.Small" Clearable Value="_groups" ValueChanged="GroupByAsync"
                                           class="tb-data-grid__group-by">
                                @foreach (var column in _arrangedColumns.Where(column => column.CanGroup))
                                {
                                    <TbOption Value="column.Key">@column.Heading</TbOption>
                                }
                            </TbMultiSelect>
                        </CascadingValue>
                    </CascadingValue>
                </div>
            }
            @if (HideableColumns)
            {
                <TbMenu Label="@Text(Labels.Columns, TbStrings.DataGridColumns)" Variant="Variant.Text"
                        Size="Size.Small" Align="PlacementAlign.End" data-part="column-chooser"
                        Class="tb-data-grid__column-chooser">
                    @foreach (var column in _arrangedColumns)
                    {
                        <TbMenuCheckboxItem KeepOpen Checked="_shownColumns.Contains(column)"
                                            Disabled="!CanShowOrHide(column)"
                                            CheckedChanged="shown => SetColumnShownAsync(column, shown)">
                            @column.Heading
                        </TbMenuCheckboxItem>
                    }
                </TbMenu>
            }
            @if (Exportable)
            {
                <TbMenu Label="@Text(Labels.Export, TbStrings.DataGridExport)" Variant="Variant.Text" Size="Size.Small"
                        Align="PlacementAlign.End" data-part="export" Class="tb-data-grid__export">
                    <TbMenuItem OnClick="() => ExportFromMenuAsync(ExportFormat.Csv)">
                        @Text(Labels.ExportCsv, TbStrings.DataGridExportCsv)
                    </TbMenuItem>
                    <TbMenuItem OnClick="() => ExportFromMenuAsync(ExportFormat.Excel)">
                        @Text(Labels.ExportExcel, TbStrings.DataGridExportExcel)
                    </TbMenuItem>
                    <TbMenuItem OnClick="() => ExportFromMenuAsync(ExportFormat.Pdf)">
                        @Text(Labels.ExportPdf, TbStrings.DataGridExportPdf)
                    </TbMenuItem>
                </TbMenu>
            }
        </div>
    }
    @* Why the app kept a row it was asked to delete shows above the rows, where a cell can't clip it, and the row's
       Delete button names it as its description. *@
    @if (_deleteRefused is { } refusal)
    {
        <p id="@DeleteRefusedId" data-part="delete-error" class="tb-data-grid__delete-error">@refusal.Message</p>
    }
    @if (EditMode == GridEditMode.Batch)
    {
        @* The bar stays while there is nothing to save, so focus on its buttons isn't lost once the changes are saved. *@
        <div data-part="batch-bar" class="tb-data-grid__batch-bar">
            <span id="@_changedId" hidden>@Text(Labels.Changed, TbStrings.DataGridChanged)</span>
            <span data-part="change-count" class="tb-data-grid__change-count">
                @Format(Labels.UnsavedChanges, TbStrings.DataGridUnsavedChanges, _changes.Count)
            </span>
            @if (_batchError is not null)
            {
                <span data-part="batch-error" class="tb-data-grid__batch-error">@_batchError</span>
            }
            <span class="tb-data-grid__batch-actions">
                <TbButton Size="Size.Small" Disabled="!HasChanges" FocusableWhenDisabled data-part="save-changes"
                          OnClick="SaveChangesFromBarAsync">
                    @Text(Labels.SaveChanges, TbStrings.DataGridSaveChanges)
                </TbButton>
                <TbButton Variant="Variant.Text" Size="Size.Small" Disabled="!HasChanges" FocusableWhenDisabled
                          data-part="discard-changes" OnClick="DiscardChangesFromBarAsync">
                    @Text(Labels.DiscardChanges, TbStrings.DataGridDiscardChanges)
                </TbButton>
            </span>
        </div>
    }
    <div data-part="scroll" class="tb-data-grid__scroll" style="@(Height is null ? null : $"max-block-size: {Height}")"
         role="@(ScrollIsTabStop && !string.IsNullOrEmpty(AriaLabel) ? "region" : null)"
         aria-label="@(ScrollIsTabStop ? AriaLabel : null)"
         tabindex="@(ScrollIsTabStop ? 0 : null)">
        <table @ref="_table" role="@(IsGrid ? !IsTree ? "grid" : "treegrid" : null)" aria-label="@AriaLabel"
               data-count="@(CanReorder ? _total : null)"
               aria-multiselectable="@(IsGrid && (SelectionMode == SelectionMode.Multiple || CellSelection) ? "true" : null)"
               data-cell-selection="@(CellSelection ? "" : null)" data-cell-range="@(HasRange ? "" : null)"
               @ontbcellrange="OnCellRange" @ontbcellrange:stopPropagation
               aria-colcount="@(VirtualizeColumns ? ColumnCount : null)" data-virtual-columns="@(VirtualizeColumns ? "" : null)"
               data-column-keys="@UnpinnedKeys" data-column-widths="@UnpinnedWidths"
               data-column-window="@(VirtualizeColumns ? $"{_columnWindow.First},{_columnWindow.Last}" : null)"
               @ontbcolumnwindow="OnColumnWindow" @ontbcolumnwindow:stopPropagation
               @ontbcellscopy="OnCellsCopied" @ontbcellscopy:stopPropagation
               data-paste="@(CanPaste && RendererInfo.IsInteractive ? "" : null)"
               @ontbcellspaste="OnCellsPastedAsync" @ontbcellspaste:stopPropagation
               data-selection="@(SelectionMode == SelectionMode.Multiple ? "multiple" : null)"
               data-select-all="@(SelectionMode == SelectionMode.Multiple && CanSelectAll ? "" : null)"
               data-row-click-selects="@(SelectionMode == SelectionMode.Multiple && RowClickSelects ? "" : null)"
               @ontbselectall="SelectAllAsync" @ontbselectall:stopPropagation
               @ontbcolumnwidths="OnColumnWidthsAsync" @ontbcolumnwidths:stopPropagation
               @ontbcolumnorder="OnColumnOrderAsync" @ontbcolumnorder:stopPropagation
               data-reorder-columns="@(ReorderableColumns ? "" : null)"
               aria-busy="@(IsLoading ? "true" : null)"
               aria-rowcount="@(!Virtualize ? null : CountUnknown ? -1
                                  : HeaderRowCount + _total + (ShowsStatus ? 1 : 0) + (HasTotals ? 1 : 0))"
               class="@ClassNames.Join("tb-data-grid__table",
                          HasFixedWidths || VirtualizeColumns ? "tb-data-grid__table--fixed" : null)">
            @if (BandDepth > 0 || VirtualizeColumns)
            {
                @* A fixed table takes its widths from its first row, here group headings or a spacer, so the <col>s carry
                   them. *@
                <colgroup>
                    @for (var lead = 0; lead < LeadCount; lead++)
                    {
                        <col />
                    }
                    @foreach (var drawn in _drawnColumns)
                    {
                        if (drawn.Column is not { } column)
                        {
                            <col @key="drawn.SpacerKey" style="@SpacerStyle(drawn)" />
                            continue;
                        }

                        <col @key="column.Key" data-column="@column.Key"
                             style="@(WidthOf(column) is { } width ? $"width: {width}" : null)" />
                    }
                </colgroup>
            }
            <thead>
                @for (var level = 0; level < BandDepth; level++)
                {
                    <tr data-part="bands" aria-rowindex="@(Virtualize ? level + 1 : null)" class="tb-data-grid__bands">
                        @BlankLeadCells
                        @foreach (var (group, columns) in BandsAt(level))
                        {
                            if (group is null)
                            {
                                <td data-pinned="@PinSide(columns[0])" style="@PinStyle(columns[0])"
                                    data-band-edge="@BandEdge(columns[0])"></td>
                            }
                            else
                            {
                                <th scope="col" colspan="@columns.Count" data-part="band"
                                    data-pinned="@PinSide(columns[0])" style="@BandPinStyle(columns)"
                                    class="tb-data-grid__band">@group.Title</th>
                            }
                        }
                    </tr>
                }
                <tr aria-rowindex="@(Virtualize ? BandDepth + 1 : null)">
                    @if (CanReorder)
                    {
                        <th scope="col" data-part="order" data-pinned="@LeadPin" style="@LeadStyle(0)"
                            class="tb-data-grid__handle">
                            <span class="tb-visually-hidden">@Text(Labels.Order, TbStrings.DataGridOrder)</span>
                        </th>
                    }
                    @if (HasDetails)
                    {
                        <th scope="col" data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)"
                            class="tb-data-grid__detail-toggle">
                            <span class="tb-visually-hidden">@Text(Labels.Details, TbStrings.DataGridDetails)</span>
                        </th>
                    }
                    @if (CanDelete)
                    {
                        <th scope="col" data-pinned="@LeadPin" style="@LeadStyle(DeleteSlot)"
                            class="tb-data-grid__delete">
                            <span class="tb-visually-hidden">@Text(Labels.Delete, TbStrings.DataGridDelete)</span>
                        </th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple && CanSelectAll)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <input type="checkbox" data-part="select-all" class="tb-checkbox__input tb-data-grid__check"
                                   aria-label="@(Labels.SelectAll ?? Localizer[TbStrings.DataGridSelectAll])"
                                   checked="@AllSelected" data-mixed="@(SomeSelected ? "" : null)"
                                   disabled="@(_rows.Count == 0)" @onchange="ToggleAllAsync" />
                        </th>
                    }
                    else if (SelectionMode != SelectionMode.None)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <span class="tb-visually-hidden">@Text(Labels.Select, TbStrings.DataGridSelect)</span>
                        </th>
                    }
                    @foreach (var drawn in _drawnColumns)
                    {
                        if (drawn.Column is not { } column)
                        {
                            @SpacerCell(drawn)
                            continue;
                        }

                        var at = _sorts.FindIndex(sort => sort.Column == column.Key);
                        var sort = at < 0 ? null : _sorts[at];
                        @* Keyed, so a moved column's header, and the menu and button in it, move with it. *@
                        <th @key="column.Key" scope="col" data-column="@column.Key" data-title="@column.Heading"
                            aria-colindex="@ColumnIndexOf(column)"
                            data-filtered="@(IsFiltered(column) ? "" : null)" aria-sort="@AriaSort(at, sort)"
                            data-pinned="@PinSide(column)" data-width="@KeptWidth(column)"
                            style="@HeaderStyle(column)"
                            class="@ClassNames.Join("tb-data-grid__header",
                                       ClassNames.Modifier("tb-data-grid__header", column.Alignment), Classes?.Header)">
                            @if (HasColumnMenu(column))
                            {
                                <div class="tb-data-grid__header-content">
                                    @HeaderContent(column, at, sort)
                                    @ColumnMenu(column)
                                </div>
                            }
                            else
                            {
                                @HeaderContent(column, at, sort)
                            }
                            @if (CanResize(column))
                            {
                                @* The column menu resizes from the keys or a click, so the edge is for dragging. *@
                                <div data-part="resize" aria-hidden="true" class="tb-data-grid__resize"></div>
                            }
                        </th>
                    }
                </tr>
                @if (HasFilterRow)
                {
                    <tr data-part="filters" aria-rowindex="@(Virtualize ? BandDepth + 2 : null)"
                        class="tb-data-grid__filters">
                        @BlankLeadCells
                        @foreach (var drawn in _drawnColumns)
                        {
                            if (drawn.Column is not { } column)
                            {
                                @SpacerCell(drawn)
                                continue;
                            }

                            <td @key="column.Key" data-column="@column.Key" data-part="filter" aria-colindex="@ColumnIndexOf(column)"
                                data-value="@FilterText(column)"
                                data-pinned="@PinSide(column)" style="@PinStyle(column)" class="@FilterClass(column)">
                                @if (column.CanFilter)
                                {
                                    @* A page's form doesn't own the grid's filters, which neither change it nor count
                                       toward its errors. *@
                                    <CascadingValue TValue="EditContext" Value="null">
                                        <CascadingValue TValue="TbForm" Value="null">@FilterField(column)</CascadingValue>
                                    </CascadingValue>
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody @ref="_body" data-sortable="@(CanReorder ? "" : null)">
                @if (Adding is { } adding)
                {
                    @Row(adding.Item, NewRowKey, false, -1, null, Text(Labels.NewRow, TbStrings.DataGridNewRow), false,
                        null)
                }
                @if (_failed)
                {
                    <tr data-part="failed" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@DrawnCount">
                            <span>@LoadFailedLabel</span>
                            <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="RefreshAsync">
                                @(Labels.Retry ?? Localizer[TbStrings.DataGridRetry])
                            </TbButton>
                        </td>
                    </tr>
                }
                else if (HasNoRows && IsLoading)
                {
                    <tr data-part="loading" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@DrawnCount">@(Labels.Loading ?? Localizer[TbStrings.DataGridLoading])</td>
                    </tr>
                }
                else if (HasNoRows && Adding is null)
                {
                    <tr data-part="empty" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@DrawnCount">
                            @if (EmptyContent is null)
                            {
                                @EmptyLabel
                            }
                            else
                            {
                                @EmptyContent
                            }
                        </td>
                    </tr>
                }
                @if (Virtualize)
                {
                    <Virtualize @ref="_virtualize" TItem="GridLine" ItemSize="RowSize" SpacerElement="tr"
                                Items="@(DataProvider is null ? _lines : null)"
                                ItemsProvider="VirtualRowsProvider" ItemContent="LineContent"
                                Placeholder="VirtualPlaceholder" />
                }
                else
                {
                    @Rows
                }
            </tbody>
            @if (HasTotals)
            {
                <tfoot>
                    <tr data-part="totals" class="@ClassNames.Join("tb-data-grid__totals", Classes?.Totals)"
                        aria-rowindex="@(Virtualize ? HeaderRowCount + _total + (ShowsStatus ? 1 : 0) + 1 : null)">
                        @TotalCells(_totals, Text(Labels.Totals, TbStrings.DataGridTotals))
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    @if (HasRange)
    {
        @* What Ctrl+C copies, kept by the server, since a virtualized grid draws only some of the range's rows. *@
        <table data-part="copy" data-from="@RangeEnd(_rangeFrom)" data-to="@RangeEnd(_rangeTo)" hidden>
            @foreach (var row in SelectedCellTexts())
            {
                <tr>
                    @foreach (var text in row)
                    {
                        <td>@text</td>
                    }
                </tr>
            }
        </table>
    }
    @if (OnMove.HasDelegate)
    {
        @* The announcer reads the reason out, so this is only for sight. *@
        <div data-part="drop-reason" class="tb-sortable__reason" aria-hidden="true" hidden></div>
    }
    @if (_pageSize is { } size && (_total > 0 || PageSizes is not null))
    {
        var first = _total == 0 ? 0 : (_page - 1) * size + 1;
        var last = Math.Min(_page * size, _total);
        <div data-part="pager" class="@ClassNames.Join("tb-data-grid__pager", Classes?.Pager)">
            <span data-part="summary" class="tb-data-grid__summary">
                @RangeText(first, last)
            </span>
            @if (PageSizes is { Count: > 0 } sizes)
            {
                @* The page-size select belongs to the grid, not to any form around it, so even a disabled form leaves it
                   alone. *@
                <CascadingValue TValue="EditContext" Value="null">
                    <CascadingValue TValue="TbForm" Value="null">
                        <TbSelect TValue="int" Label="@(Labels.PageSize ?? Localizer[TbStrings.DataGridPageSize])"
                                  Size="Size.Small" Value="size" class="tb-data-grid__page-size"
                                  ValueChanged="ChangePageSizeAsync">
                            @foreach (var option in sizes)
                            {
                                <TbOption Value="option">@option</TbOption>
                            }
                        </TbSelect>
                    </CascadingValue>
                </CascadingValue>
            }
            @if (PageCount > 1)
            {
                <TbPagination Page="_page" PageChanged="PageFromPagerAsync" PageCount="PageCount" Size="Size.Small"
                              ShowFirstLast="ShowFirstLast && !CountUnknown"
                              PageHref="@(StateHref is null ? null : PageLink)"
                              AriaLabel="@(AriaLabel is null ? null
                                  : Format(Labels.Pages, TbStrings.DataGridPages, AriaLabel))" />
            }
        </div>
    }
</div>

@code {
    // A filter menu's condition and, when it needs one, its value; Enter in the value applies the menu.
    private RenderFragment Condition(TbColumn<TItem> column, ConditionDraft condition, string label,
        string valueLabel) => @<div data-part="filter-condition" class="tb-data-grid__filter-condition">
        <TbSelect @ref="condition.Select" TValue="FilterOperator" Size="Size.Small" @bind-Value="condition.Operator"
                  Label="@label">
            @foreach (var op in FilterOperators(column))
            {
                <TbOption Value="op">@OperatorLabel(op)</TbOption>
            }
        </TbSelect>
        @if (Comparisons.NeedsValue(condition.Operator))
        {
            <div @onkeydown="_applyOnEnter.For(column)">
                @if (column.FilterKind == ColumnFilterKind.Number)
                {
                    <TbNumberField TValue="decimal?" Size="Size.Small" HideStepButtons Label="@valueLabel"
                                   UpdateOnInput @bind-Value="condition.Number" />
                }
                else
                {
                    <TbTextField TValue="string" Label="@valueLabel" Size="Size.Small" UpdateOnInput
                                 @bind-Value="condition.Text" />
                }
            </div>
        }
    </div>;

    private RenderFragment Row(TItem item, object key, bool selected, int at, string? rowClass, string? label,
        bool expanded, TreePlace? tree) =>
        @<tr @ref="_rowRefs[key]" data-part="row" data-key="@_ids.IdOf(key)" data-selected="@(selected ? "" : null)"
             data-new="@(IsNew(key) ? "" : null)" data-index="@(CanReorder && !IsNew(key) ? at : null)"
             aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)" aria-selected="@AriaSelected(selected)"
             aria-level="@tree?.Level" aria-posinset="@tree?.Position" aria-setsize="@tree?.SetSize"
             aria-expanded="@(tree?.Open is { } open ? open ? "true" : "false" : null)"
             aria-busy="@(tree?.Loading == true ? "true" : null)"
             data-parent-row="@(Virtualize && tree is { ParentIndex: >= 0 } place ? HeaderRowCount + place.ParentIndex + 1
                                 : null)"
             data-tb-focus-root="@(EditMode == GridEditMode.Row && RowEditOf(key) is not null ? "edit" : null)"
             @ontbfocusleave="@(Handler<FieldFocusEventArgs>(
                                 EditMode == GridEditMode.Row && RowEditOf(key) is { } leaving ? LeftHandler(leaving)
                                     : null))"
             @ontbrowclick="_rowClick.For(key)"
             @ontbrowextend="_rowExtend.For(key)"
             class="@ClassNames.Join("tb-data-grid__row", selected ? "tb-data-grid__row--selected" : null,
                        Virtualize && at % 2 == 1 ? "tb-data-grid__row--stripe" : null, Classes?.Row, rowClass)">
            @if (IsNew(key))
            {
                @BlankLeadCells
            }
            else
            {
                @RowLeadCells(item, key, selected, at, label, expanded)
            }
            @foreach (var drawn in _drawnColumns)
            {
                if (drawn.Column is not { } column)
                {
                    @SpacerCell(drawn)
                    continue;
                }

                var editable = CanEdit(column);
                var treeCell = tree is not null && column == _shownColumns[0];
                var change = ChangeOf(key, column);
                var inRange = InRange(key, column);
                @* Keyed, so a cell stays with its column, and keeps focus, as a grid that draws only the columns in view
                   scrolls. *@
                <td @key="column.Key" data-column="@column.Key" data-part="@(treeCell ? "tree-cell" : null)"
                    data-pinned="@PinSide(column)" aria-colindex="@ColumnIndexOf(column)"
                    style="@PinStyle(column)" data-editable="@(editable ? "" : null)"
                    data-changed="@(change is null ? null : "")" aria-describedby="@(change is null ? null : _changedId)"
                    aria-selected="@(CellSelection ? inRange ? "true" : "false" : null)"
                    data-in-range="@(inRange ? "" : null)"
                    data-copy="@(CellSelection && column.CellTemplate is not null ? CopyTextOf(key, column, item) : null)"
                    class="@ClassNames.Join(column.CellClass, change is null ? null : "tb-data-grid__cell--changed",
                               inRange ? "tb-data-grid__cell--in-range" : null, Classes?.Cell)"
                    @ondblclick="@(Handler<MouseEventArgs>(editable ? _startEdit.For((key, column)) : null))"
                    @ontbeditstart="@(Handler<EventArgs>(editable ? _startEdit.For((key, column)) : null))">
                    @if (treeCell)
                    {
                        @TreeToggle(tree!.Value, key, label ?? LabelOf(item))
                    }
                    @if (RowEditOf(key) is { } edit && edit.CellOf(column) is { } cell)
                    {
                        @Editor(edit, cell)
                    }
                    else if (change is not null)
                    {
                        @* A change shows as its column's text, since a cell template draws from the item. *@
                        @column.TextOf(change.Value)
                    }
                    else if (column.CellTemplate is not null)
                    {
                        @column.CellTemplate(item)
                    }
                    else
                    {
                        @column.TextOf(item)
                    }
                    @if (EditMode == GridEditMode.Row && column == _shownColumns[^1] && RowEditOf(key) is { } rowEdit)
                    {
                        @RowActions(rowEdit, label ?? LabelOf(item))
                    }

                </td>
            }
        </tr>;

    // An item's row leads with its move handle, details button, Delete button and selection box.
    private RenderFragment RowLeadCells(TItem item, object key, bool selected, int at, string? label, bool expanded) =>
        @<text>
            @if (CanReorder)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle">
                    @((RenderFragment)(handle => MoveHandle.Add(handle, 0,
                        Format(Labels.RowHandles.Handle, TbStrings.SortableHandle, label ?? LabelOf(item)), at,
                        _total, disabled: false, Labels.RowHandles, Localizer,
                        (to, args) => MoveRowAsync(item, to, args.Detail > 0 ? "pointer" : "keyboard"))))
                </td>
            }
            @if (HasDetails)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)" class="tb-data-grid__detail-toggle">
                    <button type="button" data-part="detail-toggle" aria-expanded="@(expanded ? "true" : "false")"
                            aria-controls="@(expanded ? DetailId(key) : null)"
                            aria-label="@Format(Labels.DetailsFor, TbStrings.DataGridDetailsFor,
                                label ?? LabelOf(item))"
                            class="tb-data-grid__detail-button" @onclick="_toggleDetail.For(key)">
                        <TbIcon Icon="BuiltInIcons.ChevronEnd" Size="Size.Small" class="tb-data-grid__detail-chevron" />
                    </button>
                </td>
            }
            @if (CanDelete)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DeleteSlot)" class="tb-data-grid__delete">
                    <button type="button" data-part="delete" class="tb-data-grid__delete-button"
                            aria-label="@Format(Labels.DeleteRow, TbStrings.DataGridDeleteRow, label ?? LabelOf(item))"
                            aria-describedby="@(_deleteRefused?.Key is { } refused && Equals(refused, key)
                                ? DeleteRefusedId : null)"
                            @onclick="_deleteRow.For(key)" @ondblclick:stopPropagation>
                        <TbIcon Icon="BuiltInIcons.Delete" Size="Size.Small" />
                    </button>
                </td>
            }
            @if (SelectionMode != SelectionMode.None)
            {
                <td data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                    class="tb-data-grid__select">
                    <input type="@(SelectionMode == SelectionMode.Single ? "radio" : "checkbox")"
                           class="@(SelectionMode == SelectionMode.Single ? "tb-radio__input tb-data-grid__check"
                                      : "tb-checkbox__input tb-data-grid__check")" checked="@selected"
                           name="@(SelectionMode == SelectionMode.Single ? _radioName : null)"
                           aria-label="@Format(Labels.SelectRow, TbStrings.DataGridSelectRow, label ?? LabelOf(item))"
                           @onchange="_choose.For(key)" />
                </td>
            }
        </text>;

    // A tree row's first cell is set in by its depth and starts with a button for the rows under it, or a blank space
    // when it has none.
    private RenderFragment TreeToggle(TreePlace tree, object key, string label) =>
        @<span class="tb-data-grid__tree" style="--_tb-data-grid-tree-level: @(tree.Level - 1)">
            @if (tree.Open is { } open)
            {
                <button type="button" data-part="tree-toggle" aria-expanded="@(open ? "true" : "false")"
                        aria-label="@Format(Labels.RowsUnder, TbStrings.DataGridRowsUnder, label)"
                        class="tb-data-grid__tree-toggle"
                        @onclick="_toggleChildren.For(key)" @ondblclick:stopPropagation>
                    @if (tree.Loading)
                    {
                        <span class="tb-data-grid__tree-spinner" aria-hidden="true"></span>
                    }
                    else
                    {
                        <TbIcon Icon="BuiltInIcons.ChevronEnd" Size="Size.Small" class="tb-data-grid__tree-chevron" />
                    }
                </button>
            }
        </span>;

    // A row's edit offers its own Save and Cancel, so a pointer can cancel it too, and Escape on them cancels. Why the
    // app turned the row down shows beside them, since it may not concern any one field.
    private RenderFragment RowActions(GridEdit edit, string label) =>
        @<div data-part="row-actions" class="tb-data-grid__row-actions" @ontbeditkey="OnRowActionKeyAsync"
              @onkeydown:stopPropagation>
            @if (edit.Error is not null)
            {
                <span data-part="row-error" class="tb-data-grid__row-error">@edit.Error</span>
            }
            <TbButton Size="Size.Small" aria-label="@Format(Labels.SaveRow, TbStrings.DataGridSaveRow, label)"
                      OnClick="() => SaveEditAsync(refocus: true)">
                @Text(Labels.Save, TbStrings.DataGridSave)
            </TbButton>
            <TbButton Variant="Variant.Text" Size="Size.Small"
                      aria-label="@Format(Labels.CancelRow, TbStrings.DataGridCancelRow, label)"
                      OnClick="CancelEditAsync">
                @Text(Labels.Cancel, TbStrings.DataGridCancel)
            </TbButton>
        </div>;

    private GridEdit? RowEditOf(object key) => _edit is { } edit && Equals(edit.Key, key) ? edit : null;

    // A cell being edited holds its field, saved when focus leaves it, or in row mode when focus leaves the row; like
    // the filters, a page's form doesn't own it, and its keys go no further than the edit.
    private RenderFragment Editor(GridEdit edit, CellEdit cell) =>
        @<div data-part="editor" data-tb-focus-root="@(EditMode != GridEditMode.Row ? "edit" : null)"
              class="tb-data-grid__editor" @ontbeditkey="OnEditKeyAsync" @onkeydown:stopPropagation
              @ontbfocusleave="@(Handler<FieldFocusEventArgs>(
                                  EditMode != GridEditMode.Row ? LeftHandler(edit) : null))">
            <CascadingValue TValue="EditContext" Value="null">
                <CascadingValue TValue="TbForm" Value="null">
                    @switch (cell.Column.Editor)
                    {
                        case ColumnEditor.Custom:
                            @cell.Column.EditTemplate!(ContextOf(edit, cell))
                            break;
                        case ColumnEditor.Number:
                            <TbNumberField TValue="decimal?" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                           HideStepButtons AutoFocus="cell.Column == edit.Start"
                                           Value="NumberOf(cell.Value)" ValueChanged="number => cell.Value = number"
                                           Error="@cell.Error" />
                            break;
                        case ColumnEditor.Choice:
                            <TbSelect TValue="string" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                      AutoFocus="cell.Column == edit.Start" Value="@cell.Value?.ToString()"
                                      ValueChanged="choice => ChooseAsync(cell, choice)" Error="@cell.Error">
                                @foreach (var (value, label) in cell.Column.Choices)
                                {
                                    <TbOption Value="value.ToString()">@label</TbOption>
                                }
                            </TbSelect>
                            break;
                        case ColumnEditor.Date:
                            @* A standard format, such as "d", leaves the box in the culture's short date. *@
                            <TbDatePicker @ref="cell.Field" TDate="DateOnly" AriaLabel="@cell.Column.Heading"
                                          Size="Size.Small" Format="@(cell.Column.Format is { Length: > 1 } format
                                                                        ? format : null)"
                                          AutoFocus="cell.Column == edit.Start" Value="cell.Value as DateOnly?"
                                          ValueChanged="date => cell.Value = date" Error="@cell.Error" />
                            break;
                        case ColumnEditor.Time:
                            <TbTimePicker @ref="cell.Field" TTime="TimeOnly" AriaLabel="@cell.Column.Heading"
                                          Size="Size.Small"
                                          AutoFocus="cell.Column == edit.Start" Value="cell.Value as TimeOnly?"
                                          ValueChanged="time => cell.Value = time" Error="@cell.Error" />
                            break;
                        case ColumnEditor.DateAndTime:
                            <TbDateTimePicker @ref="cell.Field" TDateTime="DateTime" AriaLabel="@cell.Column.Heading"
                                              Size="Size.Small" AutoFocus="cell.Column == edit.Start"
                                              Value="cell.Value as DateTime?" ValueChanged="when => cell.Value = when"
                                              Error="@cell.Error" />
                            break;
                        case ColumnEditor.DateAndTimeWithOffset:
                            <TbDateTimePicker @ref="cell.Field" TDateTime="DateTimeOffset"
                                              AriaLabel="@cell.Column.Heading"
                                              Size="Size.Small" AutoFocus="cell.Column == edit.Start"
                                              Value="cell.Value as DateTimeOffset?"
                                              ValueChanged="moment => cell.Value = moment" Error="@cell.Error" />
                            break;
                        case ColumnEditor.YesNo:
                            <TbCheckbox TValue="bool" AriaLabel="@cell.Column.Heading"
                                        AutoFocus="cell.Column == edit.Start" Value="cell.Value is true"
                                        ValueChanged="yes => cell.Value = yes" Error="@cell.Error" />
                            break;
                        default:
                            <TbTextField TValue="string" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                         AutoFocus="cell.Column == edit.Start" UpdateOnInput
                                         Value="@(cell.Value as string)" ValueChanged="text => cell.Value = text"
                                         Error="@cell.Error" />
                            break;
                    }
                </CascadingValue>
            </CascadingValue>
        </div>;

    // A group's heading spans the row, and its button stays in view while the rows scroll sideways.
    private RenderFragment GroupRow(GroupHeading group, int at) =>
        @<tr data-part="group" data-level="@group.Level" aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)"
             class="@ClassNames.Join("tb-data-grid__group", Classes?.Group)">
            <td colspan="@DrawnCount" style="--_tb-data-grid-group-level: @(group.Level - 1)"
                class="tb-data-grid__group-cell">
                <button type="button" data-part="group-toggle" aria-expanded="@(group.Open ? "true" : "false")"
                        class="tb-data-grid__group-toggle" @onclick="_toggleGroup.For(group.Key)">
                    <TbIcon Icon="BuiltInIcons.ChevronEnd" Size="Size.Small" class="tb-data-grid__group-chevron" />
                    <span>@GroupName(group)</span>
                    <span class="tb-data-grid__group-count">
                        @Format(Labels.GroupCount, TbStrings.DataGridGroupCount, group.Count)
                    </span>
                </button>
            </td>
        </tr>;

    // A row Virtualize hasn't loaded yet holds its place, and says nothing to screen readers.
    private RenderFragment<PlaceholderContext> VirtualPlaceholder => _ =>
        @<tr data-part="placeholder" aria-hidden="true" class="tb-data-grid__placeholder">
            <td colspan="@DrawnCount"></td>
        </tr>;

    // A text filter applies when typing pauses; the other fields apply as soon as they change.
    // A template or a list of choices takes the place of the field the column's type would have.
    private RenderFragment FilterField(TbColumn<TItem> column) => column.FilterKind switch
    {
        _ when column.FilterTemplate is { } template => template(FilterContext(column)),
        _ when column.FilterChoices is not null =>
            @<TbMultiSelect TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                            Placeholder="@Text(Labels.FilterAny, TbStrings.DataGridFilterAny)"
                            Value="ChoicesFilter(column)" ValueChanged="chosen => FilterChoicesAsync(column, chosen)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbMultiSelect>,
        ColumnFilterKind.Number =>
            @<TbNumberField TValue="decimal?" AriaLabel="@FilterLabel(column)" Size="Size.Small" HideStepButtons
                            Value="NumberFilter(column)" ValueChanged="number => FilterNumberAsync(column, number)" />,
        ColumnFilterKind.Date =>
            @<TbDateRangePicker TDate="DateOnly" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                Value="DateFilter(column)" ValueChanged="range => FilterDatesAsync(column, range)" />,
        ColumnFilterKind.Choice or ColumnFilterKind.YesNo =>
            @<TbSelect TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                       Placeholder="@Text(Labels.FilterAny, TbStrings.DataGridFilterAny)" Value="ChoiceFilter(column)"
                       ValueChanged="choice => FilterChoiceAsync(column, choice)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbSelect>,
        _ =>
            @<TbTextField TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Type="TextFieldType.Search"
                          UpdateOnInput UpdateDelay="FilterDelay" Value="TextFilter(column)"
                          ValueChanged="text => FilterTextAsync(column, text)" />,
    };

    private static readonly TimeSpan FilterDelay = TimeSpan.FromMilliseconds(300);

    private RenderFragment HeaderContent(TbColumn<TItem> column, int at, GridSort? sort) =>
        @<text>
            @if (column.CanSort)
            {
                @if (StateHref is null)
                {
                    <button type="button" data-part="sort" class="tb-data-grid__sort"
                            @onkeydown="OnSortKeyDown" @onclick="_sort.For(column)">
                        @SortLabel(column, at, sort)
                    </button>
                }
                else
                {
                    <a href="@SortLink(column)" data-part="sort" class="tb-data-grid__sort"
                       @onkeydown="OnSortKeyDown" @onclick="_sort.For(column)">
                        @SortLabel(column, at, sort)
                    </a>
                }
                @if (column.Header is { } extra)
                {
                    <span class="tb-data-grid__title">@extra</span>
                }
            }
            else if (column.Header is { } header)
            {
                <span class="tb-data-grid__title">@header</span>
            }
            else
            {
                <span class="tb-data-grid__title">@column.Heading</span>
            }
            @if (HasFilterMenu(column))
            {
                @FilterMenu(column)
            }
        </text>;

    private RenderFragment SortLabel(TbColumn<TItem> column, int at, GridSort? sort) =>
        @<text>
                    <span>@column.Heading</span>
                    @if (sort is not null)
                    {
                        <TbIcon Size="Size.Small" class="tb-data-grid__sort-icon"
                                Icon="@(sort.Direction == SortDirection.Ascending
                                          ? BuiltInIcons.ArrowUp : BuiltInIcons.ArrowDown)" />
                        @if (_sorts.Count > 1)
                        {
                            <span data-part="sort-order" class="tb-data-grid__sort-order"
                                  aria-hidden="true">@(at + 1)</span>
                            <span class="tb-visually-hidden">
                                @Format(Labels.SortPosition, TbStrings.DataGridSortPosition, at + 1, _sorts.Count,
                                    sort.Direction == SortDirection.Ascending
                                        ? Text(Labels.Ascending, TbStrings.DataGridAscending)
                                        : Text(Labels.Descending, TbStrings.DataGridDescending))
                            </span>
                        }
                    }
        </text>;

    private RenderFragment GroupTotalsRow(GroupTotalsLine totals, int at) =>
        @<tr data-part="group-totals" data-level="@totals.Group.Level"
             aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)" class="tb-data-grid__group-totals">
            @TotalCells(totals.Values,
                Format(Labels.GroupTotals, TbStrings.DataGridGroupTotals, GroupName(totals.Group)))
        </tr>;

    private string GroupName(GroupHeading group) => GroupName(group.Column, group.Value);

    private string GroupName(string column, string? value) =>
        Format(Labels.GroupHeading, TbStrings.DataGridGroupHeading, column,
            value ?? Text(Labels.GroupNone, TbStrings.DataGridGroupNone));

    // The handle, details and selection columns hold nothing in the rows that aren't items.
    private RenderFragment BlankLeadCells =>
        @<text>
            @if (CanReorder)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle"></td>
            }
            @if (HasDetails)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)" class="tb-data-grid__detail-toggle"></td>
            }
            @if (CanDelete)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DeleteSlot)" class="tb-data-grid__delete"></td>
            }
            @if (SelectionMode != SelectionMode.None)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)" class="tb-data-grid__select"></td>
            }
        </text>;

    // The grid's totals row and each group's totals row share these cells: blank lead cells, then one total per column.
    // Screen readers can't tell a totals row from the rows above it, so the first column's cell starts with its name.
    private RenderFragment TotalCells(Dictionary<string, object?> totals, string name) =>
        @<text>
            @BlankLeadCells
            @foreach (var drawn in _drawnColumns)
            {
                if (drawn.Column is not { } column)
                {
                    @SpacerCell(drawn)
                    continue;
                }

                <td @key="column.Key" data-column="@column.Key" data-pinned="@PinSide(column)"
                    aria-colindex="@ColumnIndexOf(column)" style="@PinStyle(column)" class="@column.CellClass">
                    @if (column == FirstDrawn)
                    {
                        <span data-part="totals-name" class="tb-visually-hidden">@name</span>
                        @(" ")
                    }
                    @TotalCell(column, totals.GetValueOrDefault(column.Key))
                </td>
            }
        </text>;

    private RenderFragment TotalCell(TbColumn<TItem> column, object? total)
    {
        if (column.FooterTemplate is { } template)
        {
            return template(total);
        }

        var labeled = total is not null && column.AggregateBy is null && column.Aggregate != ColumnAggregate.None;
        return @<text>
            @if (labeled)
            {
                <span data-part="total-label" class="tb-data-grid__total-label">
                    @AggregateLabel(column.Aggregate)
                </span>
                @(" ")
            }
            @column.TotalTextOf(total)
        </text>;
    }

    private RenderFragment ColumnMenu(TbColumn<TItem> column) =>
        @<TbMenu Class="tb-data-grid__column-menu" data-part="column-menu">
            <Trigger>
                <TbIconButton Icon="BuiltInIcons.More" Size="Size.Small" @attributes="context.Attributes"
                              AriaLabel="@Format(Labels.ColumnMenu, TbStrings.DataGridColumnMenu, column.Heading)" />
            </Trigger>
            <ChildContent>
                @if (ReorderableColumns)
                {
                    <TbMenuItem Disabled="NeighborOf(column, -1) is null" OnClick="() => MoveColumnAsync(column, -1)">
                        @Format(Labels.Earlier, TbStrings.DataGridEarlier, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem Disabled="NeighborOf(column, 1) is null" OnClick="() => MoveColumnAsync(column, 1)">
                        @Format(Labels.Later, TbStrings.DataGridLater, column.Heading)
                    </TbMenuItem>
                }
                @if (CanResize(column))
                {
                    <TbMenuItem OnClick="() => StepWidthAsync(column, WidthStep)">
                        @Format(Labels.Wider, TbStrings.DataGridWider, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem OnClick="() => StepWidthAsync(column, -WidthStep)">
                        @Format(Labels.Narrower, TbStrings.DataGridNarrower, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem Disabled="_widths.Count == 0" OnClick="ResetWidthsAsync">
                        @Text(Labels.ResetWidths, TbStrings.DataGridResetWidths)
                    </TbMenuItem>
                }
                @if (CanHide(column))
                {
                    <TbMenuItem OnClick="() => HideFromMenuAsync(column)">
                        @Format(Labels.Hide, TbStrings.DataGridHide, column.Heading)
                    </TbMenuItem>
                }
            </ChildContent>
        </TbMenu>;

    // A menu holds a draft of the column's filter, applied with its Apply button; a template applies its own.
    private RenderFragment FilterMenu(TbColumn<TItem> column)
    {
        var draft = DraftFor(column);
        var label = IsFiltered(column) ? Format(Labels.FilterOn, TbStrings.DataGridFilterOn, column.Heading)
            : FilterLabel(column);
        return @<TbPopover Icon="BuiltInIcons.Filter" AriaLabel="@label" Title="@FilterLabel(column)"
                           Variant="Variant.Text" Size="Size.Small" Open="draft.Open"
                           OpenChanged="open => OpenFilterMenu(column, open)" data-part="filter-menu"
                           class="tb-data-grid__filter-menu">
            @* As in the filter row, a page's form around the grid doesn't own or track the menu's fields. *@
            <CascadingValue TValue="EditContext" Value="null">
                <CascadingValue TValue="TbForm" Value="null">
                    @if (column.FilterTemplate is { } template)
                    {
                        <div class="tb-data-grid__filter-form">@template(FilterContext(column))</div>
                    }
                    else
                    {
                        <div class="tb-data-grid__filter-form">
                            @if (HasChoiceList(column))
                            {
                                <TbCheckboxGroup TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                                 @bind-Value="draft.Chosen">
                                    @foreach (var (key, label, _) in ChoicesOf(column))
                                    {
                                        <TbCheckboxItem Value="key">@label</TbCheckboxItem>
                                    }
                                </TbCheckboxGroup>
                            }
                            else if (column.FilterKind == ColumnFilterKind.Date)
                            {
                                <TbDateRangePicker TDate="DateOnly" Label="@FilterValueLabel"
                                                   Size="Size.Small" @bind-Value="draft.Range" />
                            }
                            else
                            {
                                @Condition(column, draft.First,
                                    Text(Labels.FilterCondition, TbStrings.DataGridFilterCondition), FilterValueLabel)
                                @* Focus goes to the second condition as it's added, and back to Add as it goes. *@
                                @if (draft.HasSecond)
                                {
                                    <TbRadioGroup TValue="FilterJoin" Row Size="Size.Small" @bind-Value="draft.Join"
                                                  Label="@Text(Labels.FilterMatch, TbStrings.DataGridFilterMatch)"
                                                  data-part="filter-join">
                                        <TbRadio Value="FilterJoin.And">
                                            @Text(Labels.FilterAnd, TbStrings.DataGridFilterAnd)
                                        </TbRadio>
                                        <TbRadio Value="FilterJoin.Or">
                                            @Text(Labels.FilterOr, TbStrings.DataGridFilterOr)
                                        </TbRadio>
                                    </TbRadioGroup>
                                    @Condition(column, draft.Second,
                                        Text(Labels.FilterSecondCondition, TbStrings.DataGridFilterSecondCondition),
                                        Text(Labels.FilterSecondValue, TbStrings.DataGridFilterSecondValue))
                                    <TbButton Variant="Variant.Text" Size="Size.Small"
                                              data-part="filter-remove-condition" OnClick="() => RemoveSecond(draft)">
                                        @Text(Labels.FilterRemoveCondition, TbStrings.DataGridFilterRemoveCondition)
                                    </TbButton>
                                }
                                else
                                {
                                    <TbButton @ref="draft.AddButton" Variant="Variant.Text" Size="Size.Small"
                                              data-part="filter-add-condition" OnClick="() => AddSecond(draft)">
                                        @Text(Labels.FilterAddCondition, TbStrings.DataGridFilterAddCondition)
                                    </TbButton>
                                }
                            }
                            <div class="tb-data-grid__filter-actions">
                                <TbButton Variant="Variant.Text" Size="Size.Small" data-part="filter-clear"
                                          OnClick="() => ClearFilterMenuAsync(column)">
                                    @Text(Labels.FilterClear, TbStrings.DataGridFilterClear)
                                </TbButton>
                                <TbButton Size="Size.Small" data-part="filter-apply"
                                          OnClick="() => ApplyFilterMenuAsync(column)">
                                    @Text(Labels.FilterApply, TbStrings.DataGridFilterApply)
                                </TbButton>
                            </div>
                        </div>
                    }
                </CascadingValue>
            </CascadingValue>
        </TbPopover>;
    }

    // Only a grid's rows say whether they are selected; a table's rows can't.
    private string? AriaSelected(bool selected) =>
        IsGrid && SelectionMode != SelectionMode.None ? (selected ? "true" : "false") : null;

    // Single selection's radio buttons need a group of their own on the page.
    private readonly string _radioName = $"tb-data-grid-{Guid.NewGuid():N}";

    // Only the first sort is the column's sort to screen readers; the rest say their place in words.
    private static string? AriaSort(int at, GridSort? sort) => at != 0 ? null
        : sort!.Direction == SortDirection.Ascending ? "ascending" : "descending";
}
