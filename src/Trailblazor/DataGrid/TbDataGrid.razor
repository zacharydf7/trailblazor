@namespace Trailblazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@typeparam TItem
@inherits TbComponentBase

<div @attributes="AdditionalAttributes" data-part="grid" style="@Style"
     class="@ClassNames.Join("tb-data-grid", ClassNames.Modifier("tb-data-grid", Size),
                Striped ? "tb-data-grid--striped" : null, IsLoading ? "tb-data-grid--loading" : null,
                Height is null ? null : "tb-data-grid--scrolls", Virtualize ? "tb-data-grid--virtual" : null, Class)">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    @{ CheckColumnKeys(); ArrangeColumns(); ArrangeForColumns(); DrawRowsForReorder(); }
    @if (HasGroupBy || HideableColumns || Exportable)
    {
        <div data-part="toolbar" class="tb-data-grid__toolbar">
            @if (HasGroupBy)
            {
                @* As with the filters, a page's form around the grid doesn't own the list. *@
                <div data-part="group-by" class="tb-data-grid__group-by-bar">
                    <CascadingValue TValue="EditContext" Value="null">
                        <CascadingValue TValue="TbForm" Value="null">
                            <TbMultiSelect TItem="string" Label="@Localizer[TbStrings.DataGridGroupBy]"
                                           Size="Size.Small" Clearable Value="_groups" ValueChanged="GroupByAsync"
                                           class="tb-data-grid__group-by">
                                @foreach (var column in _arrangedColumns.Where(column => column.CanGroup))
                                {
                                    <TbOption Value="column.Key">@column.Heading</TbOption>
                                }
                            </TbMultiSelect>
                        </CascadingValue>
                    </CascadingValue>
                </div>
            }
            @if (HideableColumns)
            {
                <TbMenu Label="@Localizer[TbStrings.DataGridColumns]" Variant="Variant.Text" Size="Size.Small"
                        Align="PlacementAlign.End" data-part="column-chooser" Class="tb-data-grid__column-chooser">
                    @foreach (var column in _arrangedColumns)
                    {
                        <TbMenuCheckboxItem KeepOpen Checked="_shownColumns.Contains(column)"
                                            Disabled="!CanShowOrHide(column)"
                                            CheckedChanged="shown => SetColumnShownAsync(column, shown)">
                            @column.Heading
                        </TbMenuCheckboxItem>
                    }
                </TbMenu>
            }
            @if (Exportable)
            {
                <TbMenu Label="@Localizer[TbStrings.DataGridExport]" Variant="Variant.Text" Size="Size.Small"
                        Align="PlacementAlign.End" data-part="export" Class="tb-data-grid__export">
                    <TbMenuItem OnClick="() => ExportFromMenuAsync(excel: false)">
                        @Localizer[TbStrings.DataGridExportCsv]
                    </TbMenuItem>
                    <TbMenuItem OnClick="() => ExportFromMenuAsync(excel: true)">
                        @Localizer[TbStrings.DataGridExportExcel]
                    </TbMenuItem>
                </TbMenu>
            }
        </div>
    }
    <div data-part="scroll" class="tb-data-grid__scroll" style="@(Height is null ? null : $"max-block-size: {Height}")"
         role="@(ScrollIsTabStop && !string.IsNullOrEmpty(AriaLabel) ? "region" : null)"
         aria-label="@(ScrollIsTabStop ? AriaLabel : null)"
         tabindex="@(ScrollIsTabStop ? 0 : null)">
        <table @ref="_table" role="@(IsGrid ? "grid" : null)" aria-label="@AriaLabel"
               aria-multiselectable="@(IsGrid && SelectionMode == SelectionMode.Multiple ? "true" : null)"
               data-selection="@(SelectionMode == SelectionMode.Multiple ? "multiple" : null)"
               data-select-all="@(SelectionMode == SelectionMode.Multiple && CanSelectAll ? "" : null)"
               data-row-click-selects="@(SelectionMode == SelectionMode.Multiple && RowClickSelects ? "" : null)"
               @ontbselectall="SelectAllAsync" @ontbselectall:stopPropagation
               @ontbcolumnwidths="OnColumnWidthsAsync" @ontbcolumnwidths:stopPropagation
               @ontbcolumnorder="OnColumnOrderAsync" @ontbcolumnorder:stopPropagation
               data-reorder-columns="@(ReorderableColumns ? "" : null)"
               aria-busy="@(IsLoading ? "true" : null)"
               aria-rowcount="@(Virtualize ? HeaderRowCount + _total + (ShowsStatus ? 1 : 0) + (HasTotals ? 1 : 0)
                                  : null)"
               class="@ClassNames.Join("tb-data-grid__table", HasFixedWidths ? "tb-data-grid__table--fixed" : null)">
            @if (BandDepth > 0)
            {
                @* A fixed table takes its widths from its first row, here group headings, so the <col>s carry them. *@
                <colgroup>
                    @for (var lead = 0; lead < LeadCount; lead++)
                    {
                        <col />
                    }
                    @foreach (var column in _shownColumns)
                    {
                        <col @key="column.Key" data-column="@column.Key"
                             style="@(WidthOf(column) is { } width ? $"width: {width}" : null)" />
                    }
                </colgroup>
            }
            <thead>
                @for (var level = 0; level < BandDepth; level++)
                {
                    <tr data-part="bands" aria-rowindex="@(Virtualize ? level + 1 : null)" class="tb-data-grid__bands">
                        @BlankLeadCells
                        @foreach (var (group, columns) in BandsAt(level))
                        {
                            if (group is null)
                            {
                                <td data-pinned="@PinSide(columns[0])" style="@PinStyle(columns[0])"></td>
                            }
                            else
                            {
                                <th scope="col" colspan="@columns.Count" data-part="band"
                                    data-pinned="@PinSide(columns[0])" style="@BandPinStyle(columns)"
                                    class="tb-data-grid__band">@group.Title</th>
                            }
                        }
                    </tr>
                }
                <tr aria-rowindex="@(Virtualize ? BandDepth + 1 : null)">
                    @if (CanReorder)
                    {
                        <th scope="col" data-part="order" data-pinned="@LeadPin" style="@LeadStyle(0)"
                            class="tb-data-grid__handle">
                            <span class="tb-visually-hidden">@Localizer[TbStrings.DataGridOrder]</span>
                        </th>
                    }
                    @if (HasDetails)
                    {
                        <th scope="col" data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)"
                            class="tb-data-grid__detail-toggle">
                            <span class="tb-visually-hidden">@Localizer[TbStrings.DataGridDetails]</span>
                        </th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple && CanSelectAll)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <input type="checkbox" data-part="select-all" class="tb-checkbox__input tb-data-grid__check"
                                   aria-label="@(Labels.SelectAll ?? Localizer[TbStrings.DataGridSelectAll])"
                                   checked="@AllSelected" data-mixed="@(SomeSelected ? "" : null)"
                                   disabled="@(_rows.Count == 0)" @onchange="ToggleAllAsync" />
                        </th>
                    }
                    else if (SelectionMode != SelectionMode.None)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <span class="tb-visually-hidden">@Localizer[TbStrings.DataGridSelect]</span>
                        </th>
                    }
                    @foreach (var column in _shownColumns)
                    {
                        var at = _sorts.FindIndex(sort => sort.Column == column.Key);
                        var sort = at < 0 ? null : _sorts[at];
                        @* Keyed, so a moved column's header, and the menu and button in it, move with it. *@
                        <th @key="column.Key" scope="col" data-column="@column.Key" data-title="@column.Heading"
                            data-filtered="@(IsFiltered(column) ? "" : null)" aria-sort="@AriaSort(at, sort)"
                            data-pinned="@PinSide(column)" data-width="@KeptWidth(column)"
                            style="@HeaderStyle(column)"
                            class="@ClassNames.Join("tb-data-grid__header",
                                       ClassNames.Modifier("tb-data-grid__header", column.Alignment))">
                            @if (HasColumnMenu(column))
                            {
                                <div class="tb-data-grid__header-content">
                                    @HeaderContent(column, at, sort)
                                    @ColumnMenu(column)
                                </div>
                            }
                            else
                            {
                                @HeaderContent(column, at, sort)
                            }
                            @if (CanResize(column))
                            {
                                @* The column menu resizes from the keys or a click, so the edge is for dragging. *@
                                <div data-part="resize" aria-hidden="true" class="tb-data-grid__resize"></div>
                            }
                        </th>
                    }
                </tr>
                @if (HasFilterRow)
                {
                    <tr data-part="filters" aria-rowindex="@(Virtualize ? BandDepth + 2 : null)"
                        class="tb-data-grid__filters">
                        @BlankLeadCells
                        @foreach (var column in _shownColumns)
                        {
                            <td @key="column.Key" data-column="@column.Key" data-part="filter"
                                data-value="@FilterText(column)"
                                data-pinned="@PinSide(column)" style="@PinStyle(column)" class="@FilterClass(column)">
                                @if (column.CanFilter)
                                {
                                    @* A page's form doesn't own the grid's filters, which neither change it nor count
                                       toward its errors. *@
                                    <CascadingValue TValue="EditContext" Value="null">
                                        <CascadingValue TValue="TbForm" Value="null">@FilterField(column)</CascadingValue>
                                    </CascadingValue>
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody @ref="_body" data-sortable="@(CanReorder ? "" : null)">
                @if (_failed)
                {
                    <tr data-part="failed" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@ColumnCount">
                            <span>@LoadFailedLabel</span>
                            <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="RefreshAsync">
                                @(Labels.Retry ?? Localizer[TbStrings.DataGridRetry])
                            </TbButton>
                        </td>
                    </tr>
                }
                else if (HasNoRows && IsLoading)
                {
                    <tr data-part="loading" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@ColumnCount">@(Labels.Loading ?? Localizer[TbStrings.DataGridLoading])</td>
                    </tr>
                }
                else if (HasNoRows)
                {
                    <tr data-part="empty" aria-rowindex="@(Virtualize ? HeaderRowCount + 1 : null)"
                        class="tb-data-grid__status">
                        <td colspan="@ColumnCount">
                            @if (EmptyContent is null)
                            {
                                @EmptyLabel
                            }
                            else
                            {
                                @EmptyContent
                            }
                        </td>
                    </tr>
                }
                @if (Virtualize)
                {
                    <Virtualize @ref="_virtualize" TItem="GridLine" ItemSize="RowSize" SpacerElement="tr"
                                Items="@(DataProvider is null ? _lines : null)"
                                ItemsProvider="VirtualRowsProvider" ItemContent="LineContent"
                                Placeholder="VirtualPlaceholder" />
                }
                else
                {
                    @Rows
                }
            </tbody>
            @if (HasTotals)
            {
                <tfoot>
                    <tr data-part="totals" class="tb-data-grid__totals"
                        aria-rowindex="@(Virtualize ? HeaderRowCount + _total + (ShowsStatus ? 1 : 0) + 1 : null)">
                        @TotalCells(_totals)
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    @if (OnRowMove.HasDelegate)
    {
        @* The announcer reads the reason out, so this is only for sight. *@
        <div data-part="drop-reason" class="tb-sortable__reason" aria-hidden="true" hidden></div>
    }
    @if (_pageSize is { } size && (_total > 0 || PageSizes is not null))
    {
        var first = _total == 0 ? 0 : (_page - 1) * size + 1;
        var last = Math.Min(_page * size, _total);
        <div data-part="pager" class="tb-data-grid__pager">
            <span data-part="summary" class="tb-data-grid__summary">
                @RangeText(first, last)
            </span>
            @if (PageSizes is { Count: > 0 } sizes)
            {
                <TbSelect TValue="int" Label="@(Labels.PageSize ?? Localizer[TbStrings.DataGridPageSize])"
                          Size="Size.Small" Value="size" ValueChanged="ChangePageSizeAsync"
                          class="tb-data-grid__page-size">
                    @foreach (var option in sizes)
                    {
                        <TbOption Value="option">@option</TbOption>
                    }
                </TbSelect>
            }
            @if (PageCount > 1)
            {
                <TbPagination Page="_page" PageChanged="PageFromPagerAsync" PageCount="PageCount" Size="Size.Small"
                              ShowFirstLast="ShowFirstLast"
                              AriaLabel="@(AriaLabel is null ? null : Format(TbStrings.DataGridPages, AriaLabel))" />
            }
        </div>
    }
</div>

@code {
    private RenderFragment Row(TItem item, object key, bool selected, int at, string? rowClass, string? label,
        bool expanded) =>
        @<tr @ref="_rowRefs[key]" data-part="row" data-key="@IdOf(item)" data-selected="@(selected ? "" : null)"
             aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)" aria-selected="@AriaSelected(selected)"
             data-tb-focus-root="@(EditMode == GridEditMode.Row && RowEditOf(key) is not null ? "" : null)"
             @ontbfocusleave="@((EditMode == GridEditMode.Row && RowEditOf(key) is { } leaving ? LeftHandler(leaving)
                                 : null)!)"
             @ontbrowclick="_rowClick.For(key)"
             @ontbrowextend="_rowExtend.For(key)"
             class="@ClassNames.Join("tb-data-grid__row", selected ? "tb-data-grid__row--selected" : null,
                        Virtualize && at % 2 == 1 ? "tb-data-grid__row--stripe" : null, rowClass)">
            @if (CanReorder)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle">
                    @((RenderFragment)(handle => MoveHandle.Add(handle, 0, Format(TbStrings.SortableHandle,
                        label ?? LabelOf(item)), at, _total, disabled: false, Localizer,
                        (to, args) => MoveRowAsync(item, to, args.Detail > 0 ? "pointer" : "keyboard"))))
                </td>
            }
            @if (HasDetails)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)" class="tb-data-grid__detail-toggle">
                    <button type="button" data-part="detail-toggle" aria-expanded="@(expanded ? "true" : "false")"
                            aria-controls="@(expanded ? DetailId(key) : null)"
                            aria-label="@Format(TbStrings.DataGridDetailsFor, label ?? LabelOf(item))"
                            class="tb-data-grid__detail-button" @onclick="_toggleDetail.For(key)">
                        <TbIcon Icon="BuiltInIcons.ChevronEnd" Size="Size.Small" class="tb-data-grid__detail-chevron" />
                    </button>
                </td>
            }
            @if (SelectionMode != SelectionMode.None)
            {
                <td data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                    class="tb-data-grid__select">
                    <input type="@(SelectionMode == SelectionMode.Single ? "radio" : "checkbox")"
                           class="@(SelectionMode == SelectionMode.Single ? "tb-data-grid__check"
                                      : "tb-checkbox__input tb-data-grid__check")" checked="@selected"
                           name="@(SelectionMode == SelectionMode.Single ? _radioName : null)"
                           aria-label="@Format(TbStrings.DataGridSelectRow, label ?? LabelOf(item))"
                           @onchange="_choose.For(key)" />
                </td>
            }
            @foreach (var column in _shownColumns)
            {
                var editable = CanEdit(column);
                <td data-column="@column.Key" data-pinned="@PinSide(column)" style="@PinStyle(column)"
                    data-editable="@(editable ? "" : null)" class="@column.CellClass"
                    @ondblclick="@((editable ? _startEdit.For((key, column)) : null)!)"
                    @ontbeditstart="@((editable ? _startEdit.For((key, column)) : null)!)"
                    @onkeydown="@((editable ? _cellKey.For((key, column)) : null)!)">
                    @if (RowEditOf(key) is { } edit && edit.CellOf(column) is { } cell)
                    {
                        @Editor(edit, cell)
                    }
                    else if (column.Cell is not null)
                    {
                        @column.Cell(item)
                    }
                    else
                    {
                        @column.TextOf(item)
                    }
                    @if (EditMode == GridEditMode.Row && column == _shownColumns[^1] && RowEditOf(key) is { } rowEdit)
                    {
                        @RowActions(rowEdit, label ?? LabelOf(item))
                    }
                </td>
            }
        </tr>;

    // A row's edit offers its own Save and Cancel, so a pointer can cancel it too, and Escape on them cancels. Why the
    // app turned the row down shows beside them, since it may not concern any one field.
    private RenderFragment RowActions(GridEdit edit, string label) =>
        @<div data-part="row-actions" class="tb-data-grid__row-actions" @ontbeditkey="OnRowActionKeyAsync"
              @onkeydown:stopPropagation>
            @if (edit.Error is not null)
            {
                <span data-part="row-error" class="tb-data-grid__row-error">@edit.Error</span>
            }
            <TbButton Size="Size.Small" aria-label="@Format(TbStrings.DataGridSaveRow, label)"
                      OnClick="() => SaveEditAsync(refocus: true)">
                @Localizer[TbStrings.DataGridSave]
            </TbButton>
            <TbButton Variant="Variant.Text" Size="Size.Small" aria-label="@Format(TbStrings.DataGridCancelRow, label)"
                      OnClick="CancelEditAsync">
                @Localizer[TbStrings.DataGridCancel]
            </TbButton>
        </div>;

    private GridEdit? RowEditOf(object key) => _edit is { } edit && Equals(edit.Key, key) ? edit : null;

    // A cell being edited holds its field, saved when focus leaves it, or in row mode when focus leaves the row; like
    // the filters, a page's form doesn't own it, and its keys go no further than the edit.
    private RenderFragment Editor(GridEdit edit, CellEdit cell) =>
        @<div data-part="editor" data-tb-focus-root="@(EditMode == GridEditMode.Cell ? "" : null)"
              class="tb-data-grid__editor" @ontbeditkey="OnEditKeyAsync" @onkeydown:stopPropagation
              @ontbfocusleave="@((EditMode == GridEditMode.Cell ? LeftHandler(edit) : null)!)">
            <CascadingValue TValue="EditContext" Value="null">
                <CascadingValue TValue="TbForm" Value="null">
                    @switch (cell.Column.Editor)
                    {
                        case ColumnEditor.Custom:
                            @cell.Column.EditTemplate!(ContextOf(edit, cell))
                            break;
                        case ColumnEditor.Number:
                            <TbNumberField TValue="decimal?" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                           HideStepButtons AutoFocus="cell.Column == edit.Start"
                                           Value="NumberOf(cell.Value)" ValueChanged="number => cell.Value = number"
                                           Error="@cell.Error" />
                            break;
                        case ColumnEditor.Choice:
                            <TbSelect TValue="string" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                      AutoFocus="cell.Column == edit.Start" Value="@cell.Value?.ToString()"
                                      ValueChanged="choice => ChooseAsync(cell, choice)" Error="@cell.Error">
                                @foreach (var (value, label) in cell.Column.Choices)
                                {
                                    <TbOption Value="value.ToString()">@label</TbOption>
                                }
                            </TbSelect>
                            break;
                        case ColumnEditor.YesNo:
                            <TbCheckbox TValue="bool" AriaLabel="@cell.Column.Heading"
                                        AutoFocus="cell.Column == edit.Start" Value="cell.Value is true"
                                        ValueChanged="yes => cell.Value = yes" Error="@cell.Error" />
                            break;
                        default:
                            <TbTextField TValue="string" AriaLabel="@cell.Column.Heading" Size="Size.Small"
                                         AutoFocus="cell.Column == edit.Start" UpdateOnInput
                                         Value="@(cell.Value as string)" ValueChanged="text => cell.Value = text"
                                         Error="@cell.Error" />
                            break;
                    }
                </CascadingValue>
            </CascadingValue>
        </div>;

    // A group's heading spans the row, and its button stays in view while the rows scroll sideways.
    private RenderFragment GroupRow(GroupHeading group, int at) =>
        @<tr data-part="group" data-level="@group.Level" aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)"
             class="tb-data-grid__group">
            <td colspan="@ColumnCount" style="--tb-data-grid-group-level: @(group.Level - 1)"
                class="tb-data-grid__group-cell">
                <button type="button" data-part="group-toggle" aria-expanded="@(group.Open ? "true" : "false")"
                        class="tb-data-grid__group-toggle" @onclick="_toggleGroup.For(group.Key)">
                    <TbIcon Icon="BuiltInIcons.ChevronEnd" Size="Size.Small" class="tb-data-grid__group-chevron" />
                    <span>@Format(TbStrings.DataGridGroupHeading, group.Column,
                        group.Value ?? Localizer[TbStrings.DataGridGroupNone])</span>
                    <span class="tb-data-grid__group-count">@Format(TbStrings.DataGridGroupCount, group.Count)</span>
                </button>
            </td>
        </tr>;

    // A row Virtualize hasn't loaded yet holds its place, and says nothing to screen readers.
    private RenderFragment<PlaceholderContext> VirtualPlaceholder => _ =>
        @<tr data-part="placeholder" aria-hidden="true" class="tb-data-grid__placeholder">
            <td colspan="@ColumnCount"></td>
        </tr>;

    // A text filter applies when typing pauses; the other fields apply as soon as they change.
    // A template or a list of choices takes the place of the field the column's type would have.
    private RenderFragment FilterField(TbColumn<TItem> column) => column.FilterKind switch
    {
        _ when column.FilterTemplate is { } template => template(FilterContext(column)),
        _ when column.FilterChoices is not null =>
            @<TbMultiSelect TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                            Placeholder="@Localizer[TbStrings.DataGridFilterAny]" Value="ChoicesFilter(column)"
                            ValueChanged="chosen => FilterChoicesAsync(column, chosen)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbMultiSelect>,
        ColumnFilterKind.Number =>
            @<TbNumberField TValue="decimal?" AriaLabel="@FilterLabel(column)" Size="Size.Small" HideStepButtons
                            Value="NumberFilter(column)" ValueChanged="number => FilterNumberAsync(column, number)" />,
        ColumnFilterKind.Date =>
            @<TbDateRangePicker TDate="DateOnly" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                Value="DateFilter(column)" ValueChanged="range => FilterDatesAsync(column, range)" />,
        ColumnFilterKind.Choice or ColumnFilterKind.YesNo =>
            @<TbSelect TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                       Placeholder="@Localizer[TbStrings.DataGridFilterAny]" Value="ChoiceFilter(column)"
                       ValueChanged="choice => FilterChoiceAsync(column, choice)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbSelect>,
        _ =>
            @<TbTextField TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Type="TextFieldType.Search"
                          UpdateOnInput UpdateDelay="FilterDelay" Value="TextFilter(column)"
                          ValueChanged="text => FilterTextAsync(column, text)" />,
    };

    private static readonly TimeSpan FilterDelay = TimeSpan.FromMilliseconds(300);

    private RenderFragment HeaderContent(TbColumn<TItem> column, int at, GridSort? sort) =>
        @<text>
            @if (column.CanSort)
            {
                <button type="button" data-part="sort" class="tb-data-grid__sort"
                        @onkeydown="OnSortKeyDown" @onclick="_sort.For(column)">
                    <span>@column.Heading</span>
                    @if (sort is not null)
                    {
                        <TbIcon Size="Size.Small" class="tb-data-grid__sort-icon"
                                Icon="@(sort.Direction == SortDirection.Ascending
                                          ? BuiltInIcons.ArrowUp : BuiltInIcons.ArrowDown)" />
                        @if (_sorts.Count > 1)
                        {
                            <span data-part="sort-order" class="tb-data-grid__sort-order"
                                  aria-hidden="true">@(at + 1)</span>
                            <span class="tb-visually-hidden">
                                @Format(TbStrings.DataGridSortPosition, at + 1, _sorts.Count,
                                    Localizer[sort.Direction == SortDirection.Ascending
                                        ? TbStrings.DataGridAscending : TbStrings.DataGridDescending])
                            </span>
                        }
                    }
                </button>
                @if (column.Header is { } extra)
                {
                    <span class="tb-data-grid__title">@extra</span>
                }
            }
            else if (column.Header is { } header)
            {
                <span class="tb-data-grid__title">@header</span>
            }
            else
            {
                <span class="tb-data-grid__title">@column.Heading</span>
            }
            @if (HasFilterMenu(column))
            {
                @FilterMenu(column)
            }
        </text>;

    private RenderFragment GroupTotalsRow(GroupTotalsLine totals, int at) =>
        @<tr data-part="group-totals" data-level="@totals.Level"
             aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)" class="tb-data-grid__group-totals">
            @TotalCells(totals.Values)
        </tr>;

    // The handle, details and selection columns hold nothing in the rows that aren't items.
    private RenderFragment BlankLeadCells =>
        @<text>
            @if (CanReorder)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle"></td>
            }
            @if (HasDetails)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(DetailSlot)" class="tb-data-grid__detail-toggle"></td>
            }
            @if (SelectionMode != SelectionMode.None)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)" class="tb-data-grid__select"></td>
            }
        </text>;

    // The grid's totals row and each group's totals row share these cells: blank lead cells, then one total per column.
    private RenderFragment TotalCells(Dictionary<string, object?> totals) =>
        @<text>
            @BlankLeadCells
            @foreach (var column in _shownColumns)
            {
                <td @key="column.Key" data-column="@column.Key" data-pinned="@PinSide(column)"
                    style="@PinStyle(column)" class="@column.CellClass">
                    @TotalCell(column, totals.GetValueOrDefault(column.Key))
                </td>
            }
        </text>;

    private RenderFragment TotalCell(TbColumn<TItem> column, object? total)
    {
        if (column.FooterTemplate is { } template)
        {
            return template(total);
        }

        var labeled = total is not null && column.AggregateBy is null && column.Aggregate != ColumnAggregate.None;
        return @<text>
            @if (labeled)
            {
                <span data-part="total-label" class="tb-data-grid__total-label">
                    @AggregateLabel(column.Aggregate)
                </span>
                @(" ")
            }
            @column.TotalTextOf(total)
        </text>;
    }

    private RenderFragment ColumnMenu(TbColumn<TItem> column) =>
        @<TbMenu Class="tb-data-grid__column-menu" data-part="column-menu">
            <Trigger>
                <TbIconButton Icon="BuiltInIcons.More" Size="Size.Small" @attributes="context.Attributes"
                              AriaLabel="@Format(TbStrings.DataGridColumnMenu, column.Heading)" />
            </Trigger>
            <ChildContent>
                @if (ReorderableColumns)
                {
                    <TbMenuItem Disabled="NeighborOf(column, -1) is null" OnClick="() => MoveColumnAsync(column, -1)">
                        @Format(TbStrings.DataGridEarlier, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem Disabled="NeighborOf(column, 1) is null" OnClick="() => MoveColumnAsync(column, 1)">
                        @Format(TbStrings.DataGridLater, column.Heading)
                    </TbMenuItem>
                }
                @if (CanResize(column))
                {
                    <TbMenuItem OnClick="() => StepWidthAsync(column, WidthStep)">
                        @Format(TbStrings.DataGridWider, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem OnClick="() => StepWidthAsync(column, -WidthStep)">
                        @Format(TbStrings.DataGridNarrower, column.Heading)
                    </TbMenuItem>
                    <TbMenuItem Disabled="_widths.Count == 0" OnClick="ResetWidthsAsync">
                        @Localizer[TbStrings.DataGridResetWidths]
                    </TbMenuItem>
                }
                @if (CanHide(column))
                {
                    <TbMenuItem OnClick="() => HideFromMenuAsync(column)">
                        @Format(TbStrings.DataGridHide, column.Heading)
                    </TbMenuItem>
                }
            </ChildContent>
        </TbMenu>;

    // A menu holds a draft of the column's filter, applied with its Apply button; a template applies its own.
    private RenderFragment FilterMenu(TbColumn<TItem> column)
    {
        var draft = DraftFor(column);
        var label = IsFiltered(column) ? Format(TbStrings.DataGridFilterOn, column.Heading) : FilterLabel(column);
        return @<TbPopover Icon="BuiltInIcons.Filter" AriaLabel="@label" Title="@FilterLabel(column)"
                           Variant="Variant.Text" Size="Size.Small" Open="draft.Open"
                           OpenChanged="open => OpenFilterMenu(column, open)" data-part="filter-menu"
                           class="tb-data-grid__filter-menu">
            @* As in the filter row, a page's form around the grid doesn't own or track the menu's fields. *@
            <CascadingValue TValue="EditContext" Value="null">
                <CascadingValue TValue="TbForm" Value="null">
                    @if (column.FilterTemplate is { } template)
                    {
                        <div class="tb-data-grid__filter-form">@template(FilterContext(column))</div>
                    }
                    else
                    {
                        <div class="tb-data-grid__filter-form">
                            @if (HasChoiceList(column))
                            {
                                <TbCheckboxGroup TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                                 @bind-Value="draft.Chosen">
                                    @foreach (var (key, label, _) in ChoicesOf(column))
                                    {
                                        <TbCheckboxItem Value="key">@label</TbCheckboxItem>
                                    }
                                </TbCheckboxGroup>
                            }
                            else if (column.FilterKind == ColumnFilterKind.Date)
                            {
                                <TbDateRangePicker TDate="DateOnly" Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                   Size="Size.Small" @bind-Value="draft.Range" />
                            }
                            else
                            {
                                <TbSelect TValue="FilterOperator" Label="@Localizer[TbStrings.DataGridFilterCondition]"
                                          Size="Size.Small" @bind-Value="draft.Operator">
                                    @foreach (var op in FilterOperators(column))
                                    {
                                        <TbOption Value="op">@OperatorLabel(op)</TbOption>
                                    }
                                </TbSelect>
                                @if (NeedsValue(draft.Operator))
                                {
                                    <div @onkeydown="_applyOnEnter.For(column)">
                                        @if (column.FilterKind == ColumnFilterKind.Number)
                                        {
                                            <TbNumberField TValue="decimal?" Size="Size.Small" HideStepButtons
                                                           Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                           UpdateOnInput @bind-Value="draft.Number" />
                                        }
                                        else
                                        {
                                            <TbTextField TValue="string" Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                         Size="Size.Small" UpdateOnInput @bind-Value="draft.Text" />
                                        }
                                    </div>
                                }
                            }
                            <div class="tb-data-grid__filter-actions">
                                <TbButton Variant="Variant.Text" Size="Size.Small" data-part="filter-clear"
                                          OnClick="() => ClearFilterMenuAsync(column)">
                                    @Localizer[TbStrings.DataGridFilterClear]
                                </TbButton>
                                <TbButton Size="Size.Small" data-part="filter-apply"
                                          OnClick="() => ApplyFilterMenuAsync(column)">
                                    @Localizer[TbStrings.DataGridFilterApply]
                                </TbButton>
                            </div>
                        </div>
                    }
                </CascadingValue>
            </CascadingValue>
        </TbPopover>;
    }

    // Only a grid's rows say whether they are selected; a table's rows can't.
    private string? AriaSelected(bool selected) =>
        IsGrid && SelectionMode != SelectionMode.None ? (selected ? "true" : "false") : null;

    // Single selection's radio buttons need a group of their own on the page.
    private readonly string _radioName = $"tb-data-grid-{Guid.NewGuid():N}";

    // Only the first sort is the column's sort to screen readers; the rest say their place in words.
    private static string? AriaSort(int at, GridSort? sort) => at != 0 ? null
        : sort!.Direction == SortDirection.Ascending ? "ascending" : "descending";
}
