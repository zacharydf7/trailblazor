@namespace Trailblazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@typeparam TItem
@inherits TbComponentBase

<div @attributes="AdditionalAttributes" data-part="grid" data-ready="@(IsReady ? "" : null)" style="@Style"
     class="@ClassNames.Join("tb-data-grid", ClassNames.Modifier("tb-data-grid", Size),
                Striped ? "tb-data-grid--striped" : null, IsLoading ? "tb-data-grid--loading" : null,
                Height is null ? null : "tb-data-grid--scrolls", Virtualize ? "tb-data-grid--virtual" : null, Class)">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    @{ CheckColumnKeys(); ArrangeColumns(); ArrangeForColumns(); DrawRowsForReorder(); }
    <div data-part="scroll" class="tb-data-grid__scroll" style="@(Height is null ? null : $"max-block-size: {Height}")">
        <table @ref="_table" aria-label="@AriaLabel" aria-busy="@(IsLoading ? "true" : null)"
               aria-rowcount="@(Virtualize ? HeaderRowCount + _total : null)" class="tb-data-grid__table">
            <thead>
                <tr aria-rowindex="@(Virtualize ? 1 : null)">
                    @if (CanReorder)
                    {
                        <th scope="col" data-part="order" data-pinned="@LeadPin" style="@LeadStyle(0)"
                            class="tb-data-grid__handle">
                            <span class="tb-visually-hidden">@Localizer[TbStrings.DataGridOrder]</span>
                        </th>
                    }
                    @if (SelectionMode == SelectionMode.Multiple && CanSelectAll)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <input type="checkbox" data-part="select-all" class="tb-checkbox__input tb-data-grid__check"
                                   aria-label="@(Labels.SelectAll ?? Localizer[TbStrings.DataGridSelectAll])"
                                   checked="@AllSelected" data-mixed="@(SomeSelected ? "" : null)"
                                   disabled="@(_rows.Count == 0)" @onchange="ToggleAllAsync" />
                        </th>
                    }
                    else if (SelectionMode != SelectionMode.None)
                    {
                        <th scope="col" data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                            class="tb-data-grid__select">
                            <span class="tb-visually-hidden">@Localizer[TbStrings.DataGridSelect]</span>
                        </th>
                    }
                    @foreach (var column in _shownColumns)
                    {
                        var at = _sorts.FindIndex(sort => sort.Column == column.Key);
                        var sort = at < 0 ? null : _sorts[at];
                        <th scope="col" data-column="@column.Key" data-title="@column.Heading"
                            data-filtered="@(IsFiltered(column) ? "" : null)" aria-sort="@AriaSort(at, sort)"
                            data-pinned="@PinSide(column)"
                            style="@HeaderStyle(column)"
                            class="@ClassNames.Join("tb-data-grid__header",
                                       ClassNames.Modifier("tb-data-grid__header", column.Alignment))">
                            @if (column.CanSort)
                            {
                                <button type="button" data-part="sort" class="tb-data-grid__sort"
                                        @onclick="args => SortAsync(column, args)">
                                    <span>@column.Heading</span>
                                    @if (sort is not null)
                                    {
                                        <TbIcon Size="Size.Small" class="tb-data-grid__sort-icon"
                                                Icon="@(sort.Direction == SortDirection.Ascending
                                                          ? BuiltInIcons.ArrowUp : BuiltInIcons.ArrowDown)" />
                                        @if (_sorts.Count > 1)
                                        {
                                            <span data-part="sort-order" class="tb-data-grid__sort-order"
                                                  aria-hidden="true">@(at + 1)</span>
                                            <span class="tb-visually-hidden">
                                                @Format(TbStrings.DataGridSortPosition, at + 1, _sorts.Count,
                                                    Localizer[sort.Direction == SortDirection.Ascending
                                                        ? TbStrings.DataGridAscending : TbStrings.DataGridDescending])
                                            </span>
                                        }
                                    }
                                </button>
                                @column.Header
                            }
                            else
                            {
                                @(column.Header ?? (RenderFragment)(builder => builder.AddContent(0, column.Heading)))
                            }
                            @if (HasFilterMenu(column))
                            {
                                @FilterMenu(column)
                            }
                        </th>
                    }
                </tr>
                @if (HasFilterRow)
                {
                    <tr data-part="filters" aria-rowindex="@(Virtualize ? 2 : null)" class="tb-data-grid__filters">
                        @if (CanReorder)
                        {
                            <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle"></td>
                        }
                        @if (SelectionMode != SelectionMode.None)
                        {
                            <td data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)" class="tb-data-grid__select">
                            </td>
                        }
                        @foreach (var column in _shownColumns)
                        {
                            <td data-column="@column.Key" data-part="filter" data-value="@FilterText(column)"
                                data-pinned="@PinSide(column)" style="@PinStyle(column)" class="@FilterClass(column)">
                                @if (column.CanFilter)
                                {
                                    @* A page's form doesn't own the grid's filters, which neither change it nor count
                                       toward its errors. *@
                                    <CascadingValue TValue="EditContext" Value="null">
                                        <CascadingValue TValue="TbForm" Value="null">@FilterField(column)</CascadingValue>
                                    </CascadingValue>
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody @ref="_body" data-sortable="@(CanReorder ? "" : null)">
                @if (_failed)
                {
                    <tr data-part="failed" class="tb-data-grid__status">
                        <td colspan="@ColumnCount">
                            <span>@LoadFailedLabel</span>
                            <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="RefreshAsync">
                                @(Labels.Retry ?? Localizer[TbStrings.DataGridRetry])
                            </TbButton>
                        </td>
                    </tr>
                }
                else if (HasNoRows && IsLoading)
                {
                    <tr data-part="loading" class="tb-data-grid__status">
                        <td colspan="@ColumnCount">@(Labels.Loading ?? Localizer[TbStrings.DataGridLoading])</td>
                    </tr>
                }
                else if (HasNoRows)
                {
                    <tr data-part="empty" class="tb-data-grid__status">
                        <td colspan="@ColumnCount">
                            @if (EmptyContent is null)
                            {
                                @EmptyLabel
                            }
                            else
                            {
                                @EmptyContent
                            }
                        </td>
                    </tr>
                }
                @if (Virtualize)
                {
                    <Virtualize @ref="_virtualize" TItem="VirtualRow" ItemSize="RowSize" SpacerElement="tr"
                                Items="@(DataProvider is null ? _virtualRows : null)"
                                ItemsProvider="VirtualRowsProvider" ItemContent="VirtualRowContent"
                                Placeholder="VirtualPlaceholder" />
                }
                else
                {
                    @Rows
                }
            </tbody>
        </table>
    </div>
    @if (OnRowMove.HasDelegate)
    {
        @* The announcer reads the reason out, so this is only for sight. *@
        <div data-part="drop-reason" class="tb-sortable__reason" aria-hidden="true" hidden></div>
    }
    @if (_pageSize is { } size && (_total > 0 || PageSizes is not null))
    {
        var first = _total == 0 ? 0 : (_page - 1) * size + 1;
        var last = Math.Min(_page * size, _total);
        <div data-part="pager" class="tb-data-grid__pager">
            <span data-part="summary" class="tb-data-grid__summary">
                @Format(TbStrings.DataGridRange, first, last, _total)
            </span>
            @if (PageSizes is { Count: > 0 } sizes)
            {
                <TbSelect TValue="int" Label="@(Labels.PageSize ?? Localizer[TbStrings.DataGridPageSize])"
                          Size="Size.Small" Value="size" ValueChanged="ChangePageSizeAsync"
                          class="tb-data-grid__page-size">
                    @foreach (var option in sizes)
                    {
                        <TbOption Value="option">@option</TbOption>
                    }
                </TbSelect>
            }
            @if (PageCount > 1)
            {
                <TbPagination Page="_page" PageChanged="PageFromPagerAsync" PageCount="PageCount" Size="Size.Small"
                              AriaLabel="@(AriaLabel is null ? null : Format(TbStrings.DataGridPages, AriaLabel))" />
            }
        </div>
    }
</div>

@code {
    private RenderFragment Row(TItem item, object key, bool selected, int at, string? rowClass, string? label) =>
        @<tr @ref="_rowRefs[key]" data-part="row" data-key="@IdOf(item)" data-selected="@(selected ? "" : null)"
             aria-rowindex="@(Virtualize ? HeaderRowCount + at + 1 : null)"
             @ontbrowclick="args => OnRowClickedAsync(item, args)"
             class="@ClassNames.Join("tb-data-grid__row", selected ? "tb-data-grid__row--selected" : null,
                        Virtualize && at % 2 == 1 ? "tb-data-grid__row--stripe" : null, rowClass)">
            @if (CanReorder)
            {
                <td data-pinned="@LeadPin" style="@LeadStyle(0)" class="tb-data-grid__handle">
                    @((RenderFragment)(handle => MoveHandle.Add(handle, 0, Format(TbStrings.SortableHandle,
                        label ?? LabelOf(item)), at, _total, disabled: false, Localizer,
                        (to, args) => MoveRowAsync(item, to, args.Detail > 0 ? "pointer" : "keyboard"))))
                </td>
            }
            @if (SelectionMode != SelectionMode.None)
            {
                <td data-part="select" data-pinned="@LeadPin" style="@LeadStyle(LeadCount - 1)"
                    class="tb-data-grid__select">
                    <input type="@(SelectionMode == SelectionMode.Single ? "radio" : "checkbox")"
                           class="@(SelectionMode == SelectionMode.Single ? "tb-data-grid__check"
                                      : "tb-checkbox__input tb-data-grid__check")" checked="@selected"
                           name="@(SelectionMode == SelectionMode.Single ? _radioName : null)"
                           aria-label="@Format(TbStrings.DataGridSelectRow, label ?? LabelOf(item))"
                           @onchange="() => ToggleAsync(item)" />
                </td>
            }
            @foreach (var column in _shownColumns)
            {
                <td data-column="@column.Key" data-pinned="@PinSide(column)" style="@PinStyle(column)"
                    class="@column.CellClass">
                    @if (column.Cell is not null)
                    {
                        @column.Cell(item)
                    }
                    else
                    {
                        @column.TextOf(item)
                    }
                </td>
            }
        </tr>;

    // A row Virtualize hasn't loaded yet holds its place, and says nothing to screen readers.
    private RenderFragment<PlaceholderContext> VirtualPlaceholder => _ =>
        @<tr data-part="placeholder" aria-hidden="true" class="tb-data-grid__placeholder">
            <td colspan="@ColumnCount"></td>
        </tr>;

    // A text filter applies when typing pauses; the other fields apply as soon as they change.
    // A template or a list of choices takes the place of the field the column's type would have.
    private RenderFragment FilterField(TbColumn<TItem> column) => column.FilterKind switch
    {
        _ when column.FilterTemplate is { } template => template(FilterContext(column)),
        _ when column.FilterChoices is not null =>
            @<TbMultiSelect TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                            Placeholder="@Localizer[TbStrings.DataGridFilterAny]" Value="ChoicesFilter(column)"
                            ValueChanged="chosen => FilterChoicesAsync(column, chosen)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbMultiSelect>,
        ColumnFilterKind.Number =>
            @<TbNumberField TValue="decimal?" AriaLabel="@FilterLabel(column)" Size="Size.Small" HideStepButtons
                            Value="NumberFilter(column)" ValueChanged="number => FilterNumberAsync(column, number)" />,
        ColumnFilterKind.Date =>
            @<TbDateRangePicker TDate="DateOnly" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                Value="DateFilter(column)" ValueChanged="range => FilterDatesAsync(column, range)" />,
        ColumnFilterKind.Choice or ColumnFilterKind.YesNo =>
            @<TbSelect TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Clearable
                       Placeholder="@Localizer[TbStrings.DataGridFilterAny]" Value="ChoiceFilter(column)"
                       ValueChanged="choice => FilterChoiceAsync(column, choice)">
                @foreach (var (key, label, _) in ChoicesOf(column))
                {
                    <TbOption Value="key">@label</TbOption>
                }
            </TbSelect>,
        _ =>
            @<TbTextField TValue="string" AriaLabel="@FilterLabel(column)" Size="Size.Small" Type="TextFieldType.Search"
                          UpdateOnInput UpdateDelay="FilterDelay" Value="TextFilter(column)"
                          ValueChanged="text => FilterTextAsync(column, text)" />,
    };

    private static readonly TimeSpan FilterDelay = TimeSpan.FromMilliseconds(300);

    // A menu holds a draft of the column's filter, applied with its Apply button; a template applies its own.
    private RenderFragment FilterMenu(TbColumn<TItem> column)
    {
        var draft = DraftFor(column);
        var label = IsFiltered(column) ? Format(TbStrings.DataGridFilterOn, column.Heading) : FilterLabel(column);
        return @<TbPopover Icon="BuiltInIcons.Filter" Label="@label" Title="@FilterLabel(column)"
                           Variant="Variant.Text" Size="Size.Small" Open="draft.Open"
                           OpenChanged="open => OpenFilterMenu(column, open)" data-part="filter-menu"
                           class="tb-data-grid__filter-menu">
            @* As in the filter row, a page's form around the grid doesn't own or track the menu's fields. *@
            <CascadingValue TValue="EditContext" Value="null">
                <CascadingValue TValue="TbForm" Value="null">
                    @if (column.FilterTemplate is { } template)
                    {
                        <div class="tb-data-grid__filter-form">@template(FilterContext(column))</div>
                    }
                    else
                    {
                        <div class="tb-data-grid__filter-form">
                            @if (HasChoiceList(column))
                            {
                                <TbCheckboxGroup TItem="string" AriaLabel="@FilterLabel(column)" Size="Size.Small"
                                                 @bind-Value="draft.Chosen">
                                    @foreach (var (key, label, _) in ChoicesOf(column))
                                    {
                                        <TbCheckboxItem Value="key">@label</TbCheckboxItem>
                                    }
                                </TbCheckboxGroup>
                            }
                            else if (column.FilterKind == ColumnFilterKind.Date)
                            {
                                <TbDateRangePicker TDate="DateOnly" Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                   Size="Size.Small" @bind-Value="draft.Range" />
                            }
                            else
                            {
                                <TbSelect TValue="FilterOperator" Label="@Localizer[TbStrings.DataGridFilterCondition]"
                                          Size="Size.Small" @bind-Value="draft.Operator">
                                    @foreach (var op in FilterOperators(column))
                                    {
                                        <TbOption Value="op">@OperatorLabel(op)</TbOption>
                                    }
                                </TbSelect>
                                @if (NeedsValue(draft.Operator))
                                {
                                    <div @onkeydown="args => ApplyOnEnterAsync(column, args)">
                                        @if (column.FilterKind == ColumnFilterKind.Number)
                                        {
                                            <TbNumberField TValue="decimal?" Size="Size.Small" HideStepButtons
                                                           Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                           UpdateOnInput @bind-Value="draft.Number" />
                                        }
                                        else
                                        {
                                            <TbTextField TValue="string" Label="@Localizer[TbStrings.DataGridFilterValue]"
                                                         Size="Size.Small" UpdateOnInput @bind-Value="draft.Text" />
                                        }
                                    </div>
                                }
                            }
                            <div class="tb-data-grid__filter-actions">
                                <TbButton Variant="Variant.Text" Size="Size.Small" data-part="filter-clear"
                                          OnClick="() => ClearFilterMenuAsync(column)">
                                    @Localizer[TbStrings.DataGridFilterClear]
                                </TbButton>
                                <TbButton Size="Size.Small" data-part="filter-apply"
                                          OnClick="() => ApplyFilterMenuAsync(column)">
                                    @Localizer[TbStrings.DataGridFilterApply]
                                </TbButton>
                            </div>
                        </div>
                    }
                </CascadingValue>
            </CascadingValue>
        </TbPopover>;
    }

    // Single selection's radio buttons need a group of their own on the page.
    private readonly string _radioName = $"tb-data-grid-{Guid.NewGuid():N}";

    // Only the first sort is the column's sort to screen readers; the rest say their place in words.
    private static string? AriaSort(int at, GridSort? sort) => at != 0 ? null
        : sort!.Direction == SortDirection.Ascending ? "ascending" : "descending";
}
