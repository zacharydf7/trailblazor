<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enum values name themselves; a test checks that every public type and property has a summary instead. Razor's
         render methods and record structs' generated Equals and ToString have no nullable annotations, which the API
         files can't fix. -->
    <NoWarn>$(NoWarn);CS1591;RS0041</NoWarn>
    <Description>Accessible Blazor UI components built on design tokens, cascade layers and native browser overlays.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trailblazor.Primitives\Trailblazor.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer ships in the package, so an app's build checks its markup. -->
    <None Include="..\Trailblazor.Analyzers\bin\$(Configuration)\netstandard2.0\Trailblazor.Analyzers.dll" Pack="true"
          PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trailblazor.Tests" />
    <!-- So a test's dialog can find its own content among others of its type. -->
    <InternalsVisibleTo Include="Trailblazor.Testing" />
  </ItemGroup>

</Project>
