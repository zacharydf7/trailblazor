@namespace Trailblazor
@using System.Globalization
@inherits TbBoxedFieldBase<string?>

@if (RendererInfo.IsInteractive)
{
    @Layout(Classes, @<text>
        @Input
    </text>, Joined(Start, Preview), Joined(End, Buttons))
}
else
{
    @* Without a circuit there is no picker. A text box stands in, since the browser's color box can't be empty or
       see-through and would post black or drop the opacity; data-prerender marks one the interactive field will
       replace. *@
    @Layout(Classes, @<text>
        <input @attributes="ControlAttributes" data-part="input" id="@InputId" name="@InputNameAttribute" type="text"
               value="@Text" placeholder="@Placeholder" pattern="@StaticPattern"
               title="@(LimitsToPalette ? NotInPaletteLabel : BadColorLabel)"
               disabled="@Disabled" readonly="@ReadOnly"
               aria-required="@AriaRequired" aria-invalid="@(ShowsInvalid ? "true" : null)"
               aria-describedby="@InputDescribedBy" data-static="@(AssignedRenderMode is null ? "" : null)"
               data-prerender="@(AssignedRenderMode is null ? null : "")"
               class="@ClassNames.Join("tb-field__input", Classes?.Input)" />
    </text>, Joined(Start, Preview), End)
}

@code {
    // A static post binds the text as it is, so the browser lets through only the hex the interactive field writes
    // (with PaletteOnly, only the palette's colors); letters match in either case, as a pattern can't ignore case.
    private string StaticPattern => LimitsToPalette
        ? string.Join("|", Palette!.Select(swatch => string.Concat(Read(swatch).ToHex(Alpha)
            .Select(digit => char.IsLetter(digit) ? $"[{digit}{char.ToUpperInvariant(digit)}]" : $"{digit}"))))
        : Alpha ? "#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" : "#[0-9a-fA-F]{6}";

    private bool LimitsToPalette => PaletteOnly && Palette is { Count: > 0 };

    private RenderFragment Preview =>
        @<span data-part="swatch-preview" aria-hidden="true" class="tb-color-picker__preview"
               style="@(Color is { } color ? $"--tb-color-picker-value: {color.ToHex(true)}" : null)"></span>;

    private RenderFragment Buttons => @<text>
        @if (Clearable && !Disabled && !ReadOnly && Value is not null)
        {
            <TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@ClearLabel" aria-describedby="@ClearDescribedBy"
                          Size="Size.Small" OnClick="ClearAsync" data-part="clear" />
        }
        @if (_canPickColor)
        {
            <TbIconButton Icon="BuiltInIcons.Eyedropper" AriaLabel="@EyedropperLabel" Size="Size.Small"
                          Disabled="@(Disabled || ReadOnly)" OnClick="PickFromScreenAsync" data-part="eyedropper" />
        }
        <TbPopover Title="@OpenLabel" Align="PlacementAlign.End" Open="_open" OpenChanged="OnOpenChangedAsync"
                   class="tb-color-picker__popover">
            <Trigger>
                <TbIconButton Icon="BuiltInIcons.Palette" AriaLabel="@OpenLabel" Size="Size.Small"
                              Disabled="@(Disabled || ReadOnly)" @attributes="context.Attributes" />
            </Trigger>
            <ChildContent>
                <div class="tb-color-picker__body" style="@BodyStyle">
                    @if (Palette is { Count: > 0 })
                    {
                        <div role="radiogroup" aria-label="@SwatchesLabel" data-part="swatches"
                             class="tb-color-picker__swatches">
                            @foreach (var swatch in Palette)
                            {
                                <input type="radio" name="@($"{FieldId}-swatch")" data-part="swatch"
                                       aria-label="@NameOf(swatch)" checked="@IsChosen(swatch)"
                                       disabled="@(Disabled || ReadOnly)"
                                       @onchange="_chooseSwatch.For(swatch)"
                                       style="@($"--tb-swatch: {Read(swatch).ToHex(true)}")"
                                       class="tb-color-picker__swatch" />
                            }
                        </div>
                    }
                    @if (!PaletteOnly)
                    {
                        @* The pad is for the pointer; the sliders below give the same control to the keyboard. *@
                        <div @ref="_pad" data-part="pad" aria-hidden="true" class="tb-color-picker__pad"
                             style="@PadStyle">
                            <span class="tb-color-picker__pad-thumb"></span>
                        </div>
                        @Slider(HueLabel, "hue", 360, _hue, OnHueInputAsync, "°")
                        @Slider(SaturationLabel, "saturation", 100, _saturation * 100, OnSaturationInputAsync, "%")
                        @Slider(BrightnessLabel, "brightness", 100, _brightness * 100, OnBrightnessInputAsync, "%")
                        @if (Alpha)
                        {
                            @Slider(AlphaLabel, "alpha", 100, _alpha / 255d * 100, OnAlphaInputAsync, "%")
                        }
                        <div class="tb-color-picker__channels">
                            @Channel(RedLabel, "red", Color?.R, OnRedChangedAsync)
                            @Channel(GreenLabel, "green", Color?.G, OnGreenChangedAsync)
                            @Channel(BlueLabel, "blue", Color?.B, OnBlueChangedAsync)
                        </div>
                    }
                </div>
            </ChildContent>
        </TbPopover>
    </text>;

    private string PadStyle => FormattableString.Invariant(
        $"--tb-color-picker-x: {_saturation}; --tb-color-picker-y: {1 - _brightness}");

    // Each slider's track shows the colors it runs through, given the other sliders' values.
    private string BodyStyle => FormattableString.Invariant($"--tb-color-picker-hue: {_hue}deg; ")
        + $"--tb-color-picker-gray: {ColorValue.FromHsv(_hue, 0, _brightness, 255).ToHex(false)}; "
        + $"--tb-color-picker-vivid: {ColorValue.FromHsv(_hue, 1, _brightness, 255).ToHex(false)}; "
        + $"--tb-color-picker-bright: {ColorValue.FromHsv(_hue, _saturation, 1, 255).ToHex(false)}; "
        + $"--tb-color-picker-opaque: {Picked.ToHex(false)}";

    // Method groups keep their handler ids between renders, unlike @bind's closures; value syncs as with @bind.
    private RenderFragment Input => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddMultipleAttributes(1, ControlAttributes);
        builder.AddAttribute(2, "data-part", "input");
        builder.AddAttribute(3, "id", InputId);
        builder.AddAttribute(4, "name", InputNameAttribute);
        builder.AddAttribute(5, "type", "text");
        builder.AddAttribute(6, "autocomplete", "off");
        builder.AddAttribute(7, "spellcheck", "false");
        // Tests wait for data-value to show the color they typed has been taken.
        builder.AddAttribute(8, "data-value", Value);
        builder.AddAttribute(9, "value", Text);
        builder.AddAttribute(10, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, OnTextChangedAsync));
        builder.SetUpdatesAttributeName("value");
        builder.AddAttribute(11, "placeholder", Placeholder);
        builder.AddAttribute(12, "disabled", Disabled);
        builder.AddAttribute(13, "readonly", ReadOnly);
        builder.AddAttribute(14, "aria-required", AriaRequired);
        builder.AddAttribute(15, "aria-invalid", ShowsInvalid ? "true" : null);
        builder.AddAttribute(16, "aria-describedby", InputDescribedBy);
        builder.AddAttribute(17, "class", ClassNames.Join("tb-field__input", Classes?.Input));
        builder.AddElementReferenceCapture(18, input => _input = input);
        builder.CloseElement();
    };

    private RenderFragment Slider(string label, string part, int max, double value,
        Func<ChangeEventArgs, Task> slide, string unit) =>
        @<label class="tb-color-picker__row">
            <span class="tb-color-picker__row-label">@label</span>
            @ChannelInput("range", part, max, Invariant(value), slide, $"{Invariant(value)}{unit}",
                $"tb-color-picker__slider tb-color-picker__slider--{part}")
        </label>;

    private RenderFragment Channel(string label, string part, byte? value, Func<ChangeEventArgs, Task> change) =>
        @<label class="tb-color-picker__channel">
            <span class="tb-color-picker__row-label">@label</span>
            @ChannelInput("number", part, 255, value?.ToString(CultureInfo.InvariantCulture), change, null,
                "tb-color-picker__number")
        </label>;

    // Each handler is one of the picker's own methods, so its id survives renders; a slider updates as it moves.
    private RenderFragment ChannelInput(string type, string part, int max, string? value,
        Func<ChangeEventArgs, Task> handler, string? valueText, string className) => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", type);
        builder.AddAttribute(2, "data-part", part);
        builder.AddAttribute(3, "min", "0");
        builder.AddAttribute(4, "max", max);
        builder.AddAttribute(5, "step", "1");
        builder.AddAttribute(6, "value", value);
        builder.AddAttribute(7, type == "range" ? "oninput" : "onchange", EventCallback.Factory.Create(this, handler));
        builder.SetUpdatesAttributeName("value");
        builder.AddAttribute(8, "disabled", Disabled || ReadOnly);
        builder.AddAttribute(9, "aria-valuetext", valueText);
        builder.AddAttribute(10, "class", className);
        builder.CloseElement();
    };
}
