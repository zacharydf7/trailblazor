@namespace Trailblazor
@inherits TbComponentBase
@implements IDisposable

<div @attributes="AdditionalAttributes" data-part="item" style="@Style"
     class="@ClassNames.Join("tb-accordion__item", _expanded ? "tb-accordion__item--expanded" : null, Class)">
    @if (HeaderActions is null)
    {
        @Heading
    }
    else
    {
        @* Beside the heading, not in it, so the actions are neither inside the button nor part of its name. *@
        <div data-part="header" class="tb-accordion__header">
            @Heading
            <div data-part="actions" class="tb-accordion__actions">@HeaderActions</div>
        </div>
    }
    @* The content stays rendered while closed, so fields inside keep what was typed; inert keeps it out of reach.
       Until the page is interactive, an enabled item's panel is hidden until found instead, so find-in-page can
       reveal it and the startup script can open it. *@
    <div id="@PanelId" role="region" aria-labelledby="@TriggerId" inert="@(!_expanded && !FindsPanel)"
         hidden="@(FindsPanel ? "until-found" : null)" data-part="panel"
         class="tb-accordion__panel">
        <div class="tb-accordion__clip">
            @* An item in the panel belongs to an accordion of its own, or to none, never to this one. *@
            <div class="tb-accordion__body">
                <CascadingValue TValue="TbAccordion" Value="null" IsFixed="true">@ChildContent</CascadingValue>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly string _id = $"tb-accordion-item-{Guid.NewGuid():N}";
    private bool _expanded;
    private bool? _lastExpanded;

    /// <summary>The header's text. <see cref="TitleContent"/> replaces it when set.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Custom header content, in place of <see cref="Title"/>.</summary>
    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    /// <summary>Whether the item is open. Bind it with <c>@bind-Expanded</c>, or set it to start the item open.
    /// </summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>Raised when the user opens or closes the item, or when opening another one closes it.</summary>
    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Stops the item from being opened or closed.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The content shown while the item is open.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The heading level of the item's header, from 1 to 6, in place of its accordion's
    /// <see cref="TbAccordion.HeadingLevel"/>. Defaults to the accordion's, or to 3 on its own. Give an item nested in
    /// another item's panel a level below that item's, so the page's outline stays in order.</summary>
    [Parameter]
    public int? HeadingLevel { get; set; }

    /// <summary>Controls for the item, such as a delete button, shown at the end of its header. They sit beside the
    /// header's button rather than in it, so they stay usable and out of its name, and Tab reaches them after it.
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [CascadingParameter]
    private TbAccordion? Accordion { get; set; }

    private string TriggerId => $"{_id}-trigger";

    private bool FindsPanel => !_expanded && !Disabled && !RendererInfo.IsInteractive;

    private string PanelId => $"{_id}-panel";

    // Razor has no element whose tag is chosen at run time, so the h1-h6 heading is built here.
    private RenderFragment Heading => builder =>
    {
        builder.OpenElement(0, $"h{HeadingLevel ?? Accordion?.HeadingLevel ?? 3}");
        builder.AddAttribute(1, "data-part", "heading");
        builder.AddAttribute(2, "class", "tb-accordion__heading");
        builder.AddContent(3, Trigger);
        builder.CloseElement();
    };

    private RenderFragment Trigger =>
        @<button type="button" id="@TriggerId" aria-expanded="@(_expanded ? "true" : "false")"
                 aria-controls="@PanelId" disabled="@Disabled" data-part="trigger" class="tb-accordion__trigger"
                 data-ready="@(RendererInfo.IsInteractive ? "" : null)"
                 @onclick="ToggleAsync">
            <span class="tb-accordion__title">
                @if (TitleContent is not null)
                {
                    @TitleContent
                }
                else
                {
                    @Title
                }
            </span>
            <TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" data-part="chevron"
                    Class="tb-accordion__chevron" />
        </button>;

    /// <inheritdoc />
    protected override void OnInitialized() => Accordion?.Add(this);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (HeadingLevel is { } level)
        {
            ArgumentOutOfRangeException.ThrowIfLessThan(level, 1, nameof(HeadingLevel));
            ArgumentOutOfRangeException.ThrowIfGreaterThan(level, 6, nameof(HeadingLevel));
        }

        // Only a new value from the parent opens or closes the item, so re-rendering with the old one keeps a click.
        if (Expanded != _lastExpanded)
        {
            _lastExpanded = Expanded;
            _expanded = Expanded;
        }
    }

    internal async Task CollapseAsync()
    {
        if (!_expanded)
        {
            return;
        }

        _expanded = false;
        StateHasChanged();
        await ExpandedChanged.InvokeAsync(false);
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        await ExpandedChanged.InvokeAsync(_expanded);
        if (_expanded && Accordion is not null)
        {
            await Accordion.ExpandedAsync(this);
        }
    }

    /// <inheritdoc />
    public void Dispose() => Accordion?.Remove(this);
}
