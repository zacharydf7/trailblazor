@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@* The script sets data-ready here once the arrow keys work, which tests wait for. *@
<div @attributes="AdditionalAttributes" @ref="_accordion" data-part="accordion" data-multiple="@Multiple"
     class="@ClassNames.Join("tb-accordion", Class)" style="@Style">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
</div>

@code {
    private readonly List<TbAccordionItem> _items = [];
    private ElementReference _accordion;
    private IJSObjectReference? _handle;
    private bool _disposed;

    /// <summary>Lets several items be open at once. Without it, opening one from its header closes the others;
    /// items opened by setting <see cref="TbAccordionItem.Expanded"/> stay as the parent sets them.</summary>
    [Parameter]
    public bool Multiple { get; set; }

    /// <summary>The heading level of each item's header, from 1 to 6, to fit the page's outline. Defaults to 3.
    /// </summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 3;

    /// <summary>The <see cref="TbAccordionItem"/>s.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        ArgumentOutOfRangeException.ThrowIfLessThan(HeadingLevel, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(HeadingLevel, 6);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/accordion.js");
            if (_disposed)
            {
                return;
            }

            var handle = await module.InvokeAsync<IJSObjectReference?>("attachAccordion", _accordion);
            if (handle is not null && _disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the accordion went with it.
        }
    }

    internal void Add(TbAccordionItem item) => _items.Add(item);

    internal void Remove(TbAccordionItem item) => _items.Remove(item);

    internal async Task ExpandedAsync(TbAccordionItem opened)
    {
        if (Multiple)
        {
            return;
        }

        foreach (var item in _items.Where(item => item != opened).ToList())
        {
            await item.CollapseAsync();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }
    }
}
