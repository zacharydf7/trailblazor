@namespace Trailblazor
@using System.Globalization
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules
@inject ITbLocalizer Localizer
@inject IAnnouncer Announcer

@* The script sets data-ready here once Ctrl+F1 and a collapsed ribbon's tabs work, which tests wait for. *@
<div @ref="_root" @attributes="AdditionalAttributes" data-part="ribbon" style="@Style"
     data-collapsible="@(Collapsible ? "" : null)" data-collapsed="@(IsCollapsed ? "" : null)"
     data-static="@(AssignedRenderMode is null && !RendererInfo.IsInteractive ? "" : null)"
     data-key-tip-label="@KeyTipLabel"
     class="@ClassNames.Join("tb-ribbon", Class)">
    <CascadingValue Value="this" IsFixed="true">@Tabs</CascadingValue>
</div>

@code {
    private bool _givenKey;
    private bool _collapsed;
    private bool _givenCollapsed;
    private ElementReference _root;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<RibbonEvents>? _events;
    private bool _disposed;
    private readonly List<(string Context, string Title)> _appeared = [];

    // Whether the ribbon has shown its first tabs, after which a tab with a context that appears is announced.
    internal bool HasRendered { get; private set; }

    /// <summary>The ribbon's accessible name, which names its row of tabs, such as "Document tools". Required.</summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>The ribbon's <see cref="TbRibbonTab"/>s.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The selected tab's position, counting from 0. Bind it with <c>@bind-ActiveIndex</c>. Use it or
    /// <see cref="ActiveKey"/>, not both. Without either, the ribbon keeps the selection itself and starts on its
    /// first tab.</summary>
    [Parameter]
    public int ActiveIndex { get; set; }

    /// <summary>Raised with the selected tab's position when the user selects another tab, and when tabs going away
    /// change the selection or its position, such as the ribbon going back to the tab selected before.</summary>
    [Parameter]
    public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>The selected tab's <see cref="TbRibbonTab.Key"/>. Bind it with <c>@bind-ActiveKey</c> to select tabs
    /// by key instead of by position, so tabs that come and go don't move the selection; every tab then needs a key.
    /// When it is bound to null, or to a key no tab has, no tab is selected.</summary>
    [Parameter]
    public string? ActiveKey { get; set; }

    /// <summary>Raised with the tab's key when the user selects another tab, and when the selected tab goes away
    /// and the ribbon goes back to the tab selected before it.</summary>
    [Parameter]
    public EventCallback<string?> ActiveKeyChanged { get; set; }

    /// <summary>Content before the tabs, in their row, such as an app button or a File menu. Tab reaches it, and the
    /// tabs' arrow keys don't.</summary>
    [Parameter]
    public RenderFragment? Start { get; set; }

    /// <summary>Content after the tabs, in their row, such as Undo, Save or Share buttons. It comes before the
    /// collapse button of a <see cref="Collapsible"/> ribbon. Tab reaches it, and the tabs' arrow keys don't.
    /// </summary>
    [Parameter]
    public RenderFragment? End { get; set; }

    /// <summary>Shows a button at the end of the tabs that collapses the ribbon to its tabs and shows its commands
    /// again, and lets Ctrl+F1 in the ribbon and a double-click on a tab do the same.</summary>
    [Parameter]
    public bool Collapsible { get; set; }

    /// <summary>Whether the ribbon shows only its tabs. Choosing a tab then shows its commands over the page until a
    /// command is chosen, Escape is pressed or focus leaves the ribbon. Bind it with <c>@bind-Collapsed</c> to set
    /// or follow it; without a binding, the ribbon tracks the state on its own. It takes effect once the page is
    /// interactive.</summary>
    [Parameter]
    public bool Collapsed { get; set; }

    /// <summary>Raised when the user collapses the ribbon or shows its commands again.</summary>
    [Parameter]
    public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>The words the ribbon says to screen readers: the collapse button's name, the announcement that a
    /// context's tabs have appeared, and the description of a control that a key tip reaches. Each one left null
    /// uses the app's text.</summary>
    [Parameter]
    public RibbonLabels Labels { get; set; } = new();

    // Until the page is interactive there's no script to show a collapsed ribbon's commands, so the ribbon stays
    // expanded.
    private bool IsCollapsed => _collapsed && RendererInfo.IsInteractive;

    // Formatted here with {0} standing for itself, so its braces follow the other labels' rules; the script puts the
    // keys in.
    private string KeyTipLabel => string.Format(CultureInfo.CurrentCulture,
        Labels.KeyTip ?? Localizer[TbStrings.RibbonKeyTip], "{0}");

    private RenderFragment CollapseButton => __builder =>
    {
        <TbIconButton Icon="@(IsCollapsed ? BuiltInIcons.ChevronDown : BuiltInIcons.ChevronUp)" Size="Size.Small"
                      AriaLabel="@(Labels.Collapse ?? Localizer[TbStrings.RibbonCollapse])" OnClick="ToggleAsync"
                      aria-expanded="@(IsCollapsed ? "false" : "true")" aria-keyshortcuts="Control+F1"
                      data-part="collapse" />
    };

    // The tabs select by key once they are given one, even a null one, so a key is passed on only when the ribbon
    // was given it.
    private RenderFragment Tabs => builder =>
    {
        builder.OpenComponent<TbTabs>(0);
        builder.AddComponentParameter(1, nameof(TbTabs.AriaLabel), AriaLabel);
        builder.AddComponentParameter(2, nameof(TbTabs.Size), Size.Small);
        builder.AddComponentParameter(3, nameof(TbTabs.KeepAlive), true);
        builder.AddComponentParameter(4, nameof(TbTabs.FocusablePanels), TabPanelFocus.Never);
        if (_givenKey)
        {
            builder.AddComponentParameter(5, nameof(TbTabs.ActiveKey), ActiveKey);
            builder.AddComponentParameter(6, nameof(TbTabs.ActiveKeyChanged), ActiveKeyChanged);
        }

        builder.AddComponentParameter(7, nameof(TbTabs.ActiveIndex), ActiveIndex);
        builder.AddComponentParameter(8, nameof(TbTabs.ActiveIndexChanged), ActiveIndexChanged);
        builder.AddComponentParameter(9, nameof(TbTabs.ChildContent), ChildContent);
        builder.AddComponentParameter(10, nameof(TbTabs.Start), Start);
        builder.AddComponentParameter(11, nameof(TbTabs.End), RowEnd);
        builder.AddComponentReferenceCapture(12, tabs => ((TbTabs)tabs).ReturnsToEarlierTab = true);
        builder.CloseComponent();
    };

    // The app's content comes first, so the collapse button stays the last thing in the row.
    private RenderFragment? RowEnd => !(Collapsible && RendererInfo.IsInteractive) ? End : builder =>
    {
        builder.AddContent(0, End);
        builder.AddContent(1, CollapseButton);
    };

    // The tabs of one context appear in the same render, so they are gathered into one message.
    internal void ContextTabAppeared(string context, string title)
    {
        _appeared.Add((context, title));
        if (_appeared.Count == 1)
        {
            _ = InvokeAsync(AnnounceAppearedAsync);
        }
    }

    private async Task AnnounceAppearedAsync()
    {
        await Task.Yield();
        var appeared = _appeared.ToLookup(tab => tab.Context, tab => tab.Title);
        _appeared.Clear();
        try
        {
            foreach (var tabs in appeared)
            {
                var format = tabs.Count() == 1 ? Labels.ContextTab ?? Localizer[TbStrings.RibbonContextTab]
                    : Labels.ContextTabs ?? Localizer[TbStrings.RibbonContextTabs];
                Announcer.Polite(string.Format(CultureInfo.CurrentCulture, format, tabs.Key,
                    string.Join(", ", tabs)));
            }
        }
        catch (Exception exception)
        {
            // Nothing awaits this method, so the error from a label with a bad placeholder would be lost without this.
            await DispatchExceptionAsync(exception);
        }
    }

    private async Task ToggleAsync()
    {
        _collapsed = !_collapsed;
        await CollapsedChanged.InvokeAsync(_collapsed);
    }

    private async Task ToggleFromScriptAsync()
    {
        await ToggleAsync();
        StateHasChanged();
    }

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        _givenKey |= parameters.TryGetValue<string?>(nameof(ActiveKey), out _)
            || parameters.TryGetValue<EventCallback<string?>>(nameof(ActiveKeyChanged), out _);
        return base.SetParametersAsync(parameters);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException($"{nameof(TbRibbon)} needs an {nameof(AriaLabel)}.");
        }

        if (Collapsed != _givenCollapsed)
        {
            _givenCollapsed = _collapsed = Collapsed;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        HasRendered = true;
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/ribbon.js");
            if (_disposed)
            {
                return;
            }

            _events = DotNetObjectReference.Create(new RibbonEvents(DispatchExceptionAsync, ToggleFromScriptAsync));
            var handle = await module.InvokeAsync<IJSObjectReference?>("attachRibbonRoot", _root, _events);
            if (handle is not null && _disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the ribbon went with it.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _events?.Dispose();
    }
}
