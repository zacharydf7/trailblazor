@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Internal.Events
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules

@* data-static: a static page never runs the script, so the browser's own menu opens and tests know not to wait for it.
   stopPropagation keeps an outer context menu's handler from hearing this one's openings too. *@
<div @ref="_target" @attributes="AdditionalAttributes" style="@Style" data-part="target"
     class="@ClassNames.Join("tb-context-menu", Class)" data-disabled="@(Disabled ? "" : null)"
     data-static="@(AssignedRenderMode is null && !RendererInfo.IsInteractive ? "" : null)"
     @ontbcontextmenuopen="OnOpening" @ontbcontextmenuopen:stopPropagation>
    @ChildContent
    @* data-open is set in the render that draws the items as the menu opens, and data-key and data-request name the key
       and request those items were drawn for. *@
    <div @ref="_menu" popover="manual" role="menu" aria-label="@AriaLabel" data-part="menu"
         data-key="@(_context.Key ?? "")" data-request="@_request" data-open="@(_open ? "" : null)"
         class="@ClassNames.Join("tb-menu__list", Classes?.Menu)">
        <CascadingValue Value="Classes">@Items?.Invoke(_context)</CascadingValue>
    </div>
</div>

@code {
    private ElementReference _target;
    private ElementReference _menu;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<MenuEvents>? _events;
    private ControlTelemetry? _telemetry;
    private ContextMenuContext _context = new();
    private int _request;
    private bool _open;
    private bool _disposed;

    /// <summary>The area the menu opens on. Put <c>data-context-key</c> on the elements inside it that each need
    /// their own items, such as a list's rows, and <see cref="Items"/> is drawn for the key of the one the menu opens
    /// on.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The menu's items: <see cref="TbMenuItem"/>s, <see cref="TbMenuCheckboxItem"/>s, a
    /// <see cref="TbMenuRadioGroup{TValue}"/>, <see cref="TbSubMenu"/>s, and <see cref="TbMenuGroup"/>s and
    /// <see cref="TbMenuSeparator"/>s to arrange them. The context's <see cref="ContextMenuContext.Key"/> says which
    /// element the menu opened on.</summary>
    [Parameter]
    public RenderFragment<ContextMenuContext>? Items { get; set; }

    /// <summary>The menu's accessible name, which screen readers read as it opens, such as <c>"Trail actions"</c>.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Turns the context menu off, so a right-click opens the browser's own menu instead.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when the user opens or closes the menu.</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Extra CSS classes for the menu and its submenus, and every item and its parts. A context menu has no
    /// trigger, so <see cref="MenuClasses.Trigger"/> isn't used.</summary>
    [Parameter]
    public MenuClasses? Classes { get; set; }

    /// <summary>A label the menu's use is counted under, such as <c>"trail-actions"</c>, through the
    /// <c>Trailblazor</c> meter: shown when it first renders, and used each time it opens, which is how often its
    /// items are seen. It names what the menu does, never the user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Telemetry.Rendered(TelemetryName);
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/menu.js");
            if (_disposed)
            {
                return;
            }

            _events = DotNetObjectReference.Create(new MenuEvents(OnToggleAsync));
            var handle = await module.InvokeAsync<IJSObjectReference?>("createContextMenu", _target, _menu, _events);
            if (handle is not null && _disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the menu went with it.
        }
    }

    // The script asks for the items of another key before it shows the menu, and shows it once they're drawn.
    private void OnOpening(ContextMenuOpenEventArgs args)
    {
        _context = new() { Key = args.Key is { Length: > 0 } key ? key : null };
        _request = args.Request;
    }

    // The menu is drawn again each time it opens, so items that depend on state changed since the page last rendered
    // are up to date.
    private async Task OnToggleAsync(bool open)
    {
        if (open)
        {
            Telemetry.Used(TelemetryName);
        }

        var changed = open != _open;
        _open = open;
        StateHasChanged();
        if (changed)
        {
            await OpenChanged.InvokeAsync(open);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _events?.Dispose();
    }
}
