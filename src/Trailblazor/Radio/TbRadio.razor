@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase

@* An id names the radio's input, which users choose. *@
<label @attributes="AttributesWithoutId" style="@Style"
       class="@ClassNames.Join("tb-radio", Disabled ? "tb-radio--disabled" : null, Class)">
    <input @attributes="Group!.InputAttributes" type="radio" data-part="input" id="@GivenId" name="@Group.GroupName"
           class="@ClassNames.Join("tb-radio__input", Group.Classes?.Input)"
           value="@Group.FormatOption(Value)" checked="@Group.IsSelected(Value)" disabled="@(Disabled || Held)"
           @onchange="() => Group.SelectAsync(Value)" />
    <span data-part="label">@ChildContent</span>
</label>

@code {
    /// <summary>The value the group takes when this option is chosen. A plain value fits a group of its nullable, such
    /// as <c>Value="2"</c> in a group bound to an <c>int?</c>; a null option names its type, as with
    /// <c>TValue="int?" Value="null"</c>.</summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>The option's visible label.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Turns this option off while the rest of the group stays usable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [CascadingParameter]
    private IRadioGroup? Group { get; set; }

    // A read-only group turns off every radio but the checked one, which stays focusable and posted.
    private bool Held => Group!.ReadOnly && !Group.IsSelected(Value);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Group is null || !Group.Accepts(Value))
        {
            throw new InvalidOperationException(
                $"{nameof(TbRadio<TValue>)} must be inside a {nameof(TbRadioGroup<TValue>)} its value fits.");
        }
    }
}
