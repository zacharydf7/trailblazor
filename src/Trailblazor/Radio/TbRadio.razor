@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase
@implements IGroupOption
@implements IDisposable

@* An id names the radio's input, which users choose. *@
<label @attributes="AttributesWithoutId" style="@Style"
       class="@ClassNames.Join("tb-radio", Disabled ? "tb-radio--disabled" : null, Class)">
    <input @attributes="Group!.InputAttributes" type="radio" data-part="input" id="@GivenId" name="@Group.GroupName"
           class="@ClassNames.Join("tb-radio__input", Group.Classes?.Input)"
           value="@Group.FormatOption(Value)" checked="@Group.IsSelected(Value)" disabled="@(Disabled || Held)"
           @onchange="() => Group.SelectAsync(Value)" />
    <span data-part="label">@Label</span>
</label>

@code {
    /// <summary>The value the group takes when this option is chosen. A plain value fits a group of its nullable type,
    /// such as <c>Value="2"</c> in a group bound to an <c>int?</c>; a null option names its type, as with
    /// <c>TValue="int?" Value="null"</c>.</summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>The option's label as plain text, and the text a <see cref="TbSmartPaste"/> names the option by. When
    /// the option has <see cref="ChildContent"/> too, the content is the label. Smart paste can't read content, so it
    /// leaves out an option that has content and no text.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>The option's visible label, in place of <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Turns this option off while the rest of the group stays usable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [CascadingParameter]
    private IRadioGroup? Group { get; set; }

    // A read-only group turns off every radio but the checked one, which stays focusable and posted.
    private bool Held => Group!.ReadOnly && !Group.IsSelected(Value);

    private RenderFragment? Label => ChildContent ?? (Text is null ? null : builder => builder.AddContent(0, Text));

    object? IGroupOption.Value => Value;

    /// <inheritdoc />
    protected override void OnInitialized() => Group?.Add(this);

    /// <inheritdoc />
    public void Dispose() => Group?.Remove(this);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Group is null || !Group.Accepts(Value))
        {
            throw new InvalidOperationException(
                $"{nameof(TbRadio<TValue>)} must be inside a {nameof(TbRadioGroup<TValue>)} its value fits.");
        }
    }
}
