@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@typeparam TValue
@inherits TbFieldBase<TValue>
@inject JsModuleLoader Modules

@* Radios that share a name already give one tab stop and arrow-key selection, so no script is needed. *@
<fieldset @attributes="GroupRootAttributes" @ref="_group" role="radiogroup" disabled="@Disabled" style="@Style"
          aria-readonly="@(ReadOnly ? "true" : null)" aria-required="@(Required ? "true" : null)"
          aria-invalid="@(ShowsInvalid ? "true" : null)"
          aria-describedby="@DescribedBy"
          class="@ClassNames.Join("tb-radio-group", ClassNames.Modifier("tb-radio-group", Tone),
                     ClassNames.Modifier("tb-radio-group", Size), ShowsInvalid ? "tb-radio-group--invalid" : null,
                     Disabled ? "tb-radio-group--disabled" : null, Class)">
    @if (ShownLabel is not null)
    {
        <legend data-part="label" class="@ClassNames.Join("tb-radio-group__label", LabelHiddenClass, Classes?.Label)">
            @ShownLabel @RequiredMarker
        </legend>
    }
    <div data-part="options"
         class="@ClassNames.Join("tb-radio-group__options", Row ? "tb-radio-group__options--row" : null)">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
    @Messages(Classes?.Helper, Classes?.Error)
</fieldset>

@code {
    private ElementReference _group;

    /// <summary>The group's <see cref="TbRadio{TValue}"/> options.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The color a chosen radio takes. Defaults to <see cref="Trailblazor.Tone.Primary"/>.</summary>
    [Parameter]
    public Tone Tone { get; set; } = Tone.Primary;

    /// <summary>The size of the radios and their labels. Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Lays the options out in a row instead of a column.</summary>
    [Parameter]
    public bool Row { get; set; }

    /// <summary>Extra CSS classes for the field's inner parts.</summary>
    [Parameter]
    public ChoiceClasses? Classes { get; set; }

    /// <inheritdoc />
    public override async ValueTask FocusAsync(bool preventScroll = false)
    {
        // Focus goes where Tab would put it: on the checked radio, or else the first radio that isn't disabled.
        var module = await Modules.ImportAsync("./_content/Trailblazor/field.js");
        await module.InvokeVoidAsync("focusRadio", _group, preventScroll);
    }

    string IRadioGroup.GroupName => RadioGroupName;

    bool IRadioGroup.Accepts(object? value) => GroupValues.TryFit<TValue>(value, out _);

    string? IRadioGroup.FormatOption(object? value) => FormatValue(GroupValues.Fit<TValue>(value));

    bool IRadioGroup.IsSelected(object? value) =>
        EqualityComparer<TValue>.Default.Equals(GroupValues.Fit<TValue>(value), Value);

    // The change event belongs to the chosen TbRadio, so the group re-renders itself for its messages.
    async Task IRadioGroup.SelectAsync(object? value)
    {
        await SetValueAsync(GroupValues.Fit<TValue>(value));
        StateHasChanged();
    }
}
