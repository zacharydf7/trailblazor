@namespace Trailblazor
@inherits TbComponentBase
@implements IDisposable

@* data-toolbar-item marks what the toolbar hides when the button moves into its overflow menu. *@
@if (Icon is Icon icon)
{
    <TbTooltip Text="@AriaLabel" Placement="Placement.Bottom" data-toolbar-item="@Id">
        <TbIconButton @attributes="AdditionalAttributes" Icon="icon" AriaLabel="@AriaLabel" Variant="Variant"
                      Disabled="Disabled" OnClick="OnClick" Class="@Class" Style="@Style" />
    </TbTooltip>
}
else
{
    <TbButton @attributes="AdditionalAttributes" Variant="Variant" Disabled="Disabled" OnClick="OnClick"
              data-toolbar-item="@Id" Class="@Class" Style="@Style">
        @Label
    </TbButton>
}

@code {
    /// <summary>The button's text, which also labels its item in the overflow menu. Required without an
    /// <see cref="Icon"/>.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The icon button's accessible name, which its tooltip shows and which labels its item in the overflow
    /// menu. Required with an <see cref="Icon"/>.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Shows only this icon, with <see cref="AriaLabel"/> in a tooltip, instead of the text.</summary>
    [Parameter]
    public Icon? Icon { get; set; }

    /// <summary>How strongly the button is drawn. Defaults to <see cref="Trailblazor.Variant.Text"/>.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    /// <summary>Turns the button, and its item in the overflow menu, off.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when the button, or its item in the overflow menu, is chosen.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [CascadingParameter]
    private TbToolbar? Toolbar { get; set; }

    internal string Id { get; } = $"tb-toolbar-button-{Guid.NewGuid():N}";

    // What names the button, and its item in the overflow menu.
    internal string Name => (Icon is null ? Label : AriaLabel) ?? "";

    /// <inheritdoc />
    protected override void OnInitialized() => Toolbar?.Add(this);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Icon is not null && string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException($"{nameof(TbToolbarButton)} with an {nameof(Icon)} needs an "
                + $"{nameof(AriaLabel)}, which names the icon button; {nameof(Label)} is for a text button.");
        }

        if (Icon is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException($"{nameof(TbToolbarButton)} needs a {nameof(Label)}.");
        }

        Toolbar?.Refresh(this);
    }

    /// <inheritdoc />
    public void Dispose() => Toolbar?.Remove(this);
}
