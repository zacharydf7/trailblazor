@namespace Trailblazor
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inherits TbComponentBase
@implements IAsyncDisposable
@inject JsModuleLoader Modules
@inject ITbLocalizer Localizer

<div @attributes="AdditionalAttributes" @ref="_toolbar" role="toolbar" aria-label="@AriaLabel"
     aria-orientation="@(Vertical ? "vertical" : "horizontal")" style="@Style"
     class="@ClassNames.Join("tb-toolbar", Vertical ? "tb-toolbar--vertical" : null, Class)">
    <CascadingValue Value="this">@ChildContent</CascadingValue>
    @if (!Vertical)
    {
        @* The script shows it once a button has moved in; the server then fills it with those buttons. *@
        <div @ref="_more" data-part="overflow" class="tb-toolbar__overflow">
            <TbMenu AriaLabel="@(OverflowLabel ?? Localizer[TbStrings.ToolbarMore])" Icon="BuiltInIcons.More"
                    Size="Size" Align="PlacementAlign.End">@OverflowItems</TbMenu>
        </div>
    }
</div>

@code {
    private readonly List<TbToolbarButton> _buttons = [];
    private readonly HashSet<string> _separators = [];
    private IReadOnlyList<string> _overflowed = [];
    private bool _attachedVertical;
    private ElementReference _toolbar;
    private ElementReference _more;
    private OverflowMenuItems? _menuItems;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ToolbarOverflow>? _overflow;
    private bool _disposed;

    /// <summary>The toolbar's accessible name, such as "Formatting". Required.</summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>The toolbar's content: <see cref="TbToolbarButton"/>s, <see cref="TbToolbarSeparator"/>s, other
    /// buttons, toggle groups, menus, text or a <see cref="TbSpacer"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Stacks the content and moves between the controls with Up and Down. A vertical toolbar never moves
    /// buttons into the overflow menu.</summary>
    [Parameter]
    public bool Vertical { get; set; }

    /// <summary>The name of the menu button that holds the toolbar buttons that don't fit.
    /// Defaults to the app's text for <see cref="TbStrings.ToolbarMore"/>, "More" in English.</summary>
    [Parameter]
    public string? OverflowLabel { get; set; }

    /// <summary>The size of the toolbar buttons and the overflow menu button, unless a toolbar button sets its own.
    /// Defaults to <see cref="Trailblazor.Size.Medium"/>.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    // Razor only finds public components by tag, so the internal menu items are added here.
    private RenderFragment OverflowItems => builder =>
    {
        builder.OpenComponent<OverflowMenuItems>(0);
        builder.AddComponentParameter(1, nameof(OverflowMenuItems.Items), (Func<IEnumerable<OverflowItem>>)(() =>
            _overflowed.Select(id => _separators.Contains(id) ? new OverflowItem(id, null)
                : _buttons.Find(button => button.Id == id) is { } button ? new OverflowItem(id, button) : null)
                .OfType<OverflowItem>()));
        builder.AddComponentReferenceCapture(2, items => _menuItems = (OverflowMenuItems)items);
        builder.CloseComponent();
    };

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException($"{nameof(TbToolbar)} needs an {nameof(AriaLabel)}.");
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // When Vertical changes, moved buttons return to the toolbar before the script attaches again.
        if (!firstRender && (_handle is null || _attachedVertical == Vertical))
        {
            return;
        }

        try
        {
            if (_handle is not null)
            {
                // Taken out first, so a render during the awaits neither disposes it twice nor skips the new one.
                var old = _handle;
                _handle = null;
                await old.DisposeHandleAsync();
                _overflow?.Dispose();
                OnOverflow([]);
            }

            var module = await Modules.ImportAsync("./_content/Trailblazor/toolbar.js");
            if (_disposed)
            {
                return;
            }

            _overflow = DotNetObjectReference.Create(new ToolbarOverflow(OnOverflow));
            _attachedVertical = Vertical;
            var handle = await module.InvokeAsync<IJSObjectReference?>("attachToolbar", _toolbar,
                Vertical ? null : _more, _overflow);
            if (handle is not null && _disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
            if (_attachedVertical != Vertical)
            {
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the toolbar went with it.
        }
    }

    internal void Add(TbToolbarButton button) => _buttons.Add(button);

    internal void Remove(TbToolbarButton button) => _buttons.Remove(button);

    internal void Add(TbToolbarSeparator separator) => _separators.Add(separator.Id);

    internal void Remove(TbToolbarSeparator separator) => _separators.Remove(separator.Id);

    // A moved button's menu item follows the button's text, icon and state.
    internal void Refresh(TbToolbarButton button)
    {
        if (_overflowed.Contains(button.Id))
        {
            _menuItems?.Refresh();
        }
    }

    private void OnOverflow(IReadOnlyList<string> ids)
    {
        _overflowed = ids;
        _menuItems?.Refresh();
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }

        _overflow?.Dispose();
    }
}
