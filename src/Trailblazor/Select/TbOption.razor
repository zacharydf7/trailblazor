@namespace Trailblazor
@typeparam TValue
@inherits TbComponentBase
@implements IDisposable
@implements ISelectOption

@if (RendererInfo.IsInteractive)
{
    <div @attributes="AdditionalAttributes" id="@_id" role="option" data-text="@Text"
         aria-label="@(ChildContent is null ? null : Text)"
         aria-selected="@(Select!.IsSelected(Value) ? "true" : "false")" aria-disabled="@(Disabled ? "true" : null)"
         data-part="option" class="@ClassNames.Join("tb-select__option", Class)" style="@Style" @onclick="ChooseAsync">
        @Content
    </div>
}
else
{
    <option @attributes="AdditionalAttributes" value="@Select!.Format(Value)" selected="@Select.IsSelected(Value)"
            disabled="@Disabled" class="@Class" style="@Style">
        @Content
    </option>
}

@code {
    private readonly string _id = $"tb-option-{Guid.NewGuid():N}";
    private TValue? _value;
    private ControlTelemetry? _telemetry;

    /// <summary>The value the select or listbox takes when this option is chosen.</summary>
    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    /// <summary>The option's text, when it has no <see cref="ChildContent"/>, or for typing to find it and its name
    /// for screen readers when the content isn't plain text, such as an image and a caption. Defaults to the value's
    /// text.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>The option's content. Defaults to <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Stops this option from being chosen while the rest stay usable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>A label this option's use is counted under, such as <c>"size-large"</c>, so the app can see how often
    /// people choose it through the <c>Trailblazor</c> meter. It counts uses only, as a select's list renders hidden
    /// until opened; give the select a <c>TelemetryName</c> to count how often it is shown. A choice a disabled or
    /// read-only list refuses isn't counted, and the option's value is never recorded. It names the choice, never the
    /// user.</summary>
    [Parameter]
    public string? TelemetryName { get; set; }

    [CascadingParameter]
    private ISelect? Select { get; set; }

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ControlTelemetry Telemetry => _telemetry ??= new(Services, GetType());

    // What the option shows, in the list and in the select once chosen.
    private RenderFragment Content =>
        ChildContent ?? (builder => builder.AddContent(0, Text ?? Select!.Format(Value)));

    object? ISelectOption.Value => Value;

    bool ISelectOption.Disabled => Disabled;

    string ISelectOption.Id => _id;

    RenderFragment ISelectOption.Content => Content;

    string? ISelectOption.Name => ChildContent is null ? null : Text;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Select is null)
        {
            throw new InvalidOperationException(
                $"{nameof(TbOption<TValue>)} must be inside a TbSelect or a TbListBox.");
        }

        _value = Value;
        Select.Add(this);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // The combobox shows the chosen option, which this option may have just become, stopped being or changed.
        if (Select!.IsSelected(Value) || !EqualityComparer<TValue>.Default.Equals(Value, _value))
        {
            _value = Value;
            Select.Refresh();
        }
    }

    // A choice the script makes for a key, such as Enter, is a click with no count of presses.
    private async Task ChooseAsync(MouseEventArgs args)
    {
        var input = args.Detail > 0 ? "pointer" : "keyboard";
        if (!Disabled && await Select!.ChooseAsync(Value, input))
        {
            Telemetry.Used(TelemetryName, input: input);
        }
    }

    /// <inheritdoc />
    public void Dispose() => Select?.Remove(this);
}
