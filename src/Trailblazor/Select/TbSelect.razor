@namespace Trailblazor
@typeparam TValue
@inherits TbFieldBase<TValue>
@implements IAsyncDisposable
@implements ISelect
@using Microsoft.JSInterop
@using Trailblazor.Primitives
@inject JsModuleLoader Modules

@Layout(@<text>
    @if (RendererInfo.IsInteractive)
    {
        @* Focus stays on the combobox; the script moves an active option with aria-activedescendant. *@
        <div @attributes="InputAttributes" @ref="_combobox" data-part="input" id="@InputId" role="combobox"
             tabindex="@(Disabled ? "-1" : "0")" aria-labelledby="@(Label is null ? null : LabelId)"
             aria-haspopup="listbox" aria-controls="@ListboxId" aria-disabled="@(Disabled ? "true" : null)"
             aria-required="@(Required ? "true" : null)" aria-invalid="@(Errors.Count > 0 ? "true" : null)"
             aria-describedby="@InputDescribedBy"
             class="@ClassNames.Join("tb-field__input", "tb-select__trigger", Classes?.Input)">
            @Display
        </div>
        <div @ref="_listbox" id="@ListboxId" popover="auto" role="listbox"
             aria-labelledby="@(Label is null ? null : LabelId)" data-part="listbox" class="tb-select__listbox">
            @* Not fixed, so every option re-renders with the select and its aria-selected follows the value. *@
            <CascadingValue Value="this">@ChildContent</CascadingValue>
        </div>
    }
    else
    {
        @* Without a circuit the custom list can't open, so a native select keeps the field usable and posted. *@
        <select @attributes="InputAttributes" data-part="input" id="@InputId" name="@InputNameAttribute"
                disabled="@Disabled" aria-required="@(Required ? "true" : null)"
                aria-invalid="@(Errors.Count > 0 ? "true" : null)" aria-describedby="@InputDescribedBy"
                class="@ClassNames.Join("tb-field__input", "tb-select__native", Classes?.Input)">
            @if (SelectedOption is null)
            {
                <option value="" selected>@Placeholder</option>
            }
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </select>
    }
</text>, null, RendererInfo.IsInteractive ? End : null)

@code {
    private readonly List<ISelectOption> _options = [];
    private ElementReference _combobox;
    private ElementReference _listbox;
    private SelectDisplay? _display;
    private IJSObjectReference? _handle;
    private bool _disposed;

    /// <summary>The <see cref="TbOption{TValue}"/>s to choose from.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Text shown while no option is chosen. It is not a label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Shows a button that clears the choice, setting the value back to its default.</summary>
    [Parameter]
    public bool Clearable { get; set; }

    private string ListboxId => $"{FieldId}-listbox";

    private ISelectOption? SelectedOption => _options.Find(option => IsSelected(option.Value));

    // Razor only finds public components by tag, so the internal display is added here.
    private RenderFragment Display => builder =>
    {
        builder.OpenComponent<SelectDisplay>(0);
        builder.AddComponentParameter(1, nameof(SelectDisplay.Selected), (Func<ISelectOption?>)(() => SelectedOption));
        builder.AddComponentParameter(2, nameof(SelectDisplay.Placeholder), Placeholder);
        builder.AddComponentReferenceCapture(3, display => _display = (SelectDisplay)display);
        builder.CloseComponent();
    };

    private RenderFragment End =>
        @<text>
            @if (Clearable && !Disabled && !EqualityComparer<TValue>.Default.Equals(Value, default))
            {
                <TbIconButton Icon="BuiltInIcons.Close" AriaLabel="Clear" Size="Size.Small" OnClick="ClearAsync"
                              data-part="clear" />
            }
            <TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" data-part="chevron" Class="tb-select__chevron" />
        </text>;

    // A label's for attribute can't point at the interactive combobox, which names itself with aria-labelledby.
    private protected override bool LabelTargetsInput => !RendererInfo.IsInteractive;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await Modules.ImportAsync("./_content/Trailblazor/select.js");
            if (_disposed)
            {
                return;
            }

            var handle = await module.InvokeAsync<IJSObjectReference?>("createSelect", _combobox, _listbox);
            if (handle is null)
            {
                return;
            }

            if (_disposed)
            {
                await handle.DisposeHandleAsync();
                return;
            }

            _handle = handle;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the select went with it.
        }
    }

    bool ISelect.IsSelected(object? value) => IsSelected(value);

    string? ISelect.Format(object? value) => FormatValue((TValue?)value);

    Task ISelect.ChooseAsync(object? value) => ChooseAsync((TValue?)value);

    void ISelect.Add(ISelectOption option)
    {
        if (option.Value is not null and not TValue)
        {
            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            throw new InvalidOperationException($"A TbOption's value must be a {type.Name}, the type of its " +
                $"TbSelect, but {option.Value} is a {option.Value.GetType().Name}.");
        }

        _options.Add(option);
        StateHasChanged();
    }

    void ISelect.Remove(ISelectOption option)
    {
        _options.Remove(option);
        StateHasChanged();
    }

    void ISelect.Refresh() => _display?.Refresh();

    private bool IsSelected(object? value) => Equals(value, Value);

    private async Task ChooseAsync(TValue? value)
    {
        await SetValueAsync(value);
        StateHasChanged();
    }

    // The clear button goes away with the value, so focus moves to the combobox instead of the page.
    private async Task ClearAsync()
    {
        await ChooseAsync(default);
        // An async ValueChanged handler may have removed the select, and a removed element can't take focus.
        if (!_disposed)
        {
            await _combobox.FocusAsync();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync when both exist, so the field's own cleanup has to run from here.
        Dispose();
        _disposed = true;
        if (_handle is not null)
        {
            await _handle.DisposeHandleAsync();
        }
    }
}
