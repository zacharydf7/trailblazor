@namespace Trailblazor
@inherits TbComponentBase

@if (RendererInfo.IsInteractive)
{
    <div @attributes="AdditionalAttributes" role="group" aria-labelledby="@_labelId" data-part="group" style="@Style"
         class="@ClassNames.Join("tb-select__group", Class)">
        <div id="@_labelId" role="presentation" data-part="group-label" class="tb-select__group-label">@Label</div>
        @ChildContent
    </div>
}
else
{
    <optgroup @attributes="AdditionalAttributes" label="@Label" class="@Class" style="@Style">@ChildContent</optgroup>
}

@code {
    private readonly string _labelId = $"tb-option-group-{Guid.NewGuid():N}";

    /// <summary>Names the group, above its options.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>The group's <see cref="TbOption{TValue}"/>s.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
