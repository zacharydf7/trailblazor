@namespace Trailblazor
@typeparam TValue
@inherits TbBoxedFieldBase<TValue>

@Layout(Classes, @<text>
    @if (RendererInfo.IsInteractive)
    {
        @* Focus stays on the combobox; the script moves an active option and keeps aria-expanded current. *@
        <div @attributes="ControlAttributes" @ref="_combobox" data-part="input" id="@InputId" role="combobox"
             data-attach-on-use="@(WaitsForUse ? "" : null)" @onfocus="AttachOnUse" @onpointerenter="AttachOnUse"
             tabindex="@(Disabled ? "-1" : "0")" aria-labelledby="@(ShownLabel is null ? null : LabelId)"
             aria-haspopup="@(Filterable ? "dialog" : "listbox")" aria-expanded="false"
             aria-controls="@(Filterable ? PopupId : ListboxId)"
             aria-disabled="@(Disabled ? "true" : null)" aria-readonly="@(ReadOnly ? "true" : null)"
             aria-required="@AriaRequired" aria-invalid="@(ShowsInvalid ? "true" : null)"
             aria-describedby="@InputDescribedBy"
             class="@ClassNames.Join("tb-field__input", "tb-select__trigger", Classes?.Input)">
            @Display
        </div>
        @if (Filterable)
        {
            @* A listbox can't hold a text box, so a dialog holds both; focus moves to the filter while it's open. *@
            <div id="@PopupId" popover="auto" role="dialog" aria-labelledby="@(ShownLabel is null ? null : LabelId)"
                 data-part="popup" class="tb-select__popup">
                <input data-part="filter" type="text" role="combobox" autocomplete="off" aria-autocomplete="list"
                       aria-expanded="true" aria-controls="@ListboxId" aria-label="@FilterText"
                       placeholder="@FilterText" class="tb-select__filter" />
                @Listbox
                <div role="status" data-part="no-results" class="tb-select__no-results"
                     data-text="@(Labels.NoResults ?? Localizer[TbStrings.SelectNoResults])">
                </div>
            </div>
        }
        else
        {
            @Listbox
        }
    }
    else
    {
        @* A native select works without a circuit; data-prerender marks one a combobox will replace. *@
        <select @attributes="ControlAttributes" data-part="input" id="@InputId" name="@InputNameAttribute"
                data-prerender="@(AssignedRenderMode is null ? null : "")"
                multiple="@Multiple" disabled="@Disabled" aria-readonly="@(ReadOnly ? "true" : null)"
                aria-required="@AriaRequired"
                aria-invalid="@(ShowsInvalid ? "true" : null)" aria-describedby="@InputDescribedBy"
                class="@ClassNames.Join("tb-field__input", "tb-select__native", Classes?.Input)">
            @if (!Multiple && SelectedOptions.Count == 0)
            {
                @* A value no option has posts back unchanged. *@
                @if (UnmatchedValueText is { } unmatched)
                {
                    <option value="@FormatItem(Value)" selected data-unmatched>@unmatched</option>
                }
                else
                {
                    <option value="" selected>@Placeholder</option>
                }
            }
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
            @if (_options.Count == 0)
            {
                <option disabled data-part="status">@(Labels.Empty ?? Localizer[TbStrings.SelectEmpty])</option>
            }
        </select>
    }
</text>, null, RendererInfo.IsInteractive ? End : null)

@code {
    private RenderFragment Listbox =>
        @<div @ref="_listbox" id="@ListboxId" popover="@(Filterable ? null : "auto")" role="listbox"
              aria-labelledby="@(ShownLabel is null ? null : LabelId)" aria-multiselectable="@(Multiple ? "true" : null)"
              data-part="listbox" class="tb-select__listbox">
            @if (ShowSelectAll)
            {
                <div id="@ListboxId-all" role="option" aria-selected="@(AllChosen ? "true" : "false")"
                     aria-disabled="@(HasEnabledOptions ? null : "true")"
                     data-part="select-all" class="tb-select__option tb-select__select-all" @onclick="SelectAllAsync">
                    <span aria-hidden="true" class="tb-select__box"></span>
                    @SelectAllText
                </div>
            }
            @* Not fixed, so every option re-renders with the select and its aria-selected follows the value. *@
            <CascadingValue Value="this">@ChildContent</CascadingValue>
            @if (_options.Count == 0)
            {
                @* A listbox holds only options, so the message is one that can't be chosen, in muted text rather
                   than disabled. *@
                <div role="option" aria-disabled="true" aria-selected="false" data-part="status"
                     class="tb-select__status">
                    @(Labels.Empty ?? Localizer[TbStrings.SelectEmpty])
                </div>
            }
        </div>;

    private RenderFragment End =>
        @<text>
            @if (Clearable && !Disabled && !ReadOnly && HasChoice)
            {
                <TbIconButton Icon="BuiltInIcons.Close" AriaLabel="@(Labels.Clear ?? Localizer[TbStrings.SelectClear])"
                              aria-describedby="@ClearDescribedBy"
                              Size="Size.Small" OnClick="ClearAsync"
                              data-part="clear" />
            }
            <TbIcon Icon="BuiltInIcons.ChevronDown" Size="Size.Small" data-part="chevron" Class="tb-select__chevron" />
        </text>;
}
