<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Headless behaviors shared by Trailblazor components.</Description>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trailblazor" />
    <InternalsVisibleTo Include="Trailblazor.Tests" />
    <InternalsVisibleTo Include="Trailblazor.BrowserTests.Client" />
    <InternalsVisibleTo Include="Trailblazor.Spikes.Client" />
  </ItemGroup>

</Project>
