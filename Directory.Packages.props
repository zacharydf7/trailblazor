<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The lowest versions the testing packages support, packed as their dependencies' lower bounds, and named in the
       docs site's Testing guide. bUnit before 2.8.6 brings in a vulnerable AngleSharp, and AngleSharpMinimum must
       match the AngleSharp bUnit 2.8.6 was built against. CI's minimums job runs the bUnit tests against these with
       -p:TestingMinimums=true. Playwright stays at its latest there, since the browser tests use newer APIs; the
       helpers still build against its minimum. -->
  <PropertyGroup>
    <BunitMinimum>2.8.6</BunitMinimum>
    <AngleSharpMinimum>1.5.2</AngleSharpMinimum>
    <TimeProviderTestingMinimum>8.0.0</TimeProviderTestingMinimum>
    <PlaywrightMinimum>1.48.0</PlaywrightMinimum>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.8.6" Condition="'$(TestingMinimums)' != 'true'" />
    <PackageVersion Include="AngleSharp" Version="$(AngleSharpMinimum)" Condition="'$(TestingMinimums)' == 'true'" />
    <PackageVersion Include="bunit" Version="2.13.3" Condition="'$(TestingMinimums)' != 'true'" />
    <PackageVersion Include="bunit" Version="$(BunitMinimum)" Condition="'$(TestingMinimums)' == 'true'" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"
                    Condition="'$(TestingMinimums)' != 'true'" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(TimeProviderTestingMinimum)"
                    Condition="'$(TestingMinimums)' == 'true'" />
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
