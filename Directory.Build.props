<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Zachary Fry</Authors>
    <Copyright>Copyright (c) 2026 Zachary Fry</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://trailblazor.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacharydf7/trailblazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!-- Every public member of a package is listed in its PublicAPI.*.txt, so a change to the public surface is a
       deliberate edit. Items are evaluated after each project sets IsPackable. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="$(MSBuildThisFileDirectory)src/package-readme.md" Pack="true" PackagePath="README.md"
          Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor;components;ui;accessibility;design-tokens</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- What ships, built in CI, maps its source paths, so they don't depend on the runner; tests keep their real
         paths. It's set here, by folder, since the compiler's targets read it before a project's IsPackable is
         known. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' And
        $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Every project with Razor markup runs the components' analyzer on itself, as an app using the package does. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Trailblazor.Analyzers/Trailblazor.Analyzers.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
