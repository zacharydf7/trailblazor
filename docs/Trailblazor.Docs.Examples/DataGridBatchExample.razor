<TbStack Gap="3">
    <TbDataGrid TItem="Trail" Items="_trails" AriaLabel="Trail closures" KeySelector="trail => trail.Id"
                EditMode="GridEditMode.Batch" Deletable NewItem="NewTrail" OnBatchSave="Save">
        <TbColumn Field="trail => trail.Name" Editable />
        <TbColumn Field="trail => trail.Region" Editable />
        <TbColumn Field="trail => trail.Reopens" Format="d" Editable />
        <TbColumn Field="trail => trail.Open" Editable />
    </TbDataGrid>
    <TbText Muted>@_status</TbText>
</TbStack>

@code {
    private readonly List<Trail> _trails =
    [
        new(1, "Pine Hollow", "North ridge", true, null),
        new(2, "Eagle Ridge", "North ridge", false, new(2026, 12, 1)),
        new(3, "Cedar Flats", "River valley", true, null),
    ];

    private string _status = "Nothing saved yet.";

    public sealed class Trail(int id, string name, string region, bool open, DateOnly? reopens)
    {
        public int Id { get; } = id;

        public string Name { get; set; } = name;

        public string Region { get; set; } = region;

        public bool Open { get; set; } = open;

        public DateOnly? Reopens { get; set; } = reopens;
    }

    // Rows added before a save each need an id of their own, so the next one is kept apart from the list.
    private int _nextId = 4;

    private Trail NewTrail() => new(_nextId++, "", "", true, null);

    // Every change, delete and new row arrives at once, as a server would take them in one request. A new row's
    // values are already set on its item, so setting them again from its changes does no harm.
    private void Save(GridBatchEdit<Trail> batch)
    {
        _trails.RemoveAll(trail => batch.Deleted.Contains(trail));
        _trails.AddRange(batch.Added);
        foreach (var change in batch.Changes)
        {
            switch (change.Column)
            {
                case nameof(Trail.Name):
                    change.Item.Name = (string)change.Value!;
                    break;
                case nameof(Trail.Region):
                    change.Item.Region = (string)change.Value!;
                    break;
                case nameof(Trail.Open):
                    change.Item.Open = (bool)change.Value!;
                    break;
                case nameof(Trail.Reopens):
                    change.Item.Reopens = (DateOnly?)change.Value;
                    break;
            }
        }

        var edits = batch.Changes.Count(change => !batch.Added.Contains(change.Item));
        _status = $"Saved {edits} {(edits == 1 ? "edit" : "edits")}, {batch.Added.Count} added and "
            + $"{batch.Deleted.Count} deleted.";
    }
}
