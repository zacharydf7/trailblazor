<TbStack>
    <TbSwitch Label="Loading the profile" @bind-Value="_loading" />
    <TbStack Row Gap="4" Align="Align.Center" role="region" aria-label="Profile"
             aria-busy="@(_loading ? "true" : "false")">
        @if (_loading)
        {
            <TbSkeleton Shape="SkeletonShape.Circle" Width="3rem" />
            <TbStack Gap="1" Style="flex: 1">
                <TbSkeleton Width="40%" />
                <TbSkeleton Width="70%" />
            </TbStack>
            <TbSkeleton Shape="SkeletonShape.Rectangle" Width="100px" Height="64px" />
        }
        else
        {
            <TbImage Src="@ExampleImages.Trail" Alt="" Width="48" Height="48" Fit="ImageFit.Cover"
                     Style="border-radius: 50%" />
            <TbStack Gap="1" Style="flex: 1">
                <TbText TextStyle="TextStyle.Subtitle">Ada Lovelace</TbText>
                <TbText>Analyst, joined in 1843</TbText>
            </TbStack>
            <TbImage Src="@ExampleImages.Trail" Alt="The ridge above the trailhead" Width="100" Height="64"
                     Fit="ImageFit.Cover" />
        }
    </TbStack>
</TbStack>

@code {
    private bool _loading = true;
}
