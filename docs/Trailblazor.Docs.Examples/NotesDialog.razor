@inherits TbDialogContent<string>

<TbTextField Label="Notes" @bind-Value="_notes" />
<TbDialogActions>
    @* The dialog changes itself while it's open: modal or not, how wide, and whether it fills the window. *@
    <TbButton Variant="Variant.Text" OnClick="() => Dialog.Modal = !Dialog.Modal">
        @(Dialog.Modal ? "Work beside the page" : "Keep the page out")
    </TbButton>
    <TbButton Variant="Variant.Text"
              OnClick="() => Dialog.Size = Dialog.Size == DialogSize.Small ? DialogSize.Medium : DialogSize.Small">
        @(Dialog.Size == DialogSize.Small ? "Widen" : "Narrow")
    </TbButton>
    <TbButton Variant="Variant.Text" OnClick="ToggleWindow">
        @(Dialog.WindowState == DialogWindowState.Maximized ? "Back to normal size" : "Fill the window")
    </TbButton>
    <TbButton OnClick="() => Dialog.CloseAsync(_notes ?? string.Empty)">Save</TbButton>
</TbDialogActions>

@code {
    private string? _notes;

    private void ToggleWindow() => Dialog.WindowState =
        Dialog.WindowState == DialogWindowState.Maximized ? DialogWindowState.Normal : DialogWindowState.Maximized;
}
