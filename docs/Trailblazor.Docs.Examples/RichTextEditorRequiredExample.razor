<TbForm @ref="_form" aria-label="Trail description" Style="max-inline-size: 32rem">
    <TbRichTextEditor Label="Description" @bind-Value="_description" Required Validation="CheckCapitals"
                      HelperText="Write it in sentence case." />
</TbForm>

@code {
    private TbForm _form = default!;
    private string? _description;

    // Only so this demo shows its messages as it appears; a real form waits for a submit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _form.ValidateAsync();
        }
    }

    // The text that counts is what people read, not the HTML around it.
    private static IEnumerable<string> CheckCapitals(string? html)
    {
        var text = RichTextDocument.Parse(html).ToPlainText();
        if (text.Any(char.IsLetter) && text == text.ToUpperInvariant())
        {
            yield return "Write the description without all capitals.";
        }
    }
}
