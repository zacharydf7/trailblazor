<TbStack Gap="2" Style="max-inline-size: 24rem">
    <TbTextField Label="Add a stop" @bind-Value="_stop" OnEnter="Add" />
    <output>Stops: @string.Join(", ", _stops)</output>
</TbStack>

@code {
    private readonly List<string> _stops = ["Trailhead"];
    private string? _stop;

    private void Add()
    {
        if (!string.IsNullOrWhiteSpace(_stop))
        {
            _stops.Add(_stop.Trim());
            _stop = null;
        }
    }
}
