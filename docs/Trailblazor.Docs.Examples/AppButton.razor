@using Microsoft.AspNetCore.Components.Web

<TbButton @ref="_button" Variant="Variant" Tone="Tone" Type="Type" OnClick="OnClick" @attributes="AdditionalAttributes">
    @ChildContent
</TbButton>

@code {
    private TbButton _button = default!;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public Tone Tone { get; set; } = Tone.Neutral;

    [Parameter]
    public ButtonType Type { get; set; } = ButtonType.Button;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public ValueTask FocusAsync(bool preventScroll = false) => _button.FocusAsync(preventScroll);
}
