<TbStack Gap="4" Style="max-inline-size: 24rem">
    <TbTextField Label="Name" @bind-Value="_name" HelperText="As it appears on your badge." Required
                 RequiredMessage="Enter a name." />
    <TbTextField Label="Who should we call if your group is overdue returning from the trail?" @bind-Value="_contact"
                 HelperText="Someone who isn't on the trip." />
    <output>Name: @(_name ?? "(null until something is typed)")</output>
</TbStack>

@code {
    private string? _name;
    private string? _contact;
}
