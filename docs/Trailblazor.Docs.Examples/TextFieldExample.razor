@using Trailblazor.Docs.Examples

<TbStack Gap="5" Style="max-width: 24rem">
    <TbTextField Label="Name" @bind-Value="_name" HelperText="As it appears on your badge." Required
                 Validation="RequireName" data-testid="name" />
    <TbTextField Label="Search" @bind-Value="_search" Type="TextFieldType.Search" UpdateOnInput data-testid="search">
        <Start><TbIcon Icon="ExampleIcons.Plus" /></Start>
    </TbTextField>
    <output data-testid="search-echo">@_search</output>
    <TbTextField Label="Age" @bind-Value="_age" data-testid="age">
        <End>years</End>
    </TbTextField>
    <TbTextField Label="Handle" Value="@_handle" ValueChanged="(string? name) => ChangeHandle(name)"
                 Error="@_handleError" UpdateOnInput HelperText="Try robin, who already has an account." />
    <TbButton Variant="Variant.Outlined" OnClick="CheckHandle">Check the handle</TbButton>
    <TbTextField Label="Notes" @bind-Value="_notes" Lines="3" Placeholder="Anything we should know?" />
    <TbTextField Label="Account" Value="@("Read only")" Disabled />
</TbStack>

@code {
    private string? _name;
    private string? _search;
    private int _age = 30;
    private string? _notes;
    private string? _handle;
    private string? _handleError;

    private static IEnumerable<string> RequireName(string? name) =>
        string.IsNullOrWhiteSpace(name) ? ["Enter a name."] : [];

    // Stands in for asking a server, which answers with an error the field shows until the name changes.
    private void CheckHandle() => _handleError = _handle == "robin" ? "That handle is taken." : null;

    private void ChangeHandle(string? name)
    {
        _handle = name;
        _handleError = null;
    }
}
