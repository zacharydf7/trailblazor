<TbStack Gap="4">
    <TbRadioGroup Label="Current plan" @bind-Value="_plan" ReadOnly HelperText="Change it from billing.">
        <TbRadio Value="@("free")">Free</TbRadio>
        <TbRadio Value="@("hiker")">Hiker</TbRadio>
    </TbRadioGroup>
    <TbRadioGroup Label="Shipping" @bind-Value="_shipping" Disabled HelperText="Can't be focused, and doesn't post.">
        <TbRadio Value="@("standard")">Standard</TbRadio>
        <TbRadio Value="@("express")">Express</TbRadio>
    </TbRadioGroup>
</TbStack>

@code {
    private string _plan = "hiker";
    private string _shipping = "standard";
}
