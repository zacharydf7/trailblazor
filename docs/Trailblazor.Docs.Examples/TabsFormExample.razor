@* A form across tabs: every panel renders from the start, so saving checks them all, and a tab with a problem says
   so in its name and its look. *@
<TbForm OnValidSubmit="SaveTrip" OnInvalidSubmit="() => _checked = true" aria-label="Plan a trip"
        Style="max-inline-size: 24rem">
    <TbTabs AriaLabel="Trip plan" RenderAllPanels>
        <TbTab Text="@TabName("Leader", _leader)" HeaderClass="@AttentionClass(_leader)">
            <TbTextField Label="Leader's name" @bind-Value="_leader" Required />
        </TbTab>
        <TbTab Text="@TabName("Itinerary", _trail)" HeaderClass="@AttentionClass(_trail)">
            <TbTextField Label="Trail" @bind-Value="_trail" Required />
        </TbTab>
    </TbTabs>
    <TbButton Type="ButtonType.Submit">Save trip</TbButton>
    <TbText>@_tripStatus</TbText>
</TbForm>

@code {
    private string? _leader;
    private string? _trail;
    private bool _checked;
    private string? _tripStatus;

    private bool NeedsAttention(string? value) => _checked && string.IsNullOrWhiteSpace(value);

    private string TabName(string name, string? value) => NeedsAttention(value) ? $"{name} (needs attention)" : name;

    private string? AttentionClass(string? value) => NeedsAttention(value) ? "docs-tab-attention" : null;

    private void SaveTrip()
    {
        _checked = false;
        _tripStatus = $"Saved {_leader}'s trip on {_trail}.";
    }
}
