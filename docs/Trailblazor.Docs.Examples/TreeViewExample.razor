<TbStack Gap="3" Style="max-inline-size: 26rem">
    <TbTextField Label="Find a trail" @bind-Value="_search" @bind-Value:event="oninput" Clearable />
    <TbText>
        @(_opened is null ? "Double-click or press Enter on a trail to open it, or on a region to open or close it."
            : $"Opened {_opened}.")
    </TbText>
    <TbTreeView TItem="Place" TKey="int" AriaLabel="Trails by region" Items="Regions" KeySelector="place => place.Id"
                ChildrenSelector="place => place.Children" ItemText="place => place.Name"
                ItemIcon="place => place.Children is null ? ExampleIcons.Trail : ExampleIcons.Folder"
                IsSelectable="place => place.Children is null" InitialExpandDepth="1"
                Filter="@(string.IsNullOrWhiteSpace(_search) ? null : Matches)" @bind-SelectedKeys="_selected"
                OnActivate="Open">
        <ItemEnd>
            @if (context.Item.Children is { } trails)
            {
                <TbBadge Count="trails.Length" Label="@($"{trails.Length} trails")" Tone="Tone.Neutral" />
            }
        </ItemEnd>
    </TbTreeView>
    @* Rows written as markup, for a tree that is part of the page rather than data. *@
    <TbTreeView TItem="string" TKey="string" AriaLabel="Notifications" Checkable @bind-CheckedKeys="_notify"
                InitialExpandDepth="1">
        <TbTreeItem Text="Trips">
            <TbTreeItem Value="@("trips-new")" Text="New trails near me" />
            <TbTreeItem Value="@("trips-changed")" Text="Changes to saved trails" />
        </TbTreeItem>
        <TbTreeItem Value="@("weather")" Text="Weather alerts" />
    </TbTreeView>
    @* Rows that move by dragging, or with Alt+Shift and the arrows; the page applies each move to its own list. *@
    <TbTreeView @ref="_planTree" TItem="Stop" TKey="int" AriaLabel="Trip plan" Items="_plan"
                KeySelector="stop => stop.Id" ChildrenSelector="stop => stop.Children" ItemText="stop => stop.Name"
                InitialExpandDepth="1"
                OnDrop="Move" CanDrop="CheckMoveAsync">
        <InsertTemplate>
            <TbIconButton Icon="ExampleIcons.Plus" Size="Size.Small" OnClick="() => Add(context)"
                          AriaLabel="@(context.Parent is null ? $"Add a day at {context.Index + 1}"
                                          : $"Add a stop to {context.Parent.Name} at {context.Index + 1}")" />
        </InsertTemplate>
    </TbTreeView>
    @* Ten thousand rows, of which only those in view render; the arrows select as they move. *@
    <TbTreeView TItem="Place" TKey="int" AriaLabel="Trail atlas" Items="Atlas" KeySelector="place => place.Id"
                ChildrenSelector="place => place.Children" ItemText="place => place.Name" InitialExpandDepth="1"
                Virtualize Style="block-size: 20rem" SelectionFollowsFocus @bind-SelectedKeys="_atlasSelected" />
    <TbText>
        @(_atlasSelected.Count == 0 ? "Move through the atlas with the arrow keys."
            : $"Showing {AtlasNames[_atlasSelected.Single()]}.")
    </TbText>
</TbStack>

@code {
    private static readonly Place[] Regions =
    [
        new(1, "North ridge", [new(2, "Pine Hollow loop"), new(3, "Eagle Ridge traverse")]),
        new(4, "River valley", [new(5, "Cedar Flats"), new(6, "Fern Gully", [new(7, "Waterfall spur")])]),
        new(8, "High peaks", [new(9, "Summit Gate")]),
    ];

    // A hundred regions of a hundred trails each.
    private static readonly Place[] Atlas = [.. Enumerable.Range(1, 100).Select(region => new Place(region * 1000,
        $"Region {region}", [.. Enumerable.Range(1, 100).Select(trail =>
            new Place(region * 1000 + trail, $"Trail {region}.{trail}"))]))];

    private static readonly Dictionary<int, string> AtlasNames = Atlas
        .Concat(Atlas.SelectMany(region => region.Children!)).ToDictionary(place => place.Id, place => place.Name);

    private string? _search;
    private IReadOnlyCollection<int> _selected = [];
    private IReadOnlyCollection<int> _atlasSelected = [];
    private string? _opened;
    private IReadOnlyCollection<string> _notify = ["weather"];
    private readonly List<Stop> _plan =
    [
        new(1, "Day 1", [new(2, "Trailhead"), new(3, "Pine Hollow"), new(4, "Lake camp")]),
        new(5, "Day 2", [new(6, "Eagle Ridge"), new(7, "Summit Gate")]),
    ];

    private TbTreeView<Stop, int> _planTree = default!;
    private int _nextStop = 8;

    // A region opens and closes in place, so only a trail counts as opened.
    private void Open(Place place)
    {
        if (place.Children is null)
        {
            _opened = place.Name;
        }
    }

    private bool Matches(Place place) => place.Name.Contains(_search!, StringComparison.OrdinalIgnoreCase);

    private sealed record Place(int Id, string Name, Place[]? Children = null);

    // A day holds stops; a stop holds nothing.
    private sealed record Stop(int Id, string Name, List<Stop>? Children = null);

    private static Task<MoveCheck> CheckMoveAsync(TreeDrop<Stop> drop)
    {
        var days = drop.Items.Any(stop => stop.Children is not null);
        var inside = drop.Position == TreeDropPosition.Inside;
        var amongDays = drop.Target.Children is not null != inside;
        return Task.FromResult(inside && drop.Target.Children is null ? MoveCheck.Refuse("A stop can't hold stops.")
            : days && !amongDays ? MoveCheck.Refuse("A day can't go inside a day.")
            : !days && amongDays ? MoveCheck.Refuse("A stop belongs in a day.")
            : MoveCheck.Allow);
    }

    private void Move(TreeDrop<Stop> drop)
    {
        foreach (var stop in drop.Items)
        {
            ListOf(stop).Remove(stop);
        }

        var into = drop.Position == TreeDropPosition.Inside ? drop.Target.Children! : ListOf(drop.Target);
        var at = drop.Position switch
        {
            TreeDropPosition.Before => into.IndexOf(drop.Target),
            TreeDropPosition.After => into.IndexOf(drop.Target) + 1,
            _ => into.Count,
        };
        into.InsertRange(at, drop.Items);
    }

    // A slot among the days adds a day; one in a day adds a stop. The list changes in place, so refresh the tree.
    private Task Add(TreeInsertContext<Stop> insert)
    {
        var id = _nextStop++;
        (insert.Parent?.Children ?? _plan).Insert(insert.Index,
            insert.Parent is null ? new(id, $"Day {id}", []) : new(id, $"Stop {id}"));
        return _planTree.RefreshAsync();
    }

    private List<Stop> ListOf(Stop stop) =>
        _plan.Contains(stop) ? _plan : _plan.First(day => day.Children?.Contains(stop) == true).Children!;
}
