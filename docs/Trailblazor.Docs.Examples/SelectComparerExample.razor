<TbSelect Label="Saved trail" @bind-Value="_saved" Comparer="ById">
    @foreach (var trail in Trails)
    {
        <TbOption Value="trail">@trail.Name</TbOption>
    }
</TbSelect>

@code {
    private static readonly IEqualityComparer<Trail?> ById =
        EqualityComparer<Trail?>.Create((a, b) => a?.Id == b?.Id, trail => trail?.Id ?? 0);

    private static readonly Trail[] Trails = [new(1, "Ridge"), new(2, "Lake"), new(3, "Pass")];

    // Not an instance from Trails, as when the saved value comes from a query of its own.
    private Trail? _saved = new(2, "Lake");

    private sealed class Trail(int id, string name)
    {
        public int Id { get; } = id;

        public string Name { get; } = name;
    }
}
