<TbStack Gap="3">
    <TbMultiTreeSelect TItem="Area" TKey="string" Label="Regions" Items="Areas" KeySelector="area => area.Id"
                       ItemText="area => area.Name" ChildrenSelector="area => area.Children"
                       Placeholder="Choose regions" Filterable @bind-Value="_regions" />
    <output aria-label="Chosen regions">
        @(_regions.Count == 0 ? "No regions chosen." : $"Chosen: {string.Join(", ", _regions)}.")
    </output>
</TbStack>

@code {
    private static readonly Area[] Areas =
    [
        new("coast", "Coast", [new("bay", "Harbor bay"), new("dunes", "Sand dunes")]),
        new("forest", "Forest", [new("birch", "Birch wood"), new("spruce", "Spruce stand")]),
        new("uplands", "Uplands", [new("moor", "Open moor")]),
    ];

    private IReadOnlyList<string> _regions = [];

    private sealed record Area(string Id, string Name, IReadOnlyList<Area>? Children = null);
}
