@* Three marks of the app's own, each with its toolbar button: a keyboard key, written as kbd, with an icon and
   keys of its own; a variable, written as var; and an aside, written as a span that this page's style gives a look. *@
<TbStack Gap="3" Style="max-inline-size: 36rem">
    <TbRichTextEditor Label="Shortcut guide" @bind-Value="_guide" Marks="Marks"
                      HelperText="Select a key's name and press the Keyboard key button, or Alt+Shift+K." />
</TbStack>

<style>
    [data-tb-mark="aside"] {
        color: var(--tb-color-text-muted);
        font-style: italic;
    }
</style>

@code {
    private static readonly Icon Key = new("<rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\" fill=\"none\" "
        + "stroke=\"currentColor\" stroke-width=\"2\" /><path d=\"M7 10h2M11 10h2M15 10h2M8 14h8\" fill=\"none\" "
        + "stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" />");

    private static readonly RichTextMark[] Marks =
    [
        new("kbd") { Label = "Keyboard key", Icon = Key, Shortcut = "Alt+Shift+K" },
        new("var") { Label = "Variable" }, new("aside") { Label = "Aside" },
    ];

    private string? _guide = "<p>Press <kbd>Ctrl</kbd> and <kbd>S</kbd> to save <var>file</var> "
        + "<span data-tb-mark=\"aside\">(or Cmd on a Mac)</span>.</p>";
}
