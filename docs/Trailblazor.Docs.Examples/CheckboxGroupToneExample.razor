<TbStack Gap="4">
    <TbCheckboxGroup Label="Packed" @bind-Value="_packed" Tone="Tone.Success" Size="Size.Small">
        <TbCheckboxItem Value="@("tent")">Tent</TbCheckboxItem>
        <TbCheckboxItem Value="@("stove")">Stove</TbCheckboxItem>
    </TbCheckboxGroup>
    <TbCheckboxGroup Label="Hazards" @bind-Value="_hazards" Tone="Tone.Warning" Size="Size.Large">
        <TbCheckboxItem Value="@("ice")">Ice</TbCheckboxItem>
        <TbCheckboxItem Value="@("rockfall")">Rockfall</TbCheckboxItem>
    </TbCheckboxGroup>
</TbStack>

@code {
    private IReadOnlyList<string> _packed = ["tent"];
    private IReadOnlyList<string> _hazards = ["ice"];
}
