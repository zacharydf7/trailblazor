<TbStack Gap="2">
    <TbDateRangePicker TDate="DateTime" Label="Created between" @bind-Value="_created" />
    <output>
        Created between value: <span class="tb-text-nowrap">@_created.Start?.ToString("s")</span> to
        <span class="tb-text-nowrap">@_created.End?.ToString("s")</span>
    </output>
</TbStack>

@code {
    private DateRange<DateTime> _created = new(new DateTime(2026, 6, 1, 8, 30, 0), new DateTime(2026, 6, 30));
}
