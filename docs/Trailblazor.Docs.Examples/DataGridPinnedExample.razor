<TbStack Gap="3">
    @* A grid in a narrow panel, whose rows are wider than it. *@
    <TbDataGrid TItem="Trail" Items="Trails" AriaLabel="Trail log" KeySelector="trail => trail.Id"
                SelectionMode="SelectionMode.Multiple" Striped Style="max-inline-size: 40rem">
        <TbColumn Field="trail => trail.Name" Pinned="ColumnPin.Start" />
        <TbColumn Field="trail => trail.Region" />
        <TbColumn Field="trail => trail.LengthKm" Title="Length (km)" Format="N1" />
        <TbColumn Field="trail => trail.ClimbM" Title="Climb (m)" />
        <TbColumn Field="trail => trail.HighPointM" Title="High point (m)" />
        <TbColumn Field="trail => trail.LastHiked" Format="d" />
        <TbColumn Field="trail => trail.Season" />
        <TbColumn Field="trail => trail.Surface" />
        <TbColumn Field="trail => trail.Dogs" />
        <TbColumn Title="Details" Id="details" Pinned="ColumnPin.End">
            <Cell>
                <TbButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _shown = context.Name"
                          aria-label="@($"Details for {context.Name}")">Details</TbButton>
            </Cell>
        </TbColumn>
    </TbDataGrid>
    <output aria-label="Trail open">@(_shown is null ? "No trail open." : $"Showing {_shown}.")</output>
</TbStack>

@code {
    private static readonly Trail[] Trails =
    [
        new(1, "Pine Hollow loop", "North ridge", 6.4, 310, 1240, new(2026, 5, 2), "Spring to fall", "Dirt",
            "On leash"),
        new(2, "Eagle Ridge traverse", "North ridge", 14.2, 1120, 2380, new(2026, 6, 14), "Summer", "Rock", "No"),
        new(3, "Cedar Flats", "River valley", 3.1, 40, 420, new(2026, 4, 20), "All year", "Gravel", "Yes"),
        new(4, "Fern Gully", "River valley", 5.8, 220, 610, new(2026, 7, 4), "Spring to fall", "Dirt", "On leash"),
        new(5, "Summit Gate", "High peaks", 11.9, 980, 2950, new(2026, 8, 9), "Summer", "Rock", "No"),
    ];

    private string? _shown;

    private sealed record Trail(int Id, string Name, string Region, double LengthKm, int ClimbM, int HighPointM,
        DateOnly LastHiked, string Season, string Surface, string Dogs);
}
