@using Trailblazor.Docs.Examples

<div style="display: flex; align-items: center; gap: var(--tb-space-2)">
    <TbIconButton Icon="ExampleIcons.Trash" AriaLabel="Delete" Size="Size.Small" />
    <TbIconButton Icon="ExampleIcons.Trash" AriaLabel="Delete" />
    <TbIconButton Icon="ExampleIcons.Trash" AriaLabel="Delete" Size="Size.Large" />
    <TbIconButton Icon="ExampleIcons.Plus" AriaLabel="Add" Variant="Variant.Filled" Tone="Tone.Primary" />
    <TbIconButton Icon="ExampleIcons.Close" AriaLabel="Remove" Variant="Variant.Soft" Tone="Tone.Danger" />
    <TbIconButton Icon="ExampleIcons.Check" AriaLabel="Confirm" Disabled />
    <TbIconButton Icon="ExampleIcons.Bell" AriaLabel="Notifications" @bind-Pressed="_notify" />
</div>

@code {
    private bool _notify = true;
}
