<TbStack Gap="4">
    <TbAutocomplete @bind-Value="_style" Label="Map style" Items="Styles" Variant="FieldVariant.Filled" />
    <TbAutocomplete @bind-Value="_units" Label="Units" Items="Units" Size="Size.Small" />
    <TbAutocomplete @bind-Value="_type" Label="Trail type" Items="Types" Size="Size.Large" />
</TbStack>

@code {
    private static readonly string[] Styles = ["Topographic", "Satellite"];
    private static readonly string[] Units = ["Metric", "Imperial"];
    private static readonly string[] Types = ["Loop", "Point to point"];

    private string? _style = "Topographic";
    private string? _units = "Metric";
    private string? _type = "Loop";
}
