<TbDataGrid TItem="Region" DataProvider="LoadRegionsAsync" PageSize="3" AriaLabel="Regions by page"
            KeySelector="region => region.Id" LoadChildren="LoadParksAsync" HasChildren="region => region.HasParks">
    <TbColumn Field="region => region.Name" Sortable />
    <TbColumn Field="region => region.Trails" Sortable />
</TbDataGrid>

@code {
    // Stands in for a server that sorts and pages the regions, and lists each one's parks.
    private static readonly Region[] Regions =
    [
        new(1, "North ridge", 14, true), new(2, "River valley", 9, true), new(3, "Coastal cliffs", 11, true),
        new(4, "High desert", 6, true), new(5, "Lake country", 12, true),
    ];

    private static Task<GridResult<Region>> LoadRegionsAsync(GridRequest request, CancellationToken cancel)
    {
        IEnumerable<Region> sorted = Regions;
        if (request.Sorts.FirstOrDefault() is { } sort)
        {
            Func<Region, object> key = sort.Column == "Trails" ? region => region.Trails : region => region.Name;
            sorted = sort.Direction == SortDirection.Descending ? sorted.OrderByDescending(key) : sorted.OrderBy(key);
        }

        List<Region> page = [.. sorted.Skip(request.StartIndex).Take(request.Count ?? Regions.Length)];
        return Task.FromResult(new GridResult<Region>(page, Regions.Length));
    }

    private static async Task<IEnumerable<Region>> LoadParksAsync(Region region, CancellationToken cancel)
    {
        await Task.Delay(600, cancel);
        return [new(region.Id * 100 + 1, $"{region.Name} park", region.Trails / 2, false),
            new(region.Id * 100 + 2, $"{region.Name} forest", region.Trails - region.Trails / 2, false)];
    }

    private sealed record Region(int Id, string Name, int Trails, bool HasParks);
}
