<TbStack Row Gap="4" Align="Align.Center">
    <TbMenu Label="View">
        <TbMenuGroup Label="Show">
            <TbMenuCheckboxItem @bind-Checked="_showMap">Map</TbMenuCheckboxItem>
            <TbMenuCheckboxItem @bind-Checked="_showElevation">Elevation</TbMenuCheckboxItem>
        </TbMenuGroup>
        <TbMenuSeparator />
        <TbMenuRadioGroup Label="Units" @bind-Value="_units">
            <TbMenuRadioItem Value="@("Miles")">Miles</TbMenuRadioItem>
            <TbMenuRadioItem Value="@("Kilometers")">Kilometers</TbMenuRadioItem>
        </TbMenuRadioGroup>
    </TbMenu>
    <output aria-label="View state">@_units@(_showMap ? ", map" : "")@(_showElevation ? ", elevation" : "")</output>
</TbStack>

@code {
    private bool _showMap = true;
    private bool _showElevation;
    private string? _units = "Miles";
}
