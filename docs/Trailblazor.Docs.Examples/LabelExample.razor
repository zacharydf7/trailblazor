<TbStack Gap="1">
    <TbLabel For="project-code" Text="Project code" Info="@ProjectCodeInfo" />
    <TbTextField id="project-code" @bind-Value="_code" />
</TbStack>

@code {
    private const string ProjectCodeInfo =
        "The code on the order form, such as PRJ-2041.\nCodes aren't case sensitive.";

    private string? _code;
}
