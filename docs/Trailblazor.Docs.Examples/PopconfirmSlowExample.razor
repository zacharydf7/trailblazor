<TbStack Row Gap="2" Align="Align.Center">
    <TbText>Cedar Flats</TbText>
    <TbPopconfirm Label="Archive Cedar Flats" Icon="ExampleIcons.Folder" Variant="Variant.Text"
                  Title="Archive Cedar Flats?" Description="It leaves the map until you restore it."
                  ConfirmText="Archive" OnConfirm="ArchiveAsync" />
    <output>@_status</output>
</TbStack>

@code {
    private string _status = "";

    // Stands in for a call to the server.
    private async Task ArchiveAsync()
    {
        await Task.Delay(800);
        _status = "Archived.";
    }
}
