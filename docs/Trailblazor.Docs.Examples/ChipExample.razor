<TbChipGroup AriaLabel="Selected tags">
    @foreach (var tag in _tags)
    {
        <TbChip @key="tag" Text="@tag" OnClose="() => RemoveAsync(tag)" />
    }
</TbChipGroup>

@code {
    private readonly List<string> _tags = ["Invoices", "Archive", "2026"];

    private async Task RemoveAsync(string tag)
    {
        // A real app would save the change here.
        await Task.Delay(100);
        _tags.Remove(tag);
    }
}
