@using Microsoft.AspNetCore.Components.Forms

<TbStack Gap="3" Style="max-inline-size: 28rem">
    <TbSwitch @bind-Value="_failing" Label="Make the uploads fail" />
    <TbFileUpload Label="Trip photos" Multiple Accept="image/*" MaxFileSize="MaxSize" Upload="SendAsync"
                  OnUploaded="file => _sent.Add(file.Name)" HelperText="Images, each up to 10 MB." />
    <output>@(_sent.Count == 0 ? "Nothing sent yet." : $"Sent: {string.Join(", ", _sent)}.")</output>
</TbStack>

@code {
    private const long MaxSize = 10_000_000;
    private readonly List<string> _sent = [];
    private bool _failing;

    // Stands in for sending to storage: reads the file in chunks, pausing after each so the progress shows.
    private async Task SendAsync(IBrowserFile file, IProgress<long> progress, CancellationToken stop)
    {
        await using var stream = file.OpenReadStream(MaxSize, stop);
        var buffer = new byte[Math.Max(16_384, file.Size / 25)];
        var sent = 0L;
        int read;
        while ((read = await stream.ReadAsync(buffer, stop)) > 0)
        {
            sent += read;
            progress.Report(sent);
            if (_failing && sent >= file.Size / 2)
            {
                throw new IOException("The storage service didn't answer.");
            }

            await Task.Delay(40, stop);
        }
    }
}
