<TbStack Gap="4" Style="max-inline-size: 22rem">
    <TbColorPicker Label="Trail marker" @bind-Value="_marker" Palette="Markers" SwatchName="NameOf" Clearable
                   HelperText="Pick a marker color, type a hex color, or open the picker." />
    <TbColorPicker Label="Map overlay" @bind-Value="_overlay" Alpha />
    <TbText>Marker @(_marker ?? "not chosen") over a @_overlay overlay.</TbText>
</TbStack>

@code {
    private static readonly string[] Markers = ["#1f6feb", "#d1242f", "#f2c037", "#2da44e", "#8250df"];

    private string? _marker = "#1f6feb";
    private string? _overlay = "#2da44e66";

    private static string NameOf(string color) => color switch
    {
        "#1f6feb" => "Blue blaze",
        "#d1242f" => "Red blaze",
        "#f2c037" => "Yellow blaze",
        "#2da44e" => "Green blaze",
        _ => "Purple blaze",
    };
}
