<TbStack Gap="2">
    <TbColorPicker Label="Trail marker" @bind-Value="_marker" Palette="Markers" SwatchName="NameOf"
                   HelperText="Pick a marker color, type a hex color, or open the picker." />
    <output>Trail marker value: @(_marker ?? "null")</output>
</TbStack>

@code {
    private static readonly string[] Markers = ["#1f6feb", "#d1242f", "#f2c037", "#2da44e", "#8250df"];

    private string? _marker = "#1f6feb";

    private static string NameOf(string color) => color switch
    {
        "#1f6feb" => "Blue blaze",
        "#d1242f" => "Red blaze",
        "#f2c037" => "Yellow blaze",
        "#2da44e" => "Green blaze",
        _ => "Purple blaze",
    };
}
