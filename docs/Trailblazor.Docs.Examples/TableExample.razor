<TbTable Striped aria-label="Opening hours">
    <thead>
        <tr>
            <th scope="col">Visitor center</th>
            <th scope="col">Weekdays</th>
            <th scope="col">Weekends</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">North ridge</th>
            <td>9:00–17:00</td>
            <td>8:00–19:00</td>
        </tr>
        <tr>
            <th scope="row">River valley</th>
            <td>10:00–16:00</td>
            <td>9:00–18:00</td>
        </tr>
        <tr>
            <th scope="row">High peaks</th>
            <td>Closed</td>
            <td>9:00–15:00</td>
        </tr>
    </tbody>
</TbTable>

@* A long log scrolls in a set height and keeps its header in view. The scroll area takes focus, so keyboard users
   can scroll it too. *@
<div role="region" aria-label="Trail log" tabindex="0"
     style="max-block-size: 14rem; overflow: auto; margin-block-start: var(--tb-space-8)">
    <TbTable StickyHeader Size="Size.Small" aria-label="Trail log entries">
        <thead>
            <tr>
                <th scope="col">Day</th>
                <th scope="col">Trail</th>
                <th scope="col">Hikers</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in Enumerable.Range(1, 20))
            {
                <tr>
                    <th scope="row">June @day</th>
                    <td>@(day % 3 == 0 ? "Cedar Flats" : day % 2 == 0 ? "Pine Hollow" : "Eagle Ridge")</td>
                    <td>@(4 + day * 7 % 23)</td>
                </tr>
            }
        </tbody>
    </TbTable>
</div>
