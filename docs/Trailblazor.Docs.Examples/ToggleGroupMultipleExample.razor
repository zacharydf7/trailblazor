<TbStack Gap="2">
    <TbMultiToggleGroup @bind-Value="_seasons" AriaLabel="Seasons open">
        <TbToggleItem Value="@("Spring")" Text="Spring" />
        <TbToggleItem Value="@("Summer")" Text="Summer" />
        <TbToggleItem Value="@("Fall")" Text="Fall" />
    </TbMultiToggleGroup>
    <TbText>Open in: @(_seasons.Count == 0 ? "no season" : string.Join(", ", _seasons))</TbText>
</TbStack>

@code {
    private IReadOnlyList<string> _seasons = ["Summer"];
}
