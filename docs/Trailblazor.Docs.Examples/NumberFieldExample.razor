<TbStack Gap="4" Style="max-inline-size: 24rem">
    <TbNumberField Label="Quantity" @bind-Value="_quantity" Min="0" Max="10" HelperText="From 0 to 10." />
    <output>Quantity value: @_quantity</output>
    <TbNumberField Label="Weight" @bind-Value="_weight" Step="0.25m" HelperText="In kilograms, a quarter at a time." />
</TbStack>

@code {
    private int _quantity = 1;
    private double _weight = 2.5;
}
