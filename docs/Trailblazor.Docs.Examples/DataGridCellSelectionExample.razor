<TbDataGrid TItem="Trail" Items="_trails" AriaLabel="Trail lengths" KeySelector="trail => trail.Id" CellSelection>
    <TbColumn Field="trail => trail.Name" />
    <TbColumn Field="trail => trail.Region" />
    <TbColumn Field="trail => trail.LengthKm" Title="Length (km)" Format="0.0" />
    <TbColumn Field="trail => trail.ClimbM" Title="Climb (m)" />
</TbDataGrid>

@code {
    private readonly Trail[] _trails =
    [
        new(1, "Pine Hollow", "North ridge", 6.5, 320),
        new(2, "Eagle Ridge", "North ridge", 14, 910),
        new(3, "Cedar Flats", "River valley", 3.2, 40),
        new(4, "Fern Gully", "River valley", 8.1, 260),
    ];

    public sealed record Trail(int Id, string Name, string Region, double LengthKm, int ClimbM);
}
