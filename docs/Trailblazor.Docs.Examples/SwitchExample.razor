<TbStack Gap="4" Style="max-inline-size: 24rem">
    <TbSwitch Label="Auto-save" @bind-Value="_autoSave" HelperText="Saves each change as you make it." />
    <output>Auto-save value: @_autoSave</output>
    <TbSwitch Label="Dim the screen after one minute of inactivity, and turn the screen off after five minutes"
              @bind-Value="_dim" />
</TbStack>

@code {
    private bool _autoSave = true;
    private bool _dim;
}
