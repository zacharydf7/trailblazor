    <TbCheckboxItem Value="@("lamp")">Head lamp</TbCheckboxItem>
    <TbCheckboxItem Value="@("kit")">First-aid kit <TbBadge>Recommended</TbBadge></TbCheckboxItem>
</TbCheckboxGroup>

@code {
    private IReadOnlyList<string> _gear = ["kit"];
}
