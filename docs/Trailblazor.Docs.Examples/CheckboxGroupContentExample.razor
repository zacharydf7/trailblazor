<TbCheckboxGroup Label="Gear to carry" @bind-Value="_gear">
    <TbCheckboxItem Value="@("map")" Text="Map" />
    <TbCheckboxItem Value="@("lamp")" Text="Head lamp" />
    <TbCheckboxItem Value="@("kit")" Text="First-aid kit">
        First-aid kit <TbChip Text="Recommended" Size="Size.Small" />
    </TbCheckboxItem>
</TbCheckboxGroup>

@code {
    private IReadOnlyList<string> _gear = ["kit"];
}
