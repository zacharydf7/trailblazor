@using Microsoft.AspNetCore.Components.Forms

<TbStack Gap="2">
    <TbFileUpload Label="Trail maps" @bind-Value="_maps" Accept=".pdf,image/*" Multiple
                  HelperText="PDFs or images, each up to 512 KB." />
    <output>Trail maps value: @(_maps is null ? "null" : string.Join(", ", _maps.Select(map => map.Name)))</output>
</TbStack>

@code {
    private IReadOnlyList<IBrowserFile>? _maps;
}
