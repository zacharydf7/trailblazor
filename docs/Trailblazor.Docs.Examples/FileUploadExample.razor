@using Microsoft.AspNetCore.Components.Forms

<TbStack Gap="4" Style="max-inline-size: 28rem">
    <TbFileUpload Label="Trail maps" @bind-Value="_maps" Accept=".pdf,image/*" Multiple MaxFiles="5"
                  HelperText="PDFs or images, up to five." />
    <TbFileUpload Label="Gear list" @bind-Value="_gear" Accept=".json" DropZone="false" />
    <TbText>@Summary</TbText>
</TbStack>

@code {
    private IReadOnlyList<IBrowserFile>? _maps;
    private IReadOnlyList<IBrowserFile>? _gear;

    private string Summary => $"{_maps?.Count ?? 0} maps and {(_gear is null ? "no gear list" : _gear[0].Name)}.";
}
