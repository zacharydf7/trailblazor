<TbSelect Label="Route" @bind-Value="_route">
    <TbOption Value="@("loop")">
        <TbStack Row Gap="2">Lake loop <TbChip Text="Easy" Size="Size.Small" /></TbStack>
    </TbOption>
    <TbOption Value="@("summit")">
        <TbStack Row Gap="2">Summit trail <TbChip Text="Hard" Size="Size.Small" Tone="Tone.Warning" /></TbStack>
    </TbOption>
</TbSelect>

@code {
    private string? _route = "loop";
}
