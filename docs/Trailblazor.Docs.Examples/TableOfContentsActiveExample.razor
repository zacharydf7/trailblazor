<TbStack Gap="2">
    <TbTableOfContents AriaLabel="Packing guide" ActiveKeyChanged="active => _active = active">
        <TbTableOfContentsItem TargetId="packing-shelter" Text="Shelter" />
        <TbTableOfContentsItem TargetId="packing-food" Text="Food" />
    </TbTableOfContents>
    <TbText>
        Section in view:
        <output aria-label="Section in view">@(Titles.GetValueOrDefault(_active ?? "") ?? "none")</output>
    </TbText>
    <div role="region" aria-label="Packing notes" tabindex="0" class="tb-px-3 tb-py-2"
         style="block-size: 8rem; max-inline-size: 34rem; overflow: auto; border: 1px solid var(--tb-border-strong);
                border-radius: var(--tb-radius-md)">
        <TbStack Gap="2">
            <TbText TextStyle="TextStyle.Title" As="TextElement.H3" id="packing-shelter">Shelter</TbText>
            <TbText>Bring a tent that stands up to wind, since the ridge has no trees to break it. Pack a ground sheet
                too, and a spare guy line in case one snaps.</TbText>
            <TbText TextStyle="TextStyle.Title" As="TextElement.H3" id="packing-food">Food</TbText>
            <TbText>Plan on three thousand calories a day, and carry one extra meal in case the weather holds you
                up.</TbText>
            <TbText>Keep it all in the bear boxes overnight.</TbText>
        </TbStack>
    </div>
</TbStack>

@code {
    private static readonly Dictionary<string, string> Titles =
        new() { ["packing-shelter"] = "Shelter", ["packing-food"] = "Food" };

    private string? _active;
}
