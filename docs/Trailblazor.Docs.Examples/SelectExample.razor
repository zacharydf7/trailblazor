<TbStack Gap="2">
    <TbSelect Label="Shipping" @bind-Value="_shipping" Placeholder="Choose a speed"
              HelperText="Express ships the same day.">
        <TbOption Value="Speed.Standard">Standard (3-5 days)</TbOption>
        <TbOption Value="Speed.Express">Express (1 day)</TbOption>
        <TbOption Value="Speed.Overnight" Disabled>Overnight</TbOption>
    </TbSelect>
    <output>Shipping value: @(_shipping?.ToString() ?? "null")</output>
</TbStack>

@code {
    private Speed? _shipping;

    private enum Speed
    {
        Standard,
        Express,
        Overnight,
    }
}
