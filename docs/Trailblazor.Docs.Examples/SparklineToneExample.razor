        Rescues a month
        <TbSparkline Values="Rescues" Tone="Tone.Danger" AriaLabel="Rescues a month this year, rising since May" />
    </TbText>
    <TbText>
        Huts booked
        <TbSparkline Values="Booked" Color="var(--tb-chart-series-5)" Width="10rem" Height="2rem"
                     AriaLabel="Huts booked a month this year, highest in July" />
