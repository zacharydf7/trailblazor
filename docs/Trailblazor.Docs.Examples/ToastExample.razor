@inject IToastService Toasts

<TbStack Row Gap="2" Wrap>
    <TbButton OnClick='() => Toasts.Show("Report saved", Tone.Success)'>Save report</TbButton>
    <TbButton Variant="Variant.Outlined" OnClick='() => Toasts.Show("A new trail was added", Tone.Info)'>
        Add a trail
    </TbButton>
    <TbButton Variant="Variant.Outlined" Tone="Tone.Warning"
              OnClick='() => Toasts.Show("Snow is forecast", Tone.Warning)'>
        Check the forecast
    </TbButton>
</TbStack>
