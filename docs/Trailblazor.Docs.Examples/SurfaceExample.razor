@foreach (var elevation in Enum.GetValues<Elevation>())
{
    <TbSurface Elevation="elevation" Style="padding: var(--tb-space-4); margin-block-end: var(--tb-space-4)">
        <TbText>@elevation elevation</TbText>
    </TbSurface>
}

<TbSurface Elevation="Elevation.None" Outlined Style="padding: var(--tb-space-4)">
    <TbText>Outlined, no elevation</TbText>
</TbSurface>
