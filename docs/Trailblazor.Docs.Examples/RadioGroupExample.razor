<TbStack Gap="4">
    <TbRadioGroup Label="Paper size" @bind-Value="_paper" HelperText="Used for the next print run.">
        <TbRadio Value="@("Letter")">Letter</TbRadio>
        <TbRadio Value="@("A4")">A4</TbRadio>
        <TbRadio Value="@("Legal")" Disabled>Legal (out of stock)</TbRadio>
    </TbRadioGroup>
    <output>Paper size value: @_paper</output>
</TbStack>

@code {
    private string _paper = "Letter";
}
