<TbGrid>
    <TbGridItem SpanMd="6">
        <TbSurface Outlined class="tb-p-3"><TbText>Full width, half from medium up</TbText></TbSurface>
    </TbGridItem>
    <TbGridItem SpanMd="6">
        <TbSurface Outlined class="tb-p-3"><TbText>Full width, half from medium up</TbText></TbSurface>
    </TbGridItem>
    @for (var i = 1; i <= 4; i++)
    {
        <TbGridItem Span="6" SpanLg="3">
            <TbSurface Outlined class="tb-p-3"><TbText>Quarter @i</TbText></TbSurface>
        </TbGridItem>
    }
</TbGrid>
