<TbGrid>
    <TbGridItem SpanMd="6">
        <TbSurface Outlined class="tb-p-3"><TbText>Full width, half from medium up</TbText></TbSurface>
    </TbGridItem>
    <TbGridItem SpanMd="6">
        <TbSurface Outlined class="tb-p-3"><TbText>Full width, half from medium up</TbText></TbSurface>
    </TbGridItem>
    @foreach (var quarter in Enumerable.Range(1, 4))
    {
        <TbGridItem Span="6" SpanLg="3">
            <TbSurface Outlined class="tb-p-3"><TbText>Quarter @quarter</TbText></TbSurface>
        </TbGridItem>
    }
</TbGrid>
