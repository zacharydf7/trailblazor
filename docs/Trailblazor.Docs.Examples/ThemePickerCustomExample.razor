@implements IDisposable
@inject IThemeService Theme

<TbRadioGroup TValue="ThemeMode" Label="Page colors" Value="Theme.Mode" ValueChanged="Theme.SetModeAsync" Segmented>
    <TbRadio Value="ThemeMode.Light">Light</TbRadio>
    <TbRadio Value="ThemeMode.Dark">Dark</TbRadio>
    <TbRadio Value="ThemeMode.System">Match the device</TbRadio>
</TbRadioGroup>

@code {
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    // Reads the remembered choice, which only an interactive page can do.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            await Theme.LoadAsync();
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
