<TbStack Gap="4" Style="max-inline-size: 24rem">
    <TbCheckbox Label="Email me updates" @bind-Value="_updates" HelperText="About once a month." />
    <output>Updates value: @_updates</output>
    <TbCheckbox Label="Send a reminder the evening before each trip, with the forecast and the meeting point"
                @bind-Value="_reminder" />
</TbStack>

@code {
    private bool _updates;
    private bool _reminder = true;
}
