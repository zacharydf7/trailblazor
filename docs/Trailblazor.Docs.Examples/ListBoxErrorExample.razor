<TbStack Gap="2">
    <TbListBox TValue="string" Label="Start day" Rows="2" Value="@_day" ValueChanged="ChangeDay" Error="@_error">
        <TbOption Value="@("Friday")" />
        <TbOption Value="@("Saturday")" />
    </TbListBox>
    <TbStack Row>
        <TbButton Variant="Variant.Outlined" OnClick="CheckDay">Check the day</TbButton>
    </TbStack>
</TbStack>

@code {
    private string? _day = "Saturday";
    private string? _error;

    private void ChangeDay(string? day)
    {
        _day = day;
        _error = null;
    }

    // Stands in for asking a server, which answers with an error the list box shows until the day changes.
    private void CheckDay() => _error = _day == "Saturday" ? "Saturday is fully booked." : null;
}
