<TbForm @ref="_form" aria-label="Trip">
    <TbTransferList TItem="Hiker" Label="Trip leaders" Items="Hikers" ItemText="hiker => hiker.Name" Required
                    Labels="@(new() { Available = "Guides", Chosen = "Leading" })" @bind-Value="_crew" />
</TbForm>

@code {
    private static readonly Hiker[] Hikers = [new(1, "Avery"), new(2, "Blake"), new(3, "Casey"), new(4, "Devon")];

    private TbForm _form = default!;
    private IReadOnlyList<Hiker> _crew = [];

    // Only so this demo shows its message on load; a real form waits for a submit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _form.ValidateAsync();
        }
    }

    private sealed record Hiker(int Id, string Name);
}
