@using Trailblazor.Docs.Examples

@foreach (var variant in Enum.GetValues<Variant>())
{
    <div style="display: flex; flex-wrap: wrap; gap: var(--tb-space-2); margin-block-end: var(--tb-space-3)">
        @foreach (var tone in Enum.GetValues<Tone>())
        {
            <TbButton Variant="variant" Tone="tone">@variant @tone</TbButton>
        }
    </div>
}

<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--tb-space-2)">
    <TbButton Size="Size.Small">Small</TbButton>
    <TbButton>Medium</TbButton>
    <TbButton Size="Size.Large">Large</TbButton>
    <TbButton StartIcon="ExampleIcons.Plus">Add item</TbButton>
    <TbButton Disabled>Disabled</TbButton>
    <TbButton Loading>Saving</TbButton>
    <TbButton data-testid="counter" OnClick="() => _clicks++">Clicked @_clicks times</TbButton>
</div>

<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--tb-space-2);
            margin-block-start: var(--tb-space-3)">
    <TbButton Href="guides/theming" Variant="Variant.Outlined">Read the theming guide</TbButton>
    <TbButton @bind-Pressed="_pinned" Variant="Variant.Outlined">Pin to top</TbButton>
    <TbTooltip Text="Add a title before publishing">
        <TbButton Variant="Variant.Filled" Tone="Tone.Primary" Disabled FocusableWhenDisabled>Publish</TbButton>
    </TbTooltip>
</div>

@code {
    private int _clicks;
    private bool _pinned;
}
