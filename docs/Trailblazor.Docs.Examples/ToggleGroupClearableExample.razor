<TbStack Gap="2">
    <TbToggleGroup @bind-Value="_units" AriaLabel="Distance units" Clearable>
        <TbToggleItem Value="@("Miles")" Text="Miles" />
        <TbToggleItem Value="@("Kilometers")" Text="Kilometers" />
    </TbToggleGroup>
    <TbText>Units: @(_units ?? "none")</TbText>
</TbStack>

@code {
    private string? _units;
}
