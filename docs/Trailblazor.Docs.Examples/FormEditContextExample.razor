@using Microsoft.AspNetCore.Components.Forms

<TbForm @ref="_form" EditContext="_context" OnValidSubmit="Save" aria-label="Meeting plan"
        Style="max-inline-size: 24rem">
    <TbTextField Label="Meeting point" @bind-Value="_plan.MeetingPoint" Required
                 RequiredMessage="Enter a meeting point." />
    <TbStack Row Gap="2">
        <TbButton Type="ButtonType.Submit">Save plan</TbButton>
        <TbButton Variant="Variant.Outlined" Tone="Tone.Neutral" OnClick="UndoAsync">Undo changes</TbButton>
    </TbStack>
    <output>@(_context.IsModified() ? "You have unsaved changes." : $"Saved: {_savedPoint}.")</output>
</TbForm>

@code {
    private readonly Plan _plan = new() { MeetingPoint = "North trailhead" };
    private TbForm _form = default!;
    private EditContext _context = default!;
    private string? _savedPoint;

    protected override void OnInitialized()
    {
        _savedPoint = _plan.MeetingPoint;
        _context = new(_plan);
    }

    private void Save()
    {
        _savedPoint = _plan.MeetingPoint;
        _context.MarkAsUnmodified();
    }

    private async Task UndoAsync()
    {
        _plan.MeetingPoint = _savedPoint;
        _context.MarkAsUnmodified();
        await _form.ResetValidationAsync();
    }

    private sealed class Plan
    {
        public string? MeetingPoint { get; set; }
    }
}
