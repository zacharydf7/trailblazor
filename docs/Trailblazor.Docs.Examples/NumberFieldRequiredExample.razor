<TbForm @ref="_form" aria-label="Group size" Style="max-inline-size: 24rem">
    <TbNumberField Label="How many people, including the leader, are going on this trip?" @bind-Value="_people" Required
                   RequiredMessage="Enter how many are going." />
</TbForm>

@code {
    private TbForm _form = default!;
    private int? _people;

    // Only so this demo shows its message on load; a real form waits for a submit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _form.ValidateAsync();
        }
    }
}
