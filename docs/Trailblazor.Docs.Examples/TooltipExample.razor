@using Trailblazor.Docs.Examples

<TbStack Row Gap="2" Align="Align.Center" Wrap Style="padding-block: var(--tb-space-10)">
    <TbTooltip Text="Add an item">
        <TbIconButton Icon="ExampleIcons.Plus" AriaLabel="Add" />
    </TbTooltip>
    <TbTooltip Text="Delete the selection">
        <TbIconButton Icon="ExampleIcons.Trash" AriaLabel="Delete" />
    </TbTooltip>
    <TbTooltip Text="Shown below the button" Placement="Placement.Bottom">
        <TbButton Variant="Variant.Outlined">Below</TbButton>
    </TbTooltip>
    <TbTooltip Placement="Placement.Bottom" Align="PlacementAlign.Start" ShowArrow>
        <TextContent>Saves a copy of the trail <kbd>Ctrl+S</kbd></TextContent>
        <ChildContent>
            <TbButton Variant="Variant.Outlined">Save</TbButton>
        </ChildContent>
    </TbTooltip>
</TbStack>
