<TbStack Gap="2">
    <TbToggleGroup @bind-Value="_view" AriaLabel="Map view">
        <TbToggleItem Value="@("Trails")" Text="Trails" />
        <TbToggleItem Value="@("Satellite")" Text="Satellite" />
        <TbToggleItem Value="@("Terrain")" Text="Terrain" />
    </TbToggleGroup>
    <TbText>View: @_view</TbText>
</TbStack>

@code {
    private string? _view = "Trails";
}
