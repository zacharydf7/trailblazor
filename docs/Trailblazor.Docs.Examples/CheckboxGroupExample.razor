<TbStack Gap="4">
    <TbCheckboxGroup Label="Trail days" @bind-Value="_days" Required HelperText="Pick at least one."
                     Validation="RequireADay" Row>
        @foreach (var day in Days)
        {
            <TbCheckboxItem Value="day" Disabled="@(day == DayOfWeek.Sunday)">@day</TbCheckboxItem>
        }
    </TbCheckboxGroup>
    <output data-testid="days-echo">@string.Join(", ", _days)</output>
    <TbCheckboxGroup Label="Gear" @bind-Value="_gear" Tone="Tone.Success" Size="Size.Small">
        <TbCheckboxItem Value="@("map")">Map</TbCheckboxItem>
        <TbCheckboxItem Value="@("lamp")">Head lamp</TbCheckboxItem>
        <TbCheckboxItem Value="@("kit")">First-aid kit <TbBadge>Required</TbBadge></TbCheckboxItem>
    </TbCheckboxGroup>
</TbStack>

@code {
    private static readonly DayOfWeek[] Days =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday,
        DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private IReadOnlyList<DayOfWeek> _days = [DayOfWeek.Saturday];
    private IReadOnlyList<string> _gear = ["kit"];

    private static IEnumerable<string> RequireADay(IReadOnlyList<DayOfWeek>? days) =>
        days is { Count: > 0 } ? [] : ["Pick at least one day."];
}
