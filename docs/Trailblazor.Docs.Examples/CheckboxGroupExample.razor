<TbStack Gap="4">
    <TbCheckboxGroup Label="Trail days" @bind-Value="_days" HelperText="Pick the days you can walk.">
        @foreach (var day in Days)
        {
            <TbCheckboxItem Value="day">@day</TbCheckboxItem>
        }
    </TbCheckboxGroup>
    <output>Trail days value: @string.Join(", ", _days)</output>
</TbStack>

@code {
    private static readonly DayOfWeek[] Days =
        [DayOfWeek.Monday, DayOfWeek.Wednesday, DayOfWeek.Friday, DayOfWeek.Saturday];

    private IReadOnlyList<DayOfWeek> _days = [DayOfWeek.Saturday];
}
