<TbStack Gap="2">
    <TbSlider @bind-Value="_brightness" Label="Map brightness" ShowValue ValueFormatter="@(value => $"{value}%")"
              OnValueCommitted="@((int value) => { _saved = value; })" />
    <output>Map brightness value: @_brightness%</output>
    <output>Saved at @_saved%</output>
</TbStack>

@code {
    private int _brightness = 60;
    private int _saved = 60;
}
