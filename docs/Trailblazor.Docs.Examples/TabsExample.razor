@using Trailblazor.Docs.Examples

<TbTabs AriaLabel="Report sections" @bind-ActiveKey="_section">
    <TbTab Key="summary" Text="Summary">
        <TbText>Revenue grew 12% over the quarter.</TbText>
    </TbTab>
    <TbTab Key="details">
        <TextContent>Details <TbBadge Count="3" Tone="Tone.Neutral" /></TextContent>
        <ChildContent>
            <TbText>Every region beat its target except the northeast.</TbText>
        </ChildContent>
    </TbTab>
    <TbTab Key="archive" Text="Archive" Disabled>
        <TbText>Older reports.</TbText>
    </TbTab>
</TbTabs>

@* Pill tabs, for a compact switch between views. *@
<TbTabs AriaLabel="Map layers" Variant="Variant.Soft" Style="margin-block-start: var(--tb-space-8)">
    <TbTab Text="Terrain"><TbText>Contours every 20 meters.</TbText></TbTab>
    <TbTab Text="Satellite"><TbText>Imagery from last summer.</TbText></TbTab>
    <TbTab Text="Trails"><TbText>Marked routes only.</TbText></TbTab>
</TbTabs>

<TbTabs AriaLabel="Trail settings" Vertical @bind-ActiveKey="_setting" Style="margin-block-start: var(--tb-space-8)">
    <TbTab Key="route" Text="Route" Icon="ExampleIcons.Trail">
        <TbText>Loop, 6.2 miles, starting at the north lot.</TbText>
    </TbTab>
    <TbTab Key="alerts" Text="Alerts" Icon="ExampleIcons.Bell">
        <TbText>Tell me about closures and fire danger.</TbText>
    </TbTab>
    <TbTab Key="filters" Text="Filters" Icon="ExampleIcons.Filter">
        <TbText>Dogs allowed, no bikes.</TbText>
    </TbTab>
</TbTabs>

@* A form across tabs: every panel renders from the start, so saving checks them all, and a tab with a problem says
   so in its name and its look. Clicking Map, even while it is selected, refreshes it. *@
<TbForm OnValidSubmit="SaveTrip" OnInvalidSubmit="() => _checked = true" aria-label="Plan a trip"
        Style="margin-block-start: var(--tb-space-8); max-inline-size: 24rem">
    <TbTabs AriaLabel="Trip plan" RenderAllPanels>
        <TbTab Text="@TabName("Leader", _leader)" HeaderClass="@AttentionClass(_leader)">
            <TbTextField Label="Leader's name" @bind-Value="_leader" Required />
        </TbTab>
        <TbTab Text="@TabName("Itinerary", _trail)" HeaderClass="@AttentionClass(_trail)">
            <TbTextField Label="Trail" @bind-Value="_trail" Required />
        </TbTab>
        <TbTab Text="Map" OnClick="() => _mapRefreshes++">
            <TbText>Map refreshed @_mapRefreshes @(_mapRefreshes == 1 ? "time" : "times").</TbText>
        </TbTab>
    </TbTabs>
    <TbButton Type="ButtonType.Submit">Save trip</TbButton>
    <TbText>@_tripStatus</TbText>
</TbForm>

@code {
    private string? _section = "summary";
    private string? _setting = "route";
    private string? _leader;
    private string? _trail;
    private bool _checked;
    private int _mapRefreshes;
    private string? _tripStatus;

    private bool NeedsAttention(string? value) => _checked && string.IsNullOrWhiteSpace(value);

    private string TabName(string name, string? value) => NeedsAttention(value) ? $"{name} (needs attention)" : name;

    private string? AttentionClass(string? value) => NeedsAttention(value) ? "docs-tab-attention" : null;

    private void SaveTrip()
    {
        _checked = false;
        _tripStatus = $"Saved {_leader}'s trip on {_trail}.";
    }
}
