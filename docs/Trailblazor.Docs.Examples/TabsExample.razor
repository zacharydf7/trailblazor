<TbTabs AriaLabel="Report sections" @bind-ActiveKey="_section">
    <TbTab Key="summary" Text="Summary">
        <TbText>Revenue grew 12% over the quarter.</TbText>
    </TbTab>
    <TbTab Key="details">
        <TextContent>Details <TbBadge Count="3" Tone="Tone.Neutral" /></TextContent>
        <ChildContent>
            <TbText>Every region beat its target except the northeast.</TbText>
        </ChildContent>
    </TbTab>
    <TbTab Key="archive" Text="Archive" Disabled>
        <TbText>Older reports.</TbText>
    </TbTab>
</TbTabs>

@code {
    private string? _section = "summary";
}
