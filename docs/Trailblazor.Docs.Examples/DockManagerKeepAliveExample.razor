            <TbAccordion>
                <TbAccordionItem Title="Open me, then switch tabs and come back">I stayed open.</TbAccordionItem>
            </TbAccordion>
        </div>
    </TbDockPanel>
    <TbDockPanel Id="rebuilt" Title="Rebuilt" KeepAlive="false">
