<TbDockManager @bind-Layout="_layout" AriaLabel="Trip office" Style="block-size: 20rem">
    <TbDockPanel Id="permits" Title="Permits">
        <TbText class="tb-p-3">Two backcountry permits, booked for the first week of July.</TbText>
    </TbDockPanel>
    <TbDockPanel Id="budget" Title="Budget">
        <TbText class="tb-p-3">Fuel, food and one night at the hut.</TbText>
    </TbDockPanel>
    <TbDockPanel Id="contacts" Title="Contacts">
        <TbText class="tb-p-3">The ranger station and the hut's warden.</TbText>
    </TbDockPanel>
    <TbDockPanel Id="transport" Title="Transport">
        <TbText class="tb-p-3">Shuttle to the trailhead at seven.</TbText>
    </TbDockPanel>
</TbDockManager>

@code {
    private DockLayout _layout = new(new DockSplit(
        new DockGroup("permits", "budget"), new DockGroup("contacts", "transport")));
}
