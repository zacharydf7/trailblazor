<TbStack Gap="3">
    @foreach (var size in Enum.GetValues<Size>())
    {
        <TbMenubar AriaLabel="@($"{size} planner")" Size="size" ItemSize="size">
            <TbMenu Label="@($"{size} routes")">
                <TbMenuItem Shortcut="Mod+N">New route</TbMenuItem>
                <TbMenuItem>Reverse</TbMenuItem>
            </TbMenu>
            <TbMenu Label="@($"{size} layers")">
                <TbMenuItem Icon="ExampleIcons.Plus">Add a layer</TbMenuItem>
                <TbMenuItem>Hide all</TbMenuItem>
            </TbMenu>
        </TbMenubar>
    }
</TbStack>
