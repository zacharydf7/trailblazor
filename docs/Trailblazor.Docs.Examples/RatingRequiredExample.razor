<TbForm @ref="_form" aria-label="Trail review">
    <TbRating Label="Rate the creek path" @bind-Value="_rating" Required HelperText="Rate the trail, not the weather."
              RequiredMessage="Choose at least one star." />
</TbForm>

@code {
    private TbForm _form = default!;
    private int _rating;

    // Only so this demo shows its message on load; a real form waits for a submit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _form.ValidateAsync();
        }
    }
}
