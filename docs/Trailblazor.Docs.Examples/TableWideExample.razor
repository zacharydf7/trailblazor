@* Wider than a phone, so it scrolls in an area of its own. The area takes focus so keyboard users can scroll it too. *@
<div role="region" aria-label="Trail details" tabindex="0" style="overflow: auto">
    <TbTable aria-label="Trail details entries" style="min-inline-size: 48rem">
        <thead>
            <tr>
                <th scope="col">Trail</th>
                <th scope="col">Region</th>
                <th scope="col">Length</th>
                <th scope="col">Climb</th>
                <th scope="col">Surface</th>
                <th scope="col">Season</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">Pine Hollow loop</th>
                <td>North ridge</td>
                <td>6.4 km</td>
                <td>310 m</td>
                <td>Dirt</td>
                <td>Spring to fall</td>
            </tr>
            <tr>
                <th scope="row">Summit Gate</th>
                <td>High peaks</td>
                <td>11.9 km</td>
                <td>980 m</td>
                <td>Rock</td>
                <td>Summer</td>
            </tr>
        </tbody>
    </TbTable>
</div>
