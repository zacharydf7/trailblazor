<TbDatePicker TDate="DateOnly" Label="Permit date" @bind-Value="_permit" Min="_today" Max="_today.AddMonths(3)"
              IsDateDisabled="IsWeekend" Clearable HelperText="A weekday in the next three months." />

@code {
    private static readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private DateOnly? _permit;

    private static bool IsWeekend(DateOnly date) => date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
}
