<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailblazor\Trailblazor.csproj" />
    <ProjectReference Include="..\..\src\Trailblazor.Icons.Material\Trailblazor.Icons.Material.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.razor" Exclude="_Imports.razor;CodeBlock.razor" LogicalName="Source/%(Filename)%(Extension)" />
    <EmbeddedResource Include="roadmap.json" LogicalName="Roadmap/roadmap.json" />
    <EmbeddedResource Include="..\..\src\Trailblazor\wwwroot\trailblazor.css" LogicalName="Css/trailblazor.css" />
  </ItemGroup>

  <!-- The library's XML documentation comes with its reference, and the API tables read it at run time. -->
  <Target Name="EmbedApiDocumentation" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" LogicalName="Api/Trailblazor.xml"
                        Condition="'%(Filename)%(Extension)' == 'Trailblazor.xml'" />
    </ItemGroup>
  </Target>

</Project>
