@inject IToastService Toasts

<TbStack Row Gap="2" Wrap>
    <TbButton Variant="Variant.Outlined" OnClick="ExportAsync">Export map</TbButton>
    <TbButton Variant="Variant.Text" OnClick="Toasts.DismissAll">Dismiss all</TbButton>
</TbStack>
<TbText class="tb-mt-3">@_status</TbText>

@code {
    private string _status = "";

    // A toast with a link; once it closes, the reason shows below the buttons.
    private async Task ExportAsync()
    {
        var toast = Toasts.Show("Trail map exported", Tone.Info, new()
        {
            Content = @<text>Trail map exported. <a href="guides/theming">Open it</a></text>,
        });
        var reason = await toast.Closed;
        _status = $"The export toast closed ({reason}).";
        StateHasChanged();
    }
}
