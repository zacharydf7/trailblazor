<TbAutocomplete @bind-Value="_peak" Label="Peak" Items="Peaks" Clearable>
    <Start><TbIcon Icon="ExampleIcons.Search" /></Start>
    <End><TbText TextStyle="TextStyle.Caption">@Peaks.Length peaks</TbText></End>
</TbAutocomplete>

@code {
    private static readonly string[] Peaks = ["Eagle", "Granite", "Summit"];

    private string? _peak;
}
