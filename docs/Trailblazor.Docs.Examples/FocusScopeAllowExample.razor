<TbDockManager @bind-Layout="_layout" AriaLabel="Route planner" AllowPopOut Style="block-size: 16rem">
    <TbDockPanel Id="routes" Title="Routes" Closable="false">
        <TbStack Gap="2" Class="tb-p-3">
            <TbText>@_name</TbText>
            <TbButton Size="Size.Small" OnClick="Edit">Edit route</TbButton>
        </TbStack>
    </TbDockPanel>
    <TbDockPanel Id="map" Title="Map" Closable="false">
        <TbStack Gap="2" Class="tb-p-3">
            <TbText>Zoom: @_zoom</TbText>
            <TbStack Row Gap="2">
                <TbButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => _zoom++">Zoom in</TbButton>
                <TbButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => _zoom--">Zoom out</TbButton>
            </TbStack>
        </TbStack>
    </TbDockPanel>
    <TbDockPanel Id="editor" Title="Editor" Closable="false">
        @if (_editing)
        {
            @* While the route is edited, the map stays usable; the Routes panel and the dock's tabs and menus
               don't. The selector names the panel alone, since the panel's tab carries data-panel too. *@
            <TbFocusScope Blocking Allow="@(["[data-part=panel][data-panel=map]"])" role="region"
                          aria-label="Edit route" class="tb-p-3">
                <TbStack Gap="2">
                    <TbTextField Label="Route name" @bind-Value="_draft" />
                    <TbStack Row Gap="2">
                        <TbButton Size="Size.Small" OnClick="Save">Save</TbButton>
                        <TbButton Size="Size.Small" Variant="Variant.Outlined" Tone="Tone.Neutral"
                                  OnClick="() => _editing = false">
                            Cancel
                        </TbButton>
                    </TbStack>
                </TbStack>
            </TbFocusScope>
        }
        else
        {
            <TbText class="tb-p-3">Choose Edit route to change the route's name.</TbText>
        }
    </TbDockPanel>
</TbDockManager>

@code {
    private DockLayout _layout = new(new DockSplit(new DockGroup("routes"), new DockGroup("map"),
        new DockGroup("editor")));
    private string _name = "Ridge loop";
    private string? _draft;
    private int _zoom = 12;
    private bool _editing;

    private void Edit() => (_draft, _editing) = (_name, true);

    private void Save() => (_name, _editing) = (string.IsNullOrWhiteSpace(_draft) ? _name : _draft, false);
}
