<TbStack Gap="2">
    <TbMultiToggleGroup @bind-Value="_layers" AriaLabel="Show on map">
        <TbToggleItem Value="@("Campsites")" Text="Campsites" Icon="ExampleIcons.Check" />
        <TbToggleItem Value="@("Water")" Text="Water" />
        <TbToggleItem Value="@("Ranger stations")" Text="Ranger stations" Disabled />
        <TbToggleItem Value="@("Alerts")" Icon="ExampleIcons.Bell" AriaLabel="Alerts" />
    </TbMultiToggleGroup>
    <TbText>Showing: @(_layers.Count == 0 ? "nothing" : string.Join(", ", _layers))</TbText>
</TbStack>

@code {
    private IReadOnlyList<string> _layers = ["Water"];
}
