<TbStack Gap="2">
    <TbListBox @bind-Value="_trail" Label="Trail" Rows="4">
        <TbOption Value="@("Ridge loop")" />
        <TbOption Value="@("Creek path")" />
        <TbOption Value="@("Summit spur")" />
        <TbOption Value="@("Lakeshore")" Disabled />
        <TbOption Value="@("Old mill")" />
        <TbOption Value="@("Fern gully")" />
    </TbListBox>
    <TbText>Trail: @(_trail ?? "none")</TbText>
</TbStack>

@code {
    private string? _trail = "Creek path";
}
