<TbForm @ref="_form" aria-label="Saved group" Style="max-inline-size: 24rem">
    <TbNumberField Label="Hikers" @bind-Value="_hikers" Min="1" Max="12" HelperText="Loaded from a saved trip." />
</TbForm>

@code {
    private TbForm _form = default!;
    private int _hikers = 14;

    // Only so this demo shows its message on load; a real form waits for a submit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _form.ValidateAsync();
        }
    }
}
