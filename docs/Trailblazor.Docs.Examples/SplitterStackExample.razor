@* Drag the corner to make the frame narrower than 640px and watch the panes stack. *@
<div style="inline-size: 100%; max-inline-size: 48rem; resize: inline; overflow: hidden;
            border: 1px solid var(--tb-border-subtle); border-radius: var(--tb-radius-md)">
    <TbSplitter StackBelow="Breakpoint.Sm" Style="block-size: 10rem">
        <TbSplitterPane Label="Trail list" Size="35" MinSize="20">
            <TbText class="tb-p-3">Saddle loop, mill path and lake spur.</TbText>
        </TbSplitterPane>
        <TbSplitterPane Label="Trail notes">
            <TbText class="tb-p-3">The saddle loop climbs through pines to an open saddle, then follows the mill
                path back to the trailhead.</TbText>
        </TbSplitterPane>
    </TbSplitter>
</div>
