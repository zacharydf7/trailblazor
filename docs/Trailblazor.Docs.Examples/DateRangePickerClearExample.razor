<TbStack Gap="2">
    <TbDateRangePicker TDate="DateOnly" Label="Closure dates" @bind-Value="_closure" Clearable />
    <output>
        Closure dates value: <span class="tb-text-nowrap">@(_closure.Start?.ToString("O") ?? "null")</span> to
        <span class="tb-text-nowrap">@(_closure.End?.ToString("O") ?? "null")</span>
    </output>
</TbStack>

@code {
    private DateRange<DateOnly> _closure = new(new(2026, 6, 12), new(2026, 6, 15));
}
