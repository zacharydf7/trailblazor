<TbStack Gap="3">
    <TbCheckbox Label="Make the next load fail" @bind-Value="_failNext" />
    <TbDataGrid @ref="_grid" TItem="Patrol" DataProvider="LoadPatrolsAsync" AriaLabel="Patrols"
                KeySelector="patrol => patrol.Id" OnLoadFailed="() => _failures++">
        <TbColumn Field="patrol => patrol.Ranger" />
        <TbColumn Field="patrol => patrol.Area" />
    </TbDataGrid>
    <TbStack Row>
        <TbButton Variant="Variant.Outlined" OnClick="() => _grid.RefreshAsync()">Load again</TbButton>
    </TbStack>
    <output aria-label="Failed loads">Failed loads: @_failures</output>
</TbStack>

@code {
    private static readonly Patrol[] Patrols = [new(1, "Ada", "North ridge"), new(2, "Grace", "River valley")];

    private TbDataGrid<Patrol> _grid = default!;
    private bool _failNext;
    private int _failures;

    // Stands in for a server that's slow, and that fails when asked to.
    private async Task<GridResult<Patrol>> LoadPatrolsAsync(GridRequest request, CancellationToken cancel)
    {
        await Task.Delay(1000, cancel);
        if (_failNext)
        {
            _failNext = false;
            throw new InvalidOperationException("The patrol log is offline.");
        }

        return new(Patrols, Patrols.Length);
    }

    private sealed record Patrol(int Id, string Ranger, string Area);
}
