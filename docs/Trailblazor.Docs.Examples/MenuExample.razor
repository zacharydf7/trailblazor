<TbStack Row Gap="4" Align="Align.Center">
    <TbMenu Label="Actions">
        <TbMenuItem Icon="ExampleIcons.Plus" OnClick="@(() => _last = "Duplicate")">Duplicate</TbMenuItem>
        <TbMenuItem OnClick="@(() => _last = "Rename")">Rename</TbMenuItem>
        <TbMenuItem Disabled OnClick="@(() => _last = "Archive")">Archive</TbMenuItem>
        <TbMenuItem Icon="ExampleIcons.Trash" OnClick="@(() => _last = "Delete")">Delete</TbMenuItem>
    </TbMenu>
    <output aria-label="Last action">@_last</output>
</TbStack>

@code {
    private string _last = "";
}
