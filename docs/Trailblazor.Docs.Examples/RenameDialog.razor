@inherits TbDialogContent<string>
@inject IDialogService Dialogs

<TbTextField Label="Name" @bind-Value="Name" UpdateOnInput />
<TbDialogActions>
    <TbButton Variant="Variant.Outlined" Tone="Tone.Neutral" OnClick="CancelEditAsync">Cancel</TbButton>
    <TbButton OnClick="() => CloseDialogAsync(Name ?? string.Empty)">Save</TbButton>
</TbDialogActions>

@code {
    private string? _original;

    [Parameter]
    public string? Name { get; set; }

    protected override void OnInitialized() => _original = Name;

    // Escape, the backdrop and the close button cancel as the Cancel button does, asking first once the name changed.
    protected override Task OnDismissAsync(DialogDismissReason reason) => CancelEditAsync();

    private async Task CancelEditAsync()
    {
        if (Name == _original || await Dialogs.ConfirmAsync("Discard the new name?",
            $"The report keeps its name, {_original}.", "Discard", "Keep editing", Tone.Danger))
        {
            await CancelDialogAsync();
        }
    }
}
