<TbStack Gap="2">
    <TbAutocomplete TValue="Trailhead" @bind-Value="_trailhead" Label="Trailhead" Search="FindTrailheadsAsync"
                    ItemText="trailhead => trailhead.Name" Placeholder="Search by name or region" Clearable>
        <ItemTemplate>
            <TbStack Gap="0">
                <span>@context.Name</span>
                <TbText TextStyle="TextStyle.Caption">@context.Region</TbText>
            </TbStack>
        </ItemTemplate>
    </TbAutocomplete>
    <TbText>Starting at: @(_trailhead?.Name ?? "nowhere yet")</TbText>
</TbStack>

@code {
    private static readonly Trailhead[] Trailheads =
    [
        new("Pine Hollow", "North ridge"), new("Eagle Ridge", "North ridge"), new("Cedar Flats", "River valley"),
        new("Fern Gully", "River valley"), new("Summit Gate", "High peaks"), new("Lakeshore", "Lake country"),
    ];

    private Trailhead? _trailhead;

    // A stand-in for a server search: it takes a moment and gives up when the user types again.
    private static async Task<IEnumerable<Trailhead>> FindTrailheadsAsync(string text, CancellationToken token)
    {
        await Task.Delay(300, token);
        return Trailheads.Where(trailhead => trailhead.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
            || trailhead.Region.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private sealed record Trailhead(string Name, string Region);
}
