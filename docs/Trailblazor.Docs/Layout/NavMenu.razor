@using Trailblazor.Docs.Examples

<h2 class="docs-nav__heading">Guides</h2>
<ul class="docs-nav__list">
    @foreach (var guide in GuideCatalog.All)
    {
        <li><NavLink href="@guide.Path" class="docs-nav__link">@guide.Title</NavLink></li>
    }
</ul>
@foreach (var category in Enum.GetValues<ExampleCategory>())
{
    <h2 class="docs-nav__heading">@category</h2>
    <ul class="docs-nav__list">
        @foreach (var example in ExampleCatalog.All.Where(example => example.Category == category))
        {
            <li><NavLink href="@($"components/{example.Name}")" class="docs-nav__link">@example.Title</NavLink></li>
        }
        @foreach (var upcoming in UpcomingCatalog.In(category))
        {
            <li class="docs-nav__upcoming" data-stage="@upcoming.Stage">
                @upcoming.Component.Title
                <span class="docs-nav__stage">@upcoming.Label</span>
            </li>
        }
    </ul>
}
