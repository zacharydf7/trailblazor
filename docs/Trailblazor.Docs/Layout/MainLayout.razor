@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<TbRoot />

<a href="@Navigation.ToSection("main")" class="docs-skip" @onclick="SkipAsync"
   @onclick:preventDefault>Skip to content</a>
<div class="@ClassNames">
    <header class="docs-header">
        <div class="@HeaderClass">
            <a href="" class="docs-brand">
                <img src="icon.svg" alt="" width="36" height="36" />
                <span class="docs-brand__name">Trail<span class="docs-brand__fade">blazor</span></span>
            </a>
            @* On a narrow screen the header shows only the brand and these buttons, which open the rest below them. *@
            <TbButton Variant="Variant.Outlined" class="docs-header__toggle" aria-controls="docs-search"
                      aria-expanded="@(_searchOpen ? "true" : "false")" OnClick="ToggleSearch">
                Search
            </TbButton>
            <TbButton Variant="Variant.Outlined" class="docs-header__toggle" aria-controls="@MenuTargets"
                      aria-expanded="@(_menuOpen ? "true" : "false")" OnClick="ToggleMenu">
                Menu
            </TbButton>
            <nav id="docs-site-nav" class="docs-site-nav" aria-label="Site">
                <NavLink href="guides/getting-started" class="docs-site-nav__link">Get started</NavLink>
                @* Relative to the base, so it opens the home page's catalog from any page. *@
                <a href="#components" class="docs-site-nav__link">Components</a>
                <a href="https://github.com/zacharydf7/trailblazor" class="docs-site-nav__link">GitHub</a>
            </nav>
            <SearchBox @ref="_search" />
            <LookSwitcher />
        </div>
    </header>
    @if (!IsHome)
    {
        <nav id="docs-nav" class="@NavClass" aria-label="Contents">
            <NavMenu />
        </nav>
    }
    <main @ref="_main" id="main" class="docs-main" tabindex="-1">
        @Body
    </main>
    <footer class="docs-footer">
        <p>Trailblazor is open source under the MIT license.</p>
        <p><a href="https://github.com/zacharydf7/trailblazor">GitHub</a></p>
    </footer>
</div>

@code {
    private bool _menuOpen;
    private bool _searchOpen;
    private bool _focusSearch;
    private ElementReference _main;
    private SearchBox _search = null!;
    private DotNetObjectReference<MainLayout>? _self;
    private IJSObjectReference? _shortcuts;

    // The home page is the whole map, so it spans the window without the sidebar.
    private bool IsHome => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] == "";

    private string ClassNames => IsHome ? "docs docs--home" : "docs";

    private string HeaderClass => _menuOpen ? "docs-header__inner docs-header__inner--menu"
        : _searchOpen ? "docs-header__inner docs-header__inner--search" : "docs-header__inner";

    // On a phone the menu also opens the contents, which a wider screen keeps beside the page.
    private string MenuTargets => IsHome ? "docs-site-nav docs-look" : "docs-site-nav docs-look docs-nav";

    private string NavClass => _menuOpen ? "docs-nav docs-nav--open" : "docs-nav";

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        _searchOpen = false;
    }

    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        _menuOpen = false;
        _focusSearch = _searchOpen;
    }

    /// <summary>Focuses the search for the "/" and Ctrl+K or Cmd+K shortcuts, opening it first on a narrow
    /// screen.</summary>
    [JSInvokable]
    public Task OpenSearch() => InvokeAsync(() =>
    {
        _searchOpen = true;
        _menuOpen = false;
        _focusSearch = true;
        StateHasChanged();
    });

    private async Task SkipAsync() => await _main.FocusAsync();

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // The field shows only once the open class has rendered, so it can't take focus before then.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shortcuts.js");
            _shortcuts = await module.InvokeAsync<IJSObjectReference>("listen", _self);
        }

        if (_focusSearch)
        {
            _focusSearch = false;
            await _search.FocusAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _searchOpen = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_shortcuts is not null)
        {
            await _shortcuts.InvokeVoidAsync("dispose");
            await _shortcuts.DisposeAsync();
        }

        _self?.Dispose();
    }
}
