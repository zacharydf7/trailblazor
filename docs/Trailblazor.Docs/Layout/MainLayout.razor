@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<TbRoot />

<a href="@Navigation.ToSection("main")" class="docs-skip" @onclick="SkipAsync"
   @onclick:preventDefault>Skip to content</a>
<div class="@ClassNames">
    <header class="docs-header">
        <div class="docs-header__inner">
            <a href="" class="docs-brand"><img src="icon.svg" alt="" width="36" height="36" /><span>Trail<span class="docs-brand__fade">blazor</span></span></a>
            <nav class="docs-site-nav" aria-label="Site">
                <NavLink href="guides/getting-started" class="docs-site-nav__link">Get started</NavLink>
                @* Relative to the base, so it opens the home page's catalog from any page. *@
                <a href="#components" class="docs-site-nav__link">Components</a>
                <a href="https://github.com/zacharydf7/trailblazor" class="docs-site-nav__link">GitHub</a>
            </nav>
            <SearchBox />
            @* A narrow screen keeps the list closed until asked for, so the page shows first. *@
            @if (!IsHome)
            {
                <TbButton Variant="Variant.Outlined" class="docs-nav-toggle" aria-controls="docs-nav"
                          aria-expanded="@(_navOpen ? "true" : "false")" OnClick="() => _navOpen = !_navOpen">
                    Contents
                </TbButton>
            }
            <LookSwitcher />
        </div>
    </header>
    @if (!IsHome)
    {
        <nav id="docs-nav" class="@NavClass" aria-label="Contents">
            <NavMenu />
        </nav>
    }
    <main @ref="_main" id="main" class="docs-main" tabindex="-1">
        @Body
    </main>
    <footer class="docs-footer">
        <p>Trailblazor is open source under the MIT license.</p>
        <p><a href="https://github.com/zacharydf7/trailblazor">GitHub</a></p>
    </footer>
</div>

@code {
    private bool _navOpen;
    private ElementReference _main;

    // The home page is the whole map, so it spans the window without the sidebar.
    private bool IsHome => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] == "";

    private string ClassNames => IsHome ? "docs docs--home" : "docs";

    private string NavClass => _navOpen ? "docs-nav docs-nav--open" : "docs-nav";

    private async Task SkipAsync() => await _main.FocusAsync();

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
