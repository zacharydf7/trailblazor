@using Trailblazor.Docs.Examples
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The labels stay the fields' names for screen readers; the header has no room to show them. *@
<TbStack Row Gap="2" Align="Align.Center" class="docs-look">
    <TbSelect Label="Theme" @bind-Value="_theme" @bind-Value:after="ApplyThemeAsync" Classes="HiddenLabel">
        <TbOption Value="@("system")">System</TbOption>
        <TbOption Value="@("light")">Light</TbOption>
        <TbOption Value="@("dark")">Dark</TbOption>
    </TbSelect>
    <TbSelect Label="Palette" @bind-Value="_palette" @bind-Value:after="ApplyPaletteAsync" Classes="HiddenLabel">
        @foreach (var palette in PaletteCatalog.All)
        {
            <TbOption Value="@palette.Name">@palette.Title</TbOption>
        }
    </TbSelect>
</TbStack>

@code {
    private static readonly FieldClasses HiddenLabel = new() { Label = "tb-visually-hidden" };
    private IJSObjectReference? _module;
    private string? _theme = "system";
    private string? _palette = "graphite";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./docs.js");
        var look = await _module.InvokeAsync<Look>("getLook");
        (_theme, _palette) = (look.Theme, look.Palette);
        StateHasChanged();
    }

    private Task ApplyThemeAsync() => SetLookAsync("tbTheme", _theme);

    private Task ApplyPaletteAsync() => SetLookAsync("tbPalette", _palette);

    private async Task SetLookAsync(string name, string? value)
    {
        if (value is not null && _module is not null)
        {
            await _module.InvokeVoidAsync("setLook", name, value);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private sealed record Look(string Theme, string Palette);
}
