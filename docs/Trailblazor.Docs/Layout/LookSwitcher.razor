@using Trailblazor.Docs.Examples
@implements IDisposable
@inject IThemeService Theme

@* The palette and density keep their labels for screen readers; the header has no room to show them. *@
<TbStack Row Gap="2" Align="Align.Center" Wrap id="docs-look" class="docs-look">
    <TbThemePicker Size="Size.Small" />
    <TbSelect Label="Palette" Value="Theme.Palette" ValueChanged="(Palette palette) => Theme.SetPaletteAsync(palette)"
              Classes="HiddenLabel">
        @foreach (var palette in PaletteCatalog.All)
        {
            <TbOption Value="palette.Value">@palette.Title</TbOption>
        }
    </TbSelect>
    <TbSelect Label="Density" Value="Theme.Density" ValueChanged="(Density density) => Theme.SetDensityAsync(density)"
              Classes="HiddenLabel">
        <TbOption Value="Density.Comfortable">Comfortable</TbOption>
        <TbOption Value="Density.Compact">Compact</TbOption>
    </TbSelect>
</TbStack>

@code {
    private static readonly FieldClasses HiddenLabel = new() { Label = "tb-visually-hidden" };

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
