        new("Date range picker", "Its label", "`DateRangePicker(label).ChooseAsync(start, end)` picks the dates, and "
            + "`RangeAsync()` reads them. `EnterAsync(start, end)` types text as it is in each box, and null leaves a "
            + "box unchanged."),
        new("Number field", "Its label", "`NumberField(label).EnterAsync(text)` types a number and waits until the "
            + "app has it, and `TextAsync()` reads what the field shows."),
        new("Slider", "Its label", "`Slider(label).SetAsync(value)` moves it and waits until the field has the value, "
            + "and `ValueAsync()` reads it."),
        new("Range slider", "Its label", "`RangeSlider(label).SetAsync(start, end)` moves both thumbs and waits until "
            + "the field has the range, and `RangeAsync()` reads it."),
        new("Tag input", "Its label", "`TagInput(label).AddAsync(text)` types a tag and presses Enter, "
            + "`RemoveAsync(tag)` clicks its remove button, and both wait for the app's answer; `Tags` is the tags, "
            + "for assertions."),
        new("Rich text editor", "Its label", "`RichTextEditor(label).EnterAsync(html)` pastes the HTML over the text, "
            + "leaves the editor and waits until the app has it; `Input` is the editing area, for typing and reading "
            + "its text."),
        new("Transfer list", "Its label", "`TransferList(label).MoveAsync(items)` moves items to the chosen list, "
            + "`MoveBackAsync(items)` moves them back, and `ChosenAsync()` reads the chosen ones."),
        new("Calendar", "Its label", "`Calendar(label).ChooseAsync(date)` picks a date as a user would, through the "
            + "calendar's years, months and days."),
        new("Signature pad", "Its label", "`SignaturePad(label).DrawAsync(points)` drags the mouse through points in "
            + "the signature's 600 by 200 space and waits until the pad has the stroke; `UndoAsync()`, `ClearAsync()` "
            + "and `TypeNameAsync(name)` use its buttons and name field, and `IsSignedAsync()` says whether anything "
            + "is drawn or typed."),
        new("Pagination", "Its name", "`Pagination(name).GoToPageAsync(number)` goes to a page, and `PageAsync()` "
            + "reads the current one."),
        new("Tree", "Its name", "`Tree(name)` expands, collapses, selects, checks, activates and drags rows by the "
            + "texts along their path, and `TextsAsync()` reads the rows that show. `RowAsync(text)` finds the one row "
            + "that shows a text at any depth, and `Branch(path)` scopes the helpers to a row's branch, with paths "
            + "that start inside it."),
        new("Tree select", "Its label", "`TreeSelect(label)` chooses, checks and unchecks items by the texts along "
            + "their path, `FilterAsync(text)` types in its filter box, and `TextAsync()` reads what the field shows. "
            + "`DisabledAsync()` reads whether it's disabled, `OpenAsync()` and `CloseAsync()` open and close its "
            + "tree, and `IsOpenAsync()` reads whether it's open."),
        new("Data grid", "Its name", "`Grid(name)` finds rows and cells by their text, and sorts, filters, selects "
            + "and pages, and `ClickRowAsync(cell)` clicks a row. `MoveRowAsync(row, index)` moves a row through its "
            + "handle's menu, and `DragRowBeforeAsync` "
            + "and `DragRowAfterAsync` drag it onto another row; each waits for the app's answer. `ExpandAsync(row)` "
            + "and `CollapseAsync(row)` open and close a tree grid's row. `RowsAsync()` and `SelectedAsync()` read the "
            + "rows shown and the selected ones as their data cells' texts, `RowCountAsync()` counts the rows shown, "
            + "`IsBusyAsync()` reads whether rows are loading, and `WaitForRowsAsync()` waits until they've loaded."),
        new("Command palette", "Its label", "`CommandPalette(name).OpenAsync()` presses its shortcut, "
            + "`SearchAsync(text)` types and waits for the results, `ResultsAsync()` reads them, "
            + "`ChooseAsync(command)` runs one and waits until the app's `OnChoose` has run, and `IsOpenAsync()` says "
            + "whether it's open."),
        new("Sortable", "Its label", "`Sortable(name).MoveAsync(item, index)` moves an item through its handle's "
            + "menu, `DragBeforeAsync` and `DragAfterAsync` drag it onto another item, `MoveToListAsync(item, list)` "
            + "and `DragToListAsync(item, list)` move it to another list of its group, and each waits for the app's "
            + "answer; `ItemsAsync()` reads the order. An item is named by the list's `ItemLabel`, or by its text "
            + "when the list has none."),
        new("Accordion", "An item's header", "`AccordionItem(header).ExpandAsync()` opens the item, waits until it "
            + "is open and hands back its panel; `CollapseAsync()` closes it."),
        new("Tooltip", "Its trigger", "`Tooltip(trigger).TextAsync()` rests the pointer on the trigger and returns "
            + "the tooltip's text once it shows."),
        new("Splitter", "Its separator's name", "`Splitter(\"Resize Trails\").ResizeAsync(percent)` resizes the pane "
            + "with the separator's keys and waits until the app has the size, and `SizeAsync()` reads it."),
        new("Popover", "Its trigger", "`Popover(trigger).OpenAsync()` opens it and hands back its panel."),
        new("Popconfirm", "Its trigger",
            "`Popconfirm(trigger).ConfirmAsync()` opens it, confirms and waits until it closes, which it does once "
            + "the app's `OnConfirm` has run; `CancelAsync()` cancels and waits until it closes, though an async "
            + "`OnCancel` may still be running. An `OnConfirm` that waits for the user, such as one that opens a "
            + "dialog, would keep the helper waiting, so click the confirm button instead."),
        new("Menu", "Its trigger", "`Menu(trigger).ChooseAsync(path)` chooses an item through its submenus. "
            + "`OpenAsync()` and `CloseAsync()` open and close the menu, and `IsOpenAsync()` reads whether it's open."),
        new("Hotkey", "Its keys", "`Hotkey(keys).PressAsync()` waits until the hotkey listens, then presses its "
            + "keys, with Mod as `ControlOrMeta`."),
        new("Viewport", "Its label", "`Viewport(label).ZoomInAsync()`, `FitAsync(ViewportFit.Page)` and the other "
            + "helpers zoom with its controls and wait until the app has the zoom. `ZoomAsync()` reads the zoom, and "
            + "`FitAsync()` the fit."),
        new("Query builder", "Its label", "`QueryBuilder(label)` adds conditions and groups, sets a group's join with "
            + "`JoinAsync(QueryJoin.Or, group)`, and `Condition(number, group)` finds a condition's Field, Comparison "
            + "and Value by their labels."),
        new("Property grid", "Its label", "`PropertyGrid(label)` finds the fields inside it by their labels, as "
            + "`NumberField`, `Select` and the other helpers do anywhere else."),
        new("Context menu", "Its menu's name", "`ContextMenu(name).On(key).ChooseAsync(path)` right-clicks the "
            + "element with that `data-context-key` and chooses an item through its submenus, from the items drawn for "
            + "that key. `On(element)` right-clicks a given element instead, and without `On` it right-clicks the "
            + "whole area."),
        new("Tabs", "Their list's name", "`Tabs(name).SelectAsync(tab)` selects a tab by its name, `TabsAsync()` "
            + "reads the tabs and `SelectedAsync()` the selected one. `Panel(tab)` scopes the helpers to that tab's "
            + "panel; select the tab first, since a hidden panel's fields can't be used. With no name, `Tabs()` finds "
            + "the visible tab list, so name the outer list when a shown panel holds another."),
        new("Dialog", "Its title", "`Dialog(title).ChooseAsync(button)` answers it with a button's name, and "
            + "`CancelAsync()` dismisses it with Escape; both wait until the dialog has left the page, or, on a static "
            + "page, until it closes."),
        new("Toast", "Its text", "`Toasts.WaitForAsync(text)` finds it once it shows."),
    ];

