</DocsArticle>

@code {
    private static readonly string HikeLogSource = ExampleSource.OfRecipeFile("HikeLog.razor").Text;
    private static readonly string HikeContextSource = ExampleSource.OfRecipeFile("HikeContext.cs").Text;

    private const string Registration = """
        using Microsoft.EntityFrameworkCore;

        builder.Services.AddDbContextFactory<HikeContext>(options => options.UseSqlServer(connectionString));
        """;
}
