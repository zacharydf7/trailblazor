@page "/guides/theming"
@using Trailblazor.Docs.Examples

<PageTitle>Theming · Trailblazor</PageTitle>

<DocsArticle Class="docs-article--guide">
    <Contents>
        <TbTableOfContentsItem TargetId="light-and-dark" Text="Light and dark" />
        <TbTableOfContentsItem TargetId="palettes" Text="Palettes" />
        <TbTableOfContentsItem TargetId="typography" Text="Typography" />
        <TbTableOfContentsItem TargetId="density" Text="Density" />
        <TbTableOfContentsItem TargetId="tokens" Text="Change tokens" />
        <TbTableOfContentsItem TargetId="restyle" Text="Restyle one component" />
        <TbTableOfContentsItem TargetId="brand" Text="Try a brand color" />
        <TbTableOfContentsItem TargetId="other-stylesheets" Text="Other stylesheets" />
        <TbTableOfContentsItem TargetId="seeded-palette" Text="A palette from seed colors" />
        <TbTableOfContentsItem TargetId="custom-palette" Text="Your own palette" />
        <TbTableOfContentsItem TargetId="reduced-motion" Text="Reduced motion" />
        <TbTableOfContentsItem TargetId="token-reference" Text="Token reference" />
        <TbTableOfContentsItem TargetId="related" Text="Related" />
    </Contents>
    <Header>
        <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Theming</TbText>
        <TbText TextStyle="TextStyle.Subtitle" class="docs-lead">
            Every component draws its colors, spacing, shapes and type from design tokens: CSS custom properties named
            <code>--tb-*</code>. Attributes switch between the ready-made looks, and your own CSS can change any token.
        </TbText>
    </Header>
    <ChildContent>
        <DocsHeading Id="light-and-dark" Text="Light and dark" Class="docs-section" />
        <TbText>
            Put <code>TbThemeHead</code> in <code>&lt;head&gt;</code>, next to <code>TbStyles</code>. It starts the
            page in the mode, palette and density you set in <code>TrailblazorOptions.Theme</code>, or in the ones the
            user chose last time, before the page paints, so a dark page never flashes light.
        </TbText>
        <ul>
            <li><code>System</code>, the default, follows the device's setting.</li>
            <li>
                Without <code>TbThemeHead</code>, Trailblazor keeps the page's own color scheme, so adding the library
                never darkens an app by itself.
            </li>
        </ul>
        <CodeBlock Label="App.razor and Program.cs" Code="@Theme" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">In a standalone WebAssembly app</TbText>
        <TbText>
            A standalone WebAssembly app has no server to render <code>&lt;head&gt;</code>, so copy the script that
            <code>TbThemeHead</code> would render into <code>index.html</code> yourself, as this site does.
        </TbText>
        <CodeBlock Label="index.html" Code="@StandaloneTheme" />
        <DocsCallout Tone="Tone.Warning" Title="Keep the script and the options the same">
            In a standalone app, the script's attributes, not <code>TrailblazorOptions.Theme</code>, choose how the
            first page looks, so keep the two the same.
        </DocsCallout>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">Let people choose</TbText>
        <TbText>
            The <a href="components/theme-picker">theme picker</a> lets people choose, as the one at the top of this
            site does, and <code>IThemeService</code> changes the mode, palette or density from your own code. Both
            remember the choice in the browser unless <code>Remember</code> is off.
        </TbText>

        <DocsHeading Id="palettes" Text="Palettes" Class="docs-section" />
        <TbText>
            A palette sets the colors for both light and dark. Graphite, a near-monochrome look with ink-colored primary
            actions, is the default. The others are
            @string.Join(", ", PaletteCatalog.All.Skip(1).Select(palette => palette.Name)), and the
            <a href="guides/palettes">palette gallery</a> shows each one on real components.
        </TbText>
        <ul>
            <li>
                For the page, set the <code>Palette</code> value in <code>TrailblazorOptions.Theme</code>, or call
                <code>IThemeService.SetPaletteAsync</code>.
            </li>
            <li>
                For one part of a page, set <code>data-tb-palette</code> or <code>data-tb-theme</code> on any element;
                it applies to everything inside it. An element with <code>data-tb-theme</code> also takes that theme's
                background and text color.
            </li>
        </ul>
        <CodeBlock Label="A palette for part of a page" Code="@Palette" />
        <DocsCallout Title="Give the page another background on html">
            <code>TbThemeHead</code> marks the page itself, so the page follows the theme without CSS of its own. To
            give it another background, set it on <code>html</code> or change <code>--tb-color-background</code>; a
            background on <code>body</code> alone leaves the theme's color around it.
        </DocsCallout>

        <DocsHeading Id="typography" Text="Typography" Class="docs-section" />
        <TbText>
            Every component sets its text in <code>--tb-font-family</code>, the system's interface font unless you
            change it. The page that <code>TbThemeHead</code> marks takes the same font and
            <code>--tb-line-height-normal</code>, and its <code>body</code> takes <code>--tb-font-size-md</code>, so
            text outside the components matches them without CSS of your own.
        </TbText>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">Your own font, everywhere</TbText>
        <TbText>
            Set <code>--tb-font-family</code> rather than a font on <code>body</code>. The token changes the page and
            every component at once, while a font on <code>body</code> alone changes only your own text and leaves the
            components in the system font.
        </TbText>
        <CodeBlock Label="Your own font, everywhere" Code="@Font" Language="CodeLanguage.Css" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">Your own type for the page</TbText>
        <TbText>
            To keep the page's type your own instead, set it on <code>html</code> or <code>body</code> in your
            stylesheet. The themed page's type sits in a cascade layer and uses zero-specificity selectors, so any rule
            of yours outside a cascade layer wins.
        </TbText>
        <TbText>
            Text fields, tabs, menu items and the other controls that take the text's font set their own line height,
            so a line height of yours doesn't change how tall they are.
        </TbText>

        <DocsHeading Id="density" Text="Density" Class="docs-section" />
        <TbText>
            Compact density makes controls, items and rows shorter, for screens full of data. Comfortable, the default,
            leaves room for touch. Every pointer target stays at least 24 by 24 px in both.
        </TbText>
        <ul>
            <li>For the page, set the <code>Density</code> value in <code>TrailblazorOptions.Theme</code>.</li>
            <li>
                While the app runs, call <code>IThemeService.SetDensityAsync</code>, which remembers the choice as it
                does the mode and palette. The density menu at the top of this site switches every page, examples
                included.
            </li>
        </ul>
        <CodeBlock Label="Program.cs" Code="@DensityOption" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">One part of a page</TbText>
        <TbText>
            Set <code>data-tb-density</code> on any element or component; it applies to everything inside it. Set
            <code>comfortable</code> inside a compact page to switch that part back.
        </TbText>
        <CodeBlock Label="A compact region" Code="@DensityRegion" />
        <DocsCallout Tone="Tone.Warning" Title="Set a virtualized tree's row height">
            A virtualized tree view keeps the row height its <code>ItemSize</code> gives, so set that to 28 in compact
            density.
        </DocsCallout>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">The density tokens</TbText>
        <TbText>
            Density sets seven tokens, and the components size themselves from them, so changing one changes every
            component that uses it.
        </TbText>
        <div class="docs-api" tabindex="0" role="region" aria-label="Density tokens">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Token</th>
                        <th scope="col">Comfortable</th>
                        <th scope="col">Compact</th>
                        <th scope="col">Sizes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var token in DensityTokens)
                    {
                        <tr>
                            <th scope="row"><code>@token.Name</code></th>
                            <td>@token.Comfortable</td>
                            <td>@token.Compact</td>
                            <td>@token.Sizes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <DocsCallout Tone="Tone.Warning" Title="Changing the control height on your own element">
            The small and large heights are worked out from <code>--tb-control-height</code> only where a density is
            set: on the page or on a <code>data-tb-density</code> region. To change <code>--tb-control-height</code> on
            an element of your own, set <code>--tb-control-height-sm</code> and <code>--tb-control-height-lg</code>
            there too.
        </DocsCallout>

        <DocsHeading Id="tokens" Text="Change tokens" Class="docs-section" />
        <TbText>
            Trailblazor's CSS sits in cascade layers named <code>tb.*</code>, and your own CSS outside any layer always
            wins over it, whatever the selectors. So set any token in your stylesheet to change it everywhere.
        </TbText>
        <CodeBlock Label="Token overrides" Code="@Overrides" Language="CodeLanguage.Css" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">A primary for part of a page</TbText>
        <TbText>
            The primary's hover, pressed, subtle and text colors and the focus ring are worked out from
            <code>--tb-color-primary</code> wherever it is set: on the page, in a palette, or in an element's
            <code>style</code>. So one color re-themes a part of a page, states included. You can still set any of the
            derived tokens yourself, on the same element as the primary. The secondary's hover, pressed, subtle and
            text colors follow <code>--tb-color-secondary</code> the same way.
        </TbText>
        <CodeBlock Label="A primary for part of a page" Code="@RegionPrimary" />
        <DocsCallout Tone="Tone.Warning" Title="A primary set from a class">
            If you set the primary from a class in your stylesheet instead of <code>style</code>, also put an empty
            <code>data-tb-palette</code> attribute on that element so its states follow.
        </DocsCallout>

        <DocsHeading Id="restyle" Text="Restyle one component" Class="docs-section" />
        <TbText>To change one component rather than the whole theme, reach for these in order:</TbText>
        <ol>
            <li>
                Its own tokens, such as <code>--tb-button-radius</code>, listed under Design tokens on its page. Set one
                on the page to change the component everywhere, or on an element to change it only inside that element.
            </li>
            <li>
                Its <code>Classes</code> parameter, a <code>ButtonClasses</code> or <code>FieldClasses</code> record for
                example, which adds your class names to its parts.
            </li>
            <li>
                Its <code>data-part</code> names, also on its page, and the ARIA attributes that mark its states, such
                as <code>aria-selected</code>, <code>aria-invalid</code> and <code>aria-disabled</code>. These let your
                stylesheet reach one part in one state.
            </li>
        </ol>
        <CodeBlock Label="app.css" Code="@Restyle" />
        <TbText>
            <code>Class</code> and <code>Style</code> go on a component's outer element. A menu, popover, select,
            autocomplete, color picker or date range picker keeps its popup inside that element, so reach the popup
            through your class and the popup's <code>data-part</code>, such as
            <code>.account-menu [data-part="menu"]</code>. A tooltip's <code>Class</code> goes on a span around its
            trigger, with the bubble inside, and <code>BubbleClass</code> adds a class to the bubble itself.
        </TbText>
        <TbText>
            Fields have tokens for their edges and fill, so you can make them quieter, such as underlined fields for a
            dense screen. <code>--tb-field-border-width</code> takes one to four widths, so <code>0 0 1px</code>
            keeps only the bottom line. Keep at least one edge that contrasts 3:1 with the page, so people can find the
            field.
        </TbText>
        <CodeBlock Label="app.css" Code="@QuietFields" />

        <DocsHeading Id="brand" Text="Try a brand color" Class="docs-section" />
        <TbText>
            Pick a color to see it as the primary, with the hover, pressed, selected and focus colors that follow from
            it, then copy the CSS. If the color is too light for readable text on it in light mode, or too dark in dark
            mode, it is darkened or lightened just that far; otherwise it is used as picked.
        </TbText>
        <TbColorPicker Label="Brand color" @bind-Value="_brand" class="docs-demo" />
        <div class="docs-brand-preview docs-demo" style="@($"--tb-color-primary: {BrandPrimary}")">
            <TbStack Row Gap="2" Wrap Align="Align.Center">
                <TbButton>Save</TbButton>
                <TbButton Variant="Variant.Soft">Preview</TbButton>
                <TbCheckbox Label="Share with team" @bind-Value="_share" />
                <TbChip Text="Open" Selected SelectedChanged="(bool _) => { }" />
            </TbStack>
            <TbList aria-label="Trails with your brand color">
                <TbListItem Selected OnClick="() => { }">Ridge loop</TbListItem>
                <TbListItem OnClick="() => { }">Creek path</TbListItem>
            </TbList>
        </div>
        <CodeBlock Label="app.css" Code="@BrandCss" />

        <DocsHeading Id="other-stylesheets" Text="Other stylesheets" Class="docs-section" />
        <TbText>
            The rule that lets your CSS win also lets any other stylesheet outside a layer win. A global rule such as
            <code>* { margin: 0; padding: 0; }</code>, which many resets and some component libraries ship, then strips
            the components' own spacing:
        </TbText>
        <ul>
            <li>Dialogs sit in the page's top corner.</li>
            <li>Fields lose their inner spacing.</li>
            <li>Radio buttons lose their dot.</li>
        </ul>
        <TbText>
            Once a page is interactive, Trailblazor names such a stylesheet from the same origin in the browser's
            console. Put that stylesheet in a cascade layer
            of its own, ordered before Trailblazor's, so Trailblazor's styles win over it and yours still win over both:
        </TbText>
        <ol>
            <li>In App.razor, state the layer order before <code>TbStyles</code> loads Trailblazor's layers.</li>
            <li>In app.css, import the stylesheet with <code>layer()</code>, which puts it in its layer.</li>
        </ol>
        <CodeBlock Label="App.razor" Code="@LayerOrder" />
        <CodeBlock Label="app.css" Code="@LayerImport" />
        <TbText>
            Once the stylesheet is in a layer, the warning stops. To turn it off anyway, set
            <code>options.WarnAboutUnlayeredStyles = false</code>.
        </TbText>

        <DocsHeading Id="seeded-palette" Text="A palette from seed colors" Class="docs-section" />
        <TbText>
            Give a palette a few seed colors and <code>TbThemeHead</code> writes its CSS, so the app needs none of its
            own. <code>Primary</code> is required. <code>Neutral</code> tints the backgrounds, text, borders and the
            neutral tone, keeping the built-in grays' lightness in both modes. <code>PrimaryDark</code>,
            <code>Secondary</code> and <code>SecondaryDark</code> are optional; when a dark color is left out,
            Trailblazor uses a lighter form of the light one. Each seed is a hex color or an <code>oklch()</code> color.
        </TbText>
        <CodeBlock Label="Program.cs" Code="@SeededPalette" />
        <TbText>
            The hover, pressed, subtle and text colors of the primary and secondary, and the focus ring, follow from the
            seeds as they do for a built-in palette. Text on a filled button is white or near-black, whichever reads
            better. Trailblazor checks the result once per app, in both modes, and logs a warning naming the tokens and
            the ratio for each text color under 4.5:1 against its background, and for the strong border, the primary or
            the focus ring under 3:1 against the page background. To warn only in Development, set
            <code>WarnAboutContrast</code> to <code>builder.Environment.IsDevelopment()</code>.
        </TbText>
        <DocsCallout Tone="Tone.Info" Title="In a standalone WebAssembly app">
            A standalone app has no <code>TbThemeHead</code>, so write the palette's CSS yourself, as below.
        </DocsCallout>

        <DocsHeading Id="custom-palette" Text="Your own palette" Class="docs-section" />
        <TbText>
            A palette is a block of color tokens for one value of <code>data-tb-palette</code>. Use
            <code>light-dark()</code> so each color has its light and dark value, and set the background, surface, text,
            border, primary, secondary and neutral tokens. The primary's and secondary's states follow from those colors,
            and the focus ring from the primary. The
            built-in palettes in <code>trailblazor.css</code> list every token a palette sets.
        </TbText>
        <CodeBlock Label="A custom palette" Code="@CustomPalette" Language="CodeLanguage.Css" />
        <TbText>
            Choose it by the name its rule matches, as you would a built-in palette: <code>new Palette("forest")</code>
            in <code>TrailblazorOptions.Theme</code> or <code>IThemeService.SetPaletteAsync</code>. It is applied before
            the page first paints and remembered like any other palette. For a picker of your own,
            <code>Palette.BuiltIn</code> lists the built-in palettes.
        </TbText>
        <CodeBlock Label="Program.cs" Code="@CustomPaletteOption" />

        <DocsHeading Id="reduced-motion" Text="Reduced motion" Class="docs-section" />
        <TbText>When the device asks for reduced motion:</TbText>
        <ul>
            <li>Transitions finish at once.</li>
            <li>A busy button's spinner stops, and so does a tree row's spinner while its children load.</li>
            <li>A skeleton stops its pulse or wave and shows as a still placeholder.</li>
            <li>An indeterminate progress bar or circle fills and gently pulses in place instead of moving.</li>
        </ul>

        <DocsHeading Id="token-reference" Text="Token reference" Class="docs-section" />
        <TbText>
            Every theme token, with the value the default palette and density give it, read from
            <code>trailblazor.css</code>. A color's sample follows the palette and mode chosen at the top of this site.
        </TbText>
        <div class="docs-api" tabindex="0" role="region" aria-label="Theme tokens">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Token</th>
                        <th scope="col">Role</th>
                        <th scope="col">Default</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (name, value) in DesignTokens.Reference())
                    {
                        <tr>
                            <th scope="row"><code>@name</code></th>
                            <td>@DesignTokens.Role(name)</td>
                            <td>
                                @if (DesignTokens.IsColor(name))
                                {
                                    <span class="docs-swatch" style="@($"background: var({name})")"></span>
                                }
                                <code>@TokenValue(value)</code>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <DocsHeading Id="related" Text="Related" Class="docs-section" />
        <ul>
            <li>
                <a href="guides/palettes">Palettes</a>: every built-in palette on real components, in light and dark.
            </li>
            <li><a href="guides/spacing">Spacing</a>: the spacing scale and its utility classes.</li>
            <li>
                <a href="components/theme-picker">Theme picker</a>: a ready-made control for mode, palette and density.
            </li>
            <li>
                Each component's page lists its own design tokens and parts, such as the
                <a href="components/button#design-tokens">button's</a>.
            </li>
        </ul>
        <GuideFooter Page="GetType()" />
    </ChildContent>
</DocsArticle>

@code {
    private static string TokenValue(string value) =>
        value.Contains("from var(--tb-color-primary)") ? "From the primary"
        : value.Contains("from var(--tb-color-secondary)") ? "From the secondary" : value;

    private const string DefaultBrand = "#0f766e";

    private string? _brand = DefaultBrand;

    private bool _share = true;

    private string Brand => _brand ?? DefaultBrand;

    private string BrandPrimary =>
        $"light-dark(oklch(from {Brand} min(l, 0.55) c h), oklch(from {Brand} max(l, 0.75) c h))";

    private string BrandCss => $$"""
        :root {
            --tb-color-primary: {{BrandPrimary}};
        }
        """;

    private const string QuietFields = """
        /* Underlined fields, with no box, in a dense form. */
        .dense-form {
            --tb-field-border-width: 0 0 1px;
            --tb-field-radius: 0;
            --tb-field-background: transparent;
        }
        """;

    private const string Restyle = """
        /* Square buttons everywhere, and taller ones in the editor's toolbar. */
        :root {
            --tb-button-radius: 0;
        }

        .editor-toolbar {
            --tb-button-height: 2.75rem;
        }

        /* A chosen option in bold. */
        [data-part="option"][aria-selected="true"] {
            font-weight: 600;
        }
        """;

    private const string Theme = """
        @* App.razor *@
        <head>
            <TbStyles />
            <TbThemeHead />
        </head>

        // Program.cs
        builder.Services.AddTrailblazor(options =>
        {
            options.Theme.Mode = ThemeMode.System;
            options.Theme.Palette = Palette.Cobalt;
        });
        """;

    private const string StandaloneTheme = """
        <script src="_content/Trailblazor/theme-head.js"
            data-mode="system" data-palette="cobalt"
            data-density="comfortable" data-remember="true"></script>
        """;

    private static readonly (string Name, string Comfortable, string Compact, string Sizes)[] DensityTokens =
    [
        ("--tb-control-height", "40px", "32px",
            "Buttons, fields, selects, tabs, pagination, toggle groups, segmented controls and nav menu links; "
                + "chips and calendar days are sized from it"),
        ("--tb-control-height-sm", "32px", "26px",
            "Small buttons, fields, selects, pagination, toggle groups and segmented controls; calendar and date "
                + "range picker titles"),
        ("--tb-control-height-lg", "48px", "40px",
            "Large buttons, fields, selects, pagination, toggle groups and segmented controls"),
        ("--tb-control-padding-block", "8px", "4px",
            "The space above and below the text in fields, tabs, list items, nav menu links and accordion headers; "
                + "alerts use 1.5 times this"),
        ("--tb-control-padding-inline", "12px", "8px", "The space either side of a button's or a field's text"),
        ("--tb-item-height", "32px", "28px", "Menu items, options in a select or list box, and tree rows"),
        ("--tb-row-height", "44px", "32px", "Table and data grid rows, list items and accordion headers"),
    ];

    private const string DensityOption = """
        builder.Services.AddTrailblazor(options =>
            options.Theme.Density = Density.Compact);
        """;

    private const string DensityRegion = """
        <section data-tb-density="compact">
            ...
        </section>
        """;

    private const string Palette = """
        <section data-tb-palette="moss" data-tb-theme="dark">
            ...
        </section>
        """;

    private const string Overrides = """
        :root {
            --tb-font-family: "Inter", system-ui, sans-serif;
            --tb-radius-md: 2px;
        }
        """;

    private const string LayerOrder = """
        <head>
            @* Razor writes a literal @ as @@. *@
            <style>@@layer vendor, tb;</style>
            <TbStyles />
            <link rel="stylesheet" href="app.css" />
        </head>
        """;

    private const string LayerImport = """
        @import url("_content/OtherLibrary/other.css") layer(vendor);

        /* Your own rules stay outside any layer, so they win over both. */
        """;

    private const string Font = """
        :root {
            --tb-font-family: "Inter", system-ui, sans-serif;
        }
        """;

    private const string RegionPrimary = """
        <section style="--tb-color-primary: light-dark(#0f766e, #5eead4)">
            ...
        </section>
        """;

    private const string SeededPalette = """
        builder.Services.AddTrailblazor(options =>
            options.Theme.Palette = new Palette("brand")
            {
                Seeds = new() { Primary = "#1F5FAD", Neutral = "#5B6472" },
            });
        """;

    private const string CustomPaletteOption = """
        builder.Services.AddTrailblazor(options =>
            options.Theme.Palette = new Palette("forest"));
        """;

    private const string CustomPalette = """
        [data-tb-palette="forest"] {
            --tb-color-background: light-dark(white, #0f1a14);
            --tb-color-text: light-dark(#14231a, #e8f2ec);
            --tb-color-primary: light-dark(#1e6b45, #7fd1a5);
            --tb-color-on-primary: light-dark(white, #0f1a14);
            --tb-color-secondary: light-dark(#7a4e14, #e8b46a);
            --tb-color-on-secondary: light-dark(white, #0f1a14);
            /* ...and the remaining surface, border and neutral tokens. */
        }
        """;
}
