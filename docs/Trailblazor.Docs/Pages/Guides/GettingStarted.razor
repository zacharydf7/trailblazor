@page "/guides/getting-started"
@inject IDialogService Dialogs
@inject IToastService Toasts

<PageTitle>Getting started · Trailblazor</PageTitle>

<DocsArticle Class="docs-article--guide">
    <Contents>
        <TbTableOfContentsItem TargetId="set-up" Text="Set up an app" />
        <TbTableOfContentsItem TargetId="host" Text="Host dialogs and toasts" />
        <TbTableOfContentsItem TargetId="render-modes" Text="Render modes" />
        <TbTableOfContentsItem TargetId="options" Text="App-wide options" />
        <TbTableOfContentsItem TargetId="next-steps" Text="Next steps" />
    </Contents>
    <Header>
        <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Getting started</TbText>
        <TbText TextStyle="TextStyle.Subtitle" class="docs-lead">
            Add Trailblazor to a Blazor app for .NET 10, check that it works, and choose a render mode.
        </TbText>
    </Header>
    <ChildContent>
        <DocsHeading Id="set-up" Text="Set up an app" Class="docs-section" />
        <TbText>
            Trailblazor is in development and isn't available to install yet, so these steps show the setup you'll
            follow once it is. Start from a Blazor app with interactive server rendering, as <code>dotnet new blazor
            --interactivity Server</code> creates. Six steps add Trailblazor to it and check that it works.
        </TbText>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">1. Add the library</TbText>
        <TbText>
            This step will show how to add the library once it's available to install.
        </TbText>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">2. Register the services</TbText>
        <TbText>
            In <code>Program.cs</code>, register Trailblazor's services: dialogs, toasts, screen-reader announcements
            and the <a href="guides/browser">browser service</a>.
        </TbText>
        <CodeBlock Label="Program.cs" Code="@Services" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">3. Import the namespace</TbText>
        <CodeBlock Label="_Imports.razor" Code="@Imports" />
        <TbText>
            If another namespace imported there also has a <code>Size</code>, <code>Icon</code> or <code>Variant</code>
            type, such as another component library's, those names become ambiguous (error CS0104). Choose
            Trailblazor's with an alias in <code>_Imports.razor</code> too. A <code>global using</code> alias in a
            <code>.cs</code> file doesn't help while the namespaces are imported here, because these imports are
            searched first. It works only when both namespaces are imported with <code>global using</code> as well.
        </TbText>
        <CodeBlock Label="_Imports.razor, with another library" Code="@Aliases" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">4. Set up App.razor</TbText>
        <TbText>
            Put <code>&lt;TbStyles /&gt;</code> and <code>&lt;TbThemeHead /&gt;</code> in the <code>&lt;head&gt;</code>,
            outside the <code>HeadOutlet</code>. <code>TbStyles</code> renders once with the page, so the styles never
            drop out when the page becomes interactive. <code>TbThemeHead</code> starts the page in the user's theme
            before it paints, so a dark page never flashes light. Here is the whole file for an app that is interactive
            throughout:
        </TbText>
        <CodeBlock Label="App.razor" Code="@App" />
        <TbText>
            A standalone WebAssembly app links the stylesheet in its index.html instead, and copies the theme script as
            <a href="guides/theming#light-and-dark">the theming guide</a> shows.
        </TbText>
        <CodeBlock Label="index.html, standalone WebAssembly" Code="@IndexHead" />
        <TbText>
            By default, <code>TbThemeHead</code> follows the device's light or dark setting. If your app's own pages
            aren't designed for dark, set the mode to light instead. In a standalone WebAssembly app, also set the theme
            script's <code>data-mode</code> to <code>light</code>.
        </TbText>
        <CodeBlock Label="Program.cs, light only" Code="@LightOnly" />
        <DocsCallout Tone="Tone.Warning" Title="Another library's CSS">
            Rules outside a cascade layer, such as a reset in another library's stylesheet, win over Trailblazor's and
            can strip the components' spacing or square their buttons. Once the page is interactive, Trailblazor names
            the same-origin stylesheets that have them in the browser's console.
            <a href="guides/theming#other-stylesheets">Other stylesheets</a> in the theming guide shows how to put them
            in a layer that Trailblazor's styles win over.
        </DocsCallout>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">5. Add TbRoot to the layout</TbText>
        <TbText>
            Put one <code>&lt;TbRoot /&gt;</code> in the main layout. It hosts the dialogs, toasts and announcements
            that services open from code. <a href="guides/getting-started#host">Host dialogs and toasts</a> explains
            what it needs from the app's render mode.
        </TbText>
        <CodeBlock Label="MainLayout.razor" Code="@Layout" />

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">6. Check your setup</TbText>
        <TbText>
            A plain button works without most of the setup, so check with something that needs more of it: a button that
            opens a dialog and then a toast. Try it here, then put the code below on a page of your own.
        </TbText>
        <div class="docs-example">
            <TbButton OnClick="CheckAsync">Check the setup</TbButton>
        </div>
        <CodeBlock Label="Check your setup" Code="@Check" />
        <TbText>If it doesn't work, the symptom says what is missing:</TbText>
        <ul>
            <li>
                <strong>Nothing happens when you click.</strong> The page isn't interactive, so give it a render mode,
                as
                in step 4.
            </li>
            <li>
                <strong>A warning is logged, and no dialog shows.</strong> No <code>TbRoot</code> hosts it in this
                page's
                session, as <a href="guides/getting-started#host">Host dialogs and toasts</a> explains.
            </li>
            <li><strong>The button or dialog has no styling.</strong> <code>TbStyles</code> is missing from the
            head.</li>
            <li>
                <strong>The page ignores the device's dark setting and forgets a chosen theme on reload.</strong>
                <code>TbThemeHead</code> is missing from the head.
            </li>
        </ul>

        <DocsHeading Id="host" Text="Host dialogs and toasts" Class="docs-section" />
        <TbText>
            The dialogs and toasts a page opens show only when <code>TbRoot</code> hosts them in the same interactive
            session as that page. How to set that up depends on where the app sets its render mode.
        </TbText>
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">When the whole app is interactive</TbText>
        <TbText>
            With the same render mode on <code>Routes</code> and <code>HeadOutlet</code>, as in step 4, the layout is
            interactive too, so <code>TbRoot</code> already shares each page's session.
        </TbText>
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">When interactivity is set page by page</TbText>
        <TbText>
            Here, as in the default Blazor template, the layout renders statically. Give <code>TbRoot</code> the render
            mode your interactive pages use, and it hosts dialogs, toasts and announcements in that mode.
        </TbText>
        <CodeBlock Label="MainLayout.razor, interactivity per page" Code="@PerPageLayout" />
        <DocsCallout Tone="Tone.Warning" Title="Every page starts a session">
            With a render mode on <code>TbRoot</code>, every page starts an interactive session for it, even a fully
            static page. Only pages in that same render mode can open its dialogs, toasts and announcements.
        </DocsCallout>
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">In either setup</TbText>
        <ul>
            <li>
                If a page shows a dialog, toast or announcement and no <code>TbRoot</code> in its session hosts it
                within a second, Trailblazor logs a warning saying so.
            </li>
            <li>The dialog and toast services can be called from any thread, such as a SignalR hub handler.</li>
        </ul>

        <DocsHeading Id="render-modes" Text="Render modes" Class="docs-section" />
        <TbText>
            Every component works in Interactive Server, Interactive WebAssembly and Interactive Auto. Pages rendered
            statically on the server still show every component, with these differences:
        </TbText>
        <ul>
            <li>Fields post their values with a form.</li>
            <li>A select renders the browser's own <code>&lt;select&gt;</code>.</li>
            <li>
                Anything that responds to clicks or keys, such as a dialog, a menu or tabs, needs an interactive render
                mode.
            </li>
        </ul>

        <DocsHeading Id="options" Text="App-wide options" Class="docs-section" />
        <TbText>
            <code>AddTrailblazor</code> takes the settings that apply to every dialog and toast. A dialog's own options
            still override them.
        </TbText>
        <CodeBlock Label="App-wide options" Code="@Options" />

        <DocsHeading Id="next-steps" Text="Next steps" Class="docs-section" />
        <ul>
            <li>
                <a href="guides/forms">Forms and validation</a>: check what people enter and show them what to fix.
            </li>
            <li><a href="guides/theming">Theming</a>: light and dark, palettes, density and design tokens.</li>
            <li><a href="guides/testing">Testing</a>: bUnit and Playwright helpers for your pages.</li>
            <li>
                <a href="guides/accessibility">Accessibility</a>: what components do, and what your app must still do.
            </li>
            <li><a href="guides/analyzers">Analyzers</a>: warnings that catch unnamed controls as you build.</li>
            <li><a href="guides/wrapping">Wrapping components</a>: give a component your app's defaults in one place.</li>
            <li><a href="recipes/sign-up">Recipes</a>: components combined for common tasks, starting with a sign-up form.</li>
            <li><a href="components/button">Button</a>, and every other component's page.</li>
        </ul>
        <GuideFooter Page="GetType()" />
    </ChildContent>
</DocsArticle>

@code {
    private async Task CheckAsync()
    {
        if (await Dialogs.ConfirmAsync("Is this dialog showing?", "Then TbRoot is hosting it.", "Yes", "No"))
        {
            Toasts.Show("Trailblazor is set up.", Tone.Success);
        }
    }

    private const string Services = """
        builder.Services.AddTrailblazor();
        """;

    private const string App = """
        <!DOCTYPE html>
        <html lang="en">

        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <base href="/" />
            <TbStyles />
            <TbThemeHead />
            <HeadOutlet @rendermode="InteractiveServer" />
        </head>

        <body>
            <Routes @rendermode="InteractiveServer" />
            <script src="_framework/blazor.web.js"></script>
        </body>

        </html>
        """;

    private const string IndexHead = """
        <link rel="stylesheet" href="_content/Trailblazor/trailblazor.css" />
        """;

    private const string Imports = """
        @using Trailblazor
        """;

    private const string Aliases = """
        @using Trailblazor
        @using OtherLibrary
        @using Size = Trailblazor.Size
        @using Icon = Trailblazor.Icon
        @using Variant = Trailblazor.Variant
        """;

    private const string LightOnly = """
        builder.Services.AddTrailblazor(options => options.Theme.Mode = ThemeMode.Light);
        """;

    private const string Layout = """
        @inherits LayoutComponentBase

        <TbRoot />

        <main>
            @Body
        </main>
        """;

    private const string PerPageLayout = """
        @inherits LayoutComponentBase

        <TbRoot HostRenderMode="InteractiveServer" />

        <main>
            @Body
        </main>
        """;

    private const string Check = """
        @inject IDialogService Dialogs
        @inject IToastService Toasts

        <TbButton OnClick="CheckAsync">Check the setup</TbButton>

        @code {
            private async Task CheckAsync()
            {
                if (await Dialogs.ConfirmAsync("Is this dialog showing?", "Then TbRoot is hosting it.", "Yes", "No"))
                {
                    Toasts.Show("Trailblazor is set up.", Tone.Success);
                }
            }
        }
        """;

    private const string Options = """
        using Trailblazor;

        builder.Services.AddTrailblazor(options =>
        {
            options.Dialogs.DismissOnBackdrop = false;
            options.Toasts.Position = ToastPosition.BottomEnd;
        });
        """;
}
