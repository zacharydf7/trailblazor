    <Header>
        <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Telemetry</TbText>
        <TbText TextStyle="TextStyle.Subtitle" class="docs-lead">
            Trailblazor's components count what people see and use, so you can tell which features matter and which
            nobody touches, in the dashboard you already have. Label a control with <code>TelemetryName</code>, listen
            to the <code>Trailblazor</code> meter, and the counts arrive with the rest of your app's telemetry. Nothing
            is recorded until you listen, and nothing leaves your app unless you send it.
        </TbText>
    </Header>
    <ChildContent>
        <DocsHeading Id="try-it" Text="Try it" Class="docs-section" />
        <TbText>
            These buttons carry a <code>TelemetryName</code>, and this page listens to the <code>Trailblazor</code>
            meter in your browser, as your app's OpenTelemetry setup would.
        </TbText>
        <ul>
            <li>Each button counts as shown when it renders, and as used when you click it.</li>
            <li>
                The disabled one is shown but can't be used, which is exactly the kind of gap the counts reveal.
            </li>
            <li>
                The menu counts each time it opens, by pointer or key, and its items count only when chosen, since
                they're hidden until then.
            </li>
        </ul>
        <TelemetryDemo />

        <DocsHeading Id="what-its-for" Text="What it's for" Class="docs-section" />
        <ul class="docs-notes">
            <li>
                <strong>Feature adoption, with the zeros.</strong> Analytics tools count the clicks they see, so a
                feature nobody uses simply never appears. Trailblazor counts a labeled control as shown when it renders,
                so a feature that is shown but never used stands out, and you can see how often each one is reached at
                all.
            </li>
            <li>
                <strong>Reports per customer.</strong> Add your own tags, such as the customer or plan a user belongs
                to, and every count carries them. A team that ships one app to many customers can show each of them
                what their people use.
            </li>
            <li>
                <strong>In your own pipeline.</strong> The counts go through .NET's standard metrics, so OpenTelemetry
                sends them wherever your app already sends its telemetry: the Aspire dashboard, Prometheus and Grafana,
                Azure Monitor, or any OpenTelemetry backend. There is no Trailblazor service and no account.
            </li>
        </ul>

        <DocsHeading Id="use-cases" Text="Use cases" Class="docs-section" />
        <TbText>
            Different apps ask different questions. Each row says what to label and which counts answer it. Start with a
            few names on the features you're least sure about, then add more as the questions come.
        </TbText>
        <div class="docs-api" tabindex="0" role="region" aria-label="Use cases">
            <table>
                <thead>
                    <tr>
                        <th scope="col">For</th>
                        <th scope="col">The question</th>
                        <th scope="col">Label</th>
                        <th scope="col">Read</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var useCase in UseCases)
                    {
                        <tr>
                            <th scope="row">@useCase.For</th>
                            <td>@useCase.Question</td>
                            <td>@DocsText.Render(useCase.Label)</td>
                            <td>@DocsText.Render(useCase.Read)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <DocsHeading Id="set-it-up" Text="Set it up" Class="docs-section" />
        <ol>
            <li>
                Listen to the meter in your OpenTelemetry setup, with the exporter for your backend.
                <code>AddTrailblazor</code> already registers the meter.
            </li>
            <li>Label the controls you want counted.</li>
        </ol>
        <CodeBlock Label="Program.cs" Code="@Setup" />
        <CodeBlock Label="Labeled buttons" Code="@Labels" />

        <DocsHeading Id="choosing-names" Text="Choosing names" Class="docs-section" />
        <ul class="docs-notes">
            <li>
                A <code>TelemetryName</code> is a label you put on a control so the app can count how often people see
                it and use it. It names what the control does for the user, never the user. It isn't a credential,
                and it never hides or gates a control.
            </li>
            <li>
                Controls that share a name count together. Give the toolbar's Export button and the dialog's Export
                button the same <code>"export-csv"</code> to count the feature, or different names to compare the two
                ways in.
            </li>
            <li>
                A control without a name isn't counted, so leave it off buttons such as OK and Cancel that aren't worth
                measuring.
            </li>
        </ul>
        <DocsCallout Tone="Tone.Warning" Title="Keep names stable, short and few">
            Dashboards group by them. A name made from data, such as a record's id, would split the counts and could
            leak what users work on.
        </DocsCallout>

        <DocsHeading Id="what-each-control-counts" Text="What each control counts" Class="docs-section" />
        <ul class="docs-notes">
            <li>
                <strong>Buttons, icon buttons, links, list items, toggle items, checkboxes and switches:</strong> shown
                as they first render, and used each time they are clicked, pressed or changed. A switch counts that it
                changed, never to what.
            </li>
            <li>
                <strong>Toolbar buttons:</strong> shown as they render, and used each time they're chosen, in the
                toolbar or from its overflow menu. The button counts as a <code>TbButton</code> or
                <code>TbIconButton</code>, and its overflow item as a <code>TbMenuItem</code>, under the same name.
            </li>
            <li>
                <strong>Tabs:</strong> a tab's header is shown as it renders, and the tab is used each time the user
                selects it.
            </li>
            <li>
                <strong>Menus, context menus, popovers and menu items:</strong> a labeled menu, context menu or popover
                is shown as it renders and used each time it opens, by pointer or key, which is how often its contents
                are seen; a labeled item,
                checkbox item or radio item counts its uses only, since it renders hidden until the menu opens.
            </li>
            <li>
                <strong>Selects and list boxes:</strong> a labeled one is shown as it renders and used for each choice,
                tagged with <code>trailblazor.input</code> set to <code>pointer</code> or <code>keyboard</code>, which
                shows how many people choose by keyboard. Which value was chosen is never recorded.
            </li>
            <li>
                <strong>Options:</strong> a labeled option counts its uses only, since its list renders hidden, and
                counts nothing when a disabled or read-only list box refuses the choice.
            </li>
            <li>
                <strong>Fields:</strong> every field takes a <code>TelemetryName</code>, shown as it renders and counted
                in <code>trailblazor.field.invalid</code> each time its <code>TbForm</code> is submitted while it has an
                error, so the fields people trip over stand out. No value is ever recorded.
            </li>
            <li>
                <strong>Forms:</strong> a labeled form counts each submit it validates in
                <code>trailblazor.form.submitted</code>, with the outcome <code>valid</code> or <code>invalid</code>.
            </li>
            <li>
                <strong>Dialogs:</strong> give <code>DialogOptions.TelemetryName</code>, or <code>ConfirmAsync</code>
                and <code>AlertAsync</code> a <code>telemetryName</code>, and each open counts as shown, then
                <code>trailblazor.dialog.closed</code> and <code>trailblazor.dialog.duration</code> say how it closed:
                <code>confirmed</code>, <code>cancelled</code>, <code>escape</code>, <code>backdrop</code> or
                <code>close_button</code>, and how long it was open. Its title and result are never recorded.
            </li>
            <li>
                <strong>Command palettes:</strong> shown as they render, and used with the action
                <code>choose</code> and the input <code>pointer</code> or <code>keyboard</code> each time the user runs
                a command. Which command is never recorded.
            </li>
            <li>
                <strong>Toasts:</strong> with <code>ToastOptions.TelemetryName</code>, each toast counts as shown, then
                <code>trailblazor.toast.closed</code> says whether its action was taken, it was dismissed, it timed out
                or the app closed it. Its message is never recorded.
            </li>
            <li>
                <strong>Chips:</strong> shown as they render, used for each click or toggle, and used with the action
                <code>remove</code> when removed.
            </li>
            <li>
                <strong>Data grids:</strong> shown as they render, and used with an action for each thing the user does:
                <code>sort</code>, <code>filter</code>, <code>page</code>, <code>page_size</code>, <code>select</code>,
                <code>move</code>, <code>group</code>, <code>expand</code>, <code>collapse</code>, <code>edit</code>,
                <code>resize</code>, <code>reorder</code>, <code>hide</code> and <code>show</code>.
                Which rows or columns were involved, or what value an edit saved, is never recorded.
            </li>
            <li>
                <strong>Tree views:</strong> shown as they render, and used with an action: <code>expand</code>,
                <code>collapse</code>, <code>select</code>, <code>check</code>, <code>activate</code> or
                <code>move</code>. For grids and trees alike, what code does, such as opening rows or scrolling to one,
                isn't counted.
            </li>
        </ul>

        <DocsHeading Id="whats-recorded" Text="What's recorded" Class="docs-section" />
        <TbText>Every instrument of the <code>@TelemetryCatalog.MeterName</code> meter carries:</TbText>
        <ul>
            <li><code>trailblazor.telemetry_name</code>: the control's <code>TelemetryName</code>.</li>
            <li><code>trailblazor.component</code>: its type, such as <code>TbButton</code>.</li>
            <li>Any tags your app adds.</li>
        </ul>
        <TbText>
            Uses also carry <code>trailblazor.action</code>, what the component did, for components that do more than
            one thing. The table shows each instrument's tags.
        </TbText>
        <div class="docs-api" tabindex="0" role="region" aria-label="The Trailblazor meter's instruments">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Instrument</th>
                        <th scope="col">Type</th>
                        <th scope="col">Unit</th>
                        <th scope="col">Tags</th>
                        <th scope="col">Recorded when</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instrument in TelemetryCatalog.Instruments)
                    {
                        <tr>
                            <th scope="row"><code>@instrument.Name</code></th>
                            <td>@instrument.Kind</td>
                            <td><code>@instrument.Unit</code></td>
                            <td>
                                @foreach (var tag in instrument.Tags)
                                {
                                    <code>@tag</code>@(" ")
                                }
                            </td>
                            <td>@instrument.When</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <TbText>
            Each component's page lists what that component reports, under Telemetry. Counts start with the first
            interactive render, so a statically rendered page reports nothing, and a prerendered one counts once, not
            twice.
        </TbText>

        <DocsHeading Id="whats-never-recorded" Text="What's never recorded" Class="docs-section" />
        <ul class="docs-notes">
            <li>
                Values, text people type, dialog and page titles, labels' text and anything about the user. Only the
                names you give and the components' types are recorded; that's by design and can't be configured.
            </li>
            <li>
                Nothing is recorded until something listens to the meter, and nothing leaves the app unless the app
                exports it. Trailblazor never sends anything anywhere itself.
            </li>
        </ul>
        <DocsCallout Tone="Tone.Warning" Title="Keep your own tags clean">
            They go on every count, so never put a user's name, email or id in them.
        </DocsCallout>
        <DocsCallout Tone="Tone.Warning" Title="Consent for browser telemetry">
            Sending telemetry from the browser, as a WebAssembly app does, can need the user's consent under EU rules
            even when no personal data is in it. Ask your own privacy advisers; the app decides when to export.
        </DocsCallout>

        <DocsHeading Id="your-own-tags" Text="Your own tags" Class="docs-section" />
        <TbText>
            Register an <code>ITelemetryTags</code>, scoped when the tags depend on who is signed in, and its tags go on
            every count. Keep each tag to a small set of values, such as a customer or a plan, since every value is a
            series in the dashboard.
        </TbText>
        <CodeBlock Label="Tags for the user's customer" Code="@Tags" />

        <DocsHeading Id="render-modes" Text="Render modes" Class="docs-section" />
        <ul class="docs-notes">
            <li>
                <strong>Interactive Server:</strong> the components run on the server, so the server's OpenTelemetry
                setup exports the counts with nothing more to do.
            </li>
            <li>
                <strong>WebAssembly:</strong> the components run in the browser, so the client exports the counts; see
                the steps below.
            </li>
            <li>
                <strong>Auto:</strong> set up both: the server's export for its renders, and the client's for after the
                WebAssembly runtime takes over.
            </li>
            <li><strong>Static rendering:</strong> nothing is counted, since nothing runs after the page is sent.</li>
        </ul>

        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">Export from WebAssembly</TbText>
        <ol>
            <li>
                Turn on <code>MetricsSupport</code> in the client project, which .NET 10 leaves off for WebAssembly.
            </li>
            <li>Use OpenTelemetry .NET 1.15.2 or later, which can export from the browser's single thread.</li>
            <li>
                Send over HTTP with protobuf to an endpoint on your own server that forwards to your collector. Your
                server adds any API keys the collector needs, so none reach the browser and no CORS setup is needed.
            </li>
            <li>
                Resolve OpenTelemetry's <code>MeterProvider</code> before running the app. WebAssembly runs no hosted
                services, so otherwise nothing starts listening.
            </li>
        </ol>
        <CodeBlock Label="The WebAssembly client" Code="@WebAssembly" />
        <TbText>The Aspire dashboard's guide to Blazor WebAssembly telemetry shows the relay.</TbText>

        <DocsHeading Id="reading-the-counts" Text="Reading the counts" Class="docs-section" />
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">In the Aspire dashboard</TbText>
        <ol>
            <li>Open Metrics and choose the app.</li>
            <li>Choose the <code>Trailblazor</code> meter, then <code>trailblazor.control.used</code>.</li>
            <li>Split it by <code>trailblazor.telemetry_name</code>.</li>
        </ol>
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">In Prometheus</TbText>
        <TbText>
            The OpenTelemetry exporter names the counters <code>trailblazor_control_shown_total</code> and
            <code>trailblazor_control_used_total</code>, and the tag <code>trailblazor_telemetry_name</code>. Features
            shown in the last month but never used:
        </TbText>
        <CodeBlock Label="Shown but never used, in PromQL" Code="@NeverUsed" Language="CodeLanguage.Plain" />
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">Controls nobody reached</TbText>
        <TbText>
            A control only counts as shown once it renders, so one on a page nobody opens never appears at all.
            <code>trailblazor.control.catalog</code> lists every control the app has, shown or not: when the app
            builds, Trailblazor reads each literal <code>TelemetryName</code> in its <code>.razor</code> files. For a
            name set from code or bound to a value, add a <code>TelemetryCatalogEntry</code> attribute yourself.
        </TbText>
        <CodeBlock Label="A name set from code" Code="@CatalogEntry" />
        <TbText>
            The catalog names a control's component as the markup does, so a wrapper such as <code>AppButton</code>
            keeps its own name, and it carries none of your own tags. Match it to the other counts by
            <code>trailblazor_telemetry_name</code> alone. It only starts reporting after a labeled control renders, so
            the query looks back over the month rather than at this moment. A name in an assembly that a WebAssembly
            app loads lazily, or in markup written inside an <code>@@code</code> block, needs an attribute in the main
            app. Controls the app has but nobody saw in the last month:
        </TbText>
        <CodeBlock Label="Never shown, in PromQL" Code="@NeverShown" Language="CodeLanguage.Plain" />

        <DocsHeading Id="testing" Text="Testing" Class="docs-section" />
        <TbText>
            Check what a page reports in bUnit with <code>MetricCollector&lt;T&gt;</code> from
            <code>Microsoft.Extensions.Diagnostics.Testing</code>. Pass it the test's <code>IMeterFactory</code>, so it
            hears only this test's components, even with other tests running alongside.
        </TbText>
        <CodeBlock Label="A bUnit test" Code="@Test" />

        <DocsHeading Id="cost-and-turning-it-off" Text="Cost and turning it off" Class="docs-section" />
        <ul>
            <li>When nothing listens, a count is one check, well under a nanosecond.</li>
            <li>When something listens, a count costs tens of nanoseconds, far less than a render.</li>
        </ul>
        <TbText>An app that listens to every meter but doesn't want its UI counted turns the components off:</TbText>
        <CodeBlock Label="Turning the counts off" Code="@Off" />

        <DocsHeading Id="api" Text="API" Class="docs-section" />
        <ApiTable Type="typeof(TelemetrySettings)" />
        <ApiTable Type="typeof(ITelemetryTags)" />
        <ApiTable Type="typeof(TelemetryCatalogEntryAttribute)" />

        <DocsHeading Id="related" Text="Related" Class="docs-section" />
        <ul>
            <li><a href="guides/testing">Testing</a>: bUnit and Playwright helpers for your pages.</li>
            <li><a href="components/data-grid#telemetry">Data grid</a>: what one component reports.</li>
        </ul>
        <GuideFooter Page="GetType()" />
    </ChildContent>
</DocsArticle>

@code {
    private sealed record UseCase(string For, string Question, string Label, string Read);

    private static readonly UseCase[] UseCases =
    [
        new("Internal business apps", "Which screens and actions does the team use, and what could we retire?",
            "The buttons, menus and tabs of each screen, such as `bulk-approve` and `export-csv`.",
            "Names in `trailblazor.control.shown` with no `trailblazor.control.used` over a quarter: features "
            + "nobody uses."),
        new("Product teams", "Did the new feature land?",
            "Every way into the feature, under one name, such as `smart-filters`.",
            "Used divided by shown, week by week after release; with your own tags, by plan or rollout group."),
        new("Vendors with many customers", "What does each customer use, and which paid features sit idle?",
            "The features as above, and an `ITelemetryTags` that adds the customer.",
            "`trailblazor.control.used` grouped by your customer tag, for account reviews and renewals."),
        new("Forms and data entry", "Where do people get stuck?", "The `TbForm` and its fields.",
            "Invalid submits in `trailblazor.form.submitted`, and `trailblazor.field.invalid` by field: the fields "
            + "to fix first."),
        new("Destructive actions", "Do people mean it when they press Delete?",
            "`ConfirmAsync` with a `telemetryName`, such as `delete-trail`.",
            "`trailblazor.dialog.closed` by outcome: many cancels can mean the action is too easy to hit, or its "
            + "words unclear."),
        new("Notifications", "Does anyone use Undo?", "The toast, with `ToastOptions.TelemetryName`.",
            "`trailblazor.toast.closed` with the outcome `action` against `timed_out`."),
        new("Long tasks", "Which tasks take people longest, and which do they give up on?",
            "The dialogs that hold them, such as `edit-trail`.",
            "`trailblazor.dialog.duration` by outcome: a long time before a cancel suggests confusion."),
        new("Data-heavy screens", "How do people work through big lists?", "Data grids and tree views.",
            "`trailblazor.control.used` by `trailblazor.action`: sorts and page sizes to set better defaults, "
            + "expands and moves to see how a tree is used."),
        new("Accessibility", "How many people choose by keyboard, and close dialogs with Escape?",
            "Selects, list boxes, their options, and dialogs.",
            "`trailblazor.control.used` by `trailblazor.input`, and dialogs closed with `escape`: real keyboard use "
            + "to test against."),
    ];

    private const string Setup = """
        builder.Services.AddTrailblazor();
        builder.Services.AddOpenTelemetry()
            .WithMetrics(metrics => metrics
                .AddMeter("Trailblazor")
                .AddOtlpExporter());
        """;

    private const string Labels = """
        <TbButton TelemetryName="export-csv" OnClick="ExportAsync">Export</TbButton>
        <TbIconButton TelemetryName="share-link" Icon="MaterialSymbols.Outlined.Share"
                      AriaLabel="Share" OnClick="Share" />
        <TbButton TelemetryName="trail-guide" Href="guides/trails" Variant="Variant.Text">
            Trail guide
        </TbButton>
        """;

    private const string Tags = """
        public sealed class CustomerTags(CurrentCustomer customer) : ITelemetryTags
        {
            public IEnumerable<KeyValuePair<string, object?>> Tags =>
                [new("app.customer", customer.Slug)];
        }

        builder.Services.AddScoped<ITelemetryTags, CustomerTags>();
        """;

    private const string WebAssembly = """
        <!-- Client.csproj -->
        <PropertyGroup>
          <MetricsSupport>true</MetricsSupport>
        </PropertyGroup>

        // Client Program.cs: send to the app's own server, which forwards
        // to the collector.
        builder.Services.AddOpenTelemetry()
            .WithMetrics(metrics => metrics
                .AddMeter("Trailblazor")
                .AddOtlpExporter(exporter =>
                {
                    exporter.Protocol = OtlpExportProtocol.HttpProtobuf;
                    var server = new Uri(builder.HostEnvironment.BaseAddress);
                    exporter.Endpoint = new Uri(server, "_otlp/v1/metrics");
                }));

        var host = builder.Build();
        // WebAssembly runs no hosted services, so OpenTelemetry starts
        // listening once its provider is resolved.
        host.Services.GetRequiredService<MeterProvider>();
        await host.RunAsync();
        """;

    private const string NeverUsed = """
        sum by (trailblazor_telemetry_name)
          (increase(trailblazor_control_shown_total[30d]))
        unless
        sum by (trailblazor_telemetry_name)
          (increase(trailblazor_control_used_total[30d]) > 0)
        """;

    private const string CatalogEntry = """
        // In any .cs file of the app. The page binds
        // TelemetryName="@($"export-{format}")", so list each name it takes.
        [assembly: TelemetryCatalogEntry("export-csv", "TbButton")]
        [assembly: TelemetryCatalogEntry("export-pdf", "TbButton")]
        """;

    private const string NeverShown = """
        sum by (trailblazor_telemetry_name)
          (max_over_time(trailblazor_control_catalog[30d]))
        unless
        sum by (trailblazor_telemetry_name)
          (increase(trailblazor_control_shown_total[30d]) > 0)
        """;

    private const string Test = """
        [Fact]
        public void Export_ShouldBeCounted_WhenClicked()
        {
            this.AddTrailblazor();
            var meters = Services.GetRequiredService<IMeterFactory>();
            using var used = new MetricCollector<long>(meters,
                "Trailblazor", "trailblazor.control.used");
            var page = Render<ReportsPage>();

            page.Find("button").Click();

            var count = Assert.Single(used.GetMeasurementSnapshot());
            Assert.Equal("export-csv", count.Tags["trailblazor.telemetry_name"]);
        }
        """;

    private const string Off = """
        builder.Services.AddTrailblazor(options => options.Telemetry.Enabled = false);
        """;
}
