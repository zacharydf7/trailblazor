@page "/components/{Name}/api"
@using Trailblazor.Docs.Examples

@if (ExampleCatalog.Find(Name) is { } example)
{
    <PageTitle>@example.Title API · Trailblazor</PageTitle>
    <DocsArticle @key="example.Name" Class="docs-article--api">
        <Contents>
            @if (example.Anatomy is not null)
            {
                <TbTableOfContentsItem TargetId="anatomy" Text="Anatomy" />
            }
            @foreach (var api in example.Api.Select(ApiDocs.Describe))
            {
                <TbTableOfContentsItem TargetId="@api.Id" Text="@api.Name">
                    @foreach (var group in api.Groups)
                    {
                        <TbTableOfContentsItem TargetId="@ApiTable.GroupId(api, group)" Text="@group.Name" />
                    }
                </TbTableOfContentsItem>
            }
            @if (example.DataParts.Count > 0)
            {
                <TbTableOfContentsItem TargetId="parts" Text="Parts" />
            }
        </Contents>
        <Header>
            <ComponentHeader Example="example" Api />
        </Header>
        <ChildContent>
            @if (example.Anatomy is { } anatomy)
            {
                <DocsHeading Id="anatomy" Text="Anatomy" Class="docs-section" />
                <TbText>Which parts go inside which:</TbText>
                <CodeBlock Label="Anatomy" Code="@anatomy" />
            }
            @if (example.Api.Any(type => type.IsAssignableTo(typeof(IComponent))))
            {
                <TbText class="docs-note">
                    Every component also takes <code>Class</code>, <code>Style</code> and any other HTML attribute, such
                    as <code>aria-*</code>, and puts them on its outer element. An <code>id</code> goes on the part
                    users act on, such as a field's input or a menu's trigger, as the Testing guide lists.
                </TbText>
            }
            @foreach (var type in example.Api)
            {
                <ApiTable Type="type" HeadingLevel="TextElement.H2" />
            }
            @if (example.DataParts.Count > 0)
            {
                <DocsHeading Id="parts" Text="Parts" Class="docs-section" />
                <TbText>
                    Each part carries a stable <code>data-part</code> name: a test can find it when a role can't, and
                    a stylesheet can target it, as with <code>[data-part=@example.DataParts[0].Name]</code>.
                </TbText>
                <div class="docs-api" role="region" tabindex="0" aria-label="Parts">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Part</th>
                                <th scope="col">What it is</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var part in example.DataParts)
                            {
                                <tr>
                                    <th scope="row"><code>@part.Name</code></th>
                                    <td>@part.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <ComponentPager Example="example" />
        </ChildContent>
    </DocsArticle>
}
else
{
    <PageTitle>Not found · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Not found</TbText>
    <TbText>There is no component named @Name.</TbText>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";
}
