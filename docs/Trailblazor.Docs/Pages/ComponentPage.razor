@page "/components/{Name}"
@using Trailblazor.Docs.Examples

@if (ExampleCatalog.Find(Name) is { } example)
{
    <PageTitle>@example.Title · Trailblazor</PageTitle>
    @* Keyed, so the next component starts with its code hidden and its contents folded. *@
    <DocsArticle @key="example.Name">
        <Contents>
            @if (HasUsage(example))
            {
                <TbTableOfContentsItem TargetId="usage" Text="Usage" />
            }
            @foreach (var section in example.Shown)
            {
                <TbTableOfContentsItem TargetId="@section.Id" Text="@section.Title" />
            }
            <TbTableOfContentsItem TargetId="accessibility" Text="Accessibility" />
            @if (example.NotesShown.Count > 0)
            {
                <TbTableOfContentsItem TargetId="notes" Text="Notes and limitations" />
            }
            <TbTableOfContentsItem TargetId="telemetry" Text="Telemetry" />
            <TbTableOfContentsItem TargetId="design-tokens" Text="Design tokens" />
            <TbTableOfContentsItem TargetId="testing" Text="Testing" />
            @if (example.Related.Count > 0)
            {
                <TbTableOfContentsItem TargetId="related" Text="Related" />
            }
        </Contents>
        <Header>
            <ComponentHeader Example="example" />
        </Header>
        <ChildContent>
            @if (HasUsage(example))
            {
                <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="usage">Usage</TbText>
                @if (example.WhenToUse.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="when-to-use">When to use</TbText>
                    @Notes("When to use", example.WhenToUse)
                }
                @if (example.WhenNotToUse.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="when-not-to-use">
                        When not to use
                    </TbText>
                    @Notes("When not to use", example.WhenNotToUse)
                }
            }

            @foreach (var section in example.Shown)
            {
                <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="@section.Id">
                    @section.Title
                </TbText>
                @if (section.Description is { } description)
                {
                    <TbText>@DocsText.Render(description)</TbText>
                }
                <ExampleFrame Name="@example.Name" Section="section" FullWidth="example.FullWidth" />
            }

            <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="accessibility">
                Accessibility
            </TbText>
            @if (example.Pattern is { } pattern)
            {
                <TbText>
                    It follows the <a href="@pattern.Url">@pattern.Name pattern</a> from the WAI-ARIA Authoring
                    Practices.
                </TbText>
            }
            @if (example.HasAccessibilityParts)
            {
                @if (example.Keyboard.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="keyboard">Keyboard</TbText>
                    <KeyboardTable Rows="example.Keyboard" />
                    @if (example.RightToLeftKeys is { } swapped)
                    {
                        <TbText>@DocsText.Render(swapped)</TbText>
                    }
                }
                @if (example.LabelingNotes.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="labeling">Labeling</TbText>
                    @Notes("Labeling", example.LabelingNotes)
                }
                @if (example.Announcements.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="announcements">
                        What screen readers announce
                    </TbText>
                    @Notes("What screen readers announce", example.Announcements)
                }
                <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="what-it-does">
                    What the component does
                </TbText>
                @Notes("Accessibility", example.Accessibility)
                @if (example.AppDuties.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="app-duties">
                        What your app must do
                    </TbText>
                    @Notes("What your app must do", example.AppDuties)
                }
                @if (example.BeforeInteractive.Count > 0)
                {
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" id="before-interactive">
                        Before the page is interactive
                    </TbText>
                    @Notes("Before the page is interactive", example.BeforeInteractive)
                }
            }
            else
            {
                @Notes("Accessibility", example.Accessibility)
            }

            @if (example.NotesShown.Count > 0)
            {
                <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="notes">
                    Notes and limitations
                </TbText>
                @foreach (var pitfall in example.NotesShown.Where(note => note.Pitfall))
                {
                    <DocsCallout Tone="Tone.Warning">@DocsText.Render(pitfall.Text)</DocsCallout>
                }
                @Notes("Notes and limitations", PlainNotes(example))
            }

            <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="telemetry">
                Telemetry
            </TbText>
            @if (example.TelemetryNotes.Count > 0)
            {
                @Notes("Telemetry", example.TelemetryNotes)
            }
            else
            {
                <TbText>It reports nothing through the <code>Trailblazor</code> meter.</TbText>
            }
            <TbText class="docs-note">
                The <a href="guides/telemetry">telemetry guide</a> shows how to see what people use, in the dashboard
                you already have.
            </TbText>

            <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="design-tokens">
                Design tokens
            </TbText>
            @if (DesignTokens.Read(example.Blocks) is { Count: > 0 } tokens)
            {
                <TbText>
                    Its styles read these tokens from the theme, so changing one restyles it along with everything
                    else that reads it. The <a href="guides/theming">theming guide</a> shows how.
                </TbText>
                <ul class="docs-tokens" aria-label="Design tokens">
                    @foreach (var token in tokens)
                    {
                        <li><code>@token</code></li>
                    }
                </ul>
            }
            else
            {
                <TbText>Its styles read no theme tokens.</TbText>
            }
            @if (DesignTokens.Hooks(example.Blocks) is { Count: > 0 } hooks)
            {
                <TbText>
                    It also has tokens of its own, which change only this component. Set one on the page or on any
                    element that contains it; a token you don't set keeps the default shown here.
                </TbText>
                <TbTable aria-label="Its own tokens" Size="Size.Small">
                    <thead>
                        <tr>
                            <th scope="col">Token</th>
                            <th scope="col">Default</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (name, fallback) in hooks)
                        {
                            <tr>
                                <th scope="row"><code>@name</code></th>
                                <td><code>@fallback</code></td>
                            </tr>
                        }
                    </tbody>
                </TbTable>
            }

            <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="testing">
                Testing
            </TbText>
            @if (example.Target is { } target)
            {
                <TbText>Find it by its role, the way a person finds it:</TbText>
                <CodeBlock Label="Finding it in Playwright" Code="@target.Steps" />
            }
            else
            {
                <TbText>
                    It has no role and name a test can single out, so find what it holds or what sits next to it.
                </TbText>
            }
            @if (example.TestingTip is { } tip)
            {
                <TbText>@DocsText.Render(tip)</TbText>
            }
            @if (example.DataParts.Count > 0)
            {
                <TbText>
                    Its parts carry a stable <code>data-part</code> name, for finding what a role can't, as with
                    <code>[data-part=@example.DataParts[0]]</code>:
                </TbText>
                <ul class="docs-tokens" aria-label="Data parts">
                    @foreach (var part in example.DataParts)
                    {
                        <li><code>@part</code></li>
                    }
                </ul>
            }
            <TbText class="docs-note">
                The <a href="guides/testing">testing guide</a> shows how to set up bUnit and Playwright.
            </TbText>

            @if (example.Related.Count > 0)
            {
                <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section" id="related">
                    Related
                </TbText>
                <ul class="docs-notes" aria-label="Related">
                    @foreach (var related in example.Related.Select(name => ExampleCatalog.Find(name)!))
                    {
                        <li><a href="@($"components/{related.Name}")">@related.Title</a>: @related.Summary</li>
                    }
                </ul>
            }

            <ComponentPager Example="example" />
        </ChildContent>
    </DocsArticle>
}
else
{
    <PageTitle>Not found · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Not found</TbText>
    <TbText>There is no component named @Name.</TbText>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";

    private static bool HasUsage(Example example) => example.WhenToUse.Count > 0 || example.WhenNotToUse.Count > 0;

    private static IReadOnlyList<string> PlainNotes(Example example) =>
        [.. example.NotesShown.Where(note => !note.Pitfall).Select(note => note.Text)];

    // A list of catalog notes, named so a test and a screen reader can tell the lists apart.
    private static RenderFragment Notes(string name, IReadOnlyList<string> notes) =>
        @<ul class="docs-notes" aria-label="@name">
            @foreach (var note in notes)
            {
                <li>@DocsText.Render(note)</li>
            }
        </ul>;
}
