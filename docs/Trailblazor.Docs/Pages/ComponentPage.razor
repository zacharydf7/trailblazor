@page "/components/{Name}"
@using Trailblazor.Docs.Examples

@if (ExampleCatalog.Find(Name) is { } example)
{
    <PageTitle>@example.Title · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">@example.Title</TbText>
    <TbText TextStyle="TextStyle.Subtitle" class="docs-lead">@example.Summary</TbText>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Example</TbText>
    <div class="docs-example">
        <DynamicComponent Type="example.Component" />
    </div>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Source</TbText>
    @foreach (var source in example.Sources)
    {
        <TbText TextStyle="TextStyle.Caption" As="TextElement.P" class="docs-source__file">@source.File</TbText>
        @* Scrolls on its own, so it takes focus for keyboard users. *@
        <pre class="docs-source" role="region" tabindex="0" aria-label="@source.File"><code>@source.Text</code></pre>
    }

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">API</TbText>
    @if (example.Api.Any(type => type.IsAssignableTo(typeof(IComponent))))
    {
        <TbText class="docs-note">
            Every component also takes <code>Class</code>, <code>Style</code> and any other HTML attribute, such as
            <code>id</code> or <code>aria-*</code>, and puts them on its outer element.
        </TbText>
    }
    @foreach (var type in example.Api.Select(ApiDocs.Describe))
    {
        <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3" class="docs-api__name">
            <code>@type.Name</code>
        </TbText>
        @if (type.Members.Count == 0)
        {
            <TbText>No parameters of its own.</TbText>
            continue;
        }

        @* Scrolls sideways on a narrow screen, so it takes focus for keyboard users. *@
        <div class="docs-api" role="region" tabindex="0" aria-label="@type.Name">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Type</th>
                        <th scope="col">Default</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in type.Members)
                    {
                        <tr>
                            <th scope="row">
                                <code>@member.Name</code>
                                @if (member.Required)
                                {
                                    <span class="docs-api__required">Required</span>
                                }
                            </th>
                            <td><code>@member.Type</code></td>
                            <td>@if (member.Default.Length > 0) { <code>@member.Default</code> }</td>
                            <td>@member.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <PageTitle>Not found · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Not found</TbText>
    <TbText>There is no component named @Name.</TbText>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";
}
