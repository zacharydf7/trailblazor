@page "/components/{Name}"
@using Trailblazor.Docs.Examples

@if (ExampleCatalog.Find(Name) is { } example)
{
    <PageTitle>@example.Title · Trailblazor</PageTitle>
    @* Keyed, so the next component starts with its code hidden and its contents folded. *@
    <DocsArticle @key="example.Name">
        <Contents>
            <TbTableOfContentsItem TargetId="usage" Text="Usage" />
            @foreach (var section in example.Sections)
            {
                <TbTableOfContentsItem TargetId="@section.Id" Text="@section.Title" />
            }
            <TbTableOfContentsItem TargetId="accessibility" Text="Accessibility" />
            @if (example.NotesShown.Count > 0)
            {
                <TbTableOfContentsItem TargetId="notes" Text="Notes and limitations" />
            }
            <TbTableOfContentsItem TargetId="telemetry" Text="Telemetry" />
            <TbTableOfContentsItem TargetId="design-tokens" Text="Design tokens" />
            <TbTableOfContentsItem TargetId="testing" Text="Testing" />
            <TbTableOfContentsItem TargetId="related" Text="Related" />
        </Contents>
        <Header>
            <ComponentHeader Example="example" />
        </Header>
        <ChildContent>
            <DocsHeading Id="usage" Text="Usage" Class="docs-section" />
            <DocsHeading Id="when-to-use" Text="When to use" Level="TextElement.H3" TextStyle="TextStyle.Subtitle" />
            @Notes("When to use", example.WhenToUse)
            @if (example.WhenNotToUse.Count > 0)
            {
                <DocsHeading Id="when-not-to-use" Text="When not to use" Level="TextElement.H3"
                             TextStyle="TextStyle.Subtitle" />
                @Notes("When not to use", example.WhenNotToUse)
            }

            @foreach (var section in example.Sections)
            {
                <DocsHeading Id="@section.Id" Text="@section.Title" Class="docs-section" />
                <TbText>@DocsText.Render(section.Description)</TbText>
                <ExampleFrame Name="@example.Name" Section="section" FullWidth="example.FullWidth" />
            }

            <DocsHeading Id="accessibility" Text="Accessibility" Class="docs-section" />
            @if (example.Pattern is { } pattern)
            {
                <TbText>
                    It follows the <a href="@pattern.Url">@pattern.Name pattern</a> from the WAI-ARIA Authoring
                    Practices.
                </TbText>
            }
            @if (example.Keyboard.Count > 0)
            {
                <DocsHeading Id="keyboard" Text="Keyboard" Level="TextElement.H3" TextStyle="TextStyle.Subtitle" />
                <KeyboardTable Rows="example.Keyboard" />
                @RightToLeft(example)
            }
            @if (example.LabelingNotes.Count > 0)
            {
                <DocsHeading Id="labeling" Text="Labeling" Level="TextElement.H3" TextStyle="TextStyle.Subtitle" />
                @Notes("Labeling", example.LabelingNotes)
            }
            @if (example.Announcements.Count > 0)
            {
                <DocsHeading Id="announcements" Text="What screen readers announce" Level="TextElement.H3"
                             TextStyle="TextStyle.Subtitle" />
                @Notes("What screen readers announce", example.Announcements)
            }
            <DocsHeading Id="what-it-does" Text="What the component does" Level="TextElement.H3"
                         TextStyle="TextStyle.Subtitle" />
            @Notes("Accessibility", example.Accessibility)
            @if (example.Keyboard.Count == 0)
            {
                @RightToLeft(example)
            }
            @if (example.AppDuties.Count > 0)
            {
                <DocsHeading Id="app-duties" Text="What your app must do" Level="TextElement.H3"
                             TextStyle="TextStyle.Subtitle" />
                @Notes("What your app must do", example.AppDuties)
            }
            <DocsHeading Id="before-interactive" Text="Before the page is interactive" Level="TextElement.H3"
                         TextStyle="TextStyle.Subtitle" />
            <TbText data-testid="render-modes">
                On a static page: <strong>@RenderModes.Label(example.Modes.Static)</strong>. On a prerendered page
                before it turns interactive: <strong>@RenderModes.Label(example.Modes.BeforeInteractive)</strong>.
                See <a href="guides/getting-started#render-modes">every component's render modes</a>.
            </TbText>
            @Notes("Before the page is interactive", example.BeforeInteractive)

            <TbText class="docs-note">
                The <a href="guides/accessibility">accessibility guide</a> lists what your app must do, and
                <a href="guides/accessibility#status">what has been tested</a> for each component.
            </TbText>

            @if (example.NotesShown.Count > 0)
            {
                <DocsHeading Id="notes" Text="Notes and limitations" Class="docs-section" />
                @foreach (var pitfall in example.NotesShown.Where(note => note.Pitfall))
                {
                    <DocsCallout Tone="Tone.Warning">@DocsText.Render(pitfall.Text)</DocsCallout>
                }
                @Notes("Notes and limitations", PlainNotes(example))
            }

            <DocsHeading Id="telemetry" Text="Telemetry" Class="docs-section" />
            @if (example.TelemetryNotes.Count > 0)
            {
                @Notes("Telemetry", example.TelemetryNotes)
            }
            else
            {
                <TbText>It reports nothing through the <code>Trailblazor</code> meter.</TbText>
            }
            <TbText class="docs-note">
                The <a href="guides/telemetry">telemetry guide</a> shows how to see what people use, in the dashboard
                you already have.
            </TbText>

            <DocsHeading Id="design-tokens" Text="Design tokens" Class="docs-section" />
            @if (DesignTokens.Read(example.Blocks) is { Count: > 0 } tokens)
            {
                <TbText>
                    Its styles read these tokens from the theme, so changing one restyles it along with everything
                    else that reads it. The <a href="guides/theming">theming guide</a> shows how.
                </TbText>
                <ul class="docs-tokens" aria-label="Design tokens">
                    @foreach (var token in tokens)
                    {
                        <li><code>@token</code></li>
                    }
                </ul>
            }
            else
            {
                <TbText>Its styles read no theme tokens.</TbText>
            }
            @if (DesignTokens.Hooks(example.Blocks) is { Count: > 0 } hooks)
            {
                <TbText>
                    It also has tokens of its own, which change only this component. Set one on the page or on any
                    element that contains it; a token you don't set keeps the default shown here.
                </TbText>
                <div class="docs-api" tabindex="0" role="region" aria-label="Its own tokens">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Token</th>
                                <th scope="col">Default</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (name, fallback) in hooks)
                            {
                                <tr>
                                    <th scope="row"><code>@name</code></th>
                                    <td><code>@fallback</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <DocsHeading Id="testing" Text="Testing" Class="docs-section" />
            <TbText class="docs-note">
                The <a href="guides/testing">testing guide</a> shows how to set up bUnit and Playwright.
            </TbText>
            <DocsHeading Id="finding-it" Text="Finding it" Level="TextElement.H3" TextStyle="TextStyle.Subtitle" />
            @if (example.Target is { } target)
            {
                <TbText>Find it by its role, the way a person finds it:</TbText>
                <CodeBlock Label="Finding it in Playwright" Code="@target.Steps" />
            }
            else
            {
                <TbText>
                    It has no role and name a test can single out, so find what it holds or what sits next to it.
                </TbText>
            }
            @if (example.Ready is { } ready)
            {
                <TbText>
                    Once it's ready to use, it sets <code>data-ready</code> on @ready.Element. If a test doesn't
                    use the Playwright helpers, wait for it first, as the
                    <a href="guides/testing#waiting">testing guide</a> explains.
                </TbText>
            }
            @if (example.DataParts.Count > 0)
            {
                <TbText>
                    Its parts carry a stable <code>data-part</code> name, for finding what a role can't, as with
                    <code>[data-part=@example.DataParts[0].Name]</code>. The
                    <a href="@($"components/{example.Name}/api#parts")">API page lists each part</a> and what it is.
                </TbText>
            }
            @if (example.Scenario is { } scenario)
            {
                var bunit = TestScenario.Bunit(example);
                var playwright = TestScenario.Playwright(example);
                <DocsHeading Id="whole-test" Text="A whole test" Level="TextElement.H3"
                             TextStyle="TextStyle.Subtitle" />
                <TbText>
                    @DocsText.Render($"The test covers the example under [{SectionTitle(example, scenario)}]"
                        + $"(components/{example.Name}#{scenario.Section}): {scenario.Checks}")
                </TbText>
                @if (scenario.WithoutHelpers)
                {
                    <TbText>
                        The component has no helper of its own, so the tests read it by role and by its markup, as an
                        app's tests would.
                    </TbText>
                }
                <TbTabs AriaLabel="The test in each package" RenderAllPanels>
                    @if (bunit is not null)
                    {
                        <TbTab Text="bUnit">
                            <CodeBlock Label="The test in bUnit" Code="@bunit" Language="CodeLanguage.CSharp" />
                            <TbText class="docs-note docs-test-setup">@DocsText.Render(BunitSetup(scenario))</TbText>
                        </TbTab>
                    }
                    @if (playwright is not null)
                    {
                        <TbTab Text="Playwright">
                            <CodeBlock Label="The test in Playwright" Code="@playwright"
                                       Language="CodeLanguage.CSharp" />
                            <TbText class="docs-note docs-test-setup">
                                @DocsText.Render(PlaywrightSetup(scenario))
                            </TbText>
                        </TbTab>
                    }
                </TbTabs>
            }
            @if (example.TestingTipsShown.Count > 0)
            {
                <DocsHeading Id="testing-tips" Text="Tips" Level="TextElement.H3" TextStyle="TextStyle.Subtitle" />
                @Notes("Testing tips", example.TestingTipsShown)
            }

            <DocsHeading Id="related" Text="Related" Class="docs-section" />
            <ul class="docs-notes" aria-label="Related">
                @foreach (var related in example.Related.Select(name => ExampleCatalog.Find(name)!))
                {
                    <li><a href="@($"components/{related.Name}")">@related.Title</a>: @related.Summary</li>
                }
            </ul>

            <ComponentPager Example="example" />
        </ChildContent>
    </DocsArticle>
}
else
{
    <PageTitle>Not found · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Not found</TbText>
    <TbText>There is no component named @Name.</TbText>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";

    private static string SectionTitle(Example example, TestScenario scenario) =>
        example.Sections.Single(section => section.Id == scenario.Section).Title;

    private static string BunitSetup(TestScenario scenario) => $"From the library's own bUnit suite, {Using(scenario)} "
        + "`Trailblazor.Testing`. The test's class is a `BunitContext` that calls `this.AddTrailblazor()`.";

    private static string PlaywrightSetup(TestScenario scenario) => "From the library's own Playwright suite, "
        + $"{Using(scenario)} `Trailblazor.Testing.Playwright`. Its `OpenAsync` opens the example on a page by itself "
        + "and waits until the page is interactive, as `page.GotoAsync(...)` and `page.Tb().InteractiveAsync()` do in "
        + "your tests. `Expect` is Playwright's `Assertions.Expect`.";

    private static string Using(TestScenario scenario) =>
        scenario.WithoutHelpers ? "set up with" : "with the helpers from";

    private static IReadOnlyList<string> PlainNotes(Example example) =>
        [.. example.NotesShown.Where(note => !note.Pitfall).Select(note => note.Text)];

    private static RenderFragment RightToLeft(Example example) => example.RightToLeftKeys is { } swapped
        ? @<TbText>Right to left: @DocsText.Render(swapped)</TbText>
        : _ => { };

    // A list of catalog notes, named so a test and a screen reader can tell the lists apart.
    private static RenderFragment Notes(string name, IReadOnlyList<string> notes) =>
        @<ul class="docs-notes" aria-label="@name">
            @foreach (var note in notes)
            {
                <li>@DocsText.Render(note)</li>
            }
        </ul>;
}
