@page "/components/{Name}"
@using Trailblazor.Docs.Examples

@if (ExampleCatalog.Find(Name) is { } example)
{
    <PageTitle>@example.Title · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">@example.Title</TbText>
    <TbText TextStyle="TextStyle.Subtitle" class="docs-lead">@example.Summary</TbText>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Example</TbText>
    <div class="docs-example">
        <DynamicComponent Type="example.Component" />
    </div>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Source</TbText>
    @foreach (var source in example.Sources)
    {
        <TbText TextStyle="TextStyle.Caption" As="TextElement.P" class="docs-source__file">@source.File</TbText>
        <CodeBlock Label="@source.File" Code="@source.Text" />
    }

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">API</TbText>
    @if (example.Api.Any(type => type.IsAssignableTo(typeof(IComponent))))
    {
        <TbText class="docs-note">
            Every component also takes <code>Class</code>, <code>Style</code> and any other HTML attribute, such as
            <code>aria-*</code>, and puts them on its outer element. An <code>id</code> goes on the part users act on,
            such as a field's input or a menu's trigger, as the Testing guide lists.
        </TbText>
    }
    @foreach (var type in example.Api)
    {
        <ApiTable Type="type" />
    }

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Accessibility</TbText>
    <ul class="docs-notes" aria-label="Accessibility">
        @foreach (var note in example.AccessibilityNotes)
        {
            <li>@DocsText.WithCode(note)</li>
        }
    </ul>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Telemetry</TbText>
    @if (example.TelemetryNotes.Count > 0)
    {
        <ul class="docs-notes" aria-label="Telemetry">
            @foreach (var note in example.TelemetryNotes)
            {
                <li>@DocsText.WithCode(note)</li>
            }
        </ul>
    }
    else
    {
        <TbText>It reports nothing through the <code>Trailblazor</code> meter.</TbText>
    }
    <TbText class="docs-note">
        The <a href="guides/telemetry">telemetry guide</a> shows how to see what people use, in the dashboard you
        already have.
    </TbText>

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Design tokens</TbText>
    @if (DesignTokens.Read(example.Blocks) is { Count: > 0 } tokens)
    {
        <TbText>
            Its styles read these tokens from the theme, so changing one restyles it along with everything else that
            reads it. The <a href="guides/theming">theming guide</a> shows how.
        </TbText>
        <ul class="docs-tokens" aria-label="Design tokens">
            @foreach (var token in tokens)
            {
                <li><code>@token</code></li>
            }
        </ul>
    }
    else
    {
        <TbText>Its styles read no theme tokens.</TbText>
    }

    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">Testing</TbText>
    @if (example.Target is { } target)
    {
        <TbText>Find it by its role, the way a person finds it:</TbText>
        <CodeBlock Label="Finding it in Playwright" Code="@target.Steps" />
    }
    else
    {
        <TbText>It has no role and name a test can single out, so find what it holds or what sits next to it.</TbText>
    }
    @if (example.TestingTip is { } tip)
    {
        <TbText>@DocsText.WithCode(tip)</TbText>
    }
    @if (example.DataParts.Count > 0)
    {
        <TbText>
            Its parts carry a stable <code>data-part</code> name, for finding what a role can't, as with
            <code>[data-part=@example.DataParts[0]]</code>:
        </TbText>
        <ul class="docs-tokens" aria-label="Data parts">
            @foreach (var part in example.DataParts)
            {
                <li><code>@part</code></li>
            }
        </ul>
    }
    <TbText class="docs-note">
        The <a href="guides/testing">testing guide</a> shows how to set up bUnit and Playwright.
    </TbText>
}
else
{
    <PageTitle>Not found · Trailblazor</PageTitle>
    <TbText TextStyle="TextStyle.Headline" As="TextElement.H1">Not found</TbText>
    <TbText>There is no component named @Name.</TbText>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";
}
