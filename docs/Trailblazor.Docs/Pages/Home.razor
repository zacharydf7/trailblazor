@page "/"
@using Trailblazor.Docs.Examples
@inject NavigationManager Navigation
@inject IBrowserService Browser

<PageTitle>Trailblazor</PageTitle>

<section class="docs-hero" aria-labelledby="docs-hero-title">
    <div class="docs-wrap docs-hero__grid">
        <div class="docs-hero__text">
            <TbText TextStyle="TextStyle.Caption" class="docs-eyebrow">Blazor components for .NET 10</TbText>
            <TbText TextStyle="TextStyle.Display" As="TextElement.H1" id="docs-hero-title" class="docs-hero__title">
                Accessible components, <span>built on the platform</span>
            </TbText>
            <TbText TextStyle="TextStyle.Subtitle" Muted class="docs-hero__lede">
                Trailblazor gives Blazor apps the inputs, overlays, navigation and feedback they need, built on the
                browser's own dialogs and popovers, themed with design tokens, and tested in Chromium, Firefox and
                WebKit. Pages built with it are <a href="guides/testing">easy to test</a>, and its components
                <a href="guides/telemetry">count which features people use</a>.
                Every example on this site runs in your browser.
            </TbText>
            <div class="docs-hero__actions">
                <TbButton Href="guides/getting-started" Size="Size.Large">Get started</TbButton>
                <TbButton Href="#components" Variant="Variant.Outlined" Size="Size.Large">Browse components</TbButton>
                <TbButton Href="https://github.com/zacharydf7/trailblazor" Variant="Variant.Outlined"
                          Size="Size.Large">GitHub</TbButton>
            </div>
            @* On a phone the command can scroll sideways, so it takes focus for keyboard users. *@
            <p class="docs-install" role="region" tabindex="0" aria-label="Clone command">
                <span aria-hidden="true">$</span> <b>git clone</b> https://github.com/zacharydf7/trailblazor.git
            </p>
        </div>
        <div class="docs-window">
            <div class="docs-window__bar" aria-hidden="true"><i></i><i></i><i></i><span>A trail form</span></div>
            <TbTabs AriaLabel="Hero example" class="docs-window__tabs">
                <TbTab Text="Preview">
                    <div class="docs-window__body">
                        <TbStack Gap="4">
                            <TbTextField Label="Trail name" @bind-Value="_trail" />
                            <TbSelect Label="Difficulty" @bind-Value="_difficulty">
                                <TbOption Value="@("Easy")">Easy</TbOption>
                                <TbOption Value="@("Moderate")">Moderate</TbOption>
                                <TbOption Value="@("Strenuous")">Strenuous</TbOption>
                            </TbSelect>
                            <TbSwitch Label="Dogs allowed" @bind-Value="_dogs" />
                            <TbStack Row Gap="2" Align="Align.Center">
                                <TbButton OnClick="Save">Save trail</TbButton>
                                @if (_saved is not null)
                                {
                                    <TbText TextStyle="TextStyle.BodySmall" Muted>Saved @_saved.</TbText>
                                }
                            </TbStack>
                        </TbStack>
                    </div>
                </TbTab>
                <TbTab Text="Code">
                    <CodeBlock Label="The trail form's markup" Code="@HeroCode" />
                </TbTab>
            </TbTabs>
        </div>
    </div>
</section>

<section class="docs-band docs-band--pillars" aria-labelledby="docs-pillars">
    <div class="docs-wrap">
        <div class="docs-band__head">
            <TbText TextStyle="TextStyle.Headline" As="TextElement.H2" id="docs-pillars">
                Built to be tested and measured
            </TbText>
            <TbText TextStyle="TextStyle.Subtitle" Muted>
                A complete component library, with nothing given up: everything an app needs, plus two things most
                libraries leave to you, tests that find components the way people do and counts of which features
                people actually use.
            </TbText>
        </div>
        <ul class="docs-pillars">
            <li class="docs-pillar">
                <TbText TextStyle="TextStyle.Title" As="TextElement.H3">Everything an app needs</TbText>
                <TbText Muted>
                    @ExampleCatalog.All.Count components: fields, pickers and file uploads, a data grid that sorts,
                    pages and selects, a virtualized tree view, dialogs, menus, popovers, tabs, toasts and more, each
                    accessible and themed, with fields and forms that work before the page is interactive.
                </TbText>
                <ul class="docs-tokens" aria-label="Components by group">
                    @foreach (var category in Enum.GetValues<ExampleCategory>())
                    {
                        var count = ExampleCatalog.All.Count(example => example.Category == category);
                        <li><code>@category @count</code></li>
                    }
                </ul>
                <TbLink Href="#components">Browse the components</TbLink>
            </li>
            <li class="docs-pillar">
                <TbText TextStyle="TextStyle.Title" As="TextElement.H3">Easy to test</TbText>
                <TbText Muted>
                    <code>Trailblazor.Testing</code> sets up bUnit with fakes for the browser, time and JavaScript, and
                    <code>Trailblazor.Testing.Playwright</code> drives selects, trees, grids and popovers by their
                    labels, the way users do, with <code>page.Tb()</code>.
                </TbText>
                <CodeBlock Label="A Playwright test" Code="@PillarTest" />
                <TbLink Href="guides/testing">Read the testing guide</TbLink>
            </li>
            <li class="docs-pillar">
                <TbText TextStyle="TextStyle.Title" As="TextElement.H3">Built-in telemetry</TbText>
                <TbText Muted>
                    Label a control with <code>TelemetryName</code> and Trailblazor counts how often people see it and
                    use it. The counts go through OpenTelemetry to the dashboard you already have. Features that are
                    shown but never used stand out, and nothing about the user is recorded.
                </TbText>
                <CodeBlock Label="A counted button" Code="@PillarTelemetry" />
                <TbLink Href="guides/telemetry">Read the telemetry guide</TbLink>
            </li>
        </ul>
    </div>
</section>

<section class="docs-band" aria-labelledby="docs-why">
    <div class="docs-wrap">
        <div class="docs-band__head">
            <TbText TextStyle="TextStyle.Headline" As="TextElement.H2" id="docs-why">
                What you get in every component
            </TbText>
            <TbText TextStyle="TextStyle.Subtitle" Muted>
                The parts that are easy to get wrong in a component library, done the same way everywhere and checked
                by tests in three browser engines.
            </TbText>
        </div>
        <ul class="docs-features">
            @foreach (var feature in Features)
            {
                <li class="docs-feature">
                    <TbText TextStyle="TextStyle.Subtitle" As="TextElement.H3">@feature.Title</TbText>
                    <TbText TextStyle="TextStyle.BodySmall" Muted>@DocsText.Render(feature.Text)</TbText>
                </li>
            }
        </ul>
    </div>
</section>

@* The catalog: every guide and component, in the sidebar's order, so this page can be the whole map. *@
<section @ref="_catalog" class="docs-band docs-band--tinted docs-catalog" aria-labelledby="components">
    <div class="docs-wrap">
        <div class="docs-band__head">
            <TbText TextStyle="TextStyle.Headline" As="TextElement.H2" id="components">Guides and components</TbText>
            <TbText TextStyle="TextStyle.Subtitle" Muted>
                @ExampleCatalog.All.Count components in @(Enum.GetValues<ExampleCategory>().Length) groups, each with a
                live example, its source, an API table, accessibility notes and a testing tip.
            </TbText>
        </div>
        <div class="docs-group">
            <TbText TextStyle="TextStyle.Title" As="TextElement.H3" class="docs-group__title">Guides</TbText>
            <ul class="docs-cards">
                @foreach (var guide in GuideCatalog.All)
                {
                    <li class="docs-card">
                        <a href="@guide.Path" class="docs-card__title">@guide.Title</a>
                        <TbText TextStyle="TextStyle.BodySmall" Muted>@guide.Summary</TbText>
                    </li>
                }
            </ul>
        </div>
        @foreach (var category in Enum.GetValues<ExampleCategory>())
        {
            var examples = ExampleCatalog.All.Where(example => example.Category == category).ToList();
            <div class="docs-group">
                <TbText TextStyle="TextStyle.Title" As="TextElement.H3" class="docs-group__title">
                    @category <span class="docs-group__count">@examples.Count</span>
                </TbText>
                <ul class="docs-cards">
                    @foreach (var example in examples)
                    {
                        <li class="docs-card">
                            <a href="@($"components/{example.Name}")" class="docs-card__title">@example.Title</a>
                            <TbText TextStyle="TextStyle.BodySmall" Muted>@example.Summary</TbText>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

@code {
    private string? _trail = "Ridge loop";
    private string? _difficulty = "Moderate";
    private bool _dogs = true;
    private string? _saved;
    private ElementReference _catalog;

    // A link to the catalog from another page arrives before the catalog has rendered, so the page scrolls to it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && new Uri(Navigation.Uri).Fragment == "#components")
        {
            await Browser.ScrollIntoViewAsync(_catalog, ScrollAlignment.Start);
        }
    }

    private void Save() => _saved = _trail;

    private static readonly (string Title, string Text)[] Features =
    [
        ("Accessible by default", "Each component follows its WAI-ARIA pattern, with the keyboard, focus and names "
            + "screen readers expect, and every example passes axe in Chromium, Firefox and WebKit. [See what's "
            + "tested and what isn't](guides/accessibility)."),
        ("Built on the platform", "Dialogs are native dialog elements and menus, selects and tooltips use the popover "
            + "API, so the browser handles layering, light dismiss and the top layer."),
        ("Themed with tokens", "Colors, spacing, type and motion are CSS custom properties. Switch palettes, follow the "
            + "system's light or dark setting, or change one token for the whole app."),
        ("Works before it's interactive", "Rendered statically, fields fall back to native controls and forms still "
            + "post, so pages work before a circuit connects or without one."),
        ("Respects your users", "Reduced motion stops animations, forced colors keep outlines and fills, and "
            + "[right-to-left layouts mirror](guides/right-to-left), without extra work in your app."),
    ];

    // Keep each card's sample narrow enough to fit the card on a phone without scrolling; DocsSiteTests checks it.
    private const string PillarTest = """
        await page.Tb()
            .Select("Difficulty")
            .ChooseAsync("Hard");

        await page.Tb()
            .Grid("Trails")
            .SortAsync("Name");
        """;

    private const string PillarTelemetry = """
        <TbButton
            TelemetryName="save"
            OnClick="SaveAsync">
            Save
        </TbButton>
        """;

    // The preview's own markup, so the Code tab shows exactly what renders beside it.
    private const string HeroCode = """
        <TbStack Gap="4">
            <TbTextField Label="Trail name" @bind-Value="_trail" />
            <TbSelect Label="Difficulty" @bind-Value="_difficulty">
                <TbOption Value="@("Easy")">Easy</TbOption>
                <TbOption Value="@("Moderate")">Moderate</TbOption>
                <TbOption Value="@("Strenuous")">Strenuous</TbOption>
            </TbSelect>
            <TbSwitch Label="Dogs allowed" @bind-Value="_dogs" />
            <TbStack Row Gap="2" Align="Align.Center">
                <TbButton OnClick="Save">Save trail</TbButton>
                @if (_saved is not null)
                {
                    <TbText TextStyle="TextStyle.BodySmall" Muted>Saved @_saved.</TbText>
                }
            </TbStack>
        </TbStack>
        """;
}
