@page "/"
@using Trailblazor.Docs.Examples

<PageTitle>Trailblazor</PageTitle>

<TbText TextStyle="TextStyle.Display" As="TextElement.H1">Trailblazor</TbText>
<TbText TextStyle="TextStyle.Subtitle" class="docs-lead">
    Accessible Blazor components for .NET 10, built on the browser's own dialogs and popovers and styled with design
    tokens. Every example on this site runs in your browser, so try them out.
</TbText>

@foreach (var category in Enum.GetValues<ExampleCategory>())
{
    <TbText TextStyle="TextStyle.Title" As="TextElement.H2" class="docs-section">@category</TbText>
    <ul class="docs-cards">
        @foreach (var example in ExampleCatalog.All.Where(example => example.Category == category))
        {
            <li class="docs-card">
                <a href="@($"components/{example.Name}")" class="docs-card__title">@example.Title</a>
                <TbText>@example.Summary</TbText>
            </li>
        }
    </ul>
}
