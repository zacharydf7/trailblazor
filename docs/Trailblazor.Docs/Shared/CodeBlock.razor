@* Long lines scroll rather than wrap, so a word never breaks; scrolling needs focus for keyboard users. *@
<pre class="docs-source" role="region" tabindex="0" aria-label="@Label"><code>@Code.ReplaceLineEndings("\n")</code></pre>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Code { get; set; } = "";
}
