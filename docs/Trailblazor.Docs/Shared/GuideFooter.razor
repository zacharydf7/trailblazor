@using System.Reflection
@using Trailblazor.Docs.Examples

<ul class="docs-page-links docs-page-links--end" aria-label="As Markdown">
    <PageMarkdown Path="@Path" />
</ul>
<nav class="docs-pager" aria-label="Previous and next guides">
    @if (Neighbor(-1) is { } previous)
    {
        <a href="@previous.Path" rel="prev" class="docs-pager__link">
            <span class="docs-pager__label">Previous</span>@previous.Title
        </a>
    }
    @if (Neighbor(1) is { } next)
    {
        <a href="@next.Path" rel="next" class="docs-pager__link docs-pager__link--next">
            <span class="docs-pager__label">Next</span>@next.Title
        </a>
    }
</nav>

@code {
    /// <summary>The guide's page component, whose route places it in the guides' order.</summary>
    [Parameter, EditorRequired]
    public Type Page { get; set; } = null!;

    private string Path => Page.GetCustomAttribute<RouteAttribute>()!.Template.TrimStart('/');

    private Guide? Neighbor(int step)
    {
        var index = GuideCatalog.All.ToList().FindIndex(guide => guide.Path == Path) + step;
        return index >= 0 && index < GuideCatalog.All.Count ? GuideCatalog.All[index] : null;
    }
}
