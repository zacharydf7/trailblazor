@using Trailblazor.Docs.Examples
@inject NavigationManager Navigation

<DocsHeading Id="@_api.Id" Text="@_api.Name" Level="HeadingLevel" TextStyle="TextStyle.Subtitle" Class="docs-api__name">
    <code>@_api.Name</code>
</DocsHeading>
<TbText class="docs-api__summary">@DocsText.Render(_api.Summary)</TbText>
@if (_api.Groups.Count == 0)
{
    <TbText>No parameters of its own.</TbText>
}
@foreach (var group in _api.Groups)
{
    <DocsHeading Id="@GroupId(_api, group)" Text="@($"{_api.Name} {group.Name.ToLowerInvariant()}")" Level="GroupLevel"
                 TextStyle="TextStyle.Label" Class="docs-api__group">
        @group.Name
    </DocsHeading>
    @* Above 48rem it can scroll sideways, so it takes focus for keyboard users. *@
    @* A phone restyles the rows as grids, which can strip the table semantics, so the roles are spelled out. *@
    <div class="docs-api docs-api--members" role="region" tabindex="0"
         aria-label="@($"{_api.Name} {group.Name.ToLowerInvariant()}")">
        <table role="table">
            <thead role="rowgroup">
                <tr role="row">
                    <th scope="col" role="columnheader">Name</th>
                    <th scope="col" role="columnheader">Type</th>
                    @if (group.Defaults)
                    {
                        <th scope="col" role="columnheader">Default</th>
                    }
                    <th scope="col" role="columnheader">Description</th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                @foreach (var member in group.Members)
                {
                    <tr id="@member.Id" role="row">
                        <th scope="row" role="rowheader">
                            <code>@member.Name</code>
                            <a href="@Navigation.ToSection(member.Id)" class="docs-api__anchor"
                               aria-label="@($"Link to {member.ShortName}")">#</a>
                            @if (member.Required)
                            {
                                <span class="docs-api__required">Required</span>
                            }
                        </th>
                        <td role="cell">
                            <span class="docs-api__label" aria-hidden="true">Type</span>
                            <code>@member.Type</code>
                            @if (member.Values.Count > 0)
                            {
                                <ul class="docs-api__values" aria-label="@($"Values of {member.Name}")">
                                    @foreach (var value in member.Values)
                                    {
                                        <li>
                                            <span class="docs-api__value">
                                                <code>@value.Name</code>@(value.Default ? " (default)" : null)
                                            </span>
                                            @if (value.Description.Length > 0)
                                            {
                                                <span>: @DocsText.Render(value.Description)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </td>
                        @if (group.Defaults)
                        {
                            <td role="cell" class="@(member.Default.Length == 0 ? "docs-api__none" : null)">
                                @if (member.Default.Length > 0)
                                {
                                    <span class="docs-api__label" aria-hidden="true">Default</span>
                                    <code>@member.Default</code>
                                }
                            </td>
                        }
                        <td role="cell">@DocsText.Render(member.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ApiType _api = null!;

    [Parameter, EditorRequired]
    public Type Type { get; set; } = null!;

    // A guide puts its types under an "API" heading, so they default to H3; the API page has no such heading and
    // passes H2.
    [Parameter]
    public TextElement HeadingLevel { get; set; } = TextElement.H3;

    private TextElement GroupLevel => HeadingLevel + 1;

    protected override void OnParametersSet() => _api = ApiDocs.Describe(Type);

    /// <summary>A group's anchor on its page, such as "tbbutton--events"; the two hyphens keep it apart from a
    /// member's.</summary>
    public static string GroupId(ApiType api, ApiGroup group) => $"{api.Id}--{group.Name.ToLowerInvariant()}";
}
