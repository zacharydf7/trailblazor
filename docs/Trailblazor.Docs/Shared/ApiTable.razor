@using Trailblazor.Docs.Examples

<TbText TextStyle="TextStyle.Subtitle" As="HeadingLevel" class="docs-api__name" id="@IdOf(Type)">
    <code>@_api.Name</code>
</TbText>
<TbText class="docs-api__summary">@_api.Summary</TbText>
@if (_api.Members.Count == 0)
{
    <TbText>No parameters of its own.</TbText>
}
else
{
    @* Scrolls sideways on a narrow screen, so it takes focus for keyboard users. *@
    <div class="docs-api" role="region" tabindex="0" aria-label="@_api.Name">
        <table>
            <thead>
                <tr>
                    <th scope="col">@(_api.Methods ? "Member" : "Name")</th>
                    <th scope="col">Type</th>
                    @if (!_api.Methods)
                    {
                        <th scope="col">Default</th>
                    }
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in _api.Members)
                {
                    <tr>
                        <th scope="row">
                            <code>@member.Name</code>
                            @if (member.Required)
                            {
                                <span class="docs-api__required">Required</span>
                            }
                        </th>
                        <td><code>@member.Type</code></td>
                        @if (!_api.Methods)
                        {
                            <td>@if (member.Default.Length > 0) { <code>@member.Default</code> }</td>
                        }
                        <td>@member.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ApiType _api = null!;

    [Parameter, EditorRequired]
    public Type Type { get; set; } = null!;

    // A guide puts its types under an "API" heading, so they default to H3; the API page has no such heading and
    // passes H2.
    [Parameter]
    public TextElement HeadingLevel { get; set; } = TextElement.H3;

    protected override void OnParametersSet() => _api = ApiDocs.Describe(Type);

    // The type's anchor on its page, such as "tbtreeview" for TbTreeView<TItem, TKey>.
    public static string IdOf(Type type) => type.Name.Split('`')[0].ToLowerInvariant();
}
