@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader Assemblies

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // The components whose examples draw the pack's icons.
    private static readonly string[] IconComponents = ["icon", "icon-button"];
    private bool _iconsLoaded;

    // Routes match without regard to case, a query or a fragment, so the check does too.
    private async Task OnNavigateAsync(NavigationContext context)
    {
        var path = context.Path.Split('?', '#')[0].Trim('/');
        // An example's preview opens in a new tab, so the app can start on a preview that needs the icons too.
        if (!_iconsLoaded && (path.Equals("guides/icons", StringComparison.OrdinalIgnoreCase) || IconComponents.Any(
            component => path.Equals($"components/{component}", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith($"preview/{component}/", StringComparison.OrdinalIgnoreCase))))
        {
            await Assemblies.LoadAssembliesAsync(["Trailblazor.Icons.Material.wasm"]);
            _iconsLoaded = true;
        }
    }
}
