<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The telemetry guide listens to the Trailblazor meter in the browser, which .NET 10 leaves off for WebAssembly. -->
    <MetricsSupport>true</MetricsSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trailblazor.Docs.Examples\Trailblazor.Docs.Examples.csproj" />
  </ItemGroup>

  <!-- The icon pack is large, so it loads with the pages that draw its icons (App.razor). -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Trailblazor.Icons.Material.wasm" />
  </ItemGroup>

  <!-- The logo lives once, in the repository's assets; the site serves it from its own root. -->
  <ItemGroup>
    <Content Include="..\..\assets\icon.svg" Link="wwwroot\icon.svg" />
    <Content Include="..\..\assets\icon-32.png" Link="wwwroot\icon-32.png" />
  </ItemGroup>

</Project>
