@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Trailblazor spikes</title>
    <TbStyles />
    <link rel="stylesheet" href="@Assets["spikes.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Trailblazor.Spikes.Client.Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    // Every spike page runs in either mode, picked per request with ?mode=wasm.
    private IComponentRenderMode PageRenderMode =>
        HttpContext.Request.Query["mode"] == "wasm" ? InteractiveWebAssembly : InteractiveServer;
}
